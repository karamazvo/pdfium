{{object 4 0}} <<
  {{streamlen}}
>>
stream
q
  % Set line width to 10
  10 w

  % Key point: Set an extremely small dash pattern [0.000015 0.000015]
  % Format: [dash_length gap_length] phase d
  [0.000015 0.000015] 0 d

  % Draw a long straight line (from x=20 to x=180, length 160)
  % Before the fix, this would cause AGG to attempt drawing 160 / 0.00003 approx 5.33 million loops
  20 100 m
  180 100 l
  S
Q
endstream
endobj
