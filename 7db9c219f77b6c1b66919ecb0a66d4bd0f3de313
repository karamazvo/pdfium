      "writtenOn": "2025-09-29T17:55:13Z",
      "side": 1,
      "message": "Are we going to allow embedders to swap decoders at runtime? Just eyeballing, but this is a compile-time swap. It\u0027s probably ok, given how libpng is used.",
      "parentUuid": "a1fdba70_0fdd7d41",
      "range": {
        "startLine": 39,
        "startChar": 6,
        "endLine": 39,
        "endChar": 16
      },
      "revId": "7db9c219f77b6c1b66919ecb0a66d4bd0f3de313",
