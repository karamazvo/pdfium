   EXPECT_EQ(VeloceRenderOpcode::kNativeOpaqueLine,
             program->native_runs()[1].opcode);
-  ASSERT_EQ(1u, program->line_leaf_ranges().size());
+  ASSERT_EQ(2u, program->line_leaf_ranges().size());
   EXPECT_EQ(0u, program->line_leaf_ranges()[0].first_line);
   EXPECT_EQ(0u, program->line_leaf_ranges()[0].first_command);
-  EXPECT_EQ(3u, program->line_leaf_ranges()[0].command_count);
-  EXPECT_EQ(2u, program->line_leaf_ranges()[0].line_count);
+  EXPECT_EQ(1u, program->line_leaf_ranges()[0].command_count);
+  EXPECT_EQ(1u, program->line_leaf_ranges()[0].line_count);
+  EXPECT_EQ(1u, program->line_leaf_ranges()[1].first_line);
+  EXPECT_EQ(2u, program->line_leaf_ranges()[1].first_command);
