+}
+
+TEST(VeloceRenderProgramTest, BuildsIndependentLeavesAcrossDenseBarriers) {
+  VeloceRenderProgramBuilder builder;
+  for (size_t i = 0; i < 130u; ++i) {
+    builder.AppendPageObject(
+        *MakeOpaqueLine(static_cast<float>(i), static_cast<float>(i + 1u)));
+    if (i + 1u < 130u) {
+      auto fill_barrier = MakeOpaqueLine(1000.0f + static_cast<float>(i),
+                                         1001.0f + static_cast<float>(i));
+      fill_barrier->set_alternate_filltype();
+      builder.AppendPageObject(*fill_barrier);
+    }
+  }
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  ASSERT_EQ(130u, program->native_runs().size());
+  ASSERT_EQ(130u, program->line_leaf_ranges().size());
+  EXPECT_EQ(3u, program->line_coarse_ranges().size());
+  for (size_t i = 0; i < program->line_leaf_ranges().size(); ++i) {
+    const VeloceLineLeafRange& leaf = program->line_leaf_ranges()[i];
+    EXPECT_EQ(i, leaf.first_line);
+    EXPECT_EQ(i * 2u, leaf.first_command);
+    EXPECT_EQ(1u, leaf.command_count);
+    EXPECT_EQ(1u, leaf.line_count);
+  }
 }
 
 }  // namespace
