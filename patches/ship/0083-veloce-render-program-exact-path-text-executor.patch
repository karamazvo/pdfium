diff --git a/core/fpdfapi/render/veloce_unified_render_backend.cpp b/core/fpdfapi/render/veloce_unified_render_backend.cpp
index a493c43e6..0dd8ff937 100644
--- a/core/fpdfapi/render/veloce_unified_render_backend.cpp
+++ b/core/fpdfapi/render/veloce_unified_render_backend.cpp
@@ -3,29 +3,127 @@

 #include "core/fpdfapi/render/veloce_unified_render_backend.h"

+#include <chrono>
+#include <cstdint>
+#include <vector>
+
+#include "core/fpdfapi/page/cpdf_pageobject.h"
 #include "core/fpdfapi/page/cpdf_pageobjectholder.h"
 #include "core/fpdfapi/page/veloce_render_program.h"
+#include "core/fpdfapi/render/cpdf_renderstatus.h"
+#include "core/fxge/cfx_renderdevice.h"
+
+namespace {
+
+constexpr size_t kMaxCandidateCommands = 256u * 1024u;
+
+uint64_t MonotonicNanoseconds() {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+bool CommandMatchesObject(VeloceRenderCommandKind kind,
+                          const CPDF_PageObject& object) {
+  return (kind == VeloceRenderCommandKind::kPath && object.IsPath()) ||
+         (kind == VeloceRenderCommandKind::kText && object.IsText());
+}
+
+bool RectIntersects(const CFX_FloatRect& object_rect,
+                    const CFX_FloatRect& clip_rect) {
+  return object_rect.left <= clip_rect.right &&
+         object_rect.right >= clip_rect.left &&
+         object_rect.bottom <= clip_rect.top &&
+         object_rect.top >= clip_rect.bottom;
+}
+
+}  // namespace

 VeloceUnifiedRenderResult VeloceTryRenderUnifiedProgram(
-    CPDF_RenderStatus*,
+    CPDF_RenderStatus* status,
     const CPDF_PageObjectHolder* holder,
-    const CFX_Matrix&,
+    const CFX_Matrix& holder_to_device,
     VeloceUnifiedRenderMetrics* metrics) {
   if (metrics) {
     *metrics = {};
-    const VeloceRenderProgram* program =
-        holder ? holder->GetVeloceRenderProgram() : nullptr;
-    if (program) {
-      metrics->total_commands = program->command_count();
-      metrics->program_bytes = program->EstimatedBytes();
-      if (program->spatial_index()) {
-        metrics->index_bytes = program->spatial_index()->EstimatedBytes();
-        metrics->index_postings =
-            program->spatial_index()->posting_count();
-        metrics->always_candidate_commands =
-            program->spatial_index()->always_candidate_count();
-      }
+  }
+  if (!status || !holder || !status->GetRenderDevice() ||
+      holder->GetParseState() != CPDF_PageObjectHolder::ParseState::kParsed) {
+    return VeloceUnifiedRenderResult::kNotEligible;
+  }
+
+  const VeloceRenderProgram* program = holder->GetVeloceRenderProgram();
+  if (!program) {
+    return VeloceUnifiedRenderResult::kNotEligible;
+  }
+  if (metrics) {
+    metrics->total_commands = program->command_count();
+    metrics->program_bytes = program->EstimatedBytes();
+  }
+
+  const VeloceSpatialCandidateIndex* index = program->spatial_index();
+  if (!index || program->command_count() != holder->GetPageObjectCount() ||
+      index->command_count() != program->command_count() ||
+      program->command_kind_count(VeloceRenderCommandKind::kPath) +
+              program->command_kind_count(VeloceRenderCommandKind::kText) !=
+          program->command_count()) {
+    return VeloceUnifiedRenderResult::kNotEligible;
+  }
+  if (metrics) {
+    metrics->index_bytes = index->EstimatedBytes();
+    metrics->index_postings = index->posting_count();
+    metrics->always_candidate_commands = index->always_candidate_count();
+  }
+
+  CFX_FloatRect holder_clip = holder_to_device.GetInverse().TransformRect(
+      CFX_FloatRect(status->GetRenderDevice()->GetClipBox()));
+  holder_clip.Normalize();
+  std::vector<uint32_t> candidates;
+  const uint64_t query_start = metrics ? MonotonicNanoseconds() : 0;
+  const VeloceSpatialQueryResult query_result = index->Query(
+      holder->GetBBox(), holder_clip, kMaxCandidateCommands, &candidates);
+  if (metrics) {
+    metrics->candidate_query_ns = MonotonicNanoseconds() - query_start;
+    metrics->candidate_commands = candidates.size();
+    metrics->scratch_bytes = candidates.capacity() * sizeof(uint32_t);
+  }
+  if (query_result == VeloceSpatialQueryResult::kUseFullReplay) {
+    return VeloceUnifiedRenderResult::kNotEligible;
+  }
+
+  const auto commands = program->commands();
+  for (uint32_t command_index : candidates) {
+    CPDF_PageObject* object = holder->GetPageObjectByIndex(command_index);
+    if (!object || command_index >= commands.size() ||
+        !CommandMatchesObject(commands[command_index], *object)) {
+      return VeloceUnifiedRenderResult::kNotEligible;
     }
   }
-  return VeloceUnifiedRenderResult::kDisabled;
+
+  const uint64_t replay_start = metrics ? MonotonicNanoseconds() : 0;
+  for (uint32_t command_index : candidates) {
+    if (status->ShouldCancelRender()) {
+      return VeloceUnifiedRenderResult::kCancelled;
+    }
+    CPDF_PageObject* object = holder->GetPageObjectByIndex(command_index);
+    if (metrics) {
+      ++metrics->visited_commands;
+    }
+    if (!object->IsActive() || !RectIntersects(object->GetRect(), holder_clip)) {
+      continue;
+    }
+    status->RenderSingleObject(object, holder_to_device);
+    if (metrics) {
+      ++metrics->drawn_commands;
+      ++metrics->dispatch_count;
+    }
+    if (status->IsStopped() || status->ShouldCancelRender()) {
+      return VeloceUnifiedRenderResult::kCancelled;
+    }
+  }
+  if (metrics) {
+    metrics->replay_ns = MonotonicNanoseconds() - replay_start;
+  }
+  return VeloceUnifiedRenderResult::kRendered;
 }
