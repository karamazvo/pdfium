+void RecordBlendPaintBarrierTelemetry(PathDlReplayStats* replay_stats,
+                                      const NativePathDisplayList& list,
+                                      const MaskRun& pending_run,
+                                      const PathDlPaint& next_paint,
+                                      const FX_RECT& next_rect) {
+  if (!replay_stats) {
+    return;
+  }
+  replay_stats->blend_paint_change_barriers++;
+  if (!pending_run.group_rect_valid || pending_run.group_rect.IsEmpty() ||
+      next_rect.IsEmpty() || pending_run.paint_key >= list.paint_table.size()) {
+    replay_stats->blend_paint_change_unknown++;
+    return;
+  }
+  if (RectsIntersect(pending_run.group_rect, next_rect)) {
+    replay_stats->blend_paint_change_overlap++;
+    return;
+  }
+  replay_stats->blend_paint_change_disjoint++;
+  const PathDlPaint& previous_paint = list.paint_table[pending_run.paint_key];
+  if (previous_paint.blend_mode == next_paint.blend_mode) {
+    replay_stats->blend_paint_change_candidates++;
+  }
+}
