+uint64_t RectPixelArea(const FX_RECT& rect) {
+  if (rect.IsEmpty()) {
+    return 0;
+  }
+  return static_cast<uint64_t>(rect.Width()) *
+         static_cast<uint64_t>(rect.Height());
+}
