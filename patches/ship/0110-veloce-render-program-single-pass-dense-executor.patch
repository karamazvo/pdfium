+class DisjointLinePixelGrid final {
+ public:
+  static constexpr int kColumns = 32;
+  static constexpr int kRows = 32;
+
+  DisjointLinePixelGrid(int width, int height)
+      : width_(width), height_(height) {}
+
+  void Reset() { rows_.fill(0u); }
+
+  bool TryClaim(const CFX_OrderedPathDraw& draw,
+                const CFX_GraphStateData& state) {
+    const std::optional<FX_RECT> bounds = ConservativeBounds(draw, state);
+    if (!bounds.has_value()) {
+      return false;
+    }
+    if (bounds->IsEmpty()) {
+      return true;
+    }
+
+    const auto grid_coordinate = [](int position, int extent,
+                                    int divisions) {
+      return static_cast<int>(static_cast<int64_t>(position) * divisions /
+                              extent);
+    };
+    const int first_column = std::clamp(
+        grid_coordinate(bounds->left, width_, kColumns), 0, kColumns - 1);
+    const int last_column =
+        std::clamp(grid_coordinate(bounds->right - 1, width_, kColumns), 0,
+                   kColumns - 1);
+    const int first_row = std::clamp(
+        grid_coordinate(bounds->top, height_, kRows), 0, kRows - 1);
+    const int last_row =
+        std::clamp(grid_coordinate(bounds->bottom - 1, height_, kRows), 0,
+                   kRows - 1);
+    const uint32_t column_mask =
+        last_column == kColumns - 1
+            ? (~uint32_t{0} << first_column)
+            : ((uint32_t{1} << (last_column + 1)) - 1u) &
+                  (~uint32_t{0} << first_column);
+    for (int row = first_row; row <= last_row; ++row) {
+      if ((rows_[row] & column_mask) != 0u) {
+        return false;
+      }
+    }
+    for (int row = first_row; row <= last_row; ++row) {
+      rows_[row] |= column_mask;
+    }
+    return true;
+  }
+
+ private:
+  std::optional<FX_RECT> ConservativeBounds(
+      const CFX_OrderedPathDraw& draw,
+      const CFX_GraphStateData& state) const {
+    const CFX_PointF start = draw.object_to_device.Transform(draw.line_start);
+    const CFX_PointF end = draw.object_to_device.Transform(draw.line_end);
+    const CFX_Matrix& matrix = draw.object_to_device;
+    const float matrix_norm =
+        std::max(fabs(matrix.a) + fabs(matrix.c),
+                 fabs(matrix.b) + fabs(matrix.d));
+    const float stroke_extent =
+        std::max(0.5f, 0.5f * fabs(state.line_width()) *
+                           std::max(1.0f, fabs(state.miter_limit())) *
+                           matrix_norm) +
+        2.0f;
+    if (!std::isfinite(start.x) || !std::isfinite(start.y) ||
+        !std::isfinite(end.x) || !std::isfinite(end.y) ||
+        !std::isfinite(stroke_extent)) {
+      return std::nullopt;
+    }
+    constexpr float kSafeIntegerCoordinate = 100000000.0f;
+    if (fabs(start.x) > kSafeIntegerCoordinate ||
+        fabs(start.y) > kSafeIntegerCoordinate ||
+        fabs(end.x) > kSafeIntegerCoordinate ||
+        fabs(end.y) > kSafeIntegerCoordinate ||
+        stroke_extent > kSafeIntegerCoordinate) {
+      return std::nullopt;
+    }
+
+    FX_RECT bounds(
+        static_cast<int>(floor(std::min(start.x, end.x) - stroke_extent)),
+        static_cast<int>(floor(std::min(start.y, end.y) - stroke_extent)),
+        static_cast<int>(ceil(std::max(start.x, end.x) + stroke_extent)) + 1,
+        static_cast<int>(ceil(std::max(start.y, end.y) + stroke_extent)) + 1);
+    bounds.Intersect(FX_RECT(0, 0, width_, height_));
+    return bounds;
+  }
+
+  const int width_;
+  const int height_;
+  std::array<uint32_t, kRows> rows_{};
+};
