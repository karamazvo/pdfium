+TEST(VeloceRenderProgramTest,
+     TranslationLineConservativeBoundsContainPriorTightBounds) {
+  auto object = MakeOpaqueLine(1.0f, 3.0f);
+  const CFX_PointF end(7.0f, -9.0f);
+  const CFX_Matrix matrix(2.5f, -1.25f, 0.75f, 3.0f, 100.0f, -50.0f);
+  VeloceRenderProgramBuilder builder(
+      0u, CFX_FloatRect(-1000.0f, -1000.0f, 1000.0f, 1000.0f));
+
+  ASSERT_TRUE(builder.AppendParsedOpaqueLine(
+      CFX_PointF(), end, matrix, object->graphic_states(),
+      *object->GetContentMarks(), /*stream_fused=*/true,
+      /*translation_origin=*/true));
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  ASSERT_TRUE(program->native_line_bounds().has_value());
+  CFX_FloatRect tight_bounds = CFX_Path::GetBoundingBoxForStrokeLine(
+      CFX_PointF(), end, object->graph_state().GetLineWidth());
+  tight_bounds = matrix.TransformRect(tight_bounds);
+  if (object->graph_state().GetLineWidth() == 0.0f) {
+    tight_bounds.Inflate(0.5f, 0.5f);
+  }
+  const CFX_FloatRect& conservative_bounds =
+      program->native_line_bounds().value();
+  EXPECT_LE(conservative_bounds.left, tight_bounds.left);
+  EXPECT_LE(conservative_bounds.bottom, tight_bounds.bottom);
+  EXPECT_GE(conservative_bounds.right, tight_bounds.right);
+  EXPECT_GE(conservative_bounds.top, tight_bounds.top);
