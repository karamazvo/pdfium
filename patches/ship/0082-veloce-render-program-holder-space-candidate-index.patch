--- a/core/fpdfapi/page/veloce_render_program.cpp
+++ b/core/fpdfapi/page/veloce_render_program.cpp
@@ -3,12 +3,24 @@

 #include "core/fpdfapi/page/veloce_render_program.h"

+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
 #include <utility>
+#include <vector>

 #include "core/fpdfapi/page/cpdf_pageobject.h"
+#include "core/fpdfapi/page/cpdf_pageobjectholder.h"

 namespace {

+constexpr size_t kMinSpatialIndexCommands = 4096;
+constexpr size_t kMaxSpatialIndexPostings = 4u * 1024u * 1024u;
+constexpr size_t kMaxAlwaysCandidateCommands = 1024u * 1024u;
+constexpr uint32_t kMaxBinsPerCommand = 64;
+
 VeloceRenderCommandKind ToRenderCommandKind(
     const CPDF_PageObject& object) {
   switch (object.GetType()) {
@@ -26,30 +38,303 @@ VeloceRenderCommandKind ToRenderCommandKind(
   return VeloceRenderCommandKind::kUnsupported;
 }

+bool IsFiniteRect(const CFX_FloatRect& rect) {
+  return std::isfinite(rect.left) && std::isfinite(rect.bottom) &&
+         std::isfinite(rect.right) && std::isfinite(rect.top);
+}
+
+bool RectsExactlyMatch(const CFX_FloatRect& lhs,
+                       const CFX_FloatRect& rhs) {
+  return lhs.left == rhs.left && lhs.bottom == rhs.bottom &&
+         lhs.right == rhs.right && lhs.top == rhs.top;
+}
+
+uint32_t CoordinateToBin(float coordinate,
+                         float minimum,
+                         float span,
+                         uint32_t bin_count) {
+  if (coordinate <= minimum) {
+    return 0;
+  }
+  const float scaled = (coordinate - minimum) * bin_count / span;
+  if (scaled >= bin_count) {
+    return bin_count - 1;
+  }
+  return static_cast<uint32_t>(scaled);
+}
+
+bool GetBinRange(const CFX_FloatRect& bounds,
+                 CFX_FloatRect rect,
+                 uint32_t* left,
+                 uint32_t* right,
+                 uint32_t* bottom,
+                 uint32_t* top) {
+  rect.Normalize();
+  if (!IsFiniteRect(rect) || rect.IsEmpty()) {
+    return false;
+  }
+  rect.Intersect(bounds);
+  if (rect.IsEmpty()) {
+    return false;
+  }
+
+  *left = CoordinateToBin(rect.left, bounds.left, bounds.Width(),
+                          VeloceSpatialCandidateIndex::kColumns);
+  *right = CoordinateToBin(rect.right, bounds.left, bounds.Width(),
+                           VeloceSpatialCandidateIndex::kColumns);
+  *bottom = CoordinateToBin(rect.bottom, bounds.bottom, bounds.Height(),
+                            VeloceSpatialCandidateIndex::kRows);
+  *top = CoordinateToBin(rect.top, bounds.bottom, bounds.Height(),
+                         VeloceSpatialCandidateIndex::kRows);
+  return true;
+}
+
 }  // namespace

+class VeloceSpatialCandidateIndexBuilder final {
+ public:
+  explicit VeloceSpatialCandidateIndexBuilder(CFX_FloatRect bounds)
+      : bounds_(bounds) {
+    bounds_.Normalize();
+  }
+
+  bool Append(uint32_t command_index,
+              VeloceRenderCommandKind kind,
+              const CPDF_PageObject& object) {
+    // Path bounds already include stroke expansion. Other command families
+    // remain always-replayed until their conservative bounds are proven by
+    // the corresponding vertical executor revision.
+    if (kind != VeloceRenderCommandKind::kPath) {
+      return AppendAlwaysCandidate(command_index);
+    }
+
+    CFX_FloatRect rect = object.GetRect();
+    rect.Normalize();
+    if (!IsFiniteRect(rect) || rect.IsEmpty() || rect.left < bounds_.left ||
+        rect.right > bounds_.right || rect.bottom < bounds_.bottom ||
+        rect.top > bounds_.top) {
+      return AppendAlwaysCandidate(command_index);
+    }
+
+    uint32_t left = 0;
+    uint32_t right = 0;
+    uint32_t bottom = 0;
+    uint32_t top = 0;
+    if (!GetBinRange(bounds_, rect, &left, &right, &bottom, &top)) {
+      return AppendAlwaysCandidate(command_index);
+    }
+    const uint32_t bin_count =
+        (right - left + 1u) * (top - bottom + 1u);
+    if (bin_count > kMaxBinsPerCommand) {
+      return AppendAlwaysCandidate(command_index);
+    }
+    if (posting_count_ > kMaxSpatialIndexPostings - bin_count) {
+      return false;
+    }
+
+    for (uint32_t row = bottom; row <= top; ++row) {
+      for (uint32_t column = left; column <= right; ++column) {
+        bins_[row * VeloceSpatialCandidateIndex::kColumns + column]
+            .push_back(command_index);
+        ++posting_count_;
+      }
+    }
+    return true;
+  }
+
+  std::unique_ptr<const VeloceSpatialCandidateIndex> Finish(
+      uint32_t command_count) {
+    std::vector<uint32_t> bin_offsets;
+    bin_offsets.reserve(VeloceSpatialCandidateIndex::kBinCount + 1u);
+    std::vector<uint32_t> command_indices;
+    command_indices.reserve(posting_count_);
+    bin_offsets.push_back(0);
+    for (const auto& bin : bins_) {
+      command_indices.insert(command_indices.end(), bin.begin(), bin.end());
+      bin_offsets.push_back(static_cast<uint32_t>(command_indices.size()));
+    }
+    return std::unique_ptr<const VeloceSpatialCandidateIndex>(
+        new VeloceSpatialCandidateIndex(
+            bounds_, command_count, std::move(bin_offsets),
+            std::move(command_indices), std::move(always_candidate_indices_)));
+  }
+
+ private:
+  bool AppendAlwaysCandidate(uint32_t command_index) {
+    if (always_candidate_indices_.size() >= kMaxAlwaysCandidateCommands) {
+      return false;
+    }
+    always_candidate_indices_.push_back(command_index);
+    return true;
+  }
+
+  CFX_FloatRect bounds_;
+  std::array<std::vector<uint32_t>,
+             VeloceSpatialCandidateIndex::kBinCount>
+      bins_;
+  std::vector<uint32_t> always_candidate_indices_;
+  size_t posting_count_ = 0;
+};
+
+VeloceSpatialCandidateIndex::VeloceSpatialCandidateIndex(
+    const CFX_FloatRect& bounds,
+    uint32_t command_count,
+    std::vector<uint32_t> bin_offsets,
+    std::vector<uint32_t> command_indices,
+    std::vector<uint32_t> always_candidate_indices)
+    : bounds_(bounds),
+      command_count_(command_count),
+      bin_offsets_(std::move(bin_offsets)),
+      command_indices_(std::move(command_indices)),
+      always_candidate_indices_(std::move(always_candidate_indices)) {}
+
+VeloceSpatialQueryResult VeloceSpatialCandidateIndex::Query(
+    const CFX_FloatRect& current_holder_bounds,
+    const CFX_FloatRect& holder_query,
+    size_t max_candidate_count,
+    std::vector<uint32_t>* candidates) const {
+  if (!candidates || max_candidate_count == 0 ||
+      bin_offsets_.size() != kBinCount + 1u) {
+    return VeloceSpatialQueryResult::kUseFullReplay;
+  }
+  candidates->clear();
+
+  CFX_FloatRect live_bounds = current_holder_bounds;
+  live_bounds.Normalize();
+  if (!IsFiniteRect(live_bounds) || live_bounds.IsEmpty() ||
+      !RectsExactlyMatch(bounds_, live_bounds)) {
+    return VeloceSpatialQueryResult::kUseFullReplay;
+  }
+
+  CFX_FloatRect query = holder_query;
+  query.Normalize();
+  if (!IsFiniteRect(query) || query.IsEmpty()) {
+    return VeloceSpatialQueryResult::kUseFullReplay;
+  }
+
+  const auto append_candidates =
+      [candidates, max_candidate_count](const uint32_t* begin,
+                                        const uint32_t* end) {
+    const size_t count = static_cast<size_t>(end - begin);
+    if (count > max_candidate_count - candidates->size()) {
+      return false;
+    }
+    candidates->insert(candidates->end(), begin, end);
+    return true;
+  };
+
+  if (!always_candidate_indices_.empty() &&
+      !append_candidates(always_candidate_indices_.data(),
+                         always_candidate_indices_.data() +
+                             always_candidate_indices_.size())) {
+    candidates->clear();
+    return VeloceSpatialQueryResult::kUseFullReplay;
+  }
+
+  uint32_t left = 0;
+  uint32_t right = 0;
+  uint32_t bottom = 0;
+  uint32_t top = 0;
+  if (GetBinRange(bounds_, query, &left, &right, &bottom, &top)) {
+    for (uint32_t row = bottom; row <= top; ++row) {
+      for (uint32_t column = left; column <= right; ++column) {
+        const uint32_t bin = row * kColumns + column;
+        const uint32_t first = bin_offsets_[bin];
+        const uint32_t last = bin_offsets_[bin + 1u];
+        if (first > last || last > command_indices_.size()) {
+          candidates->clear();
+          return VeloceSpatialQueryResult::kUseFullReplay;
+        }
+        if (first != last) {
+          if (!append_candidates(command_indices_.data() + first,
+                                 command_indices_.data() + last)) {
+            candidates->clear();
+            return VeloceSpatialQueryResult::kUseFullReplay;
+          }
+        }
+      }
+    }
+  }
+
+  std::ranges::sort(*candidates);
+  candidates->erase(std::ranges::unique(*candidates).begin(),
+                    candidates->end());
+  if (!candidates->empty() && candidates->back() >= command_count_) {
+    candidates->clear();
+    return VeloceSpatialQueryResult::kUseFullReplay;
+  }
+
+  return candidates->empty() ? VeloceSpatialQueryResult::kEmpty
+                             : VeloceSpatialQueryResult::kCandidates;
+}
+
+size_t VeloceSpatialCandidateIndex::EstimatedBytes() const {
+  return sizeof(*this) + bin_offsets_.capacity() * sizeof(uint32_t) +
+         command_indices_.capacity() * sizeof(uint32_t) +
+         always_candidate_indices_.capacity() * sizeof(uint32_t);
+}
+
 VeloceRenderProgram::VeloceRenderProgram(
     std::vector<VeloceRenderCommandKind> command_kinds,
-    std::array<uint32_t, kVeloceRenderCommandKindCount> command_kind_counts)
+    std::array<uint32_t, kVeloceRenderCommandKindCount> command_kind_counts,
+    std::unique_ptr<const VeloceSpatialCandidateIndex> spatial_index)
     : command_kinds_(std::move(command_kinds)),
-      command_kind_counts_(command_kind_counts) {}
+      command_kind_counts_(command_kind_counts),
+      spatial_index_(std::move(spatial_index)) {}

 VeloceRenderProgramBuilder::VeloceRenderProgramBuilder() = default;
 VeloceRenderProgramBuilder::~VeloceRenderProgramBuilder() = default;

 void VeloceRenderProgramBuilder::AppendPageObject(
+    const CPDF_PageObjectHolder& holder,
     const CPDF_PageObject& object) {
   if (exceeded_budget_) {
     return;
   }
   if (command_kinds_.size() >= kMaxCommandBytes) {
     std::vector<VeloceRenderCommandKind>().swap(command_kinds_);
+    spatial_index_builder_.reset();
     exceeded_budget_ = true;
     return;
   }
+
   const VeloceRenderCommandKind kind = ToRenderCommandKind(object);
   command_kinds_.push_back(kind);
   ++command_kind_counts_[static_cast<size_t>(kind)];
+
+  if (spatial_index_builder_) {
+    if (!spatial_index_builder_->Append(
+            static_cast<uint32_t>(command_kinds_.size() - 1u), kind, object)) {
+      spatial_index_builder_.reset();
+      spatial_index_abandoned_ = true;
+    }
+    return;
+  }
+  if (spatial_index_abandoned_ ||
+      command_kinds_.size() != kMinSpatialIndexCommands) {
+    return;
+  }
+
+  CFX_FloatRect holder_bounds = holder.GetBBox();
+  holder_bounds.Normalize();
+  if (!IsFiniteRect(holder_bounds) || holder_bounds.IsEmpty()) {
+    spatial_index_abandoned_ = true;
+    return;
+  }
+
+  spatial_index_builder_ =
+      std::make_unique<VeloceSpatialCandidateIndexBuilder>(holder_bounds);
+  for (uint32_t index = 0; index < command_kinds_.size(); ++index) {
+    const CPDF_PageObject* indexed_object =
+        holder.GetPageObjectByIndex(index);
+    if (!indexed_object ||
+        !spatial_index_builder_->Append(index, command_kinds_[index],
+                                        *indexed_object)) {
+      spatial_index_builder_.reset();
+      spatial_index_abandoned_ = true;
+      return;
+    }
+  }
 }

 std::unique_ptr<const VeloceRenderProgram>
@@ -57,7 +342,13 @@ VeloceRenderProgramBuilder::Finish() {
   if (exceeded_budget_ || command_kinds_.empty()) {
     return nullptr;
   }
-  return std::unique_ptr<const VeloceRenderProgram>(
-      new VeloceRenderProgram(std::move(command_kinds_),
-                              command_kind_counts_));
+
+  std::unique_ptr<const VeloceSpatialCandidateIndex> spatial_index;
+  if (spatial_index_builder_) {
+    spatial_index = spatial_index_builder_->Finish(
+        static_cast<uint32_t>(command_kinds_.size()));
+  }
+  return std::unique_ptr<const VeloceRenderProgram>(new VeloceRenderProgram(
+      std::move(command_kinds_), command_kind_counts_,
+      std::move(spatial_index)));
 }
