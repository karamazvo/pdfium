+enum class VeloceSpatialQueryResult : uint8_t {
+  kCandidates,
+  kEmpty,
+  kUseFullReplay,
+};
+
+// Immutable holder-space lookup. Bin postings contain command indices only;
+// exact graphics state and geometry remain owned by the live holder objects.
+// Every posting stream is painter-ordered, and Query() restores strictly
+// increasing command order while removing duplicates in caller-owned storage.
+class VeloceSpatialCandidateIndex final {
+ public:
+  static constexpr uint32_t kColumns = 32;
+  static constexpr uint32_t kRows = 32;
+  static constexpr uint32_t kBinCount = kColumns * kRows;
+
+  ~VeloceSpatialCandidateIndex() = default;
+
+  VeloceSpatialCandidateIndex(const VeloceSpatialCandidateIndex&) = delete;
+  VeloceSpatialCandidateIndex& operator=(
+      const VeloceSpatialCandidateIndex&) = delete;
+
+  VeloceSpatialQueryResult Query(
+      const CFX_FloatRect& current_holder_bounds,
+      const CFX_FloatRect& holder_query,
+      size_t max_candidate_count,
+      std::vector<uint32_t>* candidates) const;
+
+  const CFX_FloatRect& bounds() const { return bounds_; }
+  uint32_t command_count() const { return command_count_; }
+  size_t posting_count() const { return command_indices_.size(); }
+  size_t always_candidate_count() const {
+    return always_candidate_indices_.size();
+  }
+  size_t EstimatedBytes() const;
+
+ private:
+  friend class VeloceSpatialCandidateIndexBuilder;
+
+  VeloceSpatialCandidateIndex(
+      const CFX_FloatRect& bounds,
+      uint32_t command_count,
+      std::vector<uint32_t> bin_offsets,
+      std::vector<uint32_t> command_indices,
+      std::vector<uint32_t> always_candidate_indices);
+
+  const CFX_FloatRect bounds_;
+  const uint32_t command_count_;
+  const std::vector<uint32_t> bin_offsets_;
+  const std::vector<uint32_t> command_indices_;
+  const std::vector<uint32_t> always_candidate_indices_;
+};
+
