+bool NativeRunsCoverSpatialRange(
+    pdfium::span<const VeloceNativeRun> native_runs,
+    uint32_t first_command,
+    uint32_t command_count) {
+  uint32_t command = first_command;
+  const uint32_t limit = first_command + command_count;
+  auto run_it = std::lower_bound(
+      native_runs.begin(), native_runs.end(), first_command,
+      [](const VeloceNativeRun& run, uint32_t value) {
+        return run.first_command + run.command_count <= value;
+      });
+  while (command < limit && run_it != native_runs.end()) {
+    if (run_it->first_command > command ||
+        !RunContains(*run_it, command) ||
+        !IsSpatiallyIndexedOpcode(run_it->opcode)) {
+      return false;
+    }
+    command =
+        std::min(limit, run_it->first_command + run_it->command_count);
+    ++run_it;
+  }
+  return command == limit;
+}
