diff --git a/core/fpdfapi/render/veloce_render_plan.cpp b/core/fpdfapi/render/veloce_render_plan.cpp
--- a/core/fpdfapi/render/veloce_render_plan.cpp
+++ b/core/fpdfapi/render/veloce_render_plan.cpp
@@ -12,6 +12,7 @@
 #include <stdint.h>
 
 #include <algorithm>
+#include <cmath>
 #include <chrono>
 #include <memory>
 #include <mutex>
@@ -681,6 +682,16 @@ bool RectOutsideClip(const CFX_FloatRect& rect,
          rect.bottom > holder_clip.top || rect.top < holder_clip.bottom;
 }
 
+bool NormalizeFiniteBounds(CFX_FloatRect* rect) {
+  if (!rect || !std::isfinite(rect->left) ||
+      !std::isfinite(rect->right) || !std::isfinite(rect->bottom) ||
+      !std::isfinite(rect->top)) {
+    return false;
+  }
+  rect->Normalize();
+  return !rect->IsEmpty();
+}
+
 bool SegmentOutsideClip(const VeloceRenderPlanSegment& segment,
                         const CFX_FloatRect& holder_clip) {
   return segment.has_holder_space_bbox &&
@@ -930,19 +941,23 @@ VeloceRenderPlan VeloceBuildRenderPlanSkeletonForHolder(
   size_t path_run_count = 0;
   bool path_run_has_bbox = false;
   CFX_FloatRect path_run_bbox;
+  bool path_run_bounds_complete = true;
 
   auto flush_path_run = [&plan, &path_run_start, &path_run_count,
-                         &path_run_has_bbox, &path_run_bbox]() {
+                         &path_run_has_bbox, &path_run_bbox,
+                         &path_run_bounds_complete]() {
     if (path_run_start == kNoOpenPathRun) {
       return;
     }
     AppendSegment(&plan, VeloceRenderPlanSegmentKind::kPathRun,
-                  path_run_start, path_run_count, path_run_has_bbox,
+                  path_run_start, path_run_count,
+                  path_run_has_bbox && path_run_bounds_complete,
                   path_run_bbox);
     path_run_start = kNoOpenPathRun;
     path_run_count = 0;
     path_run_has_bbox = false;
     path_run_bbox = CFX_FloatRect();
+    path_run_bounds_complete = true;
   };
 
   for (const auto& object : *holder) {
@@ -951,14 +966,15 @@ VeloceRenderPlan VeloceBuildRenderPlanSkeletonForHolder(
         path_run_start = object_index;
       }
       CFX_FloatRect object_bbox = object->GetRect();
-      object_bbox.Normalize();
-      if (!object_bbox.IsEmpty()) {
+      if (NormalizeFiniteBounds(&object_bbox)) {
         if (path_run_has_bbox) {
           path_run_bbox.Union(object_bbox);
         } else {
           path_run_bbox = object_bbox;
           path_run_has_bbox = true;
         }
+      } else {
+        path_run_bounds_complete = false;
       }
       ++path_run_count;
       if (path_run_count >= kMaxRenderPlanPathRunObjects) {
@@ -968,9 +984,9 @@ VeloceRenderPlan VeloceBuildRenderPlanSkeletonForHolder(
     } else {
       flush_path_run();
       CFX_FloatRect object_bbox =
           object ? object->GetRect() : CFX_FloatRect();
-      object_bbox.Normalize();
+      const bool has_safe_bbox = NormalizeFiniteBounds(&object_bbox);
       AppendSegment(&plan, VeloceRenderPlanSegmentKind::kPassthroughObject,
-                    object_index, 1, !object_bbox.IsEmpty(), object_bbox);
