 core/fpdfapi/render/veloce_render_plan.cpp       | 35 +++++++++++----
 2 files changed, 69 insertions(+), 22 deletions(-)

diff --git a/core/fpdfapi/render/veloce_path_display_list.cpp b/core/fpdfapi/render/veloce_path_display_list.cpp
--- a/core/fpdfapi/render/veloce_path_display_list.cpp
+++ b/core/fpdfapi/render/veloce_path_display_list.cpp
@@ -7,6 +7,7 @@
 #include <stdint.h>
 
 #include <algorithm>
+#include <cmath>
 #include <chrono>
 #include <cstring>
 #include <limits>
@@ -651,17 +652,26 @@ bool GetSpatialIndexRange(const PathDlSpatialIndex& index,
   return true;
 }
 
+bool NormalizeFiniteSpatialRect(CFX_FloatRect* rect) {
+  if (!rect || !std::isfinite(rect->left) ||
+      !std::isfinite(rect->right) || !std::isfinite(rect->bottom) ||
+      !std::isfinite(rect->top)) {
+    return false;
+  }
+  rect->Normalize();
+  return !rect->IsEmpty();
+}
+
 void BuildPathDlSpatialIndex(NativePathDisplayList* list) {
   if (!list || list->nodes.size() < kSpatialIndexMinNodes) {
     return;
   }
 
   bool have_bounds = false;
   CFX_FloatRect bounds;
   for (const PathDlNode& node : list->nodes) {
     CFX_FloatRect rect = node.holder_space_bbox;
-    rect.Normalize();
-    if (rect.IsEmpty()) {
+    if (!NormalizeFiniteSpatialRect(&rect)) {
       continue;
     }
     if (have_bounds) {
@@ -687,8 +697,13 @@ void BuildPathDlSpatialIndex(NativePathDisplayList* list) {
     uint32_t right_bin = 0;
     uint32_t bottom_bin = 0;
     uint32_t top_bin = 0;
-    if (!GetSpatialIndexRange(index, list->nodes[node_index].holder_space_bbox,
-                              &left_bin, &right_bin, &bottom_bin, &top_bin)) {
+    CFX_FloatRect node_bounds = list->nodes[node_index].holder_space_bbox;
+    if (!NormalizeFiniteSpatialRect(&node_bounds) ||
+        !GetSpatialIndexRange(index, node_bounds, &left_bin, &right_bin,
+                              &bottom_bin, &top_bin)) {
+      // The index is only an exclusion authority if every node is represented.
+      // Unknown bounds therefore remain candidates for every indexed replay.
+      index.overflow_nodes.push_back(node_index);
       continue;
     }
     const uint32_t bin_count =
@@ -933,19 +948,19 @@ std::optional<std::vector<uint64_t>> QuerySpatialIndexForReplay(
   }
 
