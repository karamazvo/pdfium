-      (list.nodes.size() + kSpatialCandidateWordBits - 1) /
-          kSpatialCandidateWordBits,
-      0);
-  size_t candidate_count = 0;
   for (uint32_t y = bottom_bin; y <= top_bin; ++y) {
     for (uint32_t x = left_bin; x <= right_bin; ++x) {
       const std::vector<uint32_t>& bin = index.bins[y * index.columns + x];
@@ -981,10 +1005,6 @@ std::optional<std::vector<uint64_t>> QuerySpatialIndexForReplay(
       }
     }
   }
