     return finish_full_scan();
   }
+  --clip_box.left;
+  --clip_box.top;
+  ++clip_box.right;
+  ++clip_box.bottom;
 
   CFX_FloatRect holder_clip =
       holder_to_device.GetInverse().TransformRect(CFX_FloatRect(clip_box));
-  holder_clip.Normalize();
-  if (holder_clip.IsEmpty()) {
-    if (replay_stats) {
-      replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
-    }
-    return std::vector<uint64_t>();
+  if (!NormalizeFiniteSpatialRect(&holder_clip)) {
+    return finish_full_scan();
   }
 
   if (HolderClipContainsIndex(holder_clip, index)) {
     return finish_full_scan();
@@ -956,19 +971,28 @@ std::optional<std::vector<uint64_t>> QuerySpatialIndexForReplay(
   uint32_t right_bin = 0;
   uint32_t bottom_bin = 0;
   uint32_t top_bin = 0;
+  std::vector<uint64_t> candidate_words(
+      (list.nodes.size() + kSpatialCandidateWordBits - 1) /
+          kSpatialCandidateWordBits,
+      0);
+  size_t candidate_count = 0;
+  for (uint32_t node_index : index.overflow_nodes) {
+    MarkSpatialCandidate(node_index, list.nodes.size(), &candidate_words,
+                         &candidate_count);
+  }
   if (!GetSpatialIndexRange(index, holder_clip, &left_bin, &right_bin,
                             &bottom_bin, &top_bin)) {
     if (replay_stats) {
+      replay_stats->spatial_index_candidates += candidate_count;
+      replay_stats->spatial_index_skipped_by_tile +=
+          list.nodes.size() >= candidate_count
+              ? list.nodes.size() - candidate_count
+              : 0;
       replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
     }
-    return std::vector<uint64_t>();
+    return candidate_words;
   }
 
