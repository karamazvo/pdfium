+class LivePassthroughObjectTable {
+ public:
+  bool Build(const CPDF_PageObjectHolder* holder,
+             const VeloceRenderPlan& plan) {
+    indices_.clear();
+    objects_.clear();
+    if (!holder) {
+      return false;
+    }
+
+    for (const VeloceRenderPlanSegment& segment : plan.segments) {
+      if (segment.kind != VeloceRenderPlanSegmentKind::kPassthroughObject) {
+        continue;
+      }
+      if (segment.object_count != 1) {
+        return false;
+      }
+      indices_.push_back(segment.first_object_index);
     }
-    ++current_index;
+
+    if (indices_.empty()) {
+      return true;
+    }
+
+    objects_.assign(indices_.size(), nullptr);
+    size_t wanted_index = 0;
+    size_t holder_index = 0;
+    for (const auto& object : *holder) {
+      if (wanted_index >= indices_.size()) {
+        break;
+      }
+      while (wanted_index < indices_.size() &&
+             indices_[wanted_index] < holder_index) {
+        ++wanted_index;
+      }
+      if (wanted_index < indices_.size() &&
+          indices_[wanted_index] == holder_index) {
+        objects_[wanted_index] = object.get();
+        ++wanted_index;
+      }
+      ++holder_index;
+    }
+
+    return std::all_of(objects_.begin(), objects_.end(),
+                       [](const CPDF_PageObject* object) {
+                         return object != nullptr;
+                       });
   }
-  return nullptr;
-}
 
+  CPDF_PageObject* Get(size_t object_index) const {
+    auto it = std::lower_bound(indices_.begin(), indices_.end(), object_index);
+    if (it == indices_.end() || *it != object_index) {
+      return nullptr;
+    }
+    return objects_[static_cast<size_t>(it - indices_.begin())];
+  }
+
+  size_t size() const {
+    return objects_.size();
+  }
+
+ private:
+  std::vector<size_t> indices_;
+  std::vector<CPDF_PageObject*> objects_;
+};
