+FX_RECT UnionRectCopy(const FX_RECT& lhs, const FX_RECT& rhs) {
+  FX_RECT result = lhs;
+  UnionRect(&result, rhs);
+  return result;
+}
 
+bool CanAppendPaintChangeToBlendGroupRun(const MaskRun& run,
+                                         const PathDlPaint& next_paint,
+                                         const FX_RECT& next_rect) {
+  if (run.empty()) {
+    return true;
+  }
+  if (run.blend_mode != next_paint.blend_mode || !run.group_rect_valid ||
+      run.group_rect.IsEmpty() || next_rect.IsEmpty()) {
+    return false;
+  }
+  if (RectsIntersect(run.group_rect, next_rect)) {
+    return false;
+  }
+
+  const uint64_t current_pixels = RectPixelArea(run.group_rect);
+  const uint64_t next_pixels = RectPixelArea(next_rect);
+  const uint64_t union_pixels = RectPixelArea(UnionRectCopy(run.group_rect,
+                                                            next_rect));
+  return union_pixels <= (current_pixels + next_pixels) * 2u;
+}
