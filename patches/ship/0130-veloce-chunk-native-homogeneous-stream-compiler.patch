+      {1.0f, 2.0f}, {3.0f, 4.0f}, CFX_Matrix(),
+      object->graphic_states(), *object->GetContentMarks()));
+  const std::array<std::array<float, 4>, 3> operands = {{
+      {5.0f, 6.0f, 7.0f, 8.0f},
+      {9.0f, 10.0f, 0.0f, 0.0f},
+      {11.0f, 12.0f, 13.0f, 14.0f},
+  }};
+
+  const VeloceRenderProgramBuilder::ParsedLineChunkResult result =
+      builder.AppendParsedTranslationOriginLineChunk(
+          pdfium::span(operands), CFX_Matrix(), CFX_Matrix(),
+          object->graphic_states(),
+          *object->GetContentMarks());
+
+  EXPECT_EQ(3u, result.processed_count);
+  EXPECT_EQ(3u, result.omitted_count);
+  EXPECT_EQ(1u, builder.parser_line_chunk_count_for_testing());
+  EXPECT_EQ(3u, builder.parser_line_chunk_command_count_for_testing());
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+  ASSERT_TRUE(program);
+  EXPECT_EQ(4u, program->command_count());
+  EXPECT_EQ(1u, program->native_line_count());
+  EXPECT_EQ(2u, program->native_translation_line_count());
+  EXPECT_TRUE(program->IsExactNoOp(2u));
+  ASSERT_EQ(2u, program->native_runs().size());
+  EXPECT_EQ(1u, program->native_runs()[1].first_command);
+  EXPECT_EQ(3u, program->native_runs()[1].command_count);
+  EXPECT_EQ(5.0f, program->native_translation_line(0).translation_x);
+  EXPECT_EQ(6.0f, program->native_translation_line(0).translation_y);
+  EXPECT_EQ(11.0f, program->native_translation_line(1).translation_x);
+  EXPECT_EQ(12.0f, program->native_translation_line(1).translation_y);
