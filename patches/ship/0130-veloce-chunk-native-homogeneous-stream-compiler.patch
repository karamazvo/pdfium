+TEST(CPDFStreamParserTest,
+     ParsesBoundedTranslationOriginStrokeChunkAndStopsAtMismatch) {
+  uint8_t data[] =
+      "q 1 0 0 1 10 20 cm 0 0 m 3 4 l S Q "
+      "q 1 0 0 1 30 40 cm 0 0 m 5 6 l S Q "
+      "q 1.0 0 0 1 50 60 cm 0 0 m 7 8 l S Q";
+  CPDF_StreamParser parser(data);
+  std::array<std::array<float, 4>, 4> operands;
+  std::array<uint32_t, 4> end_positions = {};
+
+  const size_t count = parser.TryParseTranslationOriginStrokeLineChunk(
+      pdfium::span(operands), pdfium::span(end_positions), parser.GetSize());
+
+  ASSERT_EQ(2u, count);
+  EXPECT_EQ((std::array<float, 4>{10.0f, 20.0f, 3.0f, 4.0f}),
+            operands[0]);
+  EXPECT_EQ((std::array<float, 4>{30.0f, 40.0f, 5.0f, 6.0f}),
+            operands[1]);
+  EXPECT_EQ(end_positions[1], parser.GetPos());
+  EXPECT_EQ(CPDF_StreamParser::ElementType::kKeyword,
+            parser.ParseNextElement());
+  EXPECT_EQ("q", parser.GetWord());
+}
