+TEST(VeloceRenderProgramTest,
+     TranslationOriginChunkValidatesStateOnceAndPreservesOrdinals) {
+  auto object = MakeOpaqueLine(1.0f, 3.0f);
+  VeloceRenderProgramBuilder builder(
