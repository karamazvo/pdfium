+size_t CPDF_StreamParser::TryParseTranslationOriginStrokeLineChunk(
+    pdfium::span<std::array<float, 4>> operands,
+    pdfium::span<uint32_t> end_positions,
+    uint32_t end_position) {
+  const size_t capacity = std::min(operands.size(), end_positions.size());
+  if (capacity == 0u || end_position <= pos_) {
+    return 0u;
+  }
+  const uint32_t bounded_end =
+      std::min(end_position, static_cast<uint32_t>(buf_.size()));
+  const pdfium::raw_span<const uint8_t> bounded_buffer =
+      buf_.first(bounded_end);
+  uint32_t candidate_position = pos_;
+  size_t count = 0u;
+  while (count < capacity) {
+    std::array<float, 4> candidate;
+    if (!ReadVeloceTranslationOriginStrokeLine(
+            bounded_buffer, &candidate_position, &candidate)) {
