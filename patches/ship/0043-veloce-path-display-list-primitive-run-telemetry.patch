+PathDlPathPrimitiveStats ComputePathPrimitiveStats(const CFX_Path& path) {
+  PathDlPathPrimitiveStats stats;
+  for (const CFX_Path::Point& point : path.GetPoints()) {
+    stats.points++;
+    if (point.close_figure_) {
+      stats.closes++;
+    }
+    switch (point.type_) {
+      case CFX_Path::Point::Type::kMove:
+        stats.moves++;
+        stats.subpaths++;
+        break;
+      case CFX_Path::Point::Type::kLine:
+        stats.lines++;
+        break;
+      case CFX_Path::Point::Type::kBezier:
+        stats.beziers++;
+        break;
+    }
+  }
+  if (stats.points > 0 && stats.subpaths == 0) {
+    stats.subpaths = 1;
+  }
+  return stats;
+}
+
+void AccumulateCompiledPrimitiveStats(NativePathDisplayList* list,
+                                      const PathDlPaint& paint,
+                                      const PathDlPathPrimitiveStats& stats) {
+  list->path_points += stats.points;
+  list->path_subpaths += stats.subpaths;
+  list->path_moves += stats.moves;
+  list->path_lines += stats.lines;
+  list->path_beziers += stats.beziers;
+  list->path_closes += stats.closes;
+  list->max_path_points = std::max(list->max_path_points, stats.points);
+  list->max_path_subpaths =
+      std::max(list->max_path_subpaths, stats.subpaths);
+
+  const bool has_fill = paint.fill_options.fill_type !=
+                        CFX_FillRenderOptions::FillType::kNoFill;
+  const bool has_stroke = paint.stroke_argb != 0;
+  if (has_fill && has_stroke) {
+    list->fill_stroke_nodes++;
+  } else if (has_fill) {
+    list->fill_only_nodes++;
+  } else if (has_stroke) {
+    list->stroke_only_nodes++;
+  }
+  if (paint.blend_mode == BlendMode::kNormal) {
+    list->normal_blend_nodes++;
+  }
+}
+
+void RecordCandidatePrimitiveStats(PathDlReplayStats* replay_stats,
+                                   const PathDlPathPrimitiveStats& stats) {
+  if (!replay_stats) {
+    return;
+  }
+  replay_stats->primitive_candidate_nodes++;
+  replay_stats->primitive_candidate_points += stats.points;
+  replay_stats->primitive_candidate_subpaths += stats.subpaths;
+  replay_stats->max_candidate_path_points =
+      std::max(replay_stats->max_candidate_path_points, stats.points);
+}
+
+void RecordCulledPrimitiveStats(PathDlReplayStats* replay_stats,
+                                const PathDlPathPrimitiveStats& stats) {
+  if (!replay_stats) {
+    return;
+  }
+  replay_stats->primitive_culled_nodes++;
+  replay_stats->primitive_culled_points += stats.points;
+  replay_stats->primitive_culled_subpaths += stats.subpaths;
+}
+
+void RecordDrawnPrimitiveStats(PathDlReplayStats* replay_stats,
+                               const PathDlPathPrimitiveStats& stats) {
+  if (!replay_stats) {
+    return;
+  }
+  replay_stats->primitive_drawn_nodes++;
+  replay_stats->primitive_drawn_points += stats.points;
+  replay_stats->primitive_drawn_subpaths += stats.subpaths;
+  replay_stats->max_drawn_path_points =
+      std::max(replay_stats->max_drawn_path_points, stats.points);
+}
