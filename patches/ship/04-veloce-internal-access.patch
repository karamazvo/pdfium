                                                              int index);

+// Veloce extension API.
+// Like FPDFPage_GetObject(), but writes the result into |out_object| and
+// returns TRUE on success. This also accepts virtual Form content-page handles
+// returned by FPDFFormObjEx_GetContentPage().
