+FPDFPageEx_GetObjectFast(FPDF_PAGE page,
+                         int index,
+                         FPDF_PAGEOBJECT* out_object);
+
+// Veloce extension API.
+// Fills |out_buf| with up to |capacity| page-object handles in iteration order.
+// Returns the number of handles written. This also accepts virtual Form
+// content-page handles returned by FPDFFormObjEx_GetContentPage().
+FPDF_EXPORT int FPDF_CALLCONV FPDFPageEx_GetAllObjects(
+    FPDF_PAGE page,
+    FPDF_PAGEOBJECT* out_buf,
+    int capacity);
+
 // Checks if |page| contains transparency.
 //
 //   page - handle to a page.
@@ -276,6 +294,39 @@ FPDF_EXPORT void FPDF_CALLCONV FPDFPageObj_Destroy(FPDF_PAGEOBJECT page_object);
 FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
 FPDFPageObj_HasTransparency(FPDF_PAGEOBJECT page_object);

+// Veloce extension API.
+// Returns the object's internal BlendMode enum value, or -1 if |page_object| is
+// null. Veloce treats 0 as Normal and any positive value as non-Normal.
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFPageObjEx_GetBlendMode(FPDF_PAGEOBJECT page_object);
+
+// Veloce extension API.
+// Returns fill alpha in [0.0, 1.0], or -1.0 if |page_object| is null.
+FPDF_EXPORT float FPDF_CALLCONV
+FPDFPageObjEx_GetFillAlpha(FPDF_PAGEOBJECT page_object);
+
+// Veloce extension API.
+// Returns stroke alpha in [0.0, 1.0], or -1.0 if |page_object| is null.
+FPDF_EXPORT float FPDF_CALLCONV
+FPDFPageObjEx_GetStrokeAlpha(FPDF_PAGEOBJECT page_object);
+
+// Veloce extension API.
+// Returns 1 if the object's general state has a soft mask, 0 if not, or -1 if
+// |page_object| is null.
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFPageObjEx_HasSoftMask(FPDF_PAGEOBJECT page_object);
+
+// Veloce extension API.
+// Returns TRUE if |clip_path| is exactly one axis-aligned rectangle and writes
+// its bounds in PDF user space. Returns FALSE for absent, complex, or text clip
+// paths, or when any out parameter is null.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFClipPathEx_GetAxisAlignedRect(FPDF_CLIPPATH clip_path,
+                                  float* out_left,
+                                  float* out_bottom,
+                                  float* out_right,
+                                  float* out_top);
+
 // Get type of |page_object|.
 //
 //   page_object - handle to a page object.
@@ -1700,6 +1751,25 @@ FPDFFormObj_CountObjects(FPDF_PAGEOBJECT form_object);
 FPDF_EXPORT FPDF_PAGEOBJECT FPDF_CALLCONV
 FPDFFormObj_GetObject(FPDF_PAGEOBJECT form_object, unsigned long index);

+// Veloce extension API.
+// Returns TRUE if |form_object| is a Form XObject whose Group dictionary has
+// /S /Transparency.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFFormObjEx_HasTransparencyGroup(FPDF_PAGEOBJECT form_object);
+
+// Veloce extension API.
+// Returns TRUE if |form_object| is an isolated Form transparency group.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFFormObjEx_IsIsolatedGroup(FPDF_PAGEOBJECT form_object);
+
+// Veloce extension API.
+// Returns a virtual read-only FPDF_PAGE handle for a Form XObject's parsed
+// content. The handle is only valid while |form_object| and its owning page are
+// alive. It must not be passed to FPDF_ClosePage(); use only with
+// FPDFPageEx_GetObjectFast() and FPDFPageEx_GetAllObjects().
+FPDF_EXPORT FPDF_PAGE FPDF_CALLCONV
+FPDFFormObjEx_GetContentPage(FPDF_PAGEOBJECT form_object);
+
 // Experimental API.
 //
 // Remove |page_object| from |form_object|.
@@ -1715,6 +1785,12 @@ FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
 FPDFFormObj_RemoveObject(FPDF_PAGEOBJECT form_object,
                          FPDF_PAGEOBJECT page_object);

+// Veloce extension API.
+// Returns TRUE if the Veloce internal-access ABI sentinel checks pass. Callers
+// should disable Veloce internal-access and fall back to public APIs if this
+// returns FALSE.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV FPDFEx_CheckAbiSentinels(void);
+
 #ifdef __cplusplus
 }  // extern "C"
 #endif  // __cplusplus
