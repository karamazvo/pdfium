+TEST(VeloceRenderProgramTest,
+     TranslationOriginStreamStopsAtBoundWithoutReadingNextCommand) {
+  auto object = MakeOpaqueLine(1.0f, 3.0f);
+  VeloceRenderProgramBuilder builder(
+      0u, CFX_FloatRect(-100.0f, -100.0f, 100.0f, 100.0f));
+  ASSERT_TRUE(builder.AppendParsedOpaqueLine(
+      CFX_PointF(), {3.0f, 4.0f}, CFX_Matrix(),
+      object->graphic_states(), *object->GetContentMarks(),
+      /*stream_fused=*/true, /*translation_origin=*/true));
+  const std::array<VeloceParsedTranslationOriginLine, 3> lines = {{
+      {{7.0f, 8.0f}, 9.0f, 10.0f},
+      {CFX_PointF(), 11.0f, 12.0f},
+      {{13.0f, 14.0f}, 15.0f, 16.0f},
+  }};
+  struct ReaderContext {
+    pdfium::span<const VeloceParsedTranslationOriginLine> lines;
+    size_t index = 0u;
+  };
+  ReaderContext context{lines};
+  const auto reader = [](void* opaque,
+                         VeloceParsedTranslationOriginLine* line) {
+    auto* context = static_cast<ReaderContext*>(opaque);
+    if (context->index >= context->lines.size()) {
+      return false;
+    }
+    *line = context->lines[context->index++];
+    return true;
+  };
+  VeloceParsedTranslationOriginLine last_line;
+
+  EXPECT_EQ(2u, builder.AppendParsedTranslationOriginLineStream(
+                    2u, CFX_Matrix(), object->graphic_states(),
+                    *object->GetContentMarks(), &context, reader, &last_line));
+  EXPECT_EQ(2u, context.index);
+  EXPECT_EQ(lines[1].end, last_line.end);
+  EXPECT_EQ(lines[1].translation_x, last_line.translation_x);
+  EXPECT_EQ(lines[1].translation_y, last_line.translation_y);
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(3u, program->command_count());
+  EXPECT_TRUE(program->IsExactNoOp(2u));
+  EXPECT_EQ(1u, program->native_translation_line_count());
+  ASSERT_TRUE(program->spatial_index());
+  EXPECT_EQ(2u, program->spatial_index()->covered_command_count());
+}
