+void RecordFillBarrierTelemetry(PathDlReplayStats* replay_stats,
+                                const PathDlPaint& paint,
+                                const CFX_Path& path,
+                                const FX_RECT& barrier_rect,
+                                bool has_pending_stroke,
+                                bool overlap_known,
+                                bool overlaps_pending_stroke) {
+  if (!replay_stats) {
+    return;
+  }
+
+  replay_stats->fill_barrier_nodes++;
+  const bool has_fill = paint.fill_options.fill_type !=
+                        CFX_FillRenderOptions::FillType::kNoFill;
+  const bool has_stroke = paint.fill_options.stroke;
+  if (has_fill && has_stroke) {
+    replay_stats->fill_barrier_fill_stroke++;
+  } else if (has_fill) {
+    replay_stats->fill_barrier_fill_only++;
+  } else if (has_stroke) {
+    replay_stats->fill_barrier_stroke_only++;
+  }
+
+  if (paint.fill_options.fill_type ==
+      CFX_FillRenderOptions::FillType::kEvenOdd) {
+    replay_stats->fill_barrier_even_odd++;
+  } else if (paint.fill_options.fill_type ==
+             CFX_FillRenderOptions::FillType::kWinding) {
+    replay_stats->fill_barrier_winding++;
+  }
+
+  if (path.IsRect()) {
+    replay_stats->fill_barrier_rect_like++;
+  }
+  const size_t point_count = path.GetPoints().size();
+  replay_stats->fill_barrier_path_points += point_count;
+  if (point_count > replay_stats->max_fill_barrier_path_points) {
+    replay_stats->max_fill_barrier_path_points = point_count;
+  }
+
+  if (barrier_rect.IsEmpty()) {
+    replay_stats->fill_barrier_empty_device_rect++;
+  } else if (barrier_rect.Width() <= 1 || barrier_rect.Height() <= 1) {
+    replay_stats->fill_barrier_thin_device_rect++;
   }
+
+  if (!has_pending_stroke) {
+    return;
+  }
+  replay_stats->fill_barrier_pending_stroke++;
+  if (!overlap_known) {
+    replay_stats->fill_barrier_pending_unknown++;
+  } else if (overlaps_pending_stroke) {
+    replay_stats->fill_barrier_pending_overlap++;
+  } else {
+    replay_stats->fill_barrier_pending_disjoint++;
+  }
 }

