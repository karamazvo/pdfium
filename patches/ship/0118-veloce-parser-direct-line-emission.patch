+  const bool needs_state = !state_index.has_value();
+  const bool needs_matrix = !matrix_index.has_value();
+  const bool needs_visibility_run = !HasSameVisibilityScope(content_marks);
+  const bool needs_clip_run = !HasSameClipScope(states.clip_path());
+  const bool needs_native_run =
+      native_runs_.empty() ||
+      native_runs_.back().opcode != VeloceRenderOpcode::kNativeOpaqueLine ||
+      native_runs_.back().first_command + native_runs_.back().command_count !=
