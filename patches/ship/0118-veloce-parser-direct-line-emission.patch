+          /*needs_fill_geometry=*/false, needs_state, needs_matrix,
+          dashes.size(), needs_visibility_run ? &content_marks : nullptr,
+          needs_clip_run, needs_native_run, /*needs_command_block=*/false)) {
+    ++native_budget_fallbacks_;
+    return Reject(VeloceNativeLineRejectReason::kBudget);
+  }
+
+  if (needs_matrix) {
+    matrix_index = static_cast<uint16_t>(path_matrices_.size());
+    path_matrices_.push_back(owned_matrix);
+    matrix_indices_.emplace(matrix_hash, *matrix_index);
+  }
+  if (needs_state) {
+    candidate_state.dash_offset = static_cast<uint32_t>(dash_values_.size());
+    dash_values_.insert(dash_values_.end(), dashes.begin(), dashes.end());
+    state_index = static_cast<uint16_t>(opaque_path_states_.size());
+    opaque_path_states_.push_back(candidate_state);
+    state_indices_.emplace(state_hash, *state_index);
+  }
+  last_opaque_state_index_ = *state_index;
+  if (needs_visibility_run) {
+    visibility_runs_.push_back({command_index, content_marks});
+    RememberVisibilityScope(content_marks);
+  }
+  if (needs_clip_run) {
+    clip_runs_.push_back({command_index, states.clip_path()});
+    RememberClipScope(states.clip_path());
+  }
+
+  VeloceNativeLine line;
+  line.start = start;
+  line.end = end;
+  line.translation_x = inline_translation_x;
+  line.translation_y = inline_translation_y;
+  CHECK(native_lines_.Append(line, kMaxNativeLines));
+  if (*bounds_known) {
+    if (native_line_bounds_) {
+      native_line_bounds_->Union(*bounds);
+    } else {
+      native_line_bounds_ = *bounds;
+    }
+  }
+  AppendNativeLineRun(*state_index, *matrix_index);
