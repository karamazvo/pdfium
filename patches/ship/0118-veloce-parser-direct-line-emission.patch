+TEST(VeloceRenderProgramTest,
+     ParserDirectLineMatchesCanonicalObjectLowering) {
+  auto object = MakeOpaqueLine(1.25f, 8.5f);
+  object->SetPathMatrix(
+      CFX_Matrix(1.5f, 0.25f, -0.5f, 2.0f, 3.0f, -4.0f));
+  object->CalcBoundingBox();
+
+  VeloceRenderProgramBuilder object_builder(
+      0u, CFX_FloatRect(-100.0f, -100.0f, 100.0f, 100.0f));
+  ASSERT_TRUE(object_builder.AppendPageObject(*object));
+  std::unique_ptr<const VeloceRenderProgram> object_program =
+      object_builder.Finish();
+  ASSERT_TRUE(object_program);
+
+  VeloceRenderProgramBuilder direct_builder(
+      0u, CFX_FloatRect(-100.0f, -100.0f, 100.0f, 100.0f));
+  ASSERT_TRUE(direct_builder.AppendParsedOpaqueLine(
+      object->path().GetPoints()[0].point_,
+      object->path().GetPoints()[1].point_, object->matrix(),
+      object->graphic_states(), *object->GetContentMarks()));
+  std::unique_ptr<const VeloceRenderProgram> direct_program =
+      direct_builder.Finish();
+  ASSERT_TRUE(direct_program);
+
+  ASSERT_EQ(1u, object_program->native_line_count());
+  ASSERT_EQ(1u, direct_program->native_line_count());
+  EXPECT_EQ(object_program->native_line(0).start,
+            direct_program->native_line(0).start);
+  EXPECT_EQ(object_program->native_line(0).end,
+            direct_program->native_line(0).end);
+  EXPECT_EQ(object_program->native_line(0).translation_x,
+            direct_program->native_line(0).translation_x);
+  EXPECT_EQ(object_program->native_line(0).translation_y,
+            direct_program->native_line(0).translation_y);
+  ASSERT_EQ(object_program->opaque_path_states().size(),
+            direct_program->opaque_path_states().size());
+  const VeloceOpaquePathState& object_state =
+      object_program->opaque_path_states()[0];
+  const VeloceOpaquePathState& direct_state =
+      direct_program->opaque_path_states()[0];
+  EXPECT_EQ(object_state.stroke_color_ref, direct_state.stroke_color_ref);
+  EXPECT_EQ(object_state.line_width, direct_state.line_width);
+  EXPECT_EQ(object_state.miter_limit, direct_state.miter_limit);
+  EXPECT_EQ(object_state.dash_phase, direct_state.dash_phase);
+  EXPECT_EQ(object_state.dash_count, direct_state.dash_count);
+  EXPECT_EQ(object_state.line_cap, direct_state.line_cap);
+  EXPECT_EQ(object_state.line_join, direct_state.line_join);
+  EXPECT_EQ(object_state.flags, direct_state.flags);
+  EXPECT_EQ(object_program->path_matrices(),
+            direct_program->path_matrices());
+  EXPECT_EQ(object_program->dash_values(), direct_program->dash_values());
+  EXPECT_EQ(object_program->native_line_bounds(),
+            direct_program->native_line_bounds());
+  ASSERT_EQ(1u, object_program->native_line_runs().size());
+  ASSERT_EQ(1u, direct_program->native_line_runs().size());
+  EXPECT_EQ(object_program->native_line_runs()[0].first_line,
+            direct_program->native_line_runs()[0].first_line);
+  EXPECT_EQ(object_program->native_line_runs()[0].line_count,
+            direct_program->native_line_runs()[0].line_count);
+  EXPECT_EQ(object_program->native_line_runs()[0].state_index,
+            direct_program->native_line_runs()[0].state_index);
+  EXPECT_EQ(object_program->native_line_runs()[0].matrix_index,
+            direct_program->native_line_runs()[0].matrix_index);
+  ASSERT_TRUE(object_program->spatial_index());
+  ASSERT_TRUE(direct_program->spatial_index());
