+  CFX_Matrix owned_matrix = matrix;
+  const bool uses_inline_translation = HasIdentityLinearPart(owned_matrix);
+  const float inline_translation_x =
+      uses_inline_translation ? owned_matrix.e : 0.0f;
+  const float inline_translation_y =
