+unsigned ExactAxisAlignedRectCoverage(int x_cover,
+                                      int y_cover,
+                                      bool no_smooth) {
+  CHECK_GE(x_cover, 0);
+  CHECK_LE(x_cover, agg::poly_base_size);
+  CHECK_GE(y_cover, 0);
+  CHECK_LE(y_cover, agg::poly_base_size);
+  unsigned cover = static_cast<unsigned>(x_cover * y_cover) >>
+                   agg::poly_base_shift;
+  if (no_smooth) {
+    cover = cover > agg::rasterizer_scanline_aa::aa_mask / 2
+                ? agg::rasterizer_scanline_aa::aa_mask
+                : 0u;
+  }
+  return std::min(
+      cover, static_cast<unsigned>(agg::rasterizer_scanline_aa::aa_mask));
+}
+
+int SubpixelCoverageForPixel(int lower, int upper, int pixel) {
+  const int pixel_lower = pixel * agg::poly_base_size;
+  const int pixel_upper = pixel_lower + agg::poly_base_size;
+  return std::max(0, std::min(upper, pixel_upper) -
+                         std::max(lower, pixel_lower));
+}
+
+bool TryRenderExactAxisAlignedStrokeRect(
+    const std::array<CFX_PointF, 4>& vertices,
+    const FX_RECT& clip_box,
+    bool no_smooth,
+    agg::scanline_u8* scanline,
+    CFX_AggRenderer* renderer) {
+  const bool vertical_edges =
+      vertices[0].x == vertices[1].x &&
+      vertices[1].y == vertices[2].y &&
+      vertices[2].x == vertices[3].x &&
+      vertices[3].y == vertices[0].y;
+  const bool horizontal_edges =
+      vertices[0].y == vertices[1].y &&
+      vertices[1].x == vertices[2].x &&
+      vertices[2].y == vertices[3].y &&
+      vertices[3].x == vertices[0].x;
+  if (!vertical_edges && !horizontal_edges) {
+    return false;
+  }
+
+  float min_x = vertices[0].x;
+  float max_x = vertices[0].x;
+  float min_y = vertices[0].y;
+  float max_y = vertices[0].y;
+  for (const CFX_PointF& vertex : vertices) {
+    min_x = std::min(min_x, vertex.x);
+    max_x = std::max(max_x, vertex.x);
+    min_y = std::min(min_y, vertex.y);
+    max_y = std::max(max_y, vertex.y);
+  }
+
+  const int subpixel_left = agg::poly_coord(min_x);
+  const int subpixel_right = agg::poly_coord(max_x);
+  const int subpixel_top = agg::poly_coord(min_y);
+  const int subpixel_bottom = agg::poly_coord(max_y);
+  if (subpixel_left >= subpixel_right || subpixel_top >= subpixel_bottom) {
+    return false;
+  }
+
+  const int polygon_left = subpixel_left >> agg::poly_base_shift;
+  const int polygon_right =
+      (subpixel_right - 1) >> agg::poly_base_shift;
+  const int polygon_top = subpixel_top >> agg::poly_base_shift;
+  const int polygon_bottom =
+      (subpixel_bottom - 1) >> agg::poly_base_shift;
+  const int render_left = std::max(polygon_left, clip_box.left);
+  const int render_right = std::min(polygon_right, clip_box.right - 1);
+  const int render_top = std::max(polygon_top, clip_box.top);
+  const int render_bottom = std::min(polygon_bottom, clip_box.bottom - 1);
+  if (render_left > render_right || render_top > render_bottom) {
+    return true;
+  }
+
+  // A scanline owns reusable storage bounded by the device clip width. An
+  // axis-aligned rectangle has at most three coverage spans on each row:
+  // partial left edge, constant interior, and partial right edge.
+  scanline->reset(render_left, render_right);
+  for (int y = render_top; y <= render_bottom; ++y) {
+    const int y_cover =
+        SubpixelCoverageForPixel(subpixel_top, subpixel_bottom, y);
+    scanline->reset_spans();
+    if (render_left == render_right) {
+      const int x_cover =
+          SubpixelCoverageForPixel(subpixel_left, subpixel_right, render_left);
+      const unsigned cover =
+          ExactAxisAlignedRectCoverage(x_cover, y_cover, no_smooth);
+      if (cover != 0u) {
+        scanline->add_cell(render_left, cover);
+      }
+    } else {
+      const int left_x_cover =
+          SubpixelCoverageForPixel(subpixel_left, subpixel_right, render_left);
+      const unsigned left_cover =
+          ExactAxisAlignedRectCoverage(left_x_cover, y_cover, no_smooth);
+      if (left_cover != 0u) {
+        scanline->add_cell(render_left, left_cover);
+      }
+
+      const int interior_length = render_right - render_left - 1;
+      const unsigned interior_cover = ExactAxisAlignedRectCoverage(
+          agg::poly_base_size, y_cover, no_smooth);
+      if (interior_length > 0 && interior_cover != 0u) {
+        scanline->add_span(render_left + 1,
+                           static_cast<unsigned>(interior_length),
+                           interior_cover);
+      }
+
+      const int right_x_cover =
+          SubpixelCoverageForPixel(subpixel_left, subpixel_right, render_right);
+      const unsigned right_cover =
+          ExactAxisAlignedRectCoverage(right_x_cover, y_cover, no_smooth);
+      if (right_cover != 0u) {
+        scanline->add_cell(render_right, right_cover);
+      }
+    }
+    if (scanline->num_spans() != 0u) {
+      scanline->finalize(y);
+      renderer->render(*scanline);
+    }
+  }
+  return true;
+}
