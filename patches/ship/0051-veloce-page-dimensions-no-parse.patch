+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFEx_GetPageDimensions(FPDF_DOCUMENT document,
+                         int page_index,
+                         FPDFEx_PageDimensions* out) {
+  if (!out) {
+    return false;
+  }
+  std::memset(out, 0, sizeof(*out));
+
+  auto* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc) {
+    return false;
+  }
+
+  if (page_index < 0 || page_index >= FPDF_GetPageCount(document)) {
+    return false;
+  }
+
+  // GetMutablePageDictionary() reads the page dictionary through PDFium's
+  // page-tree cache. Constructing CPDF_Page updates dimensions from
+  // MediaBox/CropBox/Rotate, but ParseContent() is never called here.
+  RetainPtr<CPDF_Dictionary> dict = doc->GetMutablePageDictionary(page_index);
+  if (!CPDF_Page::IsValidPageDictLoose(dict)) {
+    return false;
+  }
+
+  auto page = pdfium::MakeRetain<CPDF_Page>(doc, std::move(dict));
+  const CFX_FloatRect& bbox = page->GetBBox();
+  out->page_width = page->GetPageWidth();
+  out->page_height = page->GetPageHeight();
+  out->cropbox_left = bbox.left;
+  out->cropbox_bottom = bbox.bottom;
+  out->cropbox_right = bbox.right;
+  out->cropbox_top = bbox.top;
+  out->rotation_quarter_turns = page->GetPageRotation();
+  return true;
+}
