+// Struct: FPDFEx_PageDimensions
+//   Exact page geometry read directly from the page dictionary, without
+//   parsing the page content stream. Populated by FPDFEx_GetPageDimensions().
+//   Fixed 32-byte POD layout -- do not reorder or resize fields; add a new
+//   struct/function pair instead if more data is needed later.
+//
+//   page_width / page_height:
+//     Visible page dimensions in points, after applying CropBox intersection
+//     and the Rotate width/height swap. Identical to the values
+//     FPDF_GetPageWidth/Height return for a fully loaded page.
+//
+//   cropbox_{left,bottom,right,top}:
+//     Effective CropBox in PDF user-space coordinates (bottom-left origin,
+//     Y-up): CropBox intersected with MediaBox, or MediaBox verbatim if the
+//     page has no CropBox entry.
+//
+//   rotation_quarter_turns:
+//     Page rotation in quarter-turns clockwise (0, 1, 2, or 3).
+//     Matches FPDFPage_GetRotation().
+typedef struct {
+  float page_width;
+  float page_height;
+  float cropbox_left;
+  float cropbox_bottom;
+  float cropbox_right;
+  float cropbox_top;
+  int rotation_quarter_turns;
+  int reserved;
+} FPDFEx_PageDimensions;
+
+// Function: FPDFEx_GetPageDimensions
+//   Get exact page geometry from the page dictionary without parsing page
+//   content. Skips FPDF_LoadPage's ParseContent() entirely. Does not support
+//   XFA documents; use FPDF_GetPageSizeByIndexF for those.
+//
+// Parameters:
+//   document    - Handle to document. Returned by FPDF_LoadDocument.
+//   page_index  - Page index, zero for the first page.
+//   out         - Pointer to a caller-owned FPDFEx_PageDimensions to receive
+//                 the result. Zeroed by this function before population and
+//                 left zeroed on failure.
+//
+// Return value:
+//   Non-zero on success. Zero if document/page is invalid, the page dictionary
+//   is malformed, or out is null.
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFEx_GetPageDimensions(FPDF_DOCUMENT document,
+                         int page_index,
+                         FPDFEx_PageDimensions* out);
+
