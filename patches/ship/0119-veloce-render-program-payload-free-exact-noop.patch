+std::unique_ptr<CPDF_PathObject> MakeExactButtNoOp(float x, float y) {
+  auto path = std::make_unique<CPDF_PathObject>();
+  path->SetDefaultStates();
+  path->mutable_general_state().Emplace();
+  path->path().Emplace();
+  path->path().AppendPoint({x, y}, CFX_Path::Point::Type::kMove);
+  path->path().AppendPoint({x, y}, CFX_Path::Point::Type::kLine);
+  path->set_stroke(true);
+  path->set_no_filltype();
+  path->SetPathMatrix(CFX_Matrix());
+  path->SetRect(CFX_FloatRect(x, y, x, y));
+  return path;
+}
