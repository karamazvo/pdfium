+// found in the LICENSE file.
+
+#ifndef CORE_FPDFAPI_RENDER_VELOCE_CANONICAL_RENDER_PROFILE_H_
+#define CORE_FPDFAPI_RENDER_VELOCE_CANONICAL_RENDER_PROFILE_H_
+
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+
+enum class VeloceCanonicalRenderPhase : uint8_t {
+  kLayerSetup,
+  kClip,
+  kTransparency,
+  kText,
+  kPath,
+  kImage,
+  kShading,
+  kForm,
+  kBackground,
+  kSoftMask,
+  kAccelerator,
+  kParseContinuation,
+  kCount,
+};
+
+struct VeloceCanonicalRenderProfile final {
+  using Clock = std::chrono::steady_clock;
+  static constexpr size_t kPhaseCount =
+      static_cast<size_t>(VeloceCanonicalRenderPhase::kCount);
+  static constexpr size_t kMaxDepth = 96u;
+
+  struct Frame final {
+    VeloceCanonicalRenderPhase phase =
+        VeloceCanonicalRenderPhase::kLayerSetup;
+    Clock::time_point resumed_at;
+  };
+
+  bool started = false;
+  bool finished = false;
+  bool continue_active = false;
+  bool path_display_list_rendered = false;
+  bool render_program_rendered = false;
+  bool depth_overflow = false;
+  Clock::time_point continue_started_at;
+  uint64_t active_ns = 0;
+  uint64_t continue_calls = 0;
+  uint64_t pause_returns = 0;
+  uint64_t layers = 0;
+  uint64_t objects_considered = 0;
+  uint64_t objects_inactive = 0;
+  uint64_t objects_bounds_culled = 0;
+  uint64_t objects_rendered = 0;
+  uint64_t cancel_checks = 0;
+  bool cancel_observed = false;
+  std::array<uint64_t, kPhaseCount> phase_ns = {};
+  std::array<uint64_t, kPhaseCount> phase_calls = {};
+  std::array<Frame, kMaxDepth> stack = {};
+  size_t depth = 0;
+
+  void Start() {
+    if (started) {
+      return;
+    }
+    started = true;
+    BeginContinue();
+  }
+
+  void BeginContinue() {
+    if (!started || finished || continue_active) {
+      return;
+    }
+    continue_active = true;
+    continue_started_at = Clock::now();
+    ++continue_calls;
+  }
+
+  void EndContinue() {
+    if (!continue_active) {
+      return;
+    }
+    const Clock::time_point now = Clock::now();
+    if (depth != 0u) {
+      AddElapsed(stack[depth - 1u].phase, stack[depth - 1u].resumed_at, now);
+      depth = 0u;
+      depth_overflow = true;
+    }
+    active_ns += DurationNs(continue_started_at, now);
+    continue_active = false;
+  }
+
+  void Enter(VeloceCanonicalRenderPhase phase) {
+    if (!started || finished || !continue_active) {
+      return;
+    }
+    const Clock::time_point now = Clock::now();
+    if (depth != 0u) {
+      AddElapsed(stack[depth - 1u].phase, stack[depth - 1u].resumed_at, now);
+    }
+    if (depth >= stack.size()) {
+      depth_overflow = true;
+      return;
+    }
+    stack[depth++] = Frame{phase, now};
+    ++phase_calls[static_cast<size_t>(phase)];
+  }
+
+  void Exit(VeloceCanonicalRenderPhase phase) {
+    if (!started || finished || !continue_active || depth == 0u) {
+      return;
+    }
+    const Clock::time_point now = Clock::now();
+    Frame& frame = stack[depth - 1u];
+    if (frame.phase != phase) {
+      depth_overflow = true;
+      depth = 0u;
+      return;
+    }
+    AddElapsed(frame.phase, frame.resumed_at, now);
+    --depth;
+    if (depth != 0u) {
+      stack[depth - 1u].resumed_at = now;
+    }
+  }
+
+  uint64_t AccountedNs() const {
+    uint64_t result = 0;
+    for (uint64_t value : phase_ns) {
+      result += value;
+    }
+    return result;
+  }
+
+ private:
+  static uint64_t DurationNs(Clock::time_point start, Clock::time_point end) {
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(end - start)
+            .count());
+  }
+
+  void AddElapsed(VeloceCanonicalRenderPhase phase,
+                  Clock::time_point start,
+                  Clock::time_point end) {
+    phase_ns[static_cast<size_t>(phase)] += DurationNs(start, end);
+  }
+};
+
+inline thread_local VeloceCanonicalRenderProfile*
+    g_veloce_canonical_render_profile = nullptr;
+
+class VeloceCanonicalRenderProfileActivation final {
+ public:
+  explicit VeloceCanonicalRenderProfileActivation(
+      VeloceCanonicalRenderProfile* profile)
+      : previous_(g_veloce_canonical_render_profile) {
+    g_veloce_canonical_render_profile = profile;
+    if (profile && profile->started) {
+      profile->BeginContinue();
+    }
+  }
+
+  ~VeloceCanonicalRenderProfileActivation() {
+    if (g_veloce_canonical_render_profile) {
+      g_veloce_canonical_render_profile->EndContinue();
+    }
+    g_veloce_canonical_render_profile = previous_;
+  }
+
+ private:
+  VeloceCanonicalRenderProfile* const previous_;
+};
+
+class VeloceCanonicalRenderProfileScope final {
+ public:
+  explicit VeloceCanonicalRenderProfileScope(
+      VeloceCanonicalRenderPhase phase)
+      : profile_(g_veloce_canonical_render_profile), phase_(phase) {
+    if (profile_) {
+      profile_->Enter(phase_);
+    }
+  }
+
+  ~VeloceCanonicalRenderProfileScope() {
+    if (profile_) {
+      profile_->Exit(phase_);
+    }
+  }
+
+ private:
+  VeloceCanonicalRenderProfile* const profile_;
+  const VeloceCanonicalRenderPhase phase_;
+};
+
+inline VeloceCanonicalRenderProfile* VeloceCanonicalProfileForCurrentRender() {
+  return g_veloce_canonical_render_profile;
+}
+
+#endif  // CORE_FPDFAPI_RENDER_VELOCE_CANONICAL_RENDER_PROFILE_H_
