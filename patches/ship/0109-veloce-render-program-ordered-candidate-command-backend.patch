+bool IsSpatiallyIndexedOpcode(VeloceRenderOpcode opcode) {
+  return opcode == VeloceRenderOpcode::kNativeOpaqueLine ||
+         opcode == VeloceRenderOpcode::kNativeOpaqueFillPath;
+}
+
+std::vector<VeloceNativeRunLookupBlock> BuildNativeRunLookupBlocks(
+    uint32_t command_count,
+    pdfium::span<const VeloceNativeRun> native_runs) {
+  std::vector<VeloceNativeRunLookupBlock> blocks;
+  blocks.reserve(
+      (command_count + kVeloceNativeRunLookupBlockSize - 1u) /
+      kVeloceNativeRunLookupBlockSize);
+  size_t first_run = 0u;
+  for (uint32_t block_start = 0u; block_start < command_count;
+       block_start += kVeloceNativeRunLookupBlockSize) {
+    const uint32_t block_limit =
+        std::min(command_count,
+                 block_start + kVeloceNativeRunLookupBlockSize);
+    while (first_run < native_runs.size() &&
+           native_runs[first_run].first_command +
+                   native_runs[first_run].command_count <=
+               block_start) {
+      ++first_run;
+    }
+    size_t run_limit = first_run;
+    while (run_limit < native_runs.size() &&
+           native_runs[run_limit].first_command < block_limit) {
+      ++run_limit;
+    }
+    blocks.push_back(
+        {static_cast<uint32_t>(first_run),
+         static_cast<uint32_t>(run_limit - first_run)});
+  }
+  return blocks;
+}
+
+bool NativeRunLookupBlocksMatch(
+    uint32_t command_count,
+    pdfium::span<const VeloceNativeRun> native_runs,
+    pdfium::span<const VeloceNativeRunLookupBlock> blocks) {
+  if (blocks.size() !=
+      (command_count + kVeloceNativeRunLookupBlockSize - 1u) /
+          kVeloceNativeRunLookupBlockSize) {
+    return false;
+  }
+  size_t first_run = 0u;
+  size_t block_index = 0u;
+  for (uint32_t block_start = 0u; block_start < command_count;
+       block_start += kVeloceNativeRunLookupBlockSize, ++block_index) {
+    const uint32_t block_limit =
+        std::min(command_count,
+                 block_start + kVeloceNativeRunLookupBlockSize);
+    while (first_run < native_runs.size() &&
+           native_runs[first_run].first_command +
+                   native_runs[first_run].command_count <=
+               block_start) {
+      ++first_run;
+    }
+    size_t run_limit = first_run;
+    while (run_limit < native_runs.size() &&
+           native_runs[run_limit].first_command < block_limit) {
+      ++run_limit;
+    }
+    if (blocks[block_index].first_run != first_run ||
+        blocks[block_index].run_count != run_limit - first_run) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::vector<VeloceMandatoryCommandRange> BuildMandatoryCommandRanges(
+    uint32_t command_count,
+    pdfium::span<const VeloceNativeRun> native_runs) {
+  std::vector<VeloceMandatoryCommandRange> ranges;
+  const auto append_range = [&ranges](uint32_t first, uint32_t count) {
+    if (count == 0u) {
+      return;
+    }
+    if (!ranges.empty() &&
+        ranges.back().first_command + ranges.back().command_count == first) {
+      ranges.back().command_count += count;
+      return;
+    }
+    ranges.push_back({first, count});
+  };
+
+  uint32_t command = 0u;
+  for (const VeloceNativeRun& run : native_runs) {
+    if (command < run.first_command) {
+      append_range(command, run.first_command - command);
+    }
+    if (!IsSpatiallyIndexedOpcode(run.opcode)) {
+      append_range(run.first_command, run.command_count);
+    }
+    command = run.first_command + run.command_count;
+  }
+  if (command < command_count) {
+    append_range(command, command_count - command);
+  }
+  return ranges;
+}
+
+bool MandatoryCommandRangesMatch(
+    uint32_t command_count,
+    pdfium::span<const VeloceNativeRun> native_runs,
+    pdfium::span<const VeloceMandatoryCommandRange> ranges) {
+  size_t range_index = 0u;
+  std::optional<VeloceMandatoryCommandRange> pending;
+  const auto flush_pending = [&]() {
+    if (!pending) {
+      return true;
+    }
+    if (range_index >= ranges.size() ||
+        ranges[range_index].first_command != pending->first_command ||
+        ranges[range_index].command_count != pending->command_count) {
+      return false;
+    }
+    ++range_index;
+    pending.reset();
+    return true;
+  };
+  const auto append_expected = [&](uint32_t first, uint32_t count) {
+    if (count == 0u) {
+      return true;
+    }
+    if (pending &&
+        pending->first_command + pending->command_count == first) {
+      pending->command_count += count;
+      return true;
+    }
+    if (!flush_pending()) {
+      return false;
+    }
+    pending = VeloceMandatoryCommandRange{first, count};
+    return true;
+  };
+
+  uint32_t command = 0u;
+  for (const VeloceNativeRun& run : native_runs) {
+    if (command < run.first_command &&
+        !append_expected(command, run.first_command - command)) {
+      return false;
+    }
+    if (!IsSpatiallyIndexedOpcode(run.opcode) &&
+        !append_expected(run.first_command, run.command_count)) {
+      return false;
+    }
+    command = run.first_command + run.command_count;
+  }
+  return append_expected(command, command_count - command) &&
+         flush_pending() && range_index == ranges.size();
+}
