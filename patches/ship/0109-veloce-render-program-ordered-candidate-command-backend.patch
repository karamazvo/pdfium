+uint32_t VeloceRenderProgram::FindNativeRunCursorForSpatialReplay(
+    uint32_t command_index) const {
+  if (command_index >= header_.command_count ||
+      native_run_lookup_blocks_.empty()) {
+    return static_cast<uint32_t>(native_runs_.size());
+  }
+  const VeloceNativeRunLookupBlock& block =
+      native_run_lookup_blocks_[command_index /
+                                kVeloceNativeRunLookupBlockSize];
+  const auto first = native_runs_.begin() + block.first_run;
+  const auto limit = first + block.run_count;
+  auto found = std::upper_bound(
+      first, limit, command_index,
+      [](uint32_t command, const VeloceNativeRun& run) {
+        return command < run.first_command;
+      });
+  if (found != first) {
+    const auto previous = found - 1;
+    if (command_index <
+        previous->first_command + previous->command_count) {
+      return static_cast<uint32_t>(previous - native_runs_.begin());
+    }
+  }
+  return static_cast<uint32_t>(found - native_runs_.begin());
+}
