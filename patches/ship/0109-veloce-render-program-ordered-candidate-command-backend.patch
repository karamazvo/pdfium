+VeloceOrderedCommandCursor::VeloceOrderedCommandCursor(
+    uint32_t command_count,
+    pdfium::span<const uint64_t> candidate_words,
+    pdfium::span<const VeloceMandatoryCommandRange> mandatory_ranges)
+    : command_count_(command_count),
+      candidate_words_(candidate_words),
+      mandatory_ranges_(mandatory_ranges) {
+  AdvanceCandidate();
+  AdvanceMandatory();
+}
+
+std::optional<uint32_t> VeloceOrderedCommandCursor::Next() {
+  if (!next_candidate_ && !next_mandatory_) {
+    return std::nullopt;
+  }
+  const uint32_t result =
+      !next_mandatory_ ||
+              (next_candidate_ && *next_candidate_ < *next_mandatory_)
+          ? *next_candidate_
+          : *next_mandatory_;
+  if (next_candidate_ && *next_candidate_ == result) {
+    AdvanceCandidate();
+  }
+  if (next_mandatory_ && *next_mandatory_ == result) {
+    AdvanceMandatory();
+  }
+  return result;
+}
+
+void VeloceOrderedCommandCursor::AdvanceCandidate() {
+  next_candidate_.reset();
+  while (true) {
+    if (candidate_word_ != 0u) {
+      const uint32_t ordinal =
+          candidate_word_base_ + std::countr_zero(candidate_word_);
+      candidate_word_ &= candidate_word_ - 1u;
+      if (ordinal < command_count_) {
+        next_candidate_ = ordinal;
+        return;
+      }
+      continue;
+    }
+    if (word_index_ >= candidate_words_.size()) {
+      return;
+    }
+    candidate_word_base_ = static_cast<uint32_t>(word_index_ * 64u);
+    candidate_word_ = candidate_words_[word_index_++];
+    ++words_scanned_;
+  }
+}
+
+void VeloceOrderedCommandCursor::AdvanceMandatory() {
+  next_mandatory_.reset();
+  while (mandatory_range_index_ < mandatory_ranges_.size()) {
+    const VeloceMandatoryCommandRange& range =
+        mandatory_ranges_[mandatory_range_index_];
+    if (mandatory_offset_ < range.command_count) {
+      next_mandatory_ = range.first_command + mandatory_offset_++;
+      return;
+    }
+    ++mandatory_range_index_;
+    mandatory_offset_ = 0u;
+  }
+}
