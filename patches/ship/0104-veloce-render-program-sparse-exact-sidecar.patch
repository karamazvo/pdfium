+bool VeloceRenderProgram::Validate() const {
+  if (!has_native_commands() || native_runs_.empty() || clip_runs_.empty() ||
+      visibility_runs_.empty()) {
+    return false;
+  }
+
+  uint32_t previous_run_limit = 0u;
+  uint64_t expected_lines = 0u;
+  uint64_t expected_paths = 0u;
+  for (const VeloceNativeRun& run : native_runs_) {
+    if (!IsNativeOpcode(run.opcode) || run.command_count == 0u ||
+        run.first_command < previous_run_limit ||
+        run.first_command >= header_.command_count ||
+        run.command_count > header_.command_count - run.first_command) {
+      return false;
+    }
+    previous_run_limit = run.first_command + run.command_count;
+    if (run.opcode == VeloceRenderOpcode::kNativeOpaqueLine) {
+      expected_lines += run.command_count;
+    } else {
+      expected_paths += run.command_count;
+    }
+  }
+  if (expected_lines != native_line_count() ||
+      expected_paths != native_stroke_path_count()) {
+    return false;
+  }
+
+  uint32_t previous_visibility_command = 0u;
+  for (size_t i = 0; i < visibility_runs_.size(); ++i) {
+    const uint32_t command = visibility_runs_[i].first_command;
+    if ((i != 0u && command <= previous_visibility_command) ||
+        !NativeRunsCoverRange(native_runs_, command, 1u)) {
+      return false;
+    }
+    previous_visibility_command = command;
+  }
+  uint32_t previous_clip_command = 0u;
+  for (size_t i = 0; i < clip_runs_.size(); ++i) {
+    const uint32_t command = clip_runs_[i].first_command;
+    if ((i != 0u && command <= previous_clip_command) ||
+        !NativeRunsCoverRange(native_runs_, command, 1u)) {
+      return false;
+    }
+    previous_clip_command = command;
+  }
+
+  uint32_t previous_block_limit = 0u;
+  uint32_t expected_block_path = 0u;
+  uint64_t block_paths = 0u;
+  for (const VeloceCommandBlock& block : command_blocks_) {
+    if (block.command_count == 0u || block.command_count > 256u ||
+        block.first_command < previous_block_limit ||
+        block.first_command >= header_.command_count ||
+        block.command_count > header_.command_count - block.first_command ||
+        block.first_native_path != expected_block_path ||
+        block.native_line_count != 0u ||
+        block.native_path_count != block.command_count ||
+        !NativeRunsCoverRange(native_runs_, block.first_command,
+                              block.command_count) ||
+        ((block.flags & kVeloceCommandBlockUnbounded) == 0u &&
+         (!IsFiniteRect(block.bounds) || block.bounds.IsEmpty()))) {
+      return false;
+    }
+    previous_block_limit = block.first_command + block.command_count;
+    expected_block_path += block.native_path_count;
+    block_paths += block.native_path_count;
+  }
+  if (block_paths != native_stroke_path_count()) {
+    return false;
+  }
+
+  if (native_line_count() == 0u) {
+    return line_leaf_ranges_.empty() && line_coarse_ranges_.empty();
+  }
+  if (line_leaf_ranges_.empty() || line_coarse_ranges_.empty()) {
+    return false;
+  }
+
+  size_t expected_line = 0u;
+  uint32_t previous_leaf_command_limit = 0u;
+  for (const VeloceLineLeafRange& leaf : line_leaf_ranges_) {
+    if (leaf.first_line != expected_line || leaf.line_count == 0u ||
+        leaf.line_count > 64u ||
+        leaf.command_count != leaf.line_count ||
+        leaf.first_command < previous_leaf_command_limit ||
+        leaf.first_command >= header_.command_count ||
+        leaf.command_count > header_.command_count - leaf.first_command ||
+        !NativeRunsCoverRange(native_runs_, leaf.first_command,
+                              leaf.command_count,
+                              VeloceRenderOpcode::kNativeOpaqueLine) ||
+        ((leaf.flags & kVeloceLineRangeUnbounded) == 0u &&
+         (!IsFiniteRect(leaf.bounds) || leaf.bounds.IsEmpty()))) {
+      return false;
+    }
+    expected_line += leaf.line_count;
+    previous_leaf_command_limit = leaf.first_command + leaf.command_count;
+  }
+  if (expected_line != native_line_count()) {
+    return false;
+  }
+
+  size_t expected_leaf = 0u;
+  size_t coarse_lines = 0u;
+  for (const VeloceLineCoarseRange& coarse : line_coarse_ranges_) {
+    const size_t first_leaf = coarse.first_leaf;
+    if (first_leaf != expected_leaf || coarse.leaf_count == 0u ||
+        coarse.leaf_count > 64u ||
+        first_leaf >= line_leaf_ranges_.size() ||
+        coarse.leaf_count > line_leaf_ranges_.size() - first_leaf ||
+        ((coarse.flags & kVeloceLineRangeUnbounded) == 0u &&
+         (!IsFiniteRect(coarse.bounds) || coarse.bounds.IsEmpty()))) {
+      return false;
+    }
+    uint32_t range_lines = 0u;
+    for (uint32_t i = 0u; i < coarse.leaf_count; ++i) {
+      range_lines += line_leaf_ranges_[first_leaf + i].line_count;
+    }
+    if (range_lines != coarse.line_count) {
+      return false;
+    }
+    expected_leaf += coarse.leaf_count;
+    coarse_lines += coarse.line_count;
+  }
+  return expected_leaf == line_leaf_ranges_.size() &&
+         coarse_lines == native_line_count();
+}
 
