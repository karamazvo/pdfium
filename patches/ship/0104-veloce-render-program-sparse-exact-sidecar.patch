-VeloceRenderOpcode ToCanonicalOpcode(const CPDF_PageObject& object) {
-  switch (object.GetType()) {
-    case CPDF_PageObject::Type::kPath:
-      return VeloceRenderOpcode::kCanonicalPath;
-    case CPDF_PageObject::Type::kText:
-      return VeloceRenderOpcode::kCanonicalText;
-    case CPDF_PageObject::Type::kImage:
-      return VeloceRenderOpcode::kCanonicalImage;
-    case CPDF_PageObject::Type::kShading:
-      return VeloceRenderOpcode::kCanonicalShading;
-    case CPDF_PageObject::Type::kForm:
-      return VeloceRenderOpcode::kCanonicalForm;
+bool IsNativeOpcode(VeloceRenderOpcode opcode) {
+  return opcode == VeloceRenderOpcode::kNativeOpaqueLine ||
+         opcode == VeloceRenderOpcode::kNativeOpaqueStrokePath ||
+         opcode == VeloceRenderOpcode::kNativeDarkenStrokePath;
+}
+
+bool RunContains(const VeloceNativeRun& run, uint32_t command) {
+  return command >= run.first_command &&
+         command - run.first_command < run.command_count;
+}
+
+bool NativeRunsCoverRange(pdfium::span<const VeloceNativeRun> runs,
+                          uint32_t first_command,
+                          uint32_t command_count,
+                          std::optional<VeloceRenderOpcode> required_opcode =
+                              std::nullopt) {
+  uint32_t command = first_command;
+  const uint32_t limit = first_command + command_count;
+  auto run_it = std::lower_bound(
+      runs.begin(), runs.end(), first_command,
+      [](const VeloceNativeRun& run, uint32_t value) {
+        return run.first_command + run.command_count <= value;
+      });
+  for (; run_it != runs.end(); ++run_it) {
+    const VeloceNativeRun& run = *run_it;
+    if (run.first_command > command) {
+      return false;
+    }
+    if (!RunContains(run, command) ||
+        (required_opcode.has_value() && run.opcode != *required_opcode)) {
+      return false;
+    }
+    command = std::min(limit, run.first_command + run.command_count);
+    if (command == limit) {
+      return true;
+    }
   }
-  return VeloceRenderOpcode::kCanonicalUnsupported;
+  return false;
 }
 
