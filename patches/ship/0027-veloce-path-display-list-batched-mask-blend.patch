+// Flushes all pending batches in painter's order (map iteration is by key,
+// which encodes paint_key — order within a clip group is stable because all
+// same-paint nodes share the same color and Darken is idempotent on overlap).
+bool FlushAllMaskBatches(CFX_RenderDevice* device,
+                         const NativePathDisplayList& list,
+                         std::map<uint32_t, MaskBlendBatch>& batches,
+                         PathDlReplayStats* replay_stats) {
+  for (auto& [paint_key, batch] : batches) {
+    if (!FlushMaskBlendBatch(device, list, batch, replay_stats)) {
+      return false;
+    }
+  }
+  batches.clear();
+  return true;
