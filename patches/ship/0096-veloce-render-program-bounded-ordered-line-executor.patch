+bool CPDF_RenderStatus::TryRenderVeloceProgram(
+    const CPDF_PageObjectHolder* holder,
+    const VeloceRenderProgram* program,
+    const CFX_Matrix& holder_to_device,
+    const CFX_FloatRect& holder_clip) {
+  if (!holder || !program || !program->has_native_commands() ||
+      program->header().format_version != kVeloceRenderProgramFormatVersion ||
+      program->command_count() != holder->GetPageObjectCount() ||
+      !IsFiniteVeloceRect(holder_clip)) {
+    return false;
+  }
+  if (holder_clip.IsEmpty()) {
+    return true;
+  }
+
+  const pdfium::span<const uint8_t> bytecode = program->bytecode();
+  const pdfium::span<const VeloceLineLeafRange> leaves =
+      program->line_leaf_ranges();
+  if (bytecode.size() != holder->GetPageObjectCount() || leaves.empty() ||
+      leaves.front().first_line != 0u || leaves.front().line_count == 0u) {
+    return false;
+  }
+
+  const auto replay_start = std::chrono::steady_clock::now();
+  size_t command_count = 0;
+  size_t canonical_draws = 0;
+  size_t native_draws = 0;
+  size_t native_dirty_fallbacks = 0;
+  size_t native_leaf_culled = 0;
+  size_t native_bounds_culled = 0;
+  size_t cancellation_checks = 0;
+  uint32_t native_line_index = 0;
+  size_t leaf_index = 0;
+  uint32_t leaf_limit = leaves.front().line_count;
+  bool leaf_intersects =
+      (leaves.front().flags & kVeloceLineRangeUnbounded) != 0u ||
+      VeloceRectsIntersect(leaves.front().bounds, holder_clip);
+  bool native_clip_ready = false;
+  uint16_t current_state_index = std::numeric_limits<uint16_t>::max();
+  CFX_GraphStateData current_graph_state;
+  CFX_FillRenderOptions current_fill_options;
+  FX_ARGB current_stroke_argb = 0;
+  CFX_Path line_path;
+
+  auto log_result = [&](const char* result) {
+#if BUILDFLAG(IS_ANDROID)
+    const uint64_t replay_micros = static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - replay_start)
+            .count());
+    __android_log_print(
+        ANDROID_LOG_INFO, "VeloceRenderProgram2",
+        "revision=r25-2-0096 event=replay mode=ordered_native_lines "
+        "result=%s commands=%zu nativeLines=%zu canonicalDraws=%zu "
+        "nativeDraws=%zu dirtyFallbacks=%zu leafCulled=%zu "
+        "boundsCulled=%zu cancelChecks=%zu replayUs=%llu",
+        result, command_count, program->native_line_count(), canonical_draws,
+        native_draws, native_dirty_fallbacks, native_leaf_culled,
+        native_bounds_culled, cancellation_checks,
+        static_cast<unsigned long long>(replay_micros));
+#else
+    static_cast<void>(result);
+    static_cast<void>(replay_start);
+    static_cast<void>(command_count);
+    static_cast<void>(canonical_draws);
+    static_cast<void>(native_draws);
+    static_cast<void>(native_dirty_fallbacks);
+    static_cast<void>(native_leaf_culled);
+    static_cast<void>(native_bounds_culled);
+    static_cast<void>(cancellation_checks);
+#endif
+  };
+
+  for (size_t command_index = 0; command_index < bytecode.size();
+       ++command_index) {
+    ++command_count;
+    if ((command_index & 63u) == 0u) {
+      ++cancellation_checks;
+      if (ShouldCancelRender()) {
+        stopped_ = true;
+        log_result("cancelled");
+        return true;
+      }
+    }
+
+    CPDF_PageObject* object = holder->GetPageObjectByIndex(command_index);
+    CHECK(object);
+    if (object == stop_obj_) {
+      stopped_ = true;
+      log_result("stopped");
+      return true;
+    }
+
+    const auto opcode = static_cast<VeloceRenderOpcode>(bytecode[command_index]);
+    if (opcode != VeloceRenderOpcode::kNativeOpaqueLine) {
+      native_clip_ready = false;
+      if (!object->IsActive() ||
+          !VeloceRectsIntersect(object->GetRect(), holder_clip)) {
+        continue;
+      }
+      RenderSingleObject(object, holder_to_device);
+      ++canonical_draws;
+      if (stopped_) {
+        log_result("cancelled");
+        return true;
+      }
+      continue;
+    }
+
+    CHECK_LT(native_line_index, program->native_line_count());
+    while (native_line_index >= leaf_limit) {
+      ++leaf_index;
+      CHECK_LT(leaf_index, leaves.size());
+      CHECK_EQ(leaves[leaf_index].first_line, native_line_index);
+      leaf_limit = native_line_index + leaves[leaf_index].line_count;
+      leaf_intersects =
+          (leaves[leaf_index].flags & kVeloceLineRangeUnbounded) != 0u ||
+          VeloceRectsIntersect(leaves[leaf_index].bounds, holder_clip);
+    }
+
+    const VeloceNativeLine& line =
+        program->native_line(native_line_index++);
+    if (!object->IsActive()) {
+      continue;
+    }
+    if (object->IsDirty()) {
+      native_clip_ready = false;
+      if (VeloceRectsIntersect(object->GetRect(), holder_clip)) {
+        RenderSingleObject(object, holder_to_device);
+        ++native_dirty_fallbacks;
+      }
+      if (stopped_) {
+        log_result("cancelled");
+        return true;
+      }
+      continue;
+    }
+    if (!leaf_intersects) {
+      ++native_leaf_culled;
+      continue;
+    }
+    if (!VeloceRectsIntersect(object->GetRect(), holder_clip)) {
+      ++native_bounds_culled;
+      continue;
+    }
+
+    CPDF_PathObject* path_object = object->AsPath();
+    CHECK(path_object);
+    if (!options_.CheckPageObjectVisible(path_object)) {
+      continue;
+    }
+    if (!native_clip_ready) {
+      ProcessClipPath(path_object->clip_path(), holder_to_device);
+      native_clip_ready = true;
+    }
+
+    CHECK_LT(line.state_index, program->opaque_path_states().size());
+    const VeloceOpaquePathState& state =
+        program->opaque_path_states()[line.state_index];
+    if (current_state_index != line.state_index) {
+      CHECK_LE(static_cast<size_t>(state.dash_offset) + state.dash_count,
+               program->dash_values().size());
+      current_graph_state = BuildVeloceGraphState(
+          state, program->dash_values().subspan(state.dash_offset,
+                                                 state.dash_count));
+      current_fill_options = GetFillOptionsForDrawPathWithBlend(
+          options_.GetOptions(), path_object,
+          CFX_FillRenderOptions::FillType::kNoFill,
+          /*is_stroke=*/true, type3_char_);
+      current_stroke_argb = GetStrokeArgb(path_object);
+      current_state_index = line.state_index;
+    }
+
+    CFX_Matrix path_matrix;
+    if (line.matrix_index == kVeloceInlineTranslationMatrixIndex) {
+      path_matrix = CFX_Matrix(1.0f, 0.0f, 0.0f, 1.0f,
+                               line.translation_x, line.translation_y) *
+                    holder_to_device;
+    } else {
+      CHECK_LT(line.matrix_index, program->path_matrices().size());
+      path_matrix = program->path_matrices()[line.matrix_index] *
+                    holder_to_device;
+    }
+    if (!IsAvailableMatrix(path_matrix)) {
+      continue;
+    }
+
+    cur_obj_ = path_object;
+    line_path.Clear();
+    line_path.AppendLine(line.start, line.end);
+    if (!device_->DrawPath(line_path, &path_matrix, &current_graph_state,
+                           /*fill_color=*/0, current_stroke_argb,
+                           current_fill_options)) {
+      DrawObjWithBackground(path_object, holder_to_device);
+      if (stopped_) {
+        log_result("cancelled");
+        return true;
+      }
+    }
+    ++native_draws;
+  }
+
+  CHECK_EQ(native_line_index, program->native_line_count());
+  if (ShouldCancelRender()) {
+    stopped_ = true;
+    log_result("cancelled");
+    return true;
+  }
+  log_result("rendered");
+  return true;
+}
