+TEST(VeloceRenderProgramTest, PreservesNativeOrdinalsAcrossCanonicalBarrier) {
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+
+  auto first_line = MakeOpaqueLine(1.0f, 2.0f);
+  auto fill_barrier = MakeOpaqueLine(3.0f, 4.0f);
+  fill_barrier->set_winding_filltype();
+  auto second_line = MakeOpaqueLine(5.0f, 6.0f);
+  builder.AppendPageObject(*first_line);
+  builder.AppendPageObject(*fill_barrier);
+  builder.AppendPageObject(*second_line);
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+  ASSERT_TRUE(program);
+  ASSERT_EQ(4099u, program->bytecode().size());
+  EXPECT_EQ(static_cast<uint8_t>(VeloceRenderOpcode::kNativeOpaqueLine),
+            program->bytecode()[4096]);
+  EXPECT_EQ(static_cast<uint8_t>(VeloceRenderOpcode::kCanonicalPath),
+            program->bytecode()[4097]);
+  EXPECT_EQ(static_cast<uint8_t>(VeloceRenderOpcode::kNativeOpaqueLine),
+            program->bytecode()[4098]);
+  ASSERT_EQ(1u, program->line_leaf_ranges().size());
+  EXPECT_EQ(0u, program->line_leaf_ranges()[0].first_line);
+  EXPECT_EQ(4096u, program->line_leaf_ranges()[0].first_command);
+  EXPECT_EQ(3u, program->line_leaf_ranges()[0].command_count);
+  EXPECT_EQ(2u, program->line_leaf_ranges()[0].line_count);
