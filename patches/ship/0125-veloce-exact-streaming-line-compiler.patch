+bool CPDF_StreamContentParser::TryParseVeloceTransformedSimpleStrokeLine() {
+  if (!can_try_balanced_line_unit_) {
+    return false;
+  }
+  can_try_balanced_line_unit_ = false;
+  if (param_count_ != 0u || !path_points_.empty() ||
+      path_clip_type_ != CFX_FillRenderOptions::FillType::kNoFill ||
+      cur_states_->general_state().GetBlendType() != BlendMode::kNormal ||
+      !object_holder_->HasVeloceParsedLineContext()) {
+    return false;
+  }
+
+  std::array<float, 10> operands = {};
+  const uint32_t unit_start = syntax_->GetPos();
+  if (!syntax_->TryParseTransformedSimpleStrokeLine(&operands)) {
+    return false;
+  }
+  const uint32_t unit_end = syntax_->GetPos();
+  syntax_->SetPos(unit_start);
+  const int32_t stream_index = GetCurrentStreamIndex();
+  syntax_->SetPos(unit_end);
+  if (stream_index != GetCurrentStreamIndex()) {
+    syntax_->SetPos(unit_start);
+    return false;
+  }
+
+  const CFX_PointF start(operands[6], operands[7]);
+  const CFX_PointF end(operands[8], operands[9]);
+  path_start_ = start;
+  path_current_ = end;
+  const CFX_Matrix local_matrix(operands[0], operands[1], operands[2],
+                                operands[3], operands[4], operands[5]);
+  const CFX_Matrix matrix = local_matrix *
+                            cur_states_->current_transformation_matrix() *
+                            mt_content_to_user_;
+  const CPDF_PageObjectHolder::VeloceParsedPathDisposition disposition =
+      object_holder_->RecordVeloceParsedLine(
+          start, end, matrix, cur_states_->graphic_states(),
+          *content_marks_stack_.top(), /*stream_fused=*/true);
+  CHECK_NE(disposition, CPDF_PageObjectHolder::VeloceParsedPathDisposition::
+                            kNotRecorded);
+  all_ctms_[stream_index] = cur_states_->current_transformation_matrix();
+  if (disposition ==
+      CPDF_PageObjectHolder::VeloceParsedPathDisposition::kOmitRecorded) {
+    can_try_balanced_line_unit_ = true;
+    return true;
+  }
+
+  std::vector<CFX_Path::Point> points;
+  points.reserve(2u);
+  points.emplace_back(start, CFX_Path::Point::Type::kMove, /*close=*/false);
+  points.emplace_back(end, CFX_Path::Point::Type::kLine, /*close=*/false);
+  CPDF_Path path;
+  path.SetPoints(std::move(points));
+
+  auto path_object =
+      std::make_unique<CPDF_PathObject>(stream_index);
+  path_object->set_stroke(true);
+  path_object->set_filltype(CFX_FillRenderOptions::FillType::kNoFill);
+  path_object->path() = path;
+  SetGraphicStates(path_object.get(), true, false, true);
+  path_object->SetPathMatrix(matrix);
+  object_holder_->AppendRecordedPageObject(std::move(path_object));
+  can_try_balanced_line_unit_ = true;
+  return true;
+}
