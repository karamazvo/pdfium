+constexpr uint32_t kMaxVelocePathWordLength = 255u;
+
+bool ReadVelocePathWord(pdfium::raw_span<const uint8_t> buffer,
+                        uint32_t* position,
+                        uint32_t* word_start,
+                        uint32_t* word_size,
+                        bool* is_number) {
+  while (*position < buffer.size()) {
+    const uint8_t ch = buffer[*position];
+    if (PDFCharIsWhitespace(ch)) {
+      ++*position;
+      continue;
+    }
+    if (ch != '%') {
+      break;
+    }
+    do {
+      ++*position;
+    } while (*position < buffer.size() &&
+             !PDFCharIsLineEnding(buffer[*position]));
+  }
+  if (*position >= buffer.size() ||
+      PDFCharIsDelimiter(buffer[*position])) {
+    return false;
+  }
+
+  *word_start = *position;
+  *is_number = true;
+  while (*position < buffer.size()) {
+    const uint8_t ch = buffer[*position];
+    if (PDFCharIsDelimiter(ch) || PDFCharIsWhitespace(ch)) {
+      break;
+    }
+    *is_number &= PDFCharIsNumeric(ch);
+    ++*position;
+  }
+  *word_size = *position - *word_start;
+  return *word_size > 0u && *word_size <= kMaxVelocePathWordLength;
+}
+
+bool ReadVelocePathNumber(pdfium::raw_span<const uint8_t> buffer,
+                          uint32_t* position,
+                          float* value) {
+  uint32_t word_start = 0u;
+  uint32_t word_size = 0u;
+  bool is_number = false;
+  if (!ReadVelocePathWord(buffer, position, &word_start, &word_size,
+                          &is_number) ||
+      !is_number) {
+    return false;
+  }
+  const pdfium::span<const uint8_t> word(
+      buffer.subspan(word_start, word_size));
+  *value = FX_Number(ByteStringView(word)).GetFloat();
+  return true;
+}
+
+bool ReadVelocePathOperator(pdfium::raw_span<const uint8_t> buffer,
+                            uint32_t* position,
+                            uint8_t expected) {
+  uint32_t word_start = 0u;
+  uint32_t word_size = 0u;
+  bool is_number = false;
+  return ReadVelocePathWord(buffer, position, &word_start, &word_size,
+                            &is_number) &&
+         !is_number && word_size == 1u && buffer[word_start] == expected;
+}
+
+bool ReadVelocePathOperator(pdfium::raw_span<const uint8_t> buffer,
+                            uint32_t* position,
+                            uint8_t expected_first,
+                            uint8_t expected_second) {
+  uint32_t word_start = 0u;
+  uint32_t word_size = 0u;
+  bool is_number = false;
+  return ReadVelocePathWord(buffer, position, &word_start, &word_size,
+                            &is_number) &&
+         !is_number && word_size == 2u &&
+         buffer[word_start] == expected_first &&
+         buffer[word_start + 1u] == expected_second;
+}
 
