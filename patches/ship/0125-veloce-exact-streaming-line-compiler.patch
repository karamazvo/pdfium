+TEST(CPDFStreamParserTest, ParsesTransformedSimpleStrokeLineTransactionally) {
+  uint8_t data[] =
+      "q 1 0 0 1 10 -20 cm 1.25 -2 m % comment\r\n 3 +4.5 l S Q q";
+  CPDF_StreamParser parser(data);
+  std::array<float, 10> operands = {};
+
+  EXPECT_TRUE(parser.TryParseTransformedSimpleStrokeLine(&operands));
+  EXPECT_FLOAT_EQ(1.0f, operands[0]);
+  EXPECT_FLOAT_EQ(10.0f, operands[4]);
+  EXPECT_FLOAT_EQ(-20.0f, operands[5]);
+  EXPECT_FLOAT_EQ(1.25f, operands[6]);
+  EXPECT_FLOAT_EQ(-2.0f, operands[7]);
+  EXPECT_FLOAT_EQ(3.0f, operands[8]);
+  EXPECT_FLOAT_EQ(4.5f, operands[9]);
+  EXPECT_EQ(CPDF_StreamParser::ElementType::kKeyword,
+            parser.ParseNextElement());
+  EXPECT_EQ("q", parser.GetWord());
+}
+
+TEST(CPDFStreamParserTest, LeavesPositionUnchangedOnNonLinePath) {
+  uint8_t data[] = "q 1 0 0 1 10 -20 cm 1 2 m 3 4 5 6 v S Q";
+  CPDF_StreamParser parser(data);
+  std::array<float, 10> operands = {};
+
+  EXPECT_FALSE(parser.TryParseTransformedSimpleStrokeLine(&operands));
+  EXPECT_EQ(0u, parser.GetPos());
+  EXPECT_EQ(CPDF_StreamParser::ElementType::kKeyword,
+            parser.ParseNextElement());
+  EXPECT_EQ("q", parser.GetWord());
+}
+
+TEST(CPDFStreamParserTest, LeavesPositionUnchangedOnDifferentPaintOperator) {
+  uint8_t data[] = "q 1 0 0 1 10 -20 cm 1 2 m 3 4 l s Q";
+  CPDF_StreamParser parser(data);
+  std::array<float, 10> operands = {};
+
+  EXPECT_FALSE(parser.TryParseTransformedSimpleStrokeLine(&operands));
+  EXPECT_EQ(0u, parser.GetPos());
+}
