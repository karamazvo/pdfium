+bool CFX_AggDeviceDriver::DrawStrokeLineBatch(
+    pdfium::span<const CFX_StrokeLine> lines,
+    const CFX_GraphStateData* pGraphState,
+    uint32_t stroke_color,
+    const CFX_FillRenderOptions& fill_options) {
+  if (lines.empty() || bitmap_->GetBuffer().empty()) {
+    return true;
+  }
+  if (!pGraphState || FXARGB_A(stroke_color) == 0 ||
+      fill_options.fill_type !=
+          CFX_FillRenderOptions::FillType::kNoFill) {
+    return false;
+  }
+
+  // Validate the complete packet before its first pixel. This keeps the
+  // caller's ordered canonical fallback safe.
+  if (!fill_options.zero_area) {
+    for (const CFX_StrokeLine& line : lines) {
+      const CFX_Matrix& matrix = line.object_to_device;
+      const float scale = std::max(fabs(matrix.a), fabs(matrix.b));
+      if (!std::isfinite(matrix.a) || !std::isfinite(matrix.b) ||
+          !std::isfinite(scale) || scale == 0.0f ||
+          !std::isfinite(matrix.c) || !std::isfinite(matrix.d) ||
+          !std::isfinite(matrix.e) || !std::isfinite(matrix.f)) {
+        return false;
+      }
+    }
+  }
+
+  fill_options_ = fill_options;
+  RetainPtr<CFX_DIBitmap> backdrop =
+      group_knockout_ ? backdrop_bitmap_ : nullptr;
+  CFX_AggRenderer renderer(bitmap_, backdrop, clip_rgn_.get(), stroke_color,
+                           fill_options.full_cover, rgb_byte_order_);
+  agg::scanline_u8 scanline;
+  agg::path_storage path_data;
+  agg::rasterizer_scanline_aa rasterizer;
+  rasterizer.clip_box(0.0f, 0.0f, static_cast<float>(GetPixelWidth()),
+                      static_cast<float>(GetPixelHeight()));
+
+  for (const CFX_StrokeLine& line : lines) {
+    path_data.remove_all();
+    rasterizer.reset();
+    if (fill_options.zero_area) {
+      BuildAggStrokeLine(line, &line.object_to_device, &path_data);
+      RasterizeStroke(&rasterizer, &path_data, nullptr, pGraphState, 1,
+                      fill_options.stroke_text_mode);
+    } else {
+      const CFX_Matrix& object_matrix = line.object_to_device;
+      CFX_Matrix matrix1;
+      CFX_Matrix matrix2;
+      matrix1.a = std::max(fabs(object_matrix.a), fabs(object_matrix.b));
+      matrix1.d = matrix1.a;
+      matrix2 = CFX_Matrix(
+          object_matrix.a / matrix1.a, object_matrix.b / matrix1.a,
+          object_matrix.c / matrix1.d, object_matrix.d / matrix1.d, 0, 0);
+      matrix1 = object_matrix * matrix2.GetInverse();
+      BuildAggStrokeLine(line, &matrix1, &path_data);
+      RasterizeStroke(&rasterizer, &path_data, &matrix2, pGraphState,
+                      matrix1.a, fill_options.stroke_text_mode);
+    }
+    agg::render_scanlines(rasterizer, scanline, renderer,
+                          fill_options.aliased_path);
+  }
+  return true;
+}
