+TEST(CFXDefaultRenderDeviceTest, StrokeLineBatchMatchesOrderedDrawPath) {
+  CFX_DefaultRenderDevice baseline;
+  CFX_DefaultRenderDevice batched;
+  ASSERT_TRUE(
+      baseline.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  ASSERT_TRUE(
+      batched.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  baseline.GetBitmap()->Clear(0xfff0e0d0);
+  batched.GetBitmap()->Clear(0xfff0e0d0);
+
+  const CFX_GraphStateData graphics_state;
+  const CFX_FillRenderOptions fill_options;
+  constexpr uint32_t kStrokeColor = 0xff204080;
+  const std::array<CFX_StrokeLine, 4> lines = {
+      CFX_StrokeLine{{2.25f, 3.5f}, {28.0f, 21.75f}, CFX_Matrix()},
+      CFX_StrokeLine{{3.0f, 22.0f}, {27.5f, 4.0f}, CFX_Matrix()},
+      CFX_StrokeLine{{4.0f, 12.0f},
+                     {25.0f, 12.0f},
+                     CFX_Matrix(1, 0, 0, 1, 0.25f, 0.5f)},
+      CFX_StrokeLine{{16.0f, 16.0f}, {16.0f, 16.0f}, CFX_Matrix()},
+  };
+
+  for (const CFX_StrokeLine& line : lines) {
+    CFX_Path path;
+    path.AppendLine(line.start, line.end);
+    ASSERT_TRUE(baseline.DrawPath(path, &line.object_to_device,
+                                  &graphics_state, /*fill_color=*/0,
+                                  kStrokeColor, fill_options));
+  }
+  ASSERT_TRUE(batched.DrawStrokeLineBatch(lines, &graphics_state,
+                                          kStrokeColor, fill_options));
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 batched.GetBitmap()->GetBuffer()));
+}
