+bool IsVeloceDeviceClipOpaque(const CFX_RenderDevice& device) {
+  RetainPtr<const CFX_DIBitmap> bitmap = device.GetBitmap();
+  if (!bitmap || bitmap->IsMaskFormat()) {
+    return false;
+  }
+  if (!bitmap->IsAlphaFormat()) {
+    return true;
+  }
+  if (bitmap->GetFormat() != FXDIB_Format::kBgra) {
+    return false;
+  }
+
+  FX_RECT clip = device.GetClipBox();
+  clip.Intersect(FX_RECT(0, 0, bitmap->GetWidth(), bitmap->GetHeight()));
+  for (int y = clip.top; y < clip.bottom; ++y) {
+    const auto scanline =
+        bitmap->GetScanlineAs<FX_BGRA_STRUCT<uint8_t>>(y).subspan(
+            static_cast<size_t>(clip.left),
+            static_cast<size_t>(clip.Width()));
+    if (std::ranges::any_of(
+            scanline, [](const auto& pixel) { return pixel.alpha != 255; })) {
+      return false;
+    }
+  }
+  return true;
+}
