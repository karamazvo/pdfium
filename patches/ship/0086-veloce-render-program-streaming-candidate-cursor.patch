+void VeloceSpatialCandidateCursor::Reset() {
+  linear_next_ = 0;
+  linear_end_ = 0;
+  last_emitted_ = 0;
+  stream_count_ = 0;
+  source_stream_count_ = 0;
+  heap_size_ = 0;
+  uses_linear_replay_ = false;
+  have_last_emitted_ = false;
+}
+
+void VeloceSpatialCandidateCursor::AddStream(const uint32_t* begin,
+                                             const uint32_t* end) {
+  if (begin == end) {
+    return;
   }
+  const size_t stream_index = stream_count_++;
+  streams_[stream_index] = {begin, end};
+  PushHeap({*begin, static_cast<uint16_t>(stream_index)});
+  source_stream_count_ = stream_count_;
+}
 
-  return candidates->empty() ? VeloceSpatialQueryResult::kEmpty
-                             : VeloceSpatialQueryResult::kCandidates;
+void VeloceSpatialCandidateCursor::UseLinearReplay(
+    uint32_t command_count,
+    size_t source_stream_count) {
+  Reset();
+  linear_end_ = command_count;
+  source_stream_count_ = source_stream_count;
+  uses_linear_replay_ = true;
+}
+
+bool VeloceSpatialCandidateCursor::ComesBefore(const HeapEntry& lhs,
+                                               const HeapEntry& rhs) {
+  return lhs.command_index < rhs.command_index ||
+         (lhs.command_index == rhs.command_index &&
+          lhs.stream_index < rhs.stream_index);
+}
+
+void VeloceSpatialCandidateCursor::PushHeap(HeapEntry entry) {
+  size_t child = heap_size_++;
+  while (child > 0) {
+    const size_t parent = (child - 1u) / 2u;
+    if (!ComesBefore(entry, heap_[parent])) {
+      break;
+    }
+    heap_[child] = heap_[parent];
+    child = parent;
+  }
+  heap_[child] = entry;
+}
+
+VeloceSpatialCandidateCursor::HeapEntry
+VeloceSpatialCandidateCursor::PopHeap() {
+  const HeapEntry first = heap_[0];
+  const HeapEntry tail = heap_[--heap_size_];
+  if (heap_size_ > 0) {
+    size_t parent = 0;
+    while (true) {
+      const size_t left = parent * 2u + 1u;
+      if (left >= heap_size_) {
+        break;
+      }
+      const size_t right = left + 1u;
+      const size_t child =
+          right < heap_size_ && ComesBefore(heap_[right], heap_[left])
+              ? right
+              : left;
+      if (!ComesBefore(heap_[child], tail)) {
+        break;
+      }
+      heap_[parent] = heap_[child];
+      parent = child;
+    }
+    heap_[parent] = tail;
+  }
+
+  Stream& stream = streams_[first.stream_index];
+  ++stream.current;
+  if (stream.current != stream.end) {
+    PushHeap({*stream.current, first.stream_index});
+  }
+  return first;
+}
+
+size_t VeloceSpatialCandidateCursor::NextChunk(
+    pdfium::span<uint32_t> output) {
+  size_t output_count = 0;
+  if (uses_linear_replay_) {
+    while (output_count < output.size() && linear_next_ < linear_end_) {
+      output[output_count++] = linear_next_++;
+    }
+    return output_count;
+  }
+
+  while (output_count < output.size() && heap_size_ > 0) {
+    const HeapEntry entry = PopHeap();
+    if (have_last_emitted_ && entry.command_index == last_emitted_) {
+      continue;
+    }
+    last_emitted_ = entry.command_index;
+    have_last_emitted_ = true;
+    output[output_count++] = entry.command_index;
+  }
+  return output_count;
 }
 
