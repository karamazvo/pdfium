+// Allocation-free ordered union of the immutable posting streams selected by
+// one holder-space query. NextChunk() preserves global painter order and
+// removes duplicates across chunk boundaries. Its fixed storage bounds every
+// replay independently of page density.
+class VeloceSpatialCandidateCursor final {
+ public:
+  static constexpr size_t kMaxStreams =
+      VeloceSpatialCandidateIndex::kBinCount + 1u;
+
+  VeloceSpatialCandidateCursor() = default;
+  ~VeloceSpatialCandidateCursor() = default;
+
+  VeloceSpatialCandidateCursor(const VeloceSpatialCandidateCursor&) = delete;
+  VeloceSpatialCandidateCursor& operator=(
+      const VeloceSpatialCandidateCursor&) = delete;
+
+  size_t NextChunk(pdfium::span<uint32_t> output);
+  size_t stream_count() const { return source_stream_count_; }
+  bool uses_linear_replay() const { return uses_linear_replay_; }
+
+ private:
+  friend class VeloceSpatialCandidateIndex;
+
+  struct Stream {
+    const uint32_t* current = nullptr;
+    const uint32_t* end = nullptr;
+  };
+
+  struct HeapEntry {
+    uint32_t command_index = 0;
+    uint16_t stream_index = 0;
+  };
+
+  void Reset();
+  void AddStream(const uint32_t* begin, const uint32_t* end);
+  void UseLinearReplay(uint32_t command_count, size_t source_stream_count);
+  void PushHeap(HeapEntry entry);
+  HeapEntry PopHeap();
+  static bool ComesBefore(const HeapEntry& lhs, const HeapEntry& rhs);
+
+  std::array<Stream, kMaxStreams> streams_{};
+  std::array<HeapEntry, kMaxStreams> heap_{};
+  uint32_t linear_next_ = 0;
+  uint32_t linear_end_ = 0;
+  uint32_t last_emitted_ = 0;
+  size_t stream_count_ = 0;
+  size_t source_stream_count_ = 0;
+  size_t heap_size_ = 0;
+  bool uses_linear_replay_ = false;
+  bool have_last_emitted_ = false;
+};
