+bool CPDF_RenderStatus::RenderVeloceDirectPath(
+    CPDF_PathObject* path_obj,
+    const CFX_Matrix& mtObj2Device) {
+  if (ShouldCancelRender()) {
+    stopped_ = true;
+    return false;
+  }
+  cur_obj_ = path_obj;
+  if (!options_.CheckPageObjectVisible(path_obj)) {
+    return true;
+  }
+
+  // Even an empty clip is processed so a preceding canonical text command
+  // cannot leak its device clip into this path.
+  ProcessClipPath(path_obj->clip_path(), mtObj2Device);
+  if (ShouldCancelRender()) {
+    stopped_ = true;
+    return false;
+  }
+  if (!ProcessPath(path_obj, mtObj2Device,
+                   /*pattern_proven_absent=*/true)) {
+    DrawObjWithBackground(path_obj, mtObj2Device);
+  }
+  if (ShouldCancelRender()) {
+    stopped_ = true;
+  }
+  return !stopped_;
+}
