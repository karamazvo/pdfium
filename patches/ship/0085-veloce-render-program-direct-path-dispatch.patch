+bool VeloceCanDirectDrawPath(const CPDF_PageObject& object) {
+  const CPDF_PathObject* path = object.AsPath();
+  if (!path || path->clip_path().HasRef() || !path->path().GetObject()) {
+    return false;
+  }
+
+  const CPDF_GeneralState& general_state = path->general_state();
+  if (general_state.GetBlendType() != BlendMode::kNormal ||
+      general_state.GetSoftMask() || general_state.GetTR()) {
+    return false;
+  }
+
+  const CPDF_ColorState& color_state = path->color_state();
+  if (!path->has_no_filltype()) {
+    const CPDF_Color* fill = color_state.GetFillColor();
+    if (!fill || fill->IsNull() || fill->IsPattern()) {
+      return false;
+    }
+  }
+  if (path->stroke()) {
+    const CPDF_Color* stroke = color_state.GetStrokeColor();
+    if (!stroke || stroke->IsNull() || stroke->IsPattern()) {
+      return false;
+    }
+  }
+  return true;
+}
