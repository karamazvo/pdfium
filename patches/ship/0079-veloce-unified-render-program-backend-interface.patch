+#include "core/fpdfapi/render/veloce_unified_render_backend.h"
+
+#include "core/fpdfapi/page/cpdf_pageobjectholder.h"
+#include "core/fpdfapi/page/veloce_render_program.h"
+
+VeloceUnifiedRenderResult VeloceTryRenderUnifiedProgram(
+    CPDF_RenderStatus*,
+    const CPDF_PageObjectHolder* holder,
+    const CFX_Matrix&,
+    VeloceUnifiedRenderMetrics* metrics) {
+  if (metrics) {
+    *metrics = {};
+    const VeloceRenderProgram* program =
+        holder ? holder->GetVeloceRenderProgram() : nullptr;
+    if (program) {
+      metrics->total_commands = program->commands().size();
+      metrics->program_bytes = program->EstimatedBytes();
+    }
+  }
+  return VeloceUnifiedRenderResult::kDisabled;
+}
diff --git a/core/fpdfapi/render/veloce_unified_render_backend.h b/core/fpdfapi/render/veloce_unified_render_backend.h
new file mode 100644
index 000000000..4cb77528d
--- /dev/null
+++ b/core/fpdfapi/render/veloce_unified_render_backend.h
@@ -0,0 +1,63 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#ifndef CORE_FPDFAPI_RENDER_VELOCE_UNIFIED_RENDER_BACKEND_H_
+#define CORE_FPDFAPI_RENDER_VELOCE_UNIFIED_RENDER_BACKEND_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+class CFX_Matrix;
+class CPDF_PageObjectHolder;
+class CPDF_RenderStatus;
+
+inline constexpr char kVeloceUnifiedRenderBackendRevision[] = "r25-1-0079";
+
+// Result contract for one complete holder request. Disabled and not-eligible
+// results guarantee that no destination pixel was changed. A cancelled result
+// may contain partial work and requires the caller to discard the bitmap.
+enum class VeloceUnifiedRenderResult : uint8_t {
+  kDisabled,
+  kNotEligible,
+  kRendered,
+  kCancelled,
+};
+
+// Value-only benchmark contract shared by every r25-1 backend revision. No
+// metric owns storage or changes execution. Durations use monotonic nanoseconds
+// and byte counters report retained/admitted memory, not allocator capacity
+// guesses hidden from the cache budget.
+struct VeloceUnifiedRenderMetrics {
+  uint64_t program_build_ns = 0;
+  uint64_t index_build_ns = 0;
+  uint64_t compile_ns = 0;
+  uint64_t candidate_query_ns = 0;
+  uint64_t replay_ns = 0;
+  uint64_t raster_ns = 0;
+  uint64_t blend_ns = 0;
+
+  size_t total_commands = 0;
+  size_t candidate_commands = 0;
+  size_t visited_commands = 0;
+  size_t drawn_commands = 0;
+  size_t dispatch_count = 0;
+  size_t program_bytes = 0;
+  size_t cache_bytes = 0;
+  size_t scratch_bytes = 0;
+};
+
+// Unified native execution boundary for normal, mixed-content, and path-heavy
+// holders. The holder-owned RenderProgram is the sole immutable command-order
+// representation; PDFium page objects remain authoritative for fidelity and
+// editing, and `status` owns the destination device.
+
+// r25-1-0079 intentionally returns kDisabled and has no render-path call site.
+// Later revisions may consume this contract only after complete pre-draw
+// validation. They must not delegate to the legacy Veloce path display list.
+VeloceUnifiedRenderResult VeloceTryRenderUnifiedProgram(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    const CFX_Matrix& holder_to_device,
+    VeloceUnifiedRenderMetrics* metrics);
+
+#endif  // CORE_FPDFAPI_RENDER_VELOCE_UNIFIED_RENDER_BACKEND_H_
