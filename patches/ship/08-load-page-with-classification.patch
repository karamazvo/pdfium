diff --git a/public/fpdfview.h b/public/fpdfview.h
index 4209c2fc2..ddf565295 100644
--- a/public/fpdfview.h
+++ b/public/fpdfview.h
@@ -702,6 +702,48 @@ FPDF_GetSecurityHandlerRevision(FPDF_DOCUMENT document);
 //          Total number of pages in the document.
 FPDF_EXPORT int FPDF_CALLCONV FPDF_GetPageCount(FPDF_DOCUMENT document);
 
+// Veloce extension API.
+// ABI: stable. New fields may be appended; existing fields never change
+// offset or meaning. This struct must remain exactly 64 bytes.
+typedef struct FPDFEx_PageClassification_ {
+  // Total number of page objects in the page content stream.
+  int total_object_count;
+
+  // Count of CPDF_PageObject::Type::kPath objects.
+  int path_object_count;
+
+  // Count of CPDF_PageObject::Type::kImage objects.
+  int image_object_count;
+
+  // Count of CPDF_PageObject::Type::kText objects.
+  int text_object_count;
+
+  // Count of CPDF_PageObject::Type::kForm objects.
+  int form_object_count;
+
+  // Count of CPDF_PageObject::Type::kShading objects.
+  int shading_object_count;
+
+  // 0 or 1. 1 iff any page object has a soft mask.
+  int has_soft_mask;
+
+  // 0 or 1. 1 iff the page or any top-level Form XObject declares a
+  // transparency group.
+  int has_transparency_group;
+
+  // Largest point/segment count of any single path object on the page.
+  int max_path_segment_count;
+
+  // Reserved for future classification signals. Always zeroed.
+  int reserved_0;
+  int reserved_1;
+  int reserved_2;
+  int reserved_3;
+  int reserved_4;
+  int reserved_5;
+  int reserved_6;
+} FPDFEx_PageClassification;
+
 // Function: FPDF_LoadPage
 //          Load a page inside the document.
 // Parameters:
@@ -715,6 +757,30 @@ FPDF_EXPORT int FPDF_CALLCONV FPDF_GetPageCount(FPDF_DOCUMENT document);
 FPDF_EXPORT FPDF_PAGE FPDF_CALLCONV FPDF_LoadPage(FPDF_DOCUMENT document,
                                                   int page_index);
 
+// Veloce extension API.
+// Function: FPDFEx_LoadPageWithClassification
+//          Load a page and write a classification summary for first-render
+//          backend routing.
+// Parameters:
+//          document    -   Handle to document. Returned by FPDF_LoadDocument.
+//          page_index  -   Index number of the page. 0 for the first page.
+//          out_classification
+//                      -   Non-null caller-owned output struct. The function
+//                          zeroes it before populating counts and flags.
+// Return value:
+//          A handle to the loaded page, or NULL if page load fails.
+// Comments:
+//          The returned page handle is semantically identical to a page
+//          returned by FPDF_LoadPage() and must be closed with
+//          FPDF_ClosePage(). Classification is produced from the
+//          CPDF_PageObjectHolder built during load; no classification data is
+//          cached on the page handle.
+FPDF_EXPORT FPDF_PAGE FPDF_CALLCONV
+FPDFEx_LoadPageWithClassification(
+    FPDF_DOCUMENT document,
+    int page_index,
+    FPDFEx_PageClassification* out_classification);
+
 // Experimental API
 // Function: FPDF_GetPageWidthF
 //          Get page width.
