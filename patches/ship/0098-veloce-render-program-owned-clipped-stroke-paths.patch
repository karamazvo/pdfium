+bool IsFinitePath(const CFX_Path& path) {
+  if (path.GetPoints().empty()) {
+    return false;
+  }
+  for (const CFX_Path::Point& point : path.GetPoints()) {
+    if (!IsFinitePoint(point.point_)) {
+      return false;
+    }
+  }
+  return true;
+}
+
 bool IsFiniteMatrix(const CFX_Matrix& matrix) {
