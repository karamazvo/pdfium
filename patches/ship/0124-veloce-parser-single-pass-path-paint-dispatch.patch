+TEST(CPDFStreamContentParserTest, RecognizesSinglePassPathPaintOperators) {
+  constexpr const char* kOperators[] = {
+      "S", "s", "f", "F", "f*", "B", "B*", "b", "b*", "n",
+  };
+  for (const char* op : kOperators) {
+    EXPECT_TRUE(
+        CPDF_StreamContentParser::IsPathPaintOperatorForTesting(
+            ByteStringView(op)))
+        << op;
+  }
+}
+
+TEST(CPDFStreamContentParserTest, RejectsNonPaintPathOperators) {
+  constexpr const char* kOperators[] = {
+      "", "m", "l", "c", "v", "y", "h", "re", "W", "W*", "q", "SS",
+  };
+  for (const char* op : kOperators) {
+    EXPECT_FALSE(
+        CPDF_StreamContentParser::IsPathPaintOperatorForTesting(
+            ByteStringView(op)))
+        << op;
+  }
+}
