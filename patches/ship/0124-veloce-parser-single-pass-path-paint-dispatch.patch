+enum class PathPaintOperator : uint8_t {
+  kNone,
+  kCloseFillStroke,
+  kFillStroke,
+  kCloseEvenOddFillStroke,
+  kEvenOddFillStroke,
+  kFill,
+  kFillOld,
+  kEvenOddFill,
+  kEnd,
