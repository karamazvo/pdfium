+bool CPDF_StreamContentParser::HandlePathPaintOperator(ByteStringView op) {
+  switch (DecodePathPaintOperator(op)) {
+    case PathPaintOperator::kCloseFillStroke:
+      Handle_CloseFillStrokePath();
+      return true;
+    case PathPaintOperator::kFillStroke:
+      Handle_FillStrokePath();
+      return true;
+    case PathPaintOperator::kCloseEvenOddFillStroke:
+      Handle_CloseEOFillStrokePath();
+      return true;
+    case PathPaintOperator::kEvenOddFillStroke:
+      Handle_EOFillStrokePath();
+      return true;
+    case PathPaintOperator::kFill:
+      Handle_FillPath();
+      return true;
+    case PathPaintOperator::kFillOld:
+      Handle_FillPathOld();
+      return true;
+    case PathPaintOperator::kEvenOddFill:
+      Handle_EOFillPath();
+      return true;
+    case PathPaintOperator::kEnd:
+      Handle_EndPath();
+      return true;
+    case PathPaintOperator::kCloseStroke:
+      Handle_CloseStrokePath();
+      return true;
+    case PathPaintOperator::kStroke:
+      Handle_StrokePath();
+      return true;
+    case PathPaintOperator::kNone:
+      return false;
+  }
+  return false;
+}
