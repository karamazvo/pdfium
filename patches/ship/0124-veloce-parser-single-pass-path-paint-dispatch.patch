@@ -78,6 +94,42 @@ void ResetOmittedPathPoints(std::vector<CFX_Path::Point>* path_points) {
   }
 }
 
+PathPaintOperator DecodePathPaintOperator(ByteStringView op) {
+  if (op.GetLength() == 1u) {
+    switch (op[0]) {
+      case 'B':
+        return PathPaintOperator::kFillStroke;
+      case 'F':
+        return PathPaintOperator::kFillOld;
+      case 'S':
+        return PathPaintOperator::kStroke;
+      case 'b':
+        return PathPaintOperator::kCloseFillStroke;
+      case 'f':
+        return PathPaintOperator::kFill;
+      case 'n':
+        return PathPaintOperator::kEnd;
+      case 's':
+        return PathPaintOperator::kCloseStroke;
+      default:
+        return PathPaintOperator::kNone;
+    }
+  }
+  if (op.GetLength() != 2u || op[1] != '*') {
+    return PathPaintOperator::kNone;
+  }
+  switch (op[0]) {
+    case 'B':
+      return PathPaintOperator::kEvenOddFillStroke;
+    case 'b':
+      return PathPaintOperator::kCloseEvenOddFillStroke;
+    case 'f':
+      return PathPaintOperator::kEvenOddFill;
+    default:
+      return PathPaintOperator::kNone;
+  }
+}
