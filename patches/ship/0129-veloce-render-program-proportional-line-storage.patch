+TEST(VeloceRenderProgramTest,
+     NativeLineStorageIsProportionalAndPreservesTierBoundaries) {
+  VeloceNativeLineStorage storage;
+  constexpr size_t kLineCount =
+      VeloceNativeLineStorage::kPrefixLines + 1u;
+  for (size_t i = 0u; i < kLineCount; ++i) {
+    VeloceNativeLine line;
+    line.start = CFX_PointF(static_cast<float>(i), 1.0f);
+    line.end = CFX_PointF(static_cast<float>(i + 1u), 2.0f);
+    ASSERT_TRUE(storage.Append(line, kLineCount));
+    if (i == 0u) {
+      EXPECT_EQ(VeloceNativeLineStorage::kFirstChunkLines,
+                storage.allocated_line_capacity());
+      EXPECT_EQ(1u, storage.chunk_count());
+      EXPECT_EQ(0u, storage.dense_chunk_count());
+      EXPECT_LT(storage.EstimatedBytes(),
+                VeloceNativeLineStorage::kDenseChunkLines *
+                    sizeof(VeloceNativeLine));
+    } else if (i == VeloceNativeLineStorage::kFirstChunkLines) {
+      EXPECT_EQ(VeloceNativeLineStorage::kFirstChunkLines +
+                    VeloceNativeLineStorage::kSecondChunkLines,
+                storage.allocated_line_capacity());
+      EXPECT_EQ(2u, storage.chunk_count());
+    } else if (i == VeloceNativeLineStorage::kFirstChunkLines +
+                        VeloceNativeLineStorage::kSecondChunkLines) {
+      EXPECT_EQ(VeloceNativeLineStorage::kFirstChunkLines +
+                    VeloceNativeLineStorage::kSecondChunkLines +
+                    VeloceNativeLineStorage::kThirdChunkLines,
+                storage.allocated_line_capacity());
+      EXPECT_EQ(3u, storage.chunk_count());
+    } else if (i == VeloceNativeLineStorage::kFirstChunkLines +
+                        VeloceNativeLineStorage::kSecondChunkLines +
+                        VeloceNativeLineStorage::kThirdChunkLines) {
+      EXPECT_EQ(VeloceNativeLineStorage::kPrefixLines,
+                storage.allocated_line_capacity());
+      EXPECT_EQ(4u, storage.chunk_count());
+    }
+  }
+
+  EXPECT_EQ(VeloceNativeLineStorage::kPrefixLines +
+                VeloceNativeLineStorage::kDenseChunkLines,
+            storage.allocated_line_capacity());
+  EXPECT_EQ(5u, storage.chunk_count());
+  EXPECT_EQ(1u, storage.dense_chunk_count());
+  for (size_t boundary :
+       {15u, 16u, 79u, 80u, 335u, 336u, 1359u, 1360u}) {
+    EXPECT_EQ(static_cast<float>(boundary), storage.at(boundary).start.x);
+    EXPECT_EQ(static_cast<float>(boundary + 1u),
+              storage.at(boundary).end.x);
+  }
