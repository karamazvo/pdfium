@@ -55,13 +55,16 @@ std::unique_ptr<CPDF_PathObject> MakeOpaqueFill(float translation_x = 0.0f) {
   return path;
 }

-void SetRectClip(CPDF_PathObject* object, const CFX_FloatRect& rect) {
+void SetRectClip(
+    CPDF_PathObject* object,
+    const CFX_FloatRect& rect,
+    CFX_FillRenderOptions::FillType fill_type =
+        CFX_FillRenderOptions::FillType::kWinding) {
   CPDF_Path clip_path;
   clip_path.Emplace();
   clip_path.AppendRect(rect.left, rect.bottom, rect.right, rect.top);
   object->mutable_clip_path().Emplace();
-  object->mutable_clip_path().AppendPath(
-      std::move(clip_path), CFX_FillRenderOptions::FillType::kWinding);
+  object->mutable_clip_path().AppendPath(std::move(clip_path), fill_type);
 }

 bool IsCandidate(pdfium::span<const uint64_t> words, uint32_t ordinal) {
@@ -196,6 +199,48 @@ TEST(VeloceRenderProgramTest, OwnsMultiSegmentStrokeAndExactClipRun) {
             program->clip_runs()[0].clip_path.GetClipBox());
 }

+TEST(VeloceRenderProgramTest,
+     InternsPointerDistinctExactPathOnlyClipRuns) {
+  auto first = MakeOpaqueFill(10.0f);
+  auto second = MakeOpaqueFill(20.0f);
+  SetRectClip(first.get(), CFX_FloatRect(0.0f, 0.0f, 100.0f, 100.0f));
+  SetRectClip(second.get(), CFX_FloatRect(0.0f, 0.0f, 100.0f, 100.0f));
+  ASSERT_FALSE(first->clip_path() == second->clip_path());
+
+  VeloceRenderProgramBuilder builder;
+  builder.AppendPageObject(*first);
+  builder.AppendPageObject(*second);
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(2u, program->native_fill_path_count());
+  ASSERT_EQ(1u, program->clip_runs().size());
+  EXPECT_EQ(0u, program->clip_runs()[0].first_command);
+}
+
+TEST(VeloceRenderProgramTest,
+     PreservesDifferentFillRuleClipRuns) {
+  auto first = MakeOpaqueFill(10.0f);
+  auto second = MakeOpaqueFill(20.0f);
+  auto third = MakeOpaqueFill(30.0f);
+  SetRectClip(first.get(), CFX_FloatRect(0.0f, 0.0f, 100.0f, 100.0f));
+  SetRectClip(second.get(), CFX_FloatRect(0.0f, 0.0f, 100.0f, 100.0f),
+              CFX_FillRenderOptions::FillType::kEvenOdd);
+  SetRectClip(third.get(), CFX_FloatRect(0.0f, 0.0f, 100.0f, 100.0f));
+
+  VeloceRenderProgramBuilder builder;
+  builder.AppendPageObject(*first);
+  builder.AppendPageObject(*second);
+  builder.AppendPageObject(*third);
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  ASSERT_EQ(3u, program->clip_runs().size());
+  EXPECT_EQ(0u, program->clip_runs()[0].first_command);
+  EXPECT_EQ(1u, program->clip_runs()[1].first_command);
+  EXPECT_EQ(2u, program->clip_runs()[2].first_command);
+}
