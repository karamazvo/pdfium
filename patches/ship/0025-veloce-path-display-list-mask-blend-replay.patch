+bool DrawFillPathNodeWithBlendMask(CFX_RenderDevice* device,
+                                   const CFX_Path& path,
+                                   const CFX_Matrix& path_matrix,
+                                   const PathDlPaint& paint,
+                                   const PathDlNode& node,
+                                   const CFX_Matrix& holder_to_device) {
+  FX_RECT rect =
+      holder_to_device.TransformRect(node.holder_space_bbox).GetOuterRect();
+  rect.Intersect(device->GetClipBox());
+  if (rect.IsEmpty()) {
+    return true;
+  }
+  if (!rect.Valid()) {
+    return false;
+  }
+
+  auto mask = pdfium::MakeRetain<CFX_DIBitmap>();
+  if (!mask->Create(rect.Width(), rect.Height(), FXDIB_Format::k8bppMask)) {
+    return false;
+  }
+
+  CFX_DefaultRenderDevice mask_device;
+  if (!mask_device.Attach(mask)) {
+    return false;
+  }
+  mask_device.Clear(0);
+
+  CFX_FillRenderOptions mask_fill_options = paint.fill_options;
+  mask_fill_options.stroke = false;
+  CFX_Matrix mask_matrix = path_matrix;
+  mask_matrix.Translate(-rect.left, -rect.top);
+  if (!mask_device.DrawPath(path, &mask_matrix, nullptr, 0xff000000, 0,
+                            mask_fill_options)) {
+    return false;
+  }
+
+  return device->SetMaskBitsWithBlend(std::move(mask), paint.fill_argb,
+                                      rect.left, rect.top, paint.blend_mode);
+}
