+bool CanDrawBlendNodeWithMask(const PathDlPaint& paint) {
+  return paint.blend_mode != BlendMode::kNormal && paint.stroke_argb == 0 &&
+         paint.fill_options.fill_type !=
+             CFX_FillRenderOptions::FillType::kNoFill;
+}
+
+size_t CountScratchBlendNodes(const NativePathDisplayList& list) {
+  size_t count = 0;
+  for (const PathDlNode& node : list.nodes) {
+    if (node.paint_key >= list.paint_table.size()) {
+      continue;
+    }
+    const PathDlPaint& paint = list.paint_table[node.paint_key];
+    if (paint.blend_mode != BlendMode::kNormal &&
+        !CanDrawBlendNodeWithMask(paint)) {
+      count++;
+    }
+  }
+  return count;
+}
