+bool CFX_RenderDevice::SetMaskBitsWithBlend(RetainPtr<const CFX_DIBBase> mask,
+                                            uint32_t color,
+                                            int left,
+                                            int top,
+                                            BlendMode blend_mode) {
+  DCHECK(mask->IsMaskFormat());
+  if (FXARGB_A(color) == 0) {
+    return true;
+  }
+
+  FX_RECT dest_rect(left, top, left + mask->GetWidth(),
+                    top + mask->GetHeight());
+  dest_rect.Intersect(clip_box_);
+  if (dest_rect.IsEmpty()) {
+    return true;
+  }
+
+  if (blend_mode != BlendMode::kNormal && !render_cap_blend_mode_) {
+    return false;
+  }
+
+  FX_RECT src_rect(dest_rect.left - left, dest_rect.top - top,
+                   dest_rect.left - left + dest_rect.Width(),
+                   dest_rect.top - top + dest_rect.Height());
+  return device_driver_->SetDIBits(std::move(mask), color, src_rect,
+                                   dest_rect.left, dest_rect.top, blend_mode);
+}
