+    const CFX_Matrix matrix(
+        holder_to_device.a, holder_to_device.b, holder_to_device.c,
+        holder_to_device.d,
+        line.translation_x * holder_to_device.a +
+            line.translation_y * holder_to_device.c + holder_to_device.e,
+        line.translation_x * holder_to_device.b +
+            line.translation_y * holder_to_device.d + holder_to_device.f);
+    ASSERT_TRUE(baseline.DrawPath(
+        path, &matrix, &graphics_state, /*fill_color=*/0, kStrokeColor,
+        stroke_options));
+  }
+
+  auto context = compact.CreateOrderedPathBatchContext();
+  ASSERT_TRUE(context);
+  CFX_OrderedPathBatchStats stats;
+  ASSERT_TRUE(compact.DrawCompactTranslationLineBatch(
+      context.get(), lines, holder_to_device, &graphics_state, kStrokeColor,
+      stroke_options, &stats));
+  EXPECT_EQ(lines.size(), stats.source_draws);
+  EXPECT_EQ(lines.size(), stats.raster_passes);
+  EXPECT_EQ(lines.size(), stats.direct_butt_line_draws);
+  EXPECT_EQ(1u, stats.stroke_renderer_builds);
+  EXPECT_EQ(1u, stats.stroke_transform_builds);
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 compact.GetBitmap()->GetBuffer()));
+}
