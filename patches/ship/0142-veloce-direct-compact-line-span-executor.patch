+bool CFX_AggDeviceDriver::DrawCompactTranslationLineBatch(
+    OrderedPathBatchContext* context,
+    pdfium::span<const CFX_CompactTranslationLine> lines,
+    const CFX_Matrix& holder_to_device,
+    const CFX_GraphStateData* stroke_state,
+    uint32_t stroke_color,
+    const CFX_FillRenderOptions& stroke_options,
+    CFX_OrderedPathBatchStats* stats) {
+  static constexpr size_t kMaxCompactLines = 256u;
+  if (lines.empty()) {
+    return true;
+  }
+  if (lines.size() > kMaxCompactLines || !context ||
+      !context->IsOwnedBy(this) || bitmap_->GetBuffer().empty() ||
+      !stroke_state || FXARGB_A(stroke_color) == 0 ||
+      stroke_options.fill_type !=
+          CFX_FillRenderOptions::FillType::kNoFill ||
+      !stroke_options.stroke || stroke_options.zero_area ||
+      stroke_state->line_cap() != CFX_GraphStateData::LineCap::kButt ||
+      !stroke_state->dash_array().empty()) {
+    return false;
+  }
+  if (!std::isfinite(holder_to_device.a) ||
+      !std::isfinite(holder_to_device.b) ||
+      !std::isfinite(holder_to_device.c) ||
+      !std::isfinite(holder_to_device.d) ||
+      !std::isfinite(holder_to_device.e) ||
+      !std::isfinite(holder_to_device.f)) {
+    return false;
+  }
+
+  const float stroke_scale =
+      std::max(fabs(holder_to_device.a), fabs(holder_to_device.b));
+  const float determinant =
+      holder_to_device.a * holder_to_device.d -
+      holder_to_device.b * holder_to_device.c;
+  if (!std::isfinite(stroke_scale) || stroke_scale == 0.0f ||
+      !std::isfinite(determinant) || determinant == 0.0f) {
+    return false;
+  }
+  const CFX_Matrix stroke_to_device(
+      holder_to_device.a / stroke_scale,
+      holder_to_device.b / stroke_scale,
+      holder_to_device.c / stroke_scale,
+      holder_to_device.d / stroke_scale, 0.0f, 0.0f);
+  const CFX_Matrix stroke_to_device_inverse =
+      stroke_to_device.GetInverse();
+  const float device_unit =
+      1.0f /
+      ((stroke_to_device.GetXUnit() + stroke_to_device.GetYUnit()) / 2.0f);
+  const float stroke_width =
+      std::max(stroke_state->line_width() * stroke_scale, device_unit);
+  if (!std::isfinite(stroke_width) || stroke_width <= 0.0f) {
+    return false;
+  }
+
+  const auto object_to_device =
+      [&](const CFX_CompactTranslationLine& line) {
+        return CFX_Matrix(
+            holder_to_device.a, holder_to_device.b, holder_to_device.c,
+            holder_to_device.d,
+            line.translation_x * holder_to_device.a +
+                line.translation_y * holder_to_device.c +
+                holder_to_device.e,
+            line.translation_x * holder_to_device.b +
+                line.translation_y * holder_to_device.d +
+                holder_to_device.f);
+      };
+  std::array<std::array<CFX_PointF, 4>, kMaxCompactLines> stroke_vertices;
+  const float half_width = stroke_width / 2.0f;
+  for (size_t i = 0; i < lines.size(); ++i) {
+    const CFX_CompactTranslationLine& line = lines[i];
+    if (!std::isfinite(line.end.x) || !std::isfinite(line.end.y) ||
+        !std::isfinite(line.translation_x) ||
+        !std::isfinite(line.translation_y) ||
+        line.end == CFX_PointF()) {
+      return false;
+    }
+    const CFX_Matrix object_to_stroke =
+        object_to_device(line) * stroke_to_device_inverse;
+    const CFX_PointF start =
+        HardClip(object_to_stroke.Transform(CFX_PointF()));
+    const CFX_PointF end =
+        HardClip(object_to_stroke.Transform(line.end));
+    const float segment_x = end.x - start.x;
+    const float segment_y = end.y - start.y;
+    const float segment_length = FXSYS_sqrt2(segment_x, segment_y);
+    if (!std::isfinite(segment_length) || segment_length <= 1.0e-14f) {
+      return false;
+    }
+    const float normal_x = segment_y * half_width / segment_length;
+    const float normal_y = segment_x * half_width / segment_length;
+    stroke_vertices[i] = {
+        CFX_PointF(start.x - normal_x, start.y + normal_y),
+        CFX_PointF(start.x + normal_x, start.y - normal_y),
+        CFX_PointF(end.x + normal_x, end.y - normal_y),
+        CFX_PointF(end.x - normal_x, end.y + normal_y)};
+  }
+
+  fill_options_ = stroke_options;
+  RetainPtr<CFX_DIBitmap> backdrop =
+      group_knockout_ ? backdrop_bitmap_ : nullptr;
+  CFX_AggRenderer renderer(bitmap_, backdrop, clip_rgn_.get(), stroke_color,
+                           stroke_options.full_cover, rgb_byte_order_);
+  auto* agg_context = static_cast<AggOrderedPathBatchContext*>(context);
+  CFX_OrderedPathBatchStats packet_stats;
+  packet_stats.source_draws = lines.size();
+  packet_stats.stroke_renderer_builds = 1u;
+  packet_stats.stroke_transform_builds = 1u;
+
+  for (size_t i = 0; i < lines.size(); ++i) {
+    agg_context->rasterizer.reset();
+    agg_context->rasterizer.filling_rule(agg::fill_non_zero);
+    const auto add_transformed_vertex =
+        [&](const CFX_PointF& point, unsigned command) {
+          const CFX_PointF transformed = stroke_to_device.Transform(point);
+          agg_context->rasterizer.add_vertex(
+              transformed.x, transformed.y, command);
+        };
+    add_transformed_vertex(stroke_vertices[i][0], agg::path_cmd_move_to);
+    add_transformed_vertex(stroke_vertices[i][1], agg::path_cmd_line_to);
+    add_transformed_vertex(stroke_vertices[i][2], agg::path_cmd_line_to);
+    add_transformed_vertex(stroke_vertices[i][3], agg::path_cmd_line_to);
+    add_transformed_vertex(
+        CFX_PointF(),
+        static_cast<unsigned>(agg::path_cmd_end_poly) |
+            agg::path_flags_close);
+    agg::render_scanlines(agg_context->rasterizer, agg_context->scanline,
+                          renderer, stroke_options.aliased_path);
+    ++packet_stats.raster_passes;
+    ++packet_stats.direct_butt_line_draws;
+  }
+
+  if (stats) {
+    stats->source_draws += packet_stats.source_draws;
+    stats->raster_passes += packet_stats.raster_passes;
+    stats->stroke_renderer_builds += packet_stats.stroke_renderer_builds;
+    stats->stroke_transform_builds += packet_stats.stroke_transform_builds;
+    stats->direct_butt_line_draws += packet_stats.direct_butt_line_draws;
+  }
+  return true;
+}
