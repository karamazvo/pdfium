+TEST(VeloceRenderProgramTest,
+     ParserTapeCanOwnExactGeneralStrokeAndFillGeometry) {
+  VeloceRenderProgramBuilder builder(
+      0u, CFX_FloatRect(-100.0f, -100.0f, 100.0f, 100.0f));
+  auto stroke = MakeOpaqueStrokePath();
+  auto fill = MakeOpaqueFill();
+
+  ASSERT_TRUE(builder.AppendPageObject(*stroke));
+  ASSERT_TRUE(builder.OmitLastPageObject());
+  ASSERT_TRUE(builder.AppendPageObject(*fill));
+  ASSERT_TRUE(builder.OmitLastPageObject());
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+  ASSERT_TRUE(program);
+  EXPECT_TRUE(program->has_omitted_page_objects());
+  EXPECT_EQ(2u, program->command_count());
+  EXPECT_EQ(0u, program->retained_page_object_count());
+  EXPECT_EQ(1u, program->native_stroke_path_count());
+  EXPECT_EQ(1u, program->native_fill_path_count());
+  EXPECT_EQ(VeloceRenderOpcode::kNativeOpaqueStrokePath,
+            program->native_runs()[0].opcode);
+  EXPECT_EQ(VeloceRenderOpcode::kNativeOpaqueFillPath,
+            program->native_runs()[1].opcode);
+}
