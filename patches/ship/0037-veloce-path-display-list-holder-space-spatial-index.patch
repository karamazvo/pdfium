+uint32_t SpatialIndexCoordToBin(float value,
+                                float min_value,
+                                float span,
+                                uint32_t bin_count) {
+  if (span <= 0 || bin_count == 0 || value <= min_value) {
+    return 0;
+  }
+  const float scaled = (value - min_value) * bin_count / span;
+  if (scaled >= bin_count) {
+    return bin_count - 1;
+  }
+  return static_cast<uint32_t>(scaled);
+}
+
+bool GetSpatialIndexRange(const PathDlSpatialIndex& index,
+                          const CFX_FloatRect& rect,
+                          uint32_t* left_bin,
+                          uint32_t* right_bin,
+                          uint32_t* bottom_bin,
+                          uint32_t* top_bin) {
+  if (!index.valid()) {
+    return false;
+  }
+  CFX_FloatRect clipped = rect;
+  clipped.Normalize();
+  clipped.Intersect(index.bounds);
+  if (clipped.IsEmpty()) {
+    return false;
+  }
+
+  *left_bin = SpatialIndexCoordToBin(clipped.left, index.bounds.left,
+                                     index.bounds.Width(), index.columns);
+  *right_bin = SpatialIndexCoordToBin(clipped.right, index.bounds.left,
+                                      index.bounds.Width(), index.columns);
+  *bottom_bin = SpatialIndexCoordToBin(clipped.bottom, index.bounds.bottom,
+                                       index.bounds.Height(), index.rows);
+  *top_bin = SpatialIndexCoordToBin(clipped.top, index.bounds.bottom,
+                                    index.bounds.Height(), index.rows);
+  return true;
+}
+
+void BuildPathDlSpatialIndex(NativePathDisplayList* list) {
+  if (!list || list->nodes.empty()) {
+    return;
+  }
+
+  bool have_bounds = false;
+  CFX_FloatRect bounds;
+  for (const PathDlNode& node : list->nodes) {
+    CFX_FloatRect rect = node.holder_space_bbox;
+    rect.Normalize();
+    if (rect.IsEmpty()) {
+      continue;
+    }
+    if (have_bounds) {
+      bounds.Union(rect);
+    } else {
+      bounds = rect;
+      have_bounds = true;
+    }
+  }
+  if (!have_bounds || bounds.IsEmpty()) {
+    return;
+  }
+
+  PathDlSpatialIndex index;
+  index.bounds = bounds;
+  index.columns = kSpatialIndexColumns;
+  index.rows = kSpatialIndexRows;
+  index.bins.resize(index.columns * index.rows);
+
+  for (uint32_t node_index = 0; node_index < list->nodes.size();
+       ++node_index) {
+    uint32_t left_bin = 0;
+    uint32_t right_bin = 0;
+    uint32_t bottom_bin = 0;
+    uint32_t top_bin = 0;
+    if (!GetSpatialIndexRange(index, list->nodes[node_index].holder_space_bbox,
+                              &left_bin, &right_bin, &bottom_bin, &top_bin)) {
+      continue;
+    }
+    const uint32_t bin_count =
+        (right_bin - left_bin + 1) * (top_bin - bottom_bin + 1);
+    if (bin_count > kMaxSpatialBinsPerNode) {
+      index.overflow_nodes.push_back(node_index);
+      continue;
+    }
+    for (uint32_t y = bottom_bin; y <= top_bin; ++y) {
+      for (uint32_t x = left_bin; x <= right_bin; ++x) {
+        index.bins[y * index.columns + x].push_back(node_index);
+        index.bin_entries++;
+      }
+    }
+  }
+
+  list->spatial_index = std::move(index);
+}
