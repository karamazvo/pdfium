+struct SpatialReplayQuery {
+  bool use_index = false;
+  std::vector<uint32_t> candidates;
+};
+
+SpatialReplayQuery QuerySpatialIndexForReplay(
+    const NativePathDisplayList& list,
+    const CFX_Matrix& holder_to_device,
+    CFX_RenderDevice* device,
+    PathDlReplayStats* replay_stats) {
+  SpatialReplayQuery query;
+  const PathDlSpatialIndex& index = list.spatial_index;
+  if (!index.valid()) {
+    return query;
+  }
+
+  const int64_t query_start_ns = NowNs();
+  if (replay_stats) {
+    replay_stats->spatial_index_queries++;
+  }
+
+  CFX_FloatRect holder_clip = holder_to_device.GetInverse().TransformRect(
+      CFX_FloatRect(device->GetClipBox()));
+  holder_clip.Normalize();
+
+  uint32_t left_bin = 0;
+  uint32_t right_bin = 0;
+  uint32_t bottom_bin = 0;
+  uint32_t top_bin = 0;
+  if (!GetSpatialIndexRange(index, holder_clip, &left_bin, &right_bin,
+                            &bottom_bin, &top_bin)) {
+    query.use_index = true;
+    if (replay_stats) {
+      replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
+    }
+    return query;
+  }
+
+  const size_t touched_bins =
+      static_cast<size_t>(right_bin - left_bin + 1) *
+      static_cast<size_t>(top_bin - bottom_bin + 1);
+  if (replay_stats) {
+    replay_stats->spatial_index_query_bins += touched_bins;
+  }
+
+  // Broad preview renders touch much of the holder. Keep the old sequential
+  // scan for those cases so r31 does not add sort/dedup overhead when there is
+  // little or no tile culling to gain.
+  if (touched_bins > index.bins.size() / 2) {
+    if (replay_stats) {
+      replay_stats->spatial_index_fallback_full_scan++;
+      replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
+    }
+    return query;
+  }
+
+  query.use_index = true;
+  query.candidates.insert(query.candidates.end(), index.overflow_nodes.begin(),
+                          index.overflow_nodes.end());
+  for (uint32_t y = bottom_bin; y <= top_bin; ++y) {
+    for (uint32_t x = left_bin; x <= right_bin; ++x) {
+      const std::vector<uint32_t>& bin = index.bins[y * index.columns + x];
+      query.candidates.insert(query.candidates.end(), bin.begin(), bin.end());
+    }
+  }
+  std::sort(query.candidates.begin(), query.candidates.end());
+  query.candidates.erase(
+      std::unique(query.candidates.begin(), query.candidates.end()),
+      query.candidates.end());
+
+  if (replay_stats) {
+    replay_stats->spatial_index_candidates += query.candidates.size();
+    replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
+  }
+  return query;
+}
