+// static
+bool VeloceRenderProgramBuilder::CanStartWithParsedOpaqueLine(
+    const CFX_PointF& start,
+    const CFX_PointF& end,
+    const CFX_Matrix& matrix,
+    const CPDF_GraphicStates& states,
+    const CPDF_ContentMarks& content_marks) {
+  if (!IsFinitePoint(start) || !IsFinitePoint(end) ||
+      !IsFiniteMatrix(matrix)) {
+    return false;
+  }
+
+  const CPDF_GeneralState& general_state = states.general_state();
+  if (!general_state.HasRef() ||
+      general_state.GetBlendType() != BlendMode::kNormal ||
+      general_state.GetSoftMask() || general_state.GetTR() ||
+      general_state.GetStrokeAlpha() != 1.0f ||
+      general_state.GetFillOP() || general_state.GetStrokeOP() ||
+      general_state.GetOPMode() != 0) {
+    return false;
+  }
+
+  const CPDF_ColorState& color_state = states.color_state();
+  const CPDF_Color* stroke_color = color_state.GetStrokeColor();
+  if (!color_state.HasRef() || !stroke_color || stroke_color->IsNull() ||
+      stroke_color->IsPattern() ||
+      color_state.GetStrokeColorRef() == 0xffffffffu) {
+    return false;
+  }
+
+  const CFX_GraphState& graph_state = states.graph_state();
+  const CFX_GraphStateData* graph_data = graph_state.GetObject();
+  static const std::vector<float> kEmptyDashes;
+  const std::vector<float>& dashes =
+      graph_data ? graph_data->dash_array() : kEmptyDashes;
+  if (!std::isfinite(graph_state.GetLineWidth()) ||
+      graph_state.GetLineWidth() < 0.0f ||
+      !std::isfinite(graph_state.GetMiterLimit()) ||
+      !std::isfinite(graph_state.GetLineDashPhase()) ||
+      dashes.size() > std::numeric_limits<uint16_t>::max() ||
+      dashes.size() > kMaxDashValues) {
+    return false;
+  }
+  for (float dash : dashes) {
+    if (!std::isfinite(dash) || dash < 0.0f) {
+      return false;
+    }
+  }
+  return content_marks.CountItems() <= kMaxVisibilityMarks;
+}
+
+// static
+bool VeloceRenderProgramBuilder::CanStartWithPageObject(
+    const CPDF_PageObject& object) {
+  const CPDF_PathObject* path = object.AsPath();
+  if (!path || !path->IsActive()) {
+    return false;
+  }
+
+  const CFX_Path* source_path = path->path().GetObject();
+  if (!source_path || !IsFinitePath(*source_path) ||
+      !IsFiniteMatrix(path->matrix())) {
+    return false;
+  }
+
+  if (path->stroke() && path->has_no_filltype()) {
+    if (source_path->GetPoints().size() < 2u) {
+      return false;
+    }
+    const bool is_line = source_path->GetPoints().size() == 2u &&
+                         source_path->GetPoints()[0].IsTypeAndOpen(
+                             CFX_Path::Point::Type::kMove) &&
+                         source_path->GetPoints()[1].IsTypeAndOpen(
+                             CFX_Path::Point::Type::kLine);
+    if (is_line &&
+        path->general_state().GetBlendType() == BlendMode::kNormal) {
+      return CanStartWithParsedOpaqueLine(
+          source_path->GetPoints()[0].point_,
+          source_path->GetPoints()[1].point_, path->matrix(),
+          path->graphic_states(), *path->GetContentMarks());
+    }
+
+    const CPDF_GeneralState& general_state = path->general_state();
+    const BlendMode blend_mode = general_state.GetBlendType();
+    if (!general_state.HasRef() ||
+        (blend_mode != BlendMode::kNormal &&
+         blend_mode != BlendMode::kDarken) ||
+        general_state.GetSoftMask() || general_state.GetTR() ||
+        general_state.GetStrokeAlpha() != 1.0f ||
+        general_state.GetFillOP() || general_state.GetStrokeOP() ||
+        general_state.GetOPMode() != 0) {
+      return false;
+    }
+
+    const CPDF_ColorState& color_state = path->color_state();
+    const CPDF_Color* stroke_color = color_state.GetStrokeColor();
+    if (!color_state.HasRef() || !stroke_color || stroke_color->IsNull() ||
+        stroke_color->IsPattern() ||
+        color_state.GetStrokeColorRef() == 0xffffffffu) {
+      return false;
+    }
+
+    const CFX_GraphState& graph_state = path->graph_state();
+    const CFX_GraphStateData* graph_data = graph_state.GetObject();
+    static const std::vector<float> kEmptyDashes;
+    const std::vector<float>& dashes =
+        graph_data ? graph_data->dash_array() : kEmptyDashes;
+    if (!std::isfinite(graph_state.GetLineWidth()) ||
+        graph_state.GetLineWidth() < 0.0f ||
+        !std::isfinite(graph_state.GetMiterLimit()) ||
+        !std::isfinite(graph_state.GetLineDashPhase()) ||
+        dashes.size() > std::numeric_limits<uint16_t>::max() ||
+        dashes.size() > kMaxDashValues ||
+        source_path->GetPoints().size() > kMaxNativeStrokePathPoints) {
+      return false;
+    }
+    for (float dash : dashes) {
+      if (!std::isfinite(dash) || dash < 0.0f) {
+        return false;
+      }
+    }
+    return path->GetContentMarks()->CountItems() <= kMaxVisibilityMarks;
+  }
+
+  if (path->stroke() ||
+      (!path->has_winding_filltype() &&
+       !path->has_alternate_filltype())) {
+    return false;
+  }
+
+  const CPDF_GeneralState& general_state = path->general_state();
+  if (!general_state.HasRef() ||
+      general_state.GetBlendType() != BlendMode::kNormal ||
+      general_state.GetSoftMask() || general_state.GetTR() ||
+      general_state.GetFillAlpha() != 1.0f || general_state.GetFillOP() ||
+      general_state.GetStrokeOP() || general_state.GetOPMode() != 0) {
+    return false;
+  }
+
+  const CPDF_ColorState& color_state = path->color_state();
+  const CPDF_Color* fill_color = color_state.GetFillColor();
+  return color_state.HasRef() && fill_color && !fill_color->IsNull() &&
+         !fill_color->IsPattern() &&
+         color_state.GetFillColorRef() != 0xffffffffu &&
+         path->GetContentMarks()->CountItems() <= kMaxVisibilityMarks &&
+         source_path->GetPoints().size() <= kMaxNativeFillGeometryPoints;
+}
