+TEST(VeloceRenderProgramTest,
+     SuccessLazyPreflightActivatesOnlyExactNativeCandidates) {
+  auto line = MakeOpaqueLine(1.0f, 3.0f);
+  auto stroke_path = MakeOpaqueStrokePath();
+  auto darken_path = MakeOpaqueStrokePath();
+  darken_path->mutable_general_state().SetBlendType(BlendMode::kDarken);
+  auto fill = MakeOpaqueFill();
+  auto unsupported = MakeOpaqueLine(5.0f, 7.0f);
+  unsupported->set_winding_filltype();
+  auto transparent = MakeOpaqueLine(9.0f, 11.0f);
+  transparent->mutable_general_state().SetStrokeAlpha(0.5f);
+
+  EXPECT_TRUE(
+      VeloceRenderProgramBuilder::CanStartWithPageObject(*line));
+  EXPECT_TRUE(VeloceRenderProgramBuilder::CanStartWithPageObject(
+      *stroke_path));
+  EXPECT_TRUE(VeloceRenderProgramBuilder::CanStartWithPageObject(
+      *darken_path));
+  EXPECT_TRUE(
+      VeloceRenderProgramBuilder::CanStartWithPageObject(*fill));
+  EXPECT_FALSE(VeloceRenderProgramBuilder::CanStartWithPageObject(
+      *unsupported));
+  EXPECT_FALSE(VeloceRenderProgramBuilder::CanStartWithPageObject(
+      *transparent));
+
+  EXPECT_TRUE(VeloceRenderProgramBuilder::CanStartWithParsedOpaqueLine(
+      line->path().GetPoints()[0].point_,
+      line->path().GetPoints()[1].point_, line->matrix(),
+      line->graphic_states(), *line->GetContentMarks()));
+  EXPECT_FALSE(VeloceRenderProgramBuilder::CanStartWithParsedOpaqueLine(
+      transparent->path().GetPoints()[0].point_,
+      transparent->path().GetPoints()[1].point_, transparent->matrix(),
+      transparent->graphic_states(), *transparent->GetContentMarks()));
