+// Returns true when |paint| describes a pure stroke (no fill) with normal
+// blend mode. Stroke-run packing is only equivalent when the original path
+// matrix is preserved through DrawPath(); transforming path coordinates before
+// flush would incorrectly detach stroke width/dash scaling from the CTM.
+bool IsStrokeOnlyNormal(const PathDlPaint& paint) {
+  return paint.blend_mode == BlendMode::kNormal &&
+         paint.fill_options.fill_type == CFX_FillRenderOptions::FillType::kNoFill &&
+         paint.stroke_argb != 0;
