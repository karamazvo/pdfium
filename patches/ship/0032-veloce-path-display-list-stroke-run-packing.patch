+// Returns true when |paint| describes a pure stroke (no fill) with normal
+// blend mode. CFX_Path::Append is safe for stroke-only subpaths: the stroke
+// of a composite path equals the union of strokes of its subpaths because
+// stroke rendering is per-subpath with no winding-rule interaction.
+bool IsStrokeOnlyNormal(const PathDlPaint& paint) {
+  return paint.blend_mode == BlendMode::kNormal &&
+         paint.fill_options.fill_type == CFX_FillRenderOptions::FillType::kNoFill &&
+         paint.stroke_argb != 0;
