+void VeloceRenderProgramBuilder::AppendNativeLineBounds(
+    const CPDF_PageObject& object) {
+  const uint32_t line_index =
+      static_cast<uint32_t>(native_lines_.size() - 1u);
+  const uint32_t command_index = static_cast<uint32_t>(bytecode_.size());
+  if (pending_line_leaf_.line_count == 0u) {
+    pending_line_leaf_.first_line = line_index;
+    pending_line_leaf_.first_command = command_index;
+  }
+  ++pending_line_leaf_.line_count;
+  pending_line_leaf_.command_count =
+      command_index - pending_line_leaf_.first_command + 1u;
+
+  CFX_FloatRect bounds = object.GetRect();
+  bounds.Normalize();
+  const bool bounds_known = IsFiniteRect(bounds) && !bounds.IsEmpty();
+  if (bounds_known) {
+    UnionKnownBounds(bounds, &pending_line_leaf_.bounds);
+    if (!has_native_line_bounds_) {
+      native_line_bounds_ = bounds;
+      has_native_line_bounds_ = true;
+    } else {
+      native_line_bounds_.Union(bounds);
+    }
+  } else {
+    pending_line_leaf_.flags |= kVeloceLineRangeUnbounded;
+    native_line_bounds_known_ = false;
+  }
+
+  if (pending_line_leaf_.line_count == kLineLeafSize) {
+    SealPendingLineLeaf();
+  }
+}
+
+void VeloceRenderProgramBuilder::SealPendingLineLeaf() {
+  if (pending_line_leaf_.line_count == 0u) {
+    return;
+  }
+  const uint32_t leaf_index =
+      static_cast<uint32_t>(line_leaf_ranges_.size());
+  line_leaf_ranges_.push_back(pending_line_leaf_);
+
+  if (pending_coarse_range_.leaf_count == 0u) {
+    pending_coarse_range_.first_leaf = leaf_index;
+  }
+  ++pending_coarse_range_.leaf_count;
+  pending_coarse_range_.line_count += pending_line_leaf_.line_count;
+  if ((pending_line_leaf_.flags & kVeloceLineRangeUnbounded) != 0u) {
+    pending_coarse_range_.flags |= kVeloceLineRangeUnbounded;
+  }
+  if (!pending_line_leaf_.bounds.IsEmpty()) {
+    UnionKnownBounds(pending_line_leaf_.bounds,
+                     &pending_coarse_range_.bounds);
+  }
+  pending_line_leaf_ = VeloceLineLeafRange();
+
+  if (pending_coarse_range_.leaf_count == kCoarseLeafCount) {
+    SealPendingCoarseRange();
+  }
+}
+
+void VeloceRenderProgramBuilder::SealPendingCoarseRange() {
+  if (pending_coarse_range_.leaf_count == 0u) {
+    return;
+  }
+  line_coarse_ranges_.push_back(pending_coarse_range_);
+  pending_coarse_range_ = VeloceLineCoarseRange();
+}
