+TEST(VeloceRenderProgramTest, QueriesOrderedBoundedLineRangesWithoutAllocation) {
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+  for (size_t i = 0; i < 130u; ++i) {
+    const float start_x =
+        i < 64u ? static_cast<float>(i) : 1000.0f + static_cast<float>(i);
+    builder.AppendPageObject(*MakeOpaqueLine(start_x, start_x + 0.5f));
+  }
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(130u, program->native_line_count());
+  ASSERT_EQ(3u, program->line_leaf_ranges().size());
+  ASSERT_EQ(1u, program->line_coarse_ranges().size());
+  EXPECT_EQ(0u, program->line_leaf_ranges()[0].first_line);
+  EXPECT_EQ(4096u, program->line_leaf_ranges()[0].first_command);
+  EXPECT_EQ(64u, program->line_leaf_ranges()[0].command_count);
+  EXPECT_EQ(64u, program->line_leaf_ranges()[0].line_count);
+  EXPECT_EQ(64u, program->line_leaf_ranges()[1].first_line);
+  EXPECT_EQ(4160u, program->line_leaf_ranges()[1].first_command);
+
+  const VeloceLineQueryResult sparse =
+      program->QueryNativeLines(CFX_FloatRect(-10.0f, 0.0f, 200.0f, 10.0f));
+  EXPECT_EQ(64u, sparse.candidate_lines);
+  EXPECT_EQ(66u, sparse.culled_lines);
+  EXPECT_EQ(1u, sparse.coarse_tested);
+  EXPECT_EQ(0u, sparse.coarse_rejected);
+  EXPECT_EQ(3u, sparse.leaves_tested);
+  EXPECT_EQ(2u, sparse.leaves_rejected);
+  EXPECT_FALSE(sparse.full_bounds_hit);
+  EXPECT_FALSE(sparse.fail_open);
+
+  const VeloceLineQueryResult full = program->QueryNativeLines(
+      CFX_FloatRect(-100.0f, -100.0f, 2000.0f, 100.0f));
+  EXPECT_EQ(130u, full.candidate_lines);
+  EXPECT_EQ(0u, full.culled_lines);
+  EXPECT_TRUE(full.full_bounds_hit);
+  EXPECT_EQ(0u, full.coarse_tested);
+
+  const VeloceLineQueryResult empty =
+      program->QueryNativeLines(CFX_FloatRect());
+  EXPECT_EQ(0u, empty.candidate_lines);
+  EXPECT_EQ(130u, empty.culled_lines);
+}
