+TEST(VeloceRenderProgramTest, UnknownLineBoundsFailOpen) {
+  auto line = MakeOpaqueLine(1.0f, 3.0f);
+  line->SetRect(CFX_FloatRect());
+
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+  builder.AppendPageObject(*line);
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  const VeloceLineQueryResult query =
+      program->QueryNativeLines(CFX_FloatRect(100.0f, 100.0f, 200.0f, 200.0f));
+  EXPECT_EQ(1u, query.candidate_lines);
+  EXPECT_EQ(0u, query.culled_lines);
+  EXPECT_TRUE(query.fail_open);
+}
+
 }  // namespace
