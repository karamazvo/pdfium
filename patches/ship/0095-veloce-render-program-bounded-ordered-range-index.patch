+    std::vector<VeloceLineCoarseRange> line_coarse_ranges,
+    const CFX_FloatRect& native_line_bounds,
+    bool native_line_bounds_known)
     : header_{kVeloceRenderProgramFormatVersion,
               static_cast<uint32_t>(bytecode.size()),
               static_cast<uint32_t>(bytecode.size()),
@@ -196,7 +219,78 @@ VeloceRenderProgram::VeloceRenderProgram(
       visibility_runs_(std::move(visibility_runs)),
       rejection_counts_(rejection_counts),
       visibility_scoped_line_count_(visibility_scoped_line_count),
-      inline_translation_line_count_(inline_translation_line_count) {}
+      inline_translation_line_count_(inline_translation_line_count),
+      line_leaf_ranges_(std::move(line_leaf_ranges)),
+      line_coarse_ranges_(std::move(line_coarse_ranges)),
+      native_line_bounds_(native_line_bounds),
+      native_line_bounds_known_(native_line_bounds_known) {}
+
+VeloceLineQueryResult VeloceRenderProgram::QueryNativeLines(
+    const CFX_FloatRect& holder_clip) const {
+  VeloceLineQueryResult result;
+  const uint32_t native_line_count = header_.native_command_count;
+  if (native_line_count == 0u) {
+    return result;
+  }
+  if (!IsFiniteRect(holder_clip)) {
+    result.candidate_lines = native_line_count;
+    result.fail_open = true;
+    return result;
+  }
+  if (holder_clip.IsEmpty()) {
+    result.culled_lines = native_line_count;
+    return result;
+  }
+  if (native_line_bounds_known_ &&
+      holder_clip.Contains(native_line_bounds_)) {
+    result.candidate_lines = native_line_count;
+    result.full_bounds_hit = true;
+    return result;
+  }
+  if (line_leaf_ranges_.empty() || line_coarse_ranges_.empty()) {
+    result.candidate_lines = native_line_count;
+    result.fail_open = true;
+    return result;
+  }
+
+  for (const VeloceLineCoarseRange& coarse : line_coarse_ranges_) {
+    ++result.coarse_tested;
+    const bool coarse_unbounded =
+        (coarse.flags & kVeloceLineRangeUnbounded) != 0u;
+    if (!coarse_unbounded && !RectsIntersect(coarse.bounds, holder_clip)) {
+      ++result.coarse_rejected;
+      result.culled_lines += coarse.line_count;
+      continue;
+    }
+
+    const size_t first_leaf = coarse.first_leaf;
+    const size_t leaf_limit = first_leaf + coarse.leaf_count;
+    CHECK_LE(leaf_limit, line_leaf_ranges_.size());
+    for (size_t leaf_index = first_leaf; leaf_index < leaf_limit;
+         ++leaf_index) {
+      const VeloceLineLeafRange& leaf = line_leaf_ranges_[leaf_index];
+      ++result.leaves_tested;
+      const bool leaf_unbounded =
+          (leaf.flags & kVeloceLineRangeUnbounded) != 0u;
+      result.fail_open |= leaf_unbounded;
+      if (!leaf_unbounded && !RectsIntersect(leaf.bounds, holder_clip)) {
+        ++result.leaves_rejected;
+        result.culled_lines += leaf.line_count;
+      } else {
+        result.candidate_lines += leaf.line_count;
+      }
+    }
+  }
+  CHECK_EQ(static_cast<uint64_t>(result.candidate_lines) +
+               result.culled_lines,
+           native_line_count);
+  return result;
+}
+
+size_t VeloceRenderProgram::RangeIndexBytes() const {
+  return line_leaf_ranges_.capacity() * sizeof(VeloceLineLeafRange) +
+         line_coarse_ranges_.capacity() * sizeof(VeloceLineCoarseRange);
+}
 
