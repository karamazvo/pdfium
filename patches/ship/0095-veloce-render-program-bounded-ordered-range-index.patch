+inline constexpr uint16_t kVeloceLineRangeUnbounded = 1u << 0;
+
+// Native lines remain in exact painter order. Each leaf covers a bounded
+// consecutive line range and the bytecode interval containing that range.
+// Unknown bounds set kVeloceLineRangeUnbounded and therefore fail open.
+struct VeloceLineLeafRange {
+  CFX_FloatRect bounds;
+  uint32_t first_line = 0;
+  uint32_t first_command = 0;
+  uint32_t command_count = 0;
+  uint16_t line_count = 0;
+  uint16_t flags = 0;
+};
+static_assert(sizeof(VeloceLineLeafRange) == 32u);
+
+// A coarse range rejects 4096 consecutive native lines with one comparison
+// when their union is outside the query clip. Intersecting coarse ranges are
+// refined through their ordered leaves without allocating candidate storage.
+struct VeloceLineCoarseRange {
+  CFX_FloatRect bounds;
+  uint32_t first_leaf = 0;
+  uint32_t line_count = 0;
+  uint16_t leaf_count = 0;
+  uint16_t flags = 0;
+};
+static_assert(sizeof(VeloceLineCoarseRange) == 28u);
+
+struct VeloceLineQueryResult {
+  uint32_t candidate_lines = 0;
+  uint32_t culled_lines = 0;
+  uint32_t coarse_tested = 0;
+  uint32_t coarse_rejected = 0;
+  uint32_t leaves_tested = 0;
+  uint32_t leaves_rejected = 0;
+  bool full_bounds_hit = false;
+  bool fail_open = false;
+};
