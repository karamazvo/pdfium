          matrix.d == 1.0f;
 }
 
+bool IsFiniteRect(const CFX_FloatRect& rect) {
+  return std::isfinite(rect.left) && std::isfinite(rect.bottom) &&
+         std::isfinite(rect.right) && std::isfinite(rect.top);
+}
+
+bool RectsIntersect(const CFX_FloatRect& lhs, const CFX_FloatRect& rhs) {
+  return lhs.left <= rhs.right && lhs.right >= rhs.left &&
+         lhs.bottom <= rhs.top && lhs.top >= rhs.bottom;
+}
+
+void UnionKnownBounds(const CFX_FloatRect& source,
+                      CFX_FloatRect* destination) {
+  if (destination->IsEmpty()) {
+    *destination = source;
+  } else {
+    destination->Union(source);
+  }
+}
+
 uint64_t HashMatrix(const CFX_Matrix& matrix) {
   uint64_t hash = kFnvOffsetBasis;
   hash = HashWord(hash, FloatBits(matrix.a));
@@ -182,7 +201,11 @@ VeloceRenderProgram::VeloceRenderProgram(
     std::array<uint32_t, kVeloceNativeLineRejectReasonCount>
         rejection_counts,
