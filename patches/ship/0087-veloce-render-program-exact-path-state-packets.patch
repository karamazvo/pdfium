+    pdfium::span<const CFX_Matrix> object_to_device,
+    const CFX_GraphStateData* pGraphState,
+    uint32_t fill_color,
+    uint32_t stroke_color,
+    const CFX_FillRenderOptions& fill_options) {
+  if (paths.empty()) {
+    return true;
+  }
+  if (paths.size() != object_to_device.size()) {
+    return false;
+  }
+  if (!pGraphState || FXARGB_A(stroke_color) == 0 || fill_color != 0 ||
+      fill_options.fill_type !=
+          CFX_FillRenderOptions::FillType::kNoFill) {
+    return false;
+  }
+  for (const CFX_Path* path : paths) {
+    if (!path) {
+      return false;
+    }
+  }
+  return device_driver_->DrawPathBatch(paths, object_to_device, pGraphState,
+                                       fill_color, stroke_color, fill_options);
+}
