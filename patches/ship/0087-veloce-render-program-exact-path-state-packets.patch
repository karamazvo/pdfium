+bool CPDF_RenderStatus::RenderVeloceDirectPathPacket(
+    pdfium::span<CPDF_PathObject* const> path_objects,
+    const CFX_Matrix& mtObj2Device,
+    VeloceDirectPathPacketMetrics* metrics) {
+  constexpr size_t kMaxPacketCommands = 256;
+  constexpr size_t kMaxPacketPoints = 16u * 1024u;
+
+  if (metrics) {
+    *metrics = {};
+  }
+  if (path_objects.empty()) {
+    return true;
+  }
+  if (!path_objects.front()) {
+    return false;
+  }
+  if (ShouldCancelRender()) {
+    stopped_ = true;
+    return false;
+  }
+
+  // Every packet path is proven clip-free. Reset a clip left by a preceding
+  // canonical command once at the ordered packet boundary, not per path.
+  ProcessClipPath(path_objects.front()->clip_path(), mtObj2Device);
+
+  std::array<CPDF_PathObject*, kMaxPacketCommands> packet_objects;
+  std::array<const CFX_Path*, kMaxPacketCommands> packet_paths;
+  std::array<CFX_Matrix, kMaxPacketCommands> packet_matrices;
+  size_t packet_count = 0;
+  size_t packet_points = 0;
+  const CFX_GraphStateData* packet_graph_state = nullptr;
+  uint32_t packet_stroke_argb = 0;
+  CFX_FillRenderOptions packet_fill_options;
+
+  auto reset_packet = [&]() {
+    packet_count = 0;
+    packet_points = 0;
+    packet_graph_state = nullptr;
+    packet_stroke_argb = 0;
+    packet_fill_options = CFX_FillRenderOptions();
+  };
+
+  auto flush_packet = [&]() -> bool {
+    if (packet_count == 0) {
+      return true;
+    }
+    bool draw_succeeded = false;
+    if (packet_count == 1) {
+      draw_succeeded = device_->DrawPath(
+          *packet_paths[0], &packet_matrices[0], packet_graph_state, 0,
+          packet_stroke_argb, packet_fill_options);
+      if (!draw_succeeded) {
+        cur_obj_ = packet_objects[0];
+        DrawObjWithBackground(packet_objects[0], mtObj2Device);
+        draw_succeeded = !stopped_;
+      }
+    } else {
+      draw_succeeded = device_->DrawPathBatch(
+          pdfium::span(packet_paths).first(packet_count),
+          pdfium::span(packet_matrices).first(packet_count),
+          packet_graph_state, 0, packet_stroke_argb, packet_fill_options);
+    }
+    if (metrics) {
+      metrics->commands += packet_count;
+      ++metrics->dispatches;
+      metrics->max_commands =
+          std::max(metrics->max_commands, packet_count);
+    }
+    reset_packet();
+    return draw_succeeded;
+  };
+
+  for (CPDF_PathObject* path_obj : path_objects) {
+    if (!path_obj || !path_obj->stroke() || !path_obj->has_no_filltype()) {
+      return false;
+    }
+
+    cur_obj_ = path_obj;
+    if (!options_.CheckPageObjectVisible(path_obj)) {
+      continue;
+    }
+
+    const CFX_Path* path = path_obj->path().GetObject();
+    const CFX_GraphStateData* graph_state =
+        path_obj->graph_state().GetObject();
+    CFX_Matrix path_matrix = path_obj->matrix() * mtObj2Device;
+    if (!path || !graph_state || !IsAvailableMatrix(path_matrix)) {
+      if (!flush_packet()) {
+        return false;
+      }
+      if (!RenderVeloceDirectPath(path_obj, mtObj2Device)) {
+        return false;
+      }
+      continue;
+    }
+
+    const uint32_t stroke_argb = GetStrokeArgb(path_obj);
+    CFX_FillRenderOptions fill_options =
+        GetFillOptionsForDrawPathWithBlend(
+            options_.GetOptions(), path_obj,
+            CFX_FillRenderOptions::FillType::kNoFill,
+            /*is_stroke=*/true, type3_char_);
+    if (FXARGB_A(stroke_argb) == 0) {
+      if (!flush_packet()) {
+        return false;
+      }
+      if (!RenderVeloceDirectPath(path_obj, mtObj2Device)) {
+        return false;
+      }
+      continue;
+    }
+    const size_t path_points = path->GetPoints().size();
+    const bool same_state =
+        packet_count == 0 ||
+        (packet_graph_state == graph_state &&
+         packet_stroke_argb == stroke_argb &&
+         packet_fill_options == fill_options);
+    const bool within_capacity =
+        packet_count < kMaxPacketCommands &&
+        path_points <= kMaxPacketPoints -
+                           std::min(packet_points, kMaxPacketPoints);
+    if (!same_state || !within_capacity) {
+      if (metrics) {
+        if (!same_state) {
+          ++metrics->state_flushes;
+        } else {
+          ++metrics->capacity_flushes;
+        }
+      }
+      if (!flush_packet()) {
+        return false;
+      }
+    }
+
+    if (path_points > kMaxPacketPoints) {
+      if (!RenderVeloceDirectPath(path_obj, mtObj2Device)) {
+        return false;
+      }
+      if (metrics) {
+        ++metrics->commands;
+        ++metrics->dispatches;
+        metrics->max_commands = std::max(metrics->max_commands, size_t{1});
+      }
+      continue;
+    }
+
+    if (packet_count == 0) {
+      packet_graph_state = graph_state;
+      packet_stroke_argb = stroke_argb;
+      packet_fill_options = fill_options;
+    }
+    packet_objects[packet_count] = path_obj;
+    packet_paths[packet_count] = path;
+    packet_matrices[packet_count] = path_matrix;
+    ++packet_count;
+    packet_points += path_points;
+  }
+
+  if (!flush_packet()) {
+    return false;
+  }
+  if (ShouldCancelRender()) {
+    stopped_ = true;
+  }
+  return !stopped_;
+}
