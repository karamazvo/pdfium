+bool RasterizeDirectButtStrokeLine(
+    agg::rasterizer_scanline_aa* rasterizer,
+    agg::path_storage* path,
+    const CFX_StrokeLine& line,
+    const CFX_Matrix& object_to_stroke,
+    const CFX_Matrix& stroke_to_device,
+    const CFX_GraphStateData& graph_state,
+    float stroke_scale) {
+  if (graph_state.line_cap() != CFX_GraphStateData::LineCap::kButt ||
+      !graph_state.dash_array().empty() || line.start == line.end) {
+    return false;
+  }
+
+  const CFX_PointF start =
+      HardClip(object_to_stroke.Transform(line.start));
+  const CFX_PointF end = HardClip(object_to_stroke.Transform(line.end));
+  const float segment_x = end.x - start.x;
+  const float segment_y = end.y - start.y;
+  const float segment_length = FXSYS_sqrt2(segment_x, segment_y);
+  if (!std::isfinite(segment_length) || segment_length <= 1.0e-14f) {
+    return false;
+  }
+
+  const float device_unit =
+      1.0f /
+      ((stroke_to_device.GetXUnit() + stroke_to_device.GetYUnit()) / 2.0f);
+  const float stroke_width =
+      std::max(graph_state.line_width() * stroke_scale, device_unit);
+  if (!std::isfinite(stroke_width) || stroke_width <= 0.0f) {
+    return false;
+  }
+
+  // This is the exact four-vertex polygon emitted by AGG's conv_stroke for
+  // one non-degenerate butt-cap segment. Keep the arithmetic and vertex order
+  // aligned with stroke_calc_cap(), then apply the same normalized transform.
+  const float half_width = stroke_width / 2.0f;
+  const float normal_x = segment_y * half_width / segment_length;
+  const float normal_y = segment_x * half_width / segment_length;
+  path->remove_all();
+  path->move_to(start.x - normal_x, start.y + normal_y);
+  path->line_to(start.x + normal_x, start.y - normal_y);
+  path->line_to(end.x + normal_x, end.y - normal_y);
+  path->line_to(end.x - normal_x, end.y + normal_y);
+  path->end_poly();
+  rasterizer->add_path_transformed(*path, &stroke_to_device);
+  return true;
+}
+
