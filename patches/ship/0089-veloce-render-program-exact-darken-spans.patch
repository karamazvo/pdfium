diff --git a/core/fpdfapi/page/veloce_render_program.cpp b/core/fpdfapi/page/veloce_render_program.cpp
index 3d87f4a40..79d869441 100644
--- a/core/fpdfapi/page/veloce_render_program.cpp
+++ b/core/fpdfapi/page/veloce_render_program.cpp
@@ -128,6 +128,29 @@ bool VeloceCanDirectDrawPath(const CPDF_PageObject& object) {
   return true;
 }
 
+bool VeloceCanDirectDrawDarkenPath(const CPDF_PageObject& object) {
+  const CPDF_PathObject* path = object.AsPath();
+  if (!path || path->clip_path().HasRef() || !path->path().GetObject()) {
+    return false;
+  }
+  const bool has_fill = !path->has_no_filltype();
+  const bool has_stroke = path->stroke();
+  if (has_fill == has_stroke) {
+    return false;
+  }
+
+  const CPDF_GeneralState& general_state = path->general_state();
+  if (general_state.GetBlendType() != BlendMode::kDarken ||
+      general_state.GetSoftMask() || general_state.GetTR() ||
+      general_state.GetFillOP() || general_state.GetStrokeOP()) {
+    return false;
+  }
+
+  const CPDF_Color* color = has_fill ? path->color_state().GetFillColor()
+                                     : path->color_state().GetStrokeColor();
+  return color && !color->IsNull() && !color->IsPattern();
+}
