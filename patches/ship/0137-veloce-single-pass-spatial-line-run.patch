-        } else {
-          native_line_bounds_ = bounds;
-        }
-      }
       AppendNativeLineRun(/*translation_origin=*/true,
                           parsed_line_context_->state_index,
                           parsed_line_context_->matrix_index);
       AppendNativeRun(command_index, payload_index, opcode);
-      AppendSpatialOrdinal(command_index, bounds, bounds_known);
       ++opcode_counts_[static_cast<size_t>(opcode)];
       ++inline_translation_line_count_;
       if (content_marks.CountItems() != 0u) {
@@ -2838,6 +2944,14 @@ size_t VeloceRenderProgramBuilder::AppendParsedTranslationOriginLineRun(
       build_start_millis_ = NowMillis();
     }
   }
+  AppendSpatialTranslationOriginLineRun(
+      first_command, lines.first(append_count),
+      parsed_line_context_->line_width, parsed_line_context_->line_cap);
+  if (append_count != 0u) {
+    ++spatial_line_run_count_;
+    spatial_line_run_command_count_ +=
+        static_cast<uint32_t>(append_count);
+  }
   return append_count;
 }
 
