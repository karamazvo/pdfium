+void VeloceRenderProgramBuilder::AppendSpatialTranslationOriginLineRun(
+    uint32_t first_command,
+    pdfium::span<const VeloceParsedTranslationOriginLine> lines,
+    float line_width,
+    CFX_GraphStateData::LineCap line_cap) {
+  VeloceSpatialOrdinalIndexBuilder* spatial_builder = nullptr;
+  if (!spatial_index_abandoned_ && spatial_holder_bounds_.has_value()) {
+    if (!spatial_index_builder_) {
+      spatial_index_builder_ =
+          std::make_unique<VeloceSpatialOrdinalIndexBuilder>(
+              *spatial_holder_bounds_);
+    }
+    spatial_builder = spatial_index_builder_.get();
+  }
+  if (!AppendTranslationOriginRunBoundsAndSpatial(
+          first_command, lines, line_width, line_cap, spatial_builder,
+          &native_line_bounds_)) {
+    spatial_index_builder_.reset();
+    spatial_index_abandoned_ = true;
+  }
+}
