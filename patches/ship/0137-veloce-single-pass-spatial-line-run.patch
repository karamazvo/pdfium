+TEST(VeloceRenderProgramTest,
+     TranslationOriginBatchBuildsOneExactSpatialUnionInSourceOrder) {
+  auto object = MakeOpaqueLine(1.0f, 3.0f);
+  VeloceRenderProgramBuilder builder(
+      0u, CFX_FloatRect(-100.0f, -100.0f, 100.0f, 100.0f));
+  ASSERT_TRUE(builder.AppendParsedOpaqueLine(
+      CFX_PointF(), {3.0f, 4.0f},
+      CFX_Matrix(1.0f, 0.0f, 0.0f, 1.0f, 5.0f, 6.0f),
+      object->graphic_states(), *object->GetContentMarks(),
+      /*stream_fused=*/true, /*translation_origin=*/true));
+  const std::array<VeloceParsedTranslationOriginLine, 3> lines = {{
+      {{7.0f, 8.0f}, 9.0f, 10.0f},
+      {CFX_PointF(), 11.0f, 12.0f},
+      {{-13.0f, -14.0f}, 15.0f, 16.0f},
+  }};
+  EXPECT_EQ(lines.size(), builder.AppendParsedTranslationOriginLineRun(
+                              lines, CFX_Matrix(),
+                              object->graphic_states(),
+                              *object->GetContentMarks()));
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  ASSERT_TRUE(program->spatial_index());
+  EXPECT_EQ(3u, program->spatial_index()->covered_command_count());
+  ASSERT_EQ(1u, program->spatial_index()->blocks().size());
+  const VeloceSpatialCommandBlock& block =
+      program->spatial_index()->blocks()[0];
+  EXPECT_EQ(0u, block.first_command);
+  EXPECT_EQ(4u, block.command_count);
+  EXPECT_EQ(0b1011u, block.candidate_words[0]);
+  ASSERT_TRUE(program->native_line_bounds().has_value());
+  EXPECT_EQ(program->native_line_bounds().value(), block.bounds);
+}
