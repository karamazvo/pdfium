            SealPendingBlock();
   }
 
+  bool AppendAxisAligned(uint32_t command_index,
+                         float left,
+                         float bottom,
+                         float right,
+                         float top,
+                         bool bounds_known) {
+    if (pending_block_.command_count != 0u &&
+        (pending_block_.first_command + pending_block_.command_count !=
+             command_index ||
+         pending_block_.command_count == kCommandsPerBlock) &&
+        !SealPendingBlock()) {
+      return false;
+    }
+    if (pending_block_.command_count == 0u) {
+      pending_block_.first_command = command_index;
+    }
+    const uint16_t block_offset = pending_block_.command_count;
+    pending_block_.candidate_words[block_offset / 64u] |=
+        uint64_t{1} << (block_offset % 64u);
+    ++pending_block_.command_count;
+    if (!bounds_known || left < holder_bounds_.left ||
+        right > holder_bounds_.right || bottom < holder_bounds_.bottom ||
+        top > holder_bounds_.top) {
+      pending_block_.flags |= kVeloceSpatialBlockUnbounded;
+    } else if (pending_block_.bounds.IsEmpty()) {
+      pending_block_.bounds = CFX_FloatRect(left, bottom, right, top);
+    } else {
+      pending_block_.bounds.left =
+          std::min(pending_block_.bounds.left, left);
+      pending_block_.bounds.bottom =
+          std::min(pending_block_.bounds.bottom, bottom);
+      pending_block_.bounds.right =
+          std::max(pending_block_.bounds.right, right);
+      pending_block_.bounds.top =
+          std::max(pending_block_.bounds.top, top);
+    }
+    return pending_block_.command_count != kCommandsPerBlock ||
+           SealPendingBlock();
+  }
+
   std::unique_ptr<const VeloceSpatialOrdinalIndex> Finish(
       uint32_t command_count) {
