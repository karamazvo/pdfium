@@ -397,6 +437,60 @@ class VeloceSpatialOrdinalIndexBuilder final {
   VeloceSpatialCommandBlock pending_block_;
 };
 
+bool AppendTranslationOriginRunBoundsAndSpatial(
+    uint32_t first_command,
+    pdfium::span<const VeloceParsedTranslationOriginLine> lines,
+    float line_width,
+    CFX_GraphStateData::LineCap line_cap,
+    VeloceSpatialOrdinalIndexBuilder* spatial_builder,
+    std::optional<CFX_FloatRect>* native_line_bounds) {
+  const float margin = std::max(0.5f, std::fabs(line_width) * 2.0f);
+  bool spatial_ok = true;
+  for (size_t i = 0u; i < lines.size(); ++i) {
+    const VeloceParsedTranslationOriginLine& line = lines[i];
+    const uint32_t command_index =
+        first_command + static_cast<uint32_t>(i);
+    if (line.end == CFX_PointF() &&
+        line_cap == CFX_GraphStateData::LineCap::kButt) {
+      if (spatial_builder &&
+          !spatial_builder->AppendNoOp(command_index)) {
+        spatial_builder = nullptr;
+        spatial_ok = false;
+      }
+      continue;
+    }
+
+    const float end_x = line.translation_x + line.end.x;
+    const float end_y = line.translation_y + line.end.y;
+    const float left = std::min(line.translation_x, end_x) - margin;
+    const float bottom = std::min(line.translation_y, end_y) - margin;
+    const float right = std::max(line.translation_x, end_x) + margin;
+    const float top = std::max(line.translation_y, end_y) + margin;
+    const bool bounds_known =
+        std::isfinite(left) && std::isfinite(bottom) &&
+        std::isfinite(right) && std::isfinite(top) && left < right &&
+        bottom < top;
+    if (bounds_known && native_line_bounds) {
+      if (!native_line_bounds->has_value()) {
+        *native_line_bounds = CFX_FloatRect(left, bottom, right, top);
+      } else {
+        CFX_FloatRect& aggregate = native_line_bounds->value();
+        aggregate.left = std::min(aggregate.left, left);
+        aggregate.bottom = std::min(aggregate.bottom, bottom);
+        aggregate.right = std::max(aggregate.right, right);
+        aggregate.top = std::max(aggregate.top, top);
+      }
+    }
+    if (spatial_builder &&
+        !spatial_builder->AppendAxisAligned(
+            command_index, left, bottom, right, top, bounds_known)) {
+      spatial_builder = nullptr;
+      spatial_ok = false;
+    }
+  }
+  return spatial_ok;
+}
+
 VeloceSpatialOrdinalIndex::VeloceSpatialOrdinalIndex(
     const CFX_FloatRect& holder_bounds,
     uint32_t command_count,
@@ -1535,7 +1629,8 @@ void VeloceRenderProgramBuilder::AppendNativeLineRun(
