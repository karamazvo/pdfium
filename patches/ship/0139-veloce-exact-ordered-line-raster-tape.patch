diff --git a/core/fxge/cfx_defaultrenderdevice_unittest.cpp b/core/fxge/cfx_defaultrenderdevice_unittest.cpp
index 5d49558ef30da5d6c4130bab989222a92345eaf5..6527f319c43ed0ee8eefc51e424584be3c478d3b 100644
--- a/core/fxge/cfx_defaultrenderdevice_unittest.cpp
+++ b/core/fxge/cfx_defaultrenderdevice_unittest.cpp
@@ -258,6 +258,54 @@ TEST(CFXDefaultRenderDeviceTest,
                                  batched.GetBitmap()->GetBuffer()));
 }
 
+TEST(CFXDefaultRenderDeviceTest,
+     OrderedLineTapePreservesIndependentOverlapCoverage) {
+  CFX_DefaultRenderDevice baseline;
+  CFX_DefaultRenderDevice batched;
+  ASSERT_TRUE(
+      baseline.Create(/*width=*/64, /*height=*/64, FXDIB_Format::kBgra));
+  ASSERT_TRUE(
+      batched.Create(/*width=*/64, /*height=*/64, FXDIB_Format::kBgra));
+  baseline.GetBitmap()->Clear(0xffffffff);
+  batched.GetBitmap()->Clear(0xffffffff);
+
+  CFX_GraphStateData graph_state;
+  graph_state.set_line_width(2.5f);
+  CFX_FillRenderOptions stroke_options;
+  stroke_options.stroke = true;
+  constexpr FX_ARGB kStrokeColor = 0xff204080;
+  const CFX_Matrix matrix(1.25f, 0.0f, 0.0f, 1.25f, 2.0f, 3.0f);
+  const std::array<CFX_OrderedPathDraw, 3> draws = {
+      CFX_OrderedPathDraw{nullptr, {4.0f, 8.0f}, {45.0f, 39.0f}, matrix, 0,
+                          stroke_options},
+      CFX_OrderedPathDraw{nullptr, {4.0f, 8.0f}, {45.0f, 39.0f}, matrix, 0,
+                          stroke_options},
+      CFX_OrderedPathDraw{nullptr, {4.0f, 39.0f}, {45.0f, 8.0f}, matrix, 0,
+                          stroke_options},
+  };
+
+  for (const CFX_OrderedPathDraw& draw : draws) {
+    CFX_Path line;
+    line.AppendLine(draw.line_start, draw.line_end);
+    ASSERT_TRUE(baseline.DrawPath(
+        line, &draw.object_to_device, &graph_state, /*fill_color=*/0,
+        kStrokeColor, draw.fill_options));
+  }
+
+  auto context = batched.CreateOrderedPathBatchContext();
+  ASSERT_TRUE(context);
+  CFX_OrderedPathBatchStats stats;
+  ASSERT_TRUE(batched.DrawOrderedPathBatch(
+      context.get(), draws, &graph_state, kStrokeColor, stroke_options,
+      &stats));
+  EXPECT_EQ(draws.size(), stats.source_draws);
+  EXPECT_EQ(draws.size(), stats.raster_passes);
+  EXPECT_EQ(draws.size(), stats.direct_butt_line_draws);
+  EXPECT_EQ(0u, stats.generic_stroke_draws);
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 batched.GetBitmap()->GetBuffer()));
+}
