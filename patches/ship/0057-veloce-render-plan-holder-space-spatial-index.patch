+
+uint32_t SpatialIndexCoordToBin(float value,
+                                float min_value,
+                                float span,
+                                uint32_t bin_count) {
+  if (span <= 0 || bin_count == 0 || value <= min_value) {
+    return 0;
+  }
+  const float scaled = (value - min_value) * bin_count / span;
+  if (scaled >= bin_count) {
+    return bin_count - 1;
+  }
+  return static_cast<uint32_t>(scaled);
+}
+
+bool GetSpatialIndexRange(const PathDlSpatialIndex& index,
+                          CFX_FloatRect rect,
+                          uint32_t* left_bin,
+                          uint32_t* right_bin,
+                          uint32_t* bottom_bin,
+                          uint32_t* top_bin) {
+  if (!index.valid()) {
+    return false;
+  }
+  rect.Normalize();
+  rect.Intersect(index.bounds);
+  if (rect.IsEmpty()) {
+    return false;
+  }
+
+  *left_bin = SpatialIndexCoordToBin(rect.left, index.bounds.left,
+                                     index.bounds.Width(), index.columns);
+  *right_bin = SpatialIndexCoordToBin(rect.right, index.bounds.left,
+                                      index.bounds.Width(), index.columns);
+  *bottom_bin = SpatialIndexCoordToBin(rect.bottom, index.bounds.bottom,
+                                       index.bounds.Height(), index.rows);
+  *top_bin = SpatialIndexCoordToBin(rect.top, index.bounds.bottom,
+                                    index.bounds.Height(), index.rows);
+  return true;
 }
 
+void BuildPathDlSpatialIndex(NativePathDisplayList* list) {
+  if (!list || list->nodes.size() < kSpatialIndexMinNodes) {
+    return;
+  }
+
+  bool have_bounds = false;
+  CFX_FloatRect bounds;
+  for (const PathDlNode& node : list->nodes) {
+    CFX_FloatRect rect = node.holder_space_bbox;
+    rect.Normalize();
+    if (rect.IsEmpty()) {
+      continue;
+    }
+    if (have_bounds) {
+      bounds.Union(rect);
+    } else {
+      bounds = rect;
+      have_bounds = true;
+    }
+  }
+  if (!have_bounds || bounds.IsEmpty()) {
+    return;
+  }
+
+  PathDlSpatialIndex index;
+  index.bounds = bounds;
+  index.columns = kSpatialIndexColumns;
+  index.rows = kSpatialIndexRows;
+  index.bins.resize(index.columns * index.rows);
+
+  for (uint32_t node_index = 0; node_index < list->nodes.size();
+       ++node_index) {
+    uint32_t left_bin = 0;
+    uint32_t right_bin = 0;
+    uint32_t bottom_bin = 0;
+    uint32_t top_bin = 0;
+    if (!GetSpatialIndexRange(index, list->nodes[node_index].holder_space_bbox,
+                              &left_bin, &right_bin, &bottom_bin, &top_bin)) {
+      continue;
+    }
+    const uint32_t bin_count =
+        (right_bin - left_bin + 1) * (top_bin - bottom_bin + 1);
+    if (bin_count > kMaxSpatialBinsPerNode) {
+      index.overflow_nodes.push_back(node_index);
+      continue;
+    }
+    for (uint32_t y = bottom_bin; y <= top_bin; ++y) {
+      for (uint32_t x = left_bin; x <= right_bin; ++x) {
+        index.bins[y * index.columns + x].push_back(node_index);
+        index.bin_entries++;
+      }
+    }
+  }
+
+  list->spatial_index = std::move(index);
+}
+
 bool CompilePathDisplayListRange(CPDF_RenderStatus* status,
                                  const CPDF_PageObjectHolder* holder,
                                  size_t first_object_index,
@@ -707,9 +847,11 @@ bool CompilePathDisplayListRange(CPDF_RenderStatus* status,
     list->nodes.push_back(std::move(node));
   }
 
-  return !list->nodes.empty()
-             ? true
-             : reject(PathDlRejectReason::kInactiveOrInvisibleOnly);
+  if (list->nodes.empty()) {
+    return reject(PathDlRejectReason::kInactiveOrInvisibleOnly);
+  }
+  BuildPathDlSpatialIndex(list);
+  return true;
 }
 
 bool CompilePathDisplayList(CPDF_RenderStatus* status,
@@ -728,6 +870,95 @@ bool IntersectsDeviceClip(const PathDlNode& node,
                      .GetOuterRect();
   rect.Intersect(device->GetClipBox());
   return !rect.IsEmpty();
+}
+
+bool MatrixIsSafelyInvertible(const CFX_Matrix& matrix) {
+  const float determinant = matrix.a * matrix.d - matrix.b * matrix.c;
+  return determinant > 0.000001f || determinant < -0.000001f;
+}
+
+std::optional<std::vector<uint32_t>> QuerySpatialIndexForReplay(
+    const NativePathDisplayList& list,
+    const CFX_Matrix& holder_to_device,
+    CFX_RenderDevice* device,
+    PathDlReplayStats* replay_stats) {
+  const PathDlSpatialIndex& index = list.spatial_index;
+  if (!index.valid() || !device) {
+    return std::nullopt;
+  }
+
+  const int64_t query_start_ns = NowNs();
+  auto finish_full_scan = [&]() -> std::optional<std::vector<uint32_t>> {
+    if (replay_stats) {
+      replay_stats->spatial_index_fallback_full_scan++;
+      replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
+    }
+    return std::nullopt;
+  };
+
+  if (replay_stats) {
+    replay_stats->spatial_index_queries++;
+  }
+
+  const FX_RECT clip_box = device->GetClipBox();
+  if (clip_box.IsEmpty() || !MatrixIsSafelyInvertible(holder_to_device)) {
+    return finish_full_scan();
+  }
+
+  CFX_FloatRect holder_clip =
+      holder_to_device.GetInverse().TransformRect(CFX_FloatRect(clip_box));
+  holder_clip.Normalize();
+  if (holder_clip.IsEmpty()) {
+    if (replay_stats) {
+      replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
+    }
+    return std::vector<uint32_t>();
+  }
+
+  const float index_area = index.bounds.Width() * index.bounds.Height();
+  const float query_area = holder_clip.Width() * holder_clip.Height();
+  if (index_area <= 0 ||
+      query_area >= index_area * kSpatialIndexBroadQueryAreaRatio) {
+    return finish_full_scan();
+  }
+
+  uint32_t left_bin = 0;
+  uint32_t right_bin = 0;
+  uint32_t bottom_bin = 0;
+  uint32_t top_bin = 0;
+  if (!GetSpatialIndexRange(index, holder_clip, &left_bin, &right_bin,
+                            &bottom_bin, &top_bin)) {
+    if (replay_stats) {
+      replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
+    }
+    return std::vector<uint32_t>();
+  }
+
+  std::vector<uint32_t> candidates;
+  for (uint32_t y = bottom_bin; y <= top_bin; ++y) {
+    for (uint32_t x = left_bin; x <= right_bin; ++x) {
+      const std::vector<uint32_t>& bin = index.bins[y * index.columns + x];
+      candidates.insert(candidates.end(), bin.begin(), bin.end());
+      if (replay_stats) {
+        replay_stats->spatial_index_query_bins++;
+      }
+    }
+  }
+  candidates.insert(candidates.end(), index.overflow_nodes.begin(),
+                    index.overflow_nodes.end());
+
+  std::sort(candidates.begin(), candidates.end());
+  candidates.erase(std::unique(candidates.begin(), candidates.end()),
+                   candidates.end());
+  if (replay_stats) {
+    replay_stats->spatial_index_candidates += candidates.size();
+    replay_stats->spatial_index_skipped_by_tile +=
+        list.nodes.size() >= candidates.size()
+            ? list.nodes.size() - candidates.size()
+            : 0;
+    replay_stats->spatial_index_query_ms += ElapsedMs(query_start_ns);
+  }
+  return candidates;
 }
 
 bool DrawPathNodeWithBlend(CFX_RenderDevice* device,
@@ -879,6 +1109,11 @@ VelocePathDisplayListResult ReplayPathDisplayList(
   // Active consecutive mask run. Non-empty while we are accumulating adjacent
