+       ++replay_index) {
+    if ((replay_index % kCancelCheckNodeInterval) == 0) {
       if (replay_stats) {
         replay_stats->cancel_checks++;
       }
@@ -911,6 +1147,9 @@ VelocePathDisplayListResult ReplayPathDisplayList(
     if (replay_stats) {
       replay_stats->visited_nodes++;
     }
