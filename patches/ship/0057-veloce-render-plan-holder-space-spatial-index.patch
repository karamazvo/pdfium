   // Flush |run| and record the reason. Returns kCancelled on failure.
   auto flush_run = [&](size_t* reason_counter) -> VelocePathDisplayListResult {
@@ -895,8 +1130,9 @@ VelocePathDisplayListResult ReplayPathDisplayList(
     return VelocePathDisplayListResult::kRendered;
   };
 
-  for (uint32_t i = 0; i < list.nodes.size(); ++i) {
-    if ((i % kCancelCheckNodeInterval) == 0) {
