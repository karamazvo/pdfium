+ public:
+  static constexpr size_t kChunkLines = 4096u;
+
+  VeloceNativeLineStorage();
+  VeloceNativeLineStorage(VeloceNativeLineStorage&& other) noexcept;
+  ~VeloceNativeLineStorage();
+
+  VeloceNativeLineStorage(const VeloceNativeLineStorage&) = delete;
+  VeloceNativeLineStorage& operator=(const VeloceNativeLineStorage&) = delete;
+  VeloceNativeLineStorage& operator=(
+      VeloceNativeLineStorage&& other) noexcept;
+
+  bool Append(const VeloceNativeLine& line, size_t max_lines);
+  const VeloceNativeLine& at(size_t index) const;
+  size_t size() const { return size_; }
+  size_t EstimatedBytes() const;
+
+ private:
+  using Chunk = std::array<VeloceNativeLine, kChunkLines>;
+
+  std::vector<std::unique_ptr<Chunk>> chunks_;
+  size_t size_ = 0;
+};
