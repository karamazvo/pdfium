 namespace {
 
+constexpr uint64_t kFnvOffsetBasis = 1469598103934665603ull;
+constexpr uint64_t kFnvPrime = 1099511628211ull;
+
+uint64_t NowMillis() {
+  return static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::milliseconds>(
+          std::chrono::steady_clock::now().time_since_epoch())
+          .count());
+}
+
+uint64_t HashWord(uint64_t hash, uint32_t word) {
+  hash ^= word;
+  return hash * kFnvPrime;
+}
+
+uint32_t FloatBits(float value) {
+  return std::bit_cast<uint32_t>(value);
+}
+
+bool IsFinitePoint(const CFX_PointF& point) {
+  return std::isfinite(point.x) && std::isfinite(point.y);
+}
+
+bool IsFiniteMatrix(const CFX_Matrix& matrix) {
+  return std::isfinite(matrix.a) && std::isfinite(matrix.b) &&
+         std::isfinite(matrix.c) && std::isfinite(matrix.d) &&
+         std::isfinite(matrix.e) && std::isfinite(matrix.f);
+}
+
+uint64_t HashMatrix(const CFX_Matrix& matrix) {
+  uint64_t hash = kFnvOffsetBasis;
+  hash = HashWord(hash, FloatBits(matrix.a));
+  hash = HashWord(hash, FloatBits(matrix.b));
+  hash = HashWord(hash, FloatBits(matrix.c));
+  hash = HashWord(hash, FloatBits(matrix.d));
+  hash = HashWord(hash, FloatBits(matrix.e));
+  return HashWord(hash, FloatBits(matrix.f));
+}
+
+bool SameMatrix(const CFX_Matrix& lhs, const CFX_Matrix& rhs) {
+  return FloatBits(lhs.a) == FloatBits(rhs.a) &&
+         FloatBits(lhs.b) == FloatBits(rhs.b) &&
+         FloatBits(lhs.c) == FloatBits(rhs.c) &&
+         FloatBits(lhs.d) == FloatBits(rhs.d) &&
+         FloatBits(lhs.e) == FloatBits(rhs.e) &&
+         FloatBits(lhs.f) == FloatBits(rhs.f);
+}
+
+uint64_t HashOpaquePathState(const VeloceOpaquePathState& state,
+                             pdfium::span<const float> dashes) {
+  uint64_t hash = kFnvOffsetBasis;
+  hash = HashWord(hash, state.stroke_color_ref);
+  hash = HashWord(hash, FloatBits(state.line_width));
+  hash = HashWord(hash, FloatBits(state.miter_limit));
+  hash = HashWord(hash, FloatBits(state.dash_phase));
+  hash = HashWord(hash, state.dash_count);
+  hash = HashWord(hash, state.line_cap);
+  hash = HashWord(hash, state.line_join);
+  hash = HashWord(hash, state.flags);
+  for (float dash : dashes) {
+    hash = HashWord(hash, FloatBits(dash));
+  }
+  return hash;
+}
+
+bool SameOpaquePathState(const VeloceOpaquePathState& stored,
+                         pdfium::span<const float> stored_dashes,
+                         const VeloceOpaquePathState& candidate,
+                         pdfium::span<const float> candidate_dashes) {
+  if (stored.stroke_color_ref != candidate.stroke_color_ref ||
+      FloatBits(stored.line_width) != FloatBits(candidate.line_width) ||
+      FloatBits(stored.miter_limit) != FloatBits(candidate.miter_limit) ||
+      FloatBits(stored.dash_phase) != FloatBits(candidate.dash_phase) ||
+      stored.dash_count != candidate.dash_count ||
+      stored.line_cap != candidate.line_cap ||
+      stored.line_join != candidate.line_join ||
+      stored.flags != candidate.flags ||
+      stored_dashes.size() != candidate_dashes.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < stored_dashes.size(); ++i) {
+    if (FloatBits(stored_dashes[i]) != FloatBits(candidate_dashes[i])) {
+      return false;
+    }
+  }
+  return true;
+}
