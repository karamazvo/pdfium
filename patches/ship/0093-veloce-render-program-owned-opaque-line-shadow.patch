+
+#include "core/fpdfapi/page/veloce_render_program.h"
+
+#include <memory>
+
+#include "core/fpdfapi/page/cpdf_pathobject.h"
+#include "core/fxge/cfx_path.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+std::unique_ptr<CPDF_PathObject> MakeOpaqueLine(float start_x, float end_x) {
+  auto path = std::make_unique<CPDF_PathObject>();
+  path->SetDefaultStates();
+  path->mutable_general_state().Emplace();
+  path->path().Emplace();
+  path->path().AppendPoint({start_x, 2.0f}, CFX_Path::Point::Type::kMove);
+  path->path().AppendPoint({end_x, 4.0f}, CFX_Path::Point::Type::kLine);
+  path->set_stroke(true);
+  path->set_no_filltype();
+  return path;
+}
+
+void ReachNativeCompileThreshold(VeloceRenderProgramBuilder* builder) {
+  auto canonical_path = MakeOpaqueLine(0.0f, 1.0f);
+  canonical_path->set_winding_filltype();
+  for (size_t i = 0; i < 4096u; ++i) {
+    builder->AppendPageObject(*canonical_path);
+  }
+}
+
+TEST(VeloceRenderProgramTest, OwnsLineGeometryAndInternsExactState) {
+  auto first = MakeOpaqueLine(1.0f, 3.0f);
+  auto second = MakeOpaqueLine(5.0f, 7.0f);
+
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+  builder.AppendPageObject(*first);
+  builder.AppendPageObject(*second);
+  first->path().Transform(CFX_Matrix(2.0f, 0, 0, 2.0f, 0, 0));
+  first.reset();
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+  ASSERT_TRUE(program);
+  EXPECT_EQ(4098u, program->command_count());
+  EXPECT_EQ(2u, program->native_line_count());
+  EXPECT_EQ(1u, program->opaque_path_states().size());
+  EXPECT_EQ(1u, program->path_matrices().size());
+  EXPECT_EQ(1.0f, program->native_line(0).start.x);
+  EXPECT_EQ(3.0f, program->native_line(0).end.x);
+  EXPECT_EQ(VeloceRenderOpcode::kNativeOpaqueLineShadow,
+            static_cast<VeloceRenderOpcode>(program->bytecode()[4096]));
+}
+
+TEST(VeloceRenderProgramTest, UnsupportedPathRemainsCanonicalBarrier) {
+  auto path = MakeOpaqueLine(1.0f, 3.0f);
+  path->set_winding_filltype();
+
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+  builder.AppendPageObject(*path);
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(0u, program->native_line_count());
+  EXPECT_EQ(4097u,
+            program->opcode_count(VeloceRenderOpcode::kCanonicalPath));
+  EXPECT_EQ(VeloceRenderOpcode::kCanonicalPath,
+            static_cast<VeloceRenderOpcode>(program->bytecode()[0]));
+}
+
+TEST(VeloceRenderProgramTest, TransparentPathRemainsCanonicalBarrier) {
+  auto path = MakeOpaqueLine(1.0f, 3.0f);
+  path->mutable_general_state().SetStrokeAlpha(0.5f);
+
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+  builder.AppendPageObject(*path);
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(0u, program->native_line_count());
+  EXPECT_EQ(4097u,
+            program->opcode_count(VeloceRenderOpcode::kCanonicalPath));
+}
+
+}  // namespace
