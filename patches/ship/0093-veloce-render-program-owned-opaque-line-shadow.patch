+
+// Exact source state for one opaque stroke-only path. Dash values live in the
+// program's shared immutable dash table at [dash_offset, dash_count).
+struct VeloceOpaquePathState {
+  uint32_t stroke_color_ref = 0;
+  float line_width = 1.0f;
+  float miter_limit = 10.0f;
+  float dash_phase = 0.0f;
+  uint32_t dash_offset = 0;
+  uint16_t dash_count = 0;
+  uint8_t line_cap = 0;
+  uint8_t line_join = 0;
+  uint8_t flags = 0;
+};
+static_assert(sizeof(VeloceOpaquePathState) == 28u);
+
+// A native line is independent of CPDF_PageObject lifetime. State and matrix
+// indices are 16-bit by design so storage remains bounded and cache-friendly.
+struct VeloceNativeLine {
+  CFX_PointF start;
+  CFX_PointF end;
+  uint16_t state_index = 0;
+  uint16_t matrix_index = 0;
+};
+static_assert(sizeof(VeloceNativeLine) == 20u);
+
+// Fixed-size chunks avoid repeated copies and vector capacity cliffs while
+// preserving O(1) indexed access for the later spatial executor.
