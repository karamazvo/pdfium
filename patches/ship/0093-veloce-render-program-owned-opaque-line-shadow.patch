 VeloceRenderProgramBuilder::~VeloceRenderProgramBuilder() = default;
 
+bool VeloceRenderProgramBuilder::TryAppendNativeOpaqueLine(
+    const CPDF_PageObject& object) {
+  const CPDF_PathObject* path = object.AsPath();
+  if (!path || !path->IsActive() || !path->stroke() ||
+      !path->has_no_filltype() || path->clip_path().HasRef() ||
+      path->GetContentMarks()->CountItems() != 0u) {
+    return false;
+  }
+
+  const CFX_Path* source_path = path->path().GetObject();
+  if (!source_path || source_path->GetPoints().size() != 2u) {
+    return false;
+  }
+  const CFX_Path::Point& start = source_path->GetPoints()[0];
+  const CFX_Path::Point& end = source_path->GetPoints()[1];
+  if (!start.IsTypeAndOpen(CFX_Path::Point::Type::kMove) ||
+      !end.IsTypeAndOpen(CFX_Path::Point::Type::kLine) ||
+      !IsFinitePoint(start.point_) || !IsFinitePoint(end.point_) ||
+      !IsFiniteMatrix(path->matrix())) {
+    return false;
+  }
+
+  const CPDF_GeneralState& general_state = path->general_state();
+  if (!general_state.HasRef() ||
+      general_state.GetBlendType() != BlendMode::kNormal ||
+      general_state.GetSoftMask() || general_state.GetTR() ||
+      general_state.GetStrokeAlpha() != 1.0f ||
+      general_state.GetFillOP() || general_state.GetStrokeOP() ||
+      general_state.GetOPMode() != 0) {
+    return false;
+  }
+
+  const CPDF_ColorState& color_state = path->color_state();
+  const CPDF_Color* stroke_color = color_state.GetStrokeColor();
+  if (!color_state.HasRef() || !stroke_color || stroke_color->IsNull() ||
+      stroke_color->IsPattern()) {
+    return false;
+  }
+  const uint32_t stroke_color_ref = color_state.GetStrokeColorRef();
+  if (stroke_color_ref == 0xffffffffu) {
+    return false;
+  }
+
+  const CFX_GraphState& graph_state = path->graph_state();
+  const CFX_GraphStateData* graph_data = graph_state.GetObject();
+  static const std::vector<float> kEmptyDashes;
+  const std::vector<float>& dashes =
+      graph_data ? graph_data->dash_array() : kEmptyDashes;
+  const float line_width = graph_state.GetLineWidth();
+  const float miter_limit = graph_state.GetMiterLimit();
+  const float dash_phase = graph_state.GetLineDashPhase();
+  if (!std::isfinite(line_width) || line_width < 0.0f ||
+      !std::isfinite(miter_limit) || !std::isfinite(dash_phase) ||
+      dashes.size() > std::numeric_limits<uint16_t>::max()) {
+    return false;
+  }
+  for (float dash : dashes) {
+    if (!std::isfinite(dash) || dash < 0.0f) {
+      return false;
+    }
+  }
+
+  VeloceOpaquePathState candidate_state;
+  candidate_state.stroke_color_ref = stroke_color_ref;
+  candidate_state.line_width = line_width;
+  candidate_state.miter_limit = miter_limit;
+  candidate_state.dash_phase = dash_phase;
+  candidate_state.dash_count = static_cast<uint16_t>(dashes.size());
+  candidate_state.line_cap = static_cast<uint8_t>(graph_state.GetLineCap());
+  candidate_state.line_join = static_cast<uint8_t>(graph_state.GetLineJoin());
+  if (general_state.GetStrokeAdjust()) {
+    candidate_state.flags =
+        static_cast<uint8_t>(VeloceOpaquePathStateFlag::kStrokeAdjust);
+  }
+
+  const uint64_t state_hash = HashOpaquePathState(candidate_state, dashes);
+  std::optional<uint16_t> state_index;
+  const auto state_range = state_indices_.equal_range(state_hash);
+  for (auto it = state_range.first; it != state_range.second; ++it) {
+    const VeloceOpaquePathState& stored = opaque_path_states_[it->second];
+    if (SameOpaquePathState(
+            stored,
+            pdfium::span(dash_values_).subspan(stored.dash_offset,
+                                                stored.dash_count),
+            candidate_state, dashes)) {
+      state_index = it->second;
+      break;
+    }
+  }
+
+  const uint64_t matrix_hash = HashMatrix(path->matrix());
+  std::optional<uint16_t> matrix_index;
+  const auto matrix_range = matrix_indices_.equal_range(matrix_hash);
+  for (auto it = matrix_range.first; it != matrix_range.second; ++it) {
+    if (SameMatrix(path_matrices_[it->second], path->matrix())) {
+      matrix_index = it->second;
+      break;
+    }
+  }
+
+  const bool needs_state = !state_index.has_value();
+  const bool needs_matrix = !matrix_index.has_value();
+  if (native_lines_.size() >= kMaxNativeLines ||
+      (needs_state &&
+       (opaque_path_states_.size() >= kMaxOpaquePathStates ||
+        dash_values_.size() > kMaxDashValues ||
+        dashes.size() > kMaxDashValues - dash_values_.size())) ||
+      (needs_matrix && path_matrices_.size() >= kMaxPathMatrices)) {
+    ++native_budget_fallbacks_;
+    return false;
+  }
+
+  if (needs_matrix) {
+    matrix_index = static_cast<uint16_t>(path_matrices_.size());
+    path_matrices_.push_back(path->matrix());
+    matrix_indices_.emplace(matrix_hash, *matrix_index);
+  }
+  if (needs_state) {
+    candidate_state.dash_offset = static_cast<uint32_t>(dash_values_.size());
+    dash_values_.insert(dash_values_.end(), dashes.begin(), dashes.end());
+    state_index = static_cast<uint16_t>(opaque_path_states_.size());
+    opaque_path_states_.push_back(candidate_state);
+    state_indices_.emplace(state_hash, *state_index);
+  }
+
+  VeloceNativeLine line;
+  line.start = start.point_;
+  line.end = end.point_;
+  line.state_index = *state_index;
+  line.matrix_index = *matrix_index;
+  CHECK(native_lines_.Append(line, kMaxNativeLines));
+  return true;
+}
+
 void VeloceRenderProgramBuilder::AppendPageObject(
     const CPDF_PageObject& object) {
   if (exceeded_budget_) {
     return;
   }
-  if (bytecode_.size() >= kMaxProgramBytes) {
+  if (bytecode_.size() >= kMaxBytecodeBytes) {
     std::vector<uint8_t>().swap(bytecode_);
     opcode_counts_.fill(0u);
+    native_lines_ = VeloceNativeLineStorage();
+    std::vector<VeloceOpaquePathState>().swap(opaque_path_states_);
+    std::vector<CFX_Matrix>().swap(path_matrices_);
+    std::vector<float>().swap(dash_values_);
+    state_indices_.clear();
+    matrix_indices_.clear();
     exceeded_budget_ = true;
     return;
   }
-  const VeloceRenderOpcode opcode = ToCanonicalOpcode(object);
+  const bool compile_native =
+      bytecode_.size() >= kMinNativeCompileCommands;
+  if (compile_native && build_start_millis_ == 0u) {
+    build_start_millis_ = NowMillis();
+  }
+  const VeloceRenderOpcode opcode =
+      compile_native && TryAppendNativeOpaqueLine(object)
+          ? VeloceRenderOpcode::kNativeOpaqueLineShadow
+          : ToCanonicalOpcode(object);
   bytecode_.push_back(static_cast<uint8_t>(opcode));
   ++opcode_counts_[static_cast<size_t>(opcode)];
 }
@@ -61,6 +364,28 @@ VeloceRenderProgramBuilder::Finish() {
   if (exceeded_budget_ || bytecode_.empty()) {
     return nullptr;
   }
-  return std::unique_ptr<const VeloceRenderProgram>(
-      new VeloceRenderProgram(std::move(bytecode_), opcode_counts_));
+  const uint64_t build_millis = build_start_millis_ == 0u
+                                    ? 0u
+                                    : NowMillis() - build_start_millis_;
+  auto program = std::unique_ptr<const VeloceRenderProgram>(
+      new VeloceRenderProgram(
+          std::move(bytecode_), opcode_counts_, std::move(native_lines_),
+          std::move(opaque_path_states_), std::move(path_matrices_),
+          std::move(dash_values_)));
+#if BUILDFLAG(IS_ANDROID)
+  if (program->command_count() >= 4096u) {
+    __android_log_print(
+        ANDROID_LOG_INFO, "VeloceRenderProgram2",
+        "revision=r25-2-0093 mode=shadow commands=%zu nativeOpaqueLines=%zu "
+        "canonicalPaths=%zu states=%zu matrices=%zu dashValues=%zu "
+        "bytes=%zu nativeBudgetFallbacks=%u shadowBuildMs=%llu",
+        program->command_count(), program->native_line_count(),
+        program->opcode_count(VeloceRenderOpcode::kCanonicalPath),
+        program->opaque_path_states().size(), program->path_matrices().size(),
+        program->dash_values().size(), program->EstimatedBytes(),
+        native_budget_fallbacks_,
+        static_cast<unsigned long long>(build_millis));
+  }
+#endif
+  return program;
 }
