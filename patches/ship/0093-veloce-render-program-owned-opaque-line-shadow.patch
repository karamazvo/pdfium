+VeloceNativeLineStorage::VeloceNativeLineStorage() = default;
+VeloceNativeLineStorage::VeloceNativeLineStorage(
+    VeloceNativeLineStorage&& other) noexcept = default;
+VeloceNativeLineStorage::~VeloceNativeLineStorage() = default;
+VeloceNativeLineStorage& VeloceNativeLineStorage::operator=(
+    VeloceNativeLineStorage&& other) noexcept = default;
+
+bool VeloceNativeLineStorage::Append(const VeloceNativeLine& line,
+                                     size_t max_lines) {
+  if (size_ >= max_lines) {
+    return false;
+  }
+  const size_t chunk_index = size_ / kChunkLines;
+  if (chunk_index == chunks_.size()) {
+    chunks_.push_back(std::make_unique<Chunk>());
+  }
+  (*chunks_[chunk_index])[size_ % kChunkLines] = line;
+  ++size_;
+  return true;
+}
+
+const VeloceNativeLine& VeloceNativeLineStorage::at(size_t index) const {
+  CHECK_LT(index, size_);
+  return (*chunks_[index / kChunkLines])[index % kChunkLines];
+}
+
+size_t VeloceNativeLineStorage::EstimatedBytes() const {
+  return chunks_.capacity() * sizeof(std::unique_ptr<Chunk>) +
+         chunks_.size() * sizeof(Chunk);
+}
