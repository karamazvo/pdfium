diff --git a/public/fpdfex_render_skip_mask.h b/public/fpdfex_render_skip_mask.h
new file mode 100644
index 000000000..235682985
--- /dev/null
+++ b/public/fpdfex_render_skip_mask.h
@@ -0,0 +1,55 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#ifndef PUBLIC_FPDFEX_RENDER_SKIP_MASK_H_
+#define PUBLIC_FPDFEX_RENDER_SKIP_MASK_H_
+
+#include <stdint.h>
+
+#include "public/fpdfview.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Object-type bits for FPDFEx_SetRenderSkipMask(). When a bit is set, page
+// objects of that type are walked (counted toward CPDF_RenderStatus's normal
+// bookkeeping) but never drawn -- ProcessObjectNoClip returns early before
+// dispatching to Process{Text,Path,Image,Shading,Form}, and the object is
+// omitted from this render pass entirely (no DrawObjWithBackground call --
+// see core/fpdfapi/render/cpdf_renderstatus.cpp's ProcessObjectNoClip). The
+// output bitmap is therefore complete and well-formed, just missing that
+// object type's pixels within their bboxes (whatever was already in the
+// bitmap at those pixels -- typically the initial fill color -- shows
+// through).
+//
+// v1 defines only the FORM bit (form-deferred first paint). The remaining
+// bit positions are reserved for symmetry with the patches/experiments/0010
+// draft (TEXT/PATH/IMAGE/SHADING/TRANSPARENCY/SOFT_MASK) but are NOT
+// implemented by this patch -- setting them has no effect. Do not rely on
+// them until a future patch documents and implements them.
+#define FPDFEX_RENDER_SKIP_FORM 0x00000010u
+
+// Thread-local skip mask for subsequent FPDF_RenderPageBitmap() /
+// FPDF_RenderPageBitmap_Start() / FPDF_RenderPage_Continue() calls on the
+// calling thread, until changed again. Default 0 (skip nothing -- behavior
+// identical to a libpdfium.so without this patch).
+//
+// Thread-safety: g_skip_mask is `thread_local uint32_t`, mirroring patch
+// 09's `thread_local VeloceRenderCallbacks g_render_callbacks`. Each
+// CPDF_RenderStatus snapshots VeloceGetRenderSkipMask() once at construction
+// time (same pattern patch 09 uses for render_callbacks_), so a render in
+// progress is unaffected by a later FPDFEx_SetRenderSkipMask() call on the
+// same or another thread -- it always sees the value that was current when
+// it started.
+//
+// Callers MUST reset skip_mask to 0 after pass 1 so a later render on the
+// same thread that doesn't intend to skip anything doesn't inherit a stale
+// nonzero mask.
+FPDF_EXPORT void FPDF_CALLCONV FPDFEx_SetRenderSkipMask(uint32_t skip_mask);
+
+#ifdef __cplusplus
+}  // extern "C"
+#endif
+
+#endif  // PUBLIC_FPDFEX_RENDER_SKIP_MASK_H_
