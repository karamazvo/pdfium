 constexpr size_t kMinSpatialIndexCommands = 4096;
 constexpr size_t kMaxSpatialIndexPostings = 4u * 1024u * 1024u;
 constexpr size_t kMaxAlwaysCandidateCommands = 1024u * 1024u;
+constexpr size_t kMaxCompactBoundsBytes = 32u * 1024u * 1024u;
 constexpr uint32_t kMaxBinsPerCommand = 64;
 
 uint64_t MonotonicNanoseconds() {
@@ -98,6 +99,37 @@ bool GetBinRange(const CFX_FloatRect& bounds,
   return true;
 }
 
+uint16_t QuantizeCoordinate(float coordinate,
+                            float minimum,
+                            float span,
+                            bool round_up) {
+  constexpr double kQuantizedMaximum = UINT16_MAX;
+  const double scaled =
+      (static_cast<double>(coordinate) - minimum) * kQuantizedMaximum / span;
+  const double rounded = round_up ? std::ceil(scaled) : std::floor(scaled);
+  return static_cast<uint16_t>(
+      std::clamp(rounded, 0.0, kQuantizedMaximum));
+}
+
+VeloceQuantizedBounds QuantizeBounds(const CFX_FloatRect& holder_bounds,
+                                     CFX_FloatRect rect) {
+  rect.Normalize();
+  return {
+      QuantizeCoordinate(rect.left, holder_bounds.left, holder_bounds.Width(),
+                         /*round_up=*/false),
+      QuantizeCoordinate(rect.bottom, holder_bounds.bottom,
+                         holder_bounds.Height(), /*round_up=*/false),
+      QuantizeCoordinate(rect.right, holder_bounds.left,
+                         holder_bounds.Width(), /*round_up=*/true),
+      QuantizeCoordinate(rect.top, holder_bounds.bottom,
+                         holder_bounds.Height(), /*round_up=*/true),
+  };
+}
+
+VeloceQuantizedBounds FullQuantizedBounds() {
+  return {};
+}
+
 }  // namespace
 
