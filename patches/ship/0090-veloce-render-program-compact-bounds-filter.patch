 }
 
+void VeloceSpatialCandidateCursor::SetBoundsFilter(
+    const VeloceQuantizedBounds* compact_bounds,
+    size_t compact_bounds_count,
+    const VeloceQuantizedBounds& query_bounds,
+    bool enabled) {
+  compact_bounds_ = compact_bounds;
+  compact_bounds_count_ = compact_bounds_count;
+  query_bounds_ = query_bounds;
+  bounds_filter_enabled_ = enabled;
+}
+
+bool VeloceSpatialCandidateCursor::PassesBoundsFilter(
+    uint32_t command_index) {
+  if (!bounds_filter_enabled_) {
+    return true;
+  }
+  if (!compact_bounds_ || command_index >= compact_bounds_count_) {
+    // Structural validation occurs before opening the cursor. If ownership
+    // ever drifts, keep the command rather than risking a false negative.
+    return true;
+  }
+  if (compact_bounds_[command_index].Intersects(query_bounds_)) {
+    return true;
+  }
+  ++bounds_rejected_count_;
+  return false;
+}
