       list && list->spatial_index.valid() ? list->spatial_index.bins.size()
                                           : kZero,
       list && list->spatial_index.valid() ? list->spatial_index.bin_entries
@@ -1147,6 +1164,45 @@ bool FlushGroupRun(CFX_RenderDevice* device,
   return true;
 }
 
+bool IsStrokeOnlyNormal(const PathDlPaint& paint) {
+  return paint.blend_mode == BlendMode::kNormal &&
+         paint.fill_options.fill_type ==
+             CFX_FillRenderOptions::FillType::kNoFill &&
+         paint.stroke_argb != 0;
+}
+
+FX_RECT GetClippedDeviceBounds(const PathDlNode& node,
+                               const CFX_Matrix& holder_to_device,
+                               CFX_RenderDevice* device) {
+  FX_RECT rect =
+      holder_to_device.TransformRect(node.holder_space_bbox).GetOuterRect();
+  rect.Intersect(device->GetClipBox());
+  return rect;
+}
+
+bool DeviceBoundsArePixelDisjoint(const FX_RECT& lhs, const FX_RECT& rhs) {
+  if (lhs.IsEmpty() || rhs.IsEmpty() || !lhs.Valid() || !rhs.Valid()) {
+    return false;
+  }
+  // Keep one full device pixel between batches. This conservatively includes
+  // antialias coverage that can extend beyond geometric stroke bounds.
+  return static_cast<int64_t>(lhs.right) + 1 <= rhs.left ||
+         static_cast<int64_t>(rhs.right) + 1 <= lhs.left ||
+         static_cast<int64_t>(lhs.bottom) + 1 <= rhs.top ||
+         static_cast<int64_t>(rhs.bottom) + 1 <= lhs.top;
+}
+
+void UnionDeviceBounds(FX_RECT* destination, const FX_RECT& source) {
+  if (destination->IsEmpty()) {
+    *destination = source;
+    return;
+  }
+  destination->left = std::min(destination->left, source.left);
+  destination->top = std::min(destination->top, source.top);
+  destination->right = std::max(destination->right, source.right);
+  destination->bottom = std::max(destination->bottom, source.bottom);
+}
+
 VelocePathDisplayListResult ReplayPathDisplayList(
     CPDF_RenderStatus* status,
     const NativePathDisplayList& list,
@@ -1183,6 +1239,66 @@ VelocePathDisplayListResult ReplayPathDisplayList(
     return VelocePathDisplayListResult::kRendered;
   };
 
+  // A stroke batch contains only adjacent, same-state, same-matrix stroke
+  // objects whose conservative device bounds are pairwise disjoint. The
+  // aggregate-bounds check is intentionally stricter than necessary: it gives
+  // an O(1) proof that combining paths cannot change source-over accumulation
+  // or antialias coverage at intersections.
+  std::array<uint32_t, kMaxStrokeBatchNodes> stroke_batch_path_indices;
+  size_t stroke_batch_count = 0;
+  CFX_Matrix stroke_batch_matrix;
+  uint32_t stroke_batch_paint_key = kNoClipKey;
+  FX_RECT stroke_batch_bounds;
+  size_t stroke_batch_points = 0;
+
+  auto reset_stroke_batch = [&]() {
+    stroke_batch_count = 0;
+    stroke_batch_matrix = CFX_Matrix();
+    stroke_batch_paint_key = kNoClipKey;
+    stroke_batch_bounds = FX_RECT();
+    stroke_batch_points = 0;
+  };
+
+  auto flush_stroke_batch = [&]() {
+    if (stroke_batch_count == 0) {
+      return;
+    }
+    const PathDlPaint& paint = list.paint_table[stroke_batch_paint_key];
+    const CFX_GraphStateData* graph_state =
+        paint.graph_state_key == kNoGraphStateKey
+            ? nullptr
+            : &list.graph_state_table[paint.graph_state_key];
+    if (stroke_batch_count == 1) {
+      const CFX_Path* path =
+          list.path_table[stroke_batch_path_indices[0]].GetObject();
+      if (path) {
+        device->DrawPath(*path, &stroke_batch_matrix, graph_state, 0,
+                         paint.stroke_argb, paint.fill_options);
+      }
+    } else {
+      CFX_Path combined_path;
+      for (size_t batch_index = 0; batch_index < stroke_batch_count;
+           ++batch_index) {
+        const uint32_t path_index = stroke_batch_path_indices[batch_index];
+        const CFX_Path* path = list.path_table[path_index].GetObject();
+        if (path) {
+          combined_path.Append(*path, nullptr);
+        }
+      }
+      device->DrawPath(combined_path, &stroke_batch_matrix, graph_state, 0,
+                       paint.stroke_argb, paint.fill_options);
+    }
+    if (replay_stats) {
+      const size_t node_count = stroke_batch_count;
+      replay_stats->stroke_draw_calls++;
+      replay_stats->stroke_nodes += node_count;
+      replay_stats->stroke_dispatches_saved += node_count - 1;
+      replay_stats->max_stroke_batch_nodes =
+          std::max(replay_stats->max_stroke_batch_nodes, node_count);
+    }
+    reset_stroke_batch();
+  };
+
   size_t replay_candidate_index = 0;
   for (size_t replay_index = 0; replay_index < list.nodes.size();
        ++replay_index) {
@@ -1199,6 +1315,7 @@ VelocePathDisplayListResult ReplayPathDisplayList(
         // P2: cancelled output is discarded — do not flush partial run into
         // the bitmap. Just reset and return kCancelled immediately.
         run.reset();
+        reset_stroke_batch();
         return VelocePathDisplayListResult::kCancelled;
       }
     }
@@ -1214,8 +1331,9 @@ VelocePathDisplayListResult ReplayPathDisplayList(
       continue;
     }
 
-    // Clip change: flush run before installing new clip state.
+    // Clip changes are hard ordered barriers for both batching mechanisms.
     if (!have_clip_state || current_clip_key != node.clip_key) {
+      flush_stroke_batch();
       if (auto r = flush_run(replay_stats
                                  ? &replay_stats->run_flush_clip_change
                                  : nullptr);
@@ -1241,7 +1359,11 @@ VelocePathDisplayListResult ReplayPathDisplayList(
       if (replay_stats) {
         replay_stats->missing_path_nodes++;
       }
-      continue;
+      // Compiled path ownership should make this impossible. Do not batch
+      // across an unknown ordered object or publish incomplete output.
+      run.reset();
+      reset_stroke_batch();
+      return VelocePathDisplayListResult::kCancelled;
     }
     CFX_Matrix path_matrix = node.path_to_holder * holder_to_device;
     const CFX_GraphStateData* graph_state =
@@ -1249,9 +1371,57 @@ VelocePathDisplayListResult ReplayPathDisplayList(
             ? nullptr
             : &list.graph_state_table[paint.graph_state_key];
 
-    if (paint.blend_mode == BlendMode::kNormal) {
-      // Normal node: flush pending run first (blend must composite before
-      // the normal node paints over it), then draw directly.
+    if (IsStrokeOnlyNormal(paint)) {
+      // Any preceding blend group must composite before this normal stroke.
+      if (auto r = flush_run(replay_stats
+                                 ? &replay_stats->run_flush_normal_node
+                                 : nullptr);
+          r != VelocePathDisplayListResult::kRendered) {
+        return r;
+      }
+
+      const FX_RECT node_bounds =
+          GetClippedDeviceBounds(node, holder_to_device, device);
+      const size_t node_points = path->GetPoints().size();
+      if (stroke_batch_count > 0) {
+        const bool same_state = node.paint_key == stroke_batch_paint_key &&
+                                path_matrix == stroke_batch_matrix;
+        const bool within_capacity =
+            stroke_batch_count < kMaxStrokeBatchNodes &&
+            node_points <= kMaxStrokeBatchPoints -
+                               std::min(stroke_batch_points,
+                                        kMaxStrokeBatchPoints);
+        const bool disjoint = DeviceBoundsArePixelDisjoint(
+            stroke_batch_bounds, node_bounds);
+        if (!same_state || !within_capacity || !disjoint) {
+          if (replay_stats && same_state && within_capacity && !disjoint) {
+            replay_stats->stroke_overlap_flushes++;
+          }
+          if (replay_stats && same_state && !within_capacity) {
+            replay_stats->stroke_capacity_flushes++;
+          }
+          flush_stroke_batch();
+        }
+      }
+      if (stroke_batch_count == 0) {
+        stroke_batch_matrix = path_matrix;
+        stroke_batch_paint_key = node.paint_key;
+        stroke_batch_bounds = node_bounds;
+      } else {
+        UnionDeviceBounds(&stroke_batch_bounds, node_bounds);
+      }
+      stroke_batch_path_indices[stroke_batch_count++] = node.path_index;
+      stroke_batch_points += node_points;
+      if (node_points > kMaxStrokeBatchPoints) {
+        // Oversized paths remain individual draws and never inflate a batch.
+        if (replay_stats) {
+          replay_stats->stroke_capacity_flushes++;
+        }
+        flush_stroke_batch();
+      }
+    } else if (paint.blend_mode == BlendMode::kNormal) {
+      // Fills and fill+stroke objects are hard painter-order barriers.
+      flush_stroke_batch();
       if (auto r = flush_run(replay_stats
                                  ? &replay_stats->run_flush_normal_node
                                  : nullptr);
@@ -1262,7 +1432,8 @@ VelocePathDisplayListResult ReplayPathDisplayList(
                        paint.stroke_argb, paint.fill_options);
 
     } else if (CanDrawBlendNodeWithMask(paint)) {
-      // Mask-eligible blend node. Flush if the paint key changes.
+      // Blend objects are hard painter-order barriers for stroke batches.
+      flush_stroke_batch();
       if (!run.empty() && run.paint_key != node.paint_key) {
         if (auto r = flush_run(replay_stats
                                    ? &replay_stats->run_flush_paint_change
@@ -1293,7 +1464,8 @@ VelocePathDisplayListResult ReplayPathDisplayList(
       }
 
     } else {
-      // Scratch-blend or unsupported: flush run, then draw via per-node BGRA.
+      // Scratch-blend or unsupported objects are hard ordered barriers.
+      flush_stroke_batch();
       if (auto r = flush_run(replay_stats
                                  ? &replay_stats->run_flush_scratch_blend
                                  : nullptr);
@@ -1311,7 +1483,8 @@ VelocePathDisplayListResult ReplayPathDisplayList(
     }
   }
 
-  // Flush any run remaining after the last node.
+  // Flush ordered work remaining after the last node.
+  flush_stroke_batch();
   if (auto r = flush_run(replay_stats ? &replay_stats->run_flush_end : nullptr);
       r != VelocePathDisplayListResult::kRendered) {
     return r;
@@ -1411,6 +1584,12 @@ VelocePathDisplayListResult VeloceReplayCompiledPathDisplayList(
     metrics->visited_nodes = replay_stats.visited_nodes;
     metrics->culled_nodes = replay_stats.culled_nodes;
     metrics->drawn_nodes = replay_stats.drawn_nodes;
+    metrics->stroke_draw_calls = replay_stats.stroke_draw_calls;
+    metrics->stroke_nodes = replay_stats.stroke_nodes;
+    metrics->stroke_dispatches_saved = replay_stats.stroke_dispatches_saved;
+    metrics->max_stroke_batch_nodes = replay_stats.max_stroke_batch_nodes;
+    metrics->stroke_overlap_flushes = replay_stats.stroke_overlap_flushes;
+    metrics->stroke_capacity_flushes = replay_stats.stroke_capacity_flushes;
     metrics->spatial_index_queries = replay_stats.spatial_index_queries;
     metrics->spatial_index_query_bins = replay_stats.spatial_index_query_bins;
     metrics->spatial_index_candidates = replay_stats.spatial_index_candidates;
