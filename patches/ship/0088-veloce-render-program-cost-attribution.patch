+class ScopedNanosecondTimer final {
+ public:
+  explicit ScopedNanosecondTimer(uint64_t* elapsed_ns)
+      : elapsed_ns_(elapsed_ns),
+        started_ns_(elapsed_ns ? MonotonicNanoseconds() : 0) {}
+
+  ~ScopedNanosecondTimer() {
+    if (elapsed_ns_) {
+      *elapsed_ns_ = MonotonicNanoseconds() - started_ns_;
+    }
+  }
+
+ private:
+  uint64_t* const elapsed_ns_;
+  const uint64_t started_ns_;
