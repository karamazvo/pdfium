+    case VeloceUnifiedRenderResult::kNotEligible:
+      return "not_eligible";
+    case VeloceUnifiedRenderResult::kRendered:
+      return "rendered";
+    case VeloceUnifiedRenderResult::kCancelled:
+      return "cancelled";
+  }
+  return "unknown";
+}
