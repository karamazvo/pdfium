+      metrics.text_commands, metrics.candidate_postings, metrics.queried_bins,
+      metrics.candidate_streams, metrics.candidate_linear_replay,
+      metrics.candidate_commands, metrics.candidate_chunks,
+      metrics.visited_commands, metrics.drawn_commands, rejected_commands,
+      metrics.dispatch_count, metrics.direct_path_commands,
+      metrics.path_packet_commands, metrics.path_packet_dispatches,
+      metrics.path_packet_state_flushes,
+      metrics.path_packet_capacity_flushes, metrics.max_path_packet_commands,
+      metrics.program_bytes, metrics.index_bytes, metrics.index_postings,
+      metrics.always_candidate_commands, metrics.scratch_bytes);
