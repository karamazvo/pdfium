+VeloceUnifiedRenderResult VeloceTryRenderUnifiedProgramMeasured(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    const CFX_Matrix& holder_to_device) {
+#if BUILDFLAG(IS_ANDROID)
+  if (!holder || holder->GetPageObjectCount() < kTelemetryMinCommands) {
+    return VeloceTryRenderUnifiedProgram(status, holder, holder_to_device,
+                                         nullptr);
+  }
+
+  VeloceUnifiedRenderMetrics metrics;
+  const uint64_t started_ns = MonotonicNanoseconds();
+  const VeloceUnifiedRenderResult result = VeloceTryRenderUnifiedProgram(
+      status, holder, holder_to_device, &metrics);
+  metrics.total_ns = MonotonicNanoseconds() - started_ns;
+  LogMeasuredResult(holder, result, metrics);
+  return result;
+#else
+  return VeloceTryRenderUnifiedProgram(status, holder, holder_to_device,
+                                       nullptr);
+#endif
+}
