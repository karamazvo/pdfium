+    case VeloceUnifiedFallbackReason::kUnsupportedCommandKinds:
+      return "unsupported_kinds";
+    case VeloceUnifiedFallbackReason::kSpatialQueryFallback:
+      return "spatial_query_fallback";
+  }
+  return "unknown";
+}
