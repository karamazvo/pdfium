+  ASSERT_TRUE(
+      baseline.Create(/*width=*/64, /*height=*/64, FXDIB_Format::kBgra));
+  ASSERT_TRUE(
+      batched.Create(/*width=*/64, /*height=*/64, FXDIB_Format::kBgra));
+  baseline.GetBitmap()->Clear(0xffffffff);
+  batched.GetBitmap()->Clear(0xffffffff);
+
+  constexpr uint32_t kStrokeColor = 0x80204080;
+  CFX_GraphStateData graphics_state;
+  graphics_state.set_line_width(3.0f);
+  CFX_FillRenderOptions stroke_options;
+  stroke_options.stroke = true;
+  const std::array<CFX_OrderedPathDraw, 2> draws = {
+      CFX_OrderedPathDraw{nullptr, {4.0f, 4.0f}, {58.0f, 58.0f},
+                          CFX_Matrix(), 0, stroke_options},
+      CFX_OrderedPathDraw{nullptr, {4.0f, 58.0f}, {58.0f, 4.0f},
+                          CFX_Matrix(), 0, stroke_options},
+  };
+
+  for (const CFX_OrderedPathDraw& draw : draws) {
+    CFX_Path line;
+    line.AppendLine(draw.line_start, draw.line_end);
+    ASSERT_TRUE(baseline.DrawPath(
+        line, &draw.object_to_device, &graphics_state, /*fill_color=*/0,
+        kStrokeColor, draw.fill_options));
+  }
+
+  auto context = batched.CreateOrderedPathBatchContext();
+  ASSERT_TRUE(context);
+  CFX_OrderedPathBatchStats stats;
+  ASSERT_TRUE(batched.DrawOrderedPathBatch(
+      context.get(), draws, &graphics_state, kStrokeColor, stroke_options,
+      &stats));
+  EXPECT_EQ(draws.size(), stats.source_draws);
+  EXPECT_EQ(draws.size(), stats.raster_passes);
+  EXPECT_EQ(0u, stats.coalesced_source_draws);
+  EXPECT_EQ(0u, stats.coalesced_raster_passes);
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 batched.GetBitmap()->GetBuffer()));
+}
