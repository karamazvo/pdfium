+void CPDF_Form::EnsureCanonicalPageObjects() const {
+  if (GetParseState() != ParseState::kParsed ||
+      !HasVeloceOmittedPageObjects()) {
+    return;
+  }
+
+  CPDF_Form* form = const_cast<CPDF_Form*>(this);
+  form->BeginVeloceCanonicalReparse();
+  form->veloce_cached_content_bbox_.reset();
+  form->StartParse(std::make_unique<CPDF_ContentParser>(
+      form->GetStream(), form,
+      form->veloce_initial_states_ ? &*form->veloce_initial_states_ : nullptr,
+      form->veloce_parent_matrix_ ? &*form->veloce_parent_matrix_ : nullptr,
+      nullptr, &form->recursion_state_));
+  form->DisableVeloceRenderProgramRecordingForCurrentParse();
+  form->ContinueParse(nullptr);
+  form->EndVeloceCanonicalReparse();
