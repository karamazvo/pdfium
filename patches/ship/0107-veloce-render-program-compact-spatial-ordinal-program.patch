+size_t FindNextVeloceCandidate(pdfium::span<const uint64_t> words,
+                               size_t first,
+                               size_t limit) {
+  if (first >= limit) {
+    return limit;
+  }
+  size_t word_index = first / 64u;
+  uint64_t word =
+      words[word_index] & (~uint64_t{0} << (first % 64u));
+  while (true) {
+    if (word != 0u) {
+      const size_t candidate =
+          word_index * 64u + std::countr_zero(word);
+      return std::min(candidate, limit);
+    }
+    ++word_index;
+    first = word_index * 64u;
+    if (first >= limit || word_index >= words.size()) {
+      return limit;
+    }
+    word = words[word_index];
+  }
+}
