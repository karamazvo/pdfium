+class VeloceSpatialOrdinalIndexBuilder final {
+ public:
+  static constexpr size_t kMaxPostings = 4u * 1024u * 1024u;
+  static constexpr size_t kMaxAlwaysCandidates = 1024u * 1024u;
+  static constexpr uint32_t kMaxBinsPerCommand = 64u;
+
+  explicit VeloceSpatialOrdinalIndexBuilder(CFX_FloatRect holder_bounds)
+      : holder_bounds_(holder_bounds) {
+    holder_bounds_.Normalize();
+  }
+
+  bool Append(uint32_t command_index,
+              const CFX_FloatRect& object_bounds,
+              bool bounds_known) {
+    if (!bounds_known || !IsFiniteRect(object_bounds) ||
+        object_bounds.IsEmpty() ||
+        !RectContains(holder_bounds_, object_bounds)) {
+      return AppendAlwaysCandidate(command_index);
+    }
+
+    uint32_t left = 0u;
+    uint32_t right = 0u;
+    uint32_t bottom = 0u;
+    uint32_t top = 0u;
+    if (!GetBinRange(holder_bounds_, object_bounds, &left, &right, &bottom,
+                     &top)) {
+      return AppendAlwaysCandidate(command_index);
+    }
+    const uint32_t bin_count =
+        (right - left + 1u) * (top - bottom + 1u);
+    if (bin_count > kMaxBinsPerCommand) {
+      return AppendAlwaysCandidate(command_index);
+    }
+    if (posting_count_ > kMaxPostings - bin_count) {
+      return false;
+    }
+
+    for (uint32_t row = bottom; row <= top; ++row) {
+      for (uint32_t column = left; column <= right; ++column) {
+        bins_[row * VeloceSpatialOrdinalIndex::kColumns + column].push_back(
+            command_index);
+        ++posting_count_;
+      }
+    }
+    return true;
+  }
+
+  std::unique_ptr<const VeloceSpatialOrdinalIndex> Finish(
+      uint32_t command_count) {
+    std::vector<VeloceSpatialCell> cells;
+    std::vector<uint32_t> ordinals;
+    cells.reserve(VeloceSpatialOrdinalIndex::kBinCount);
+    ordinals.reserve(posting_count_);
+    for (size_t bin = 0u; bin < bins_.size(); ++bin) {
+      const std::vector<uint32_t>& source = bins_[bin];
+      if (source.empty()) {
+        continue;
+      }
+      cells.push_back(
+          {static_cast<uint32_t>(ordinals.size()),
+           static_cast<uint32_t>(source.size()), static_cast<uint16_t>(bin),
+           0u});
+      ordinals.insert(ordinals.end(), source.begin(), source.end());
+    }
+    return std::unique_ptr<const VeloceSpatialOrdinalIndex>(
+        new VeloceSpatialOrdinalIndex(
+            holder_bounds_, command_count, std::move(cells),
+            std::move(ordinals), std::move(always_candidate_ordinals_)));
+  }
+
+ private:
+  bool AppendAlwaysCandidate(uint32_t command_index) {
+    if (always_candidate_ordinals_.size() >= kMaxAlwaysCandidates) {
+      return false;
+    }
+    always_candidate_ordinals_.push_back(command_index);
+    return true;
+  }
+
+  CFX_FloatRect holder_bounds_;
+  std::array<std::vector<uint32_t>,
+             VeloceSpatialOrdinalIndex::kBinCount>
+      bins_;
+  std::vector<uint32_t> always_candidate_ordinals_;
+  size_t posting_count_ = 0u;
+};
+
+VeloceSpatialOrdinalIndex::VeloceSpatialOrdinalIndex(
+    const CFX_FloatRect& holder_bounds,
+    uint32_t command_count,
+    std::vector<VeloceSpatialCell> cells,
+    std::vector<uint32_t> ordinals,
+    std::vector<uint32_t> always_candidate_ordinals)
+    : holder_bounds_(holder_bounds),
+      command_count_(command_count),
+      cells_(std::move(cells)),
+      ordinals_(std::move(ordinals)),
+      always_candidate_ordinals_(std::move(always_candidate_ordinals)) {}
+
+VeloceSpatialQueryResult VeloceSpatialOrdinalIndex::MarkCandidates(
+    const CFX_FloatRect& holder_clip,
+    std::vector<uint64_t>* candidate_words) const {
+  VeloceSpatialQueryResult result;
+  if (!candidate_words || !IsFiniteRect(holder_clip)) {
+    return result;
+  }
+  if (holder_clip.IsEmpty()) {
+    result.mode = VeloceSpatialQueryMode::kNoCandidates;
+    candidate_words->clear();
+    return result;
+  }
+  if (RectContains(holder_clip, holder_bounds_)) {
+    candidate_words->clear();
+    return result;
+  }
+
+  const size_t word_count = (command_count_ + 63u) / 64u;
+  candidate_words->assign(word_count, 0u);
+  const auto mark_ordinal = [&](uint32_t ordinal) {
+    if (ordinal >= command_count_) {
+      return false;
+    }
+    uint64_t& word = (*candidate_words)[ordinal / 64u];
+    const uint64_t mask = uint64_t{1} << (ordinal % 64u);
+    if ((word & mask) == 0u) {
+      word |= mask;
+      ++result.candidate_commands;
+    }
+    ++result.postings_marked;
+    return true;
+  };
+  for (uint32_t ordinal : always_candidate_ordinals_) {
+    if (!mark_ordinal(ordinal)) {
+      candidate_words->clear();
+      return VeloceSpatialQueryResult();
+    }
+  }

+  uint32_t left = 0u;
+  uint32_t right = 0u;
+  uint32_t bottom = 0u;
+  uint32_t top = 0u;
+  const bool has_bin_range = GetBinRange(holder_bounds_, holder_clip, &left,
+                                         &right, &bottom, &top);
+  for (const VeloceSpatialCell& cell : cells_) {
+    ++result.bins_tested;
+    const uint32_t row =
+        cell.bin_index / VeloceSpatialOrdinalIndex::kColumns;
+    const uint32_t column =
+        cell.bin_index % VeloceSpatialOrdinalIndex::kColumns;
+    if (!has_bin_range || column < left || column > right || row < bottom ||
+        row > top) {
+      continue;
+    }
+    ++result.bins_selected;
+    if (cell.first_ordinal > ordinals_.size() ||
+        cell.ordinal_count > ordinals_.size() - cell.first_ordinal) {
+      candidate_words->clear();
+      return VeloceSpatialQueryResult();
+    }
+    const size_t ordinal_limit =
+        static_cast<size_t>(cell.first_ordinal) + cell.ordinal_count;
+    for (size_t i = cell.first_ordinal; i < ordinal_limit; ++i) {
+      if (!mark_ordinal(ordinals_[i])) {
+        candidate_words->clear();
+        return VeloceSpatialQueryResult();
+      }
+    }
+  }
+  result.mode = result.candidate_commands == 0u
+                    ? VeloceSpatialQueryMode::kNoCandidates
+                    : VeloceSpatialQueryMode::kCandidates;
+  return result;
+}
+
+bool VeloceSpatialOrdinalIndex::is_valid() const {
+  if (command_count_ == 0u || !IsFiniteRect(holder_bounds_) ||
+      holder_bounds_.IsEmpty()) {
+    return false;
+  }
+  size_t expected_ordinal = 0u;
+  uint16_t previous_bin = 0u;
+  for (size_t cell_index = 0u; cell_index < cells_.size(); ++cell_index) {
+    const VeloceSpatialCell& cell = cells_[cell_index];
+    if (cell.ordinal_count == 0u || cell.first_ordinal != expected_ordinal ||
+        cell.bin_index >= kBinCount ||
+        (cell_index != 0u && cell.bin_index <= previous_bin) ||
+        cell.ordinal_count > ordinals_.size() - expected_ordinal) {
+      return false;
+    }
+    uint32_t previous_command = 0u;
+    for (size_t i = expected_ordinal;
+         i < expected_ordinal + cell.ordinal_count; ++i) {
+      const uint32_t command = ordinals_[i];
+      if (command >= command_count_ ||
+          (i != expected_ordinal && command <= previous_command)) {
+        return false;
+      }
+      previous_command = command;
+    }
+    expected_ordinal += cell.ordinal_count;
+    previous_bin = cell.bin_index;
+  }
+  if (expected_ordinal != ordinals_.size()) {
+    return false;
+  }
+  uint32_t previous_always = 0u;
+  for (size_t i = 0u; i < always_candidate_ordinals_.size(); ++i) {
+    const uint32_t command = always_candidate_ordinals_[i];
+    if (command >= command_count_ ||
+        (i != 0u && command <= previous_always)) {
+      return false;
+    }
+    previous_always = command;
+  }
+  return true;
+}
+
+size_t VeloceSpatialOrdinalIndex::EstimatedBytes() const {
+  return sizeof(*this) +
+         cells_.capacity() * sizeof(VeloceSpatialCell) +
+         ordinals_.capacity() * sizeof(uint32_t) +
+         always_candidate_ordinals_.capacity() * sizeof(uint32_t);
+}
