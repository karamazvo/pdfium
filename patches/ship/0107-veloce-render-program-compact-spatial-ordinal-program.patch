+bool RectContains(const CFX_FloatRect& outer, const CFX_FloatRect& inner) {
+  return outer.left <= inner.left && outer.right >= inner.right &&
+         outer.bottom <= inner.bottom && outer.top >= inner.top;
+}
+
+uint32_t CoordinateToBin(float coordinate,
+                         float minimum,
+                         float span,
+                         uint32_t bin_count) {
+  if (coordinate <= minimum) {
+    return 0u;
+  }
+  const float scaled = (coordinate - minimum) * bin_count / span;
+  return scaled >= bin_count ? bin_count - 1u
+                             : static_cast<uint32_t>(scaled);
+}
+
+bool GetBinRange(const CFX_FloatRect& holder_bounds,
+                 CFX_FloatRect rect,
+                 uint32_t* left,
+                 uint32_t* right,
+                 uint32_t* bottom,
+                 uint32_t* top) {
+  rect.Normalize();
+  if (!IsFiniteRect(rect) || rect.IsEmpty() ||
+      !RectsIntersect(holder_bounds, rect)) {
+    return false;
+  }
+  rect.Intersect(holder_bounds);
+  if (rect.IsEmpty()) {
+    return false;
+  }
+  *left = CoordinateToBin(rect.left, holder_bounds.left,
+                          holder_bounds.Width(),
+                          VeloceSpatialOrdinalIndex::kColumns);
+  *right = CoordinateToBin(rect.right, holder_bounds.left,
+                           holder_bounds.Width(),
+                           VeloceSpatialOrdinalIndex::kColumns);
+  *bottom = CoordinateToBin(rect.bottom, holder_bounds.bottom,
+                            holder_bounds.Height(),
+                            VeloceSpatialOrdinalIndex::kRows);
+  *top = CoordinateToBin(rect.top, holder_bounds.bottom,
+                         holder_bounds.Height(),
+                         VeloceSpatialOrdinalIndex::kRows);
+  return true;
+}
