+// but reject it before feature inspection, allocation, cache lookup, or pixel
+// modification.
+inline constexpr bool kVeloceLegacyPathDisplayListEnabled = false;
+
 enum class VelocePathDisplayListResult {
   kNotEligible,
   kRendered,
