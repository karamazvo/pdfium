   if (!status || !holder) {
     return VelocePathDisplayListResult::kNotEligible;
   }
diff --git a/core/fpdfapi/render/veloce_path_display_list.h b/core/fpdfapi/render/veloce_path_display_list.h
index e5a46595d..f5d251015 100644
--- a/core/fpdfapi/render/veloce_path_display_list.h
+++ b/core/fpdfapi/render/veloce_path_display_list.h
@@ -8,6 +8,12 @@ class CFX_Matrix;
 class CPDF_PageObjectHolder;
 class CPDF_RenderStatus;

+// Generation 2 has one future acceleration boundary: the holder-owned packed
