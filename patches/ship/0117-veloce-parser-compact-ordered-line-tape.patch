+  EXPECT_EQ(3u, program->retained_page_object_count());
+  ASSERT_EQ(0u, program->RetainedPageObjectIndex(0u).value());
+  ASSERT_EQ(1u, program->RetainedPageObjectIndex(1u).value());
+  EXPECT_FALSE(program->RetainedPageObjectIndex(2u).has_value());
+  ASSERT_EQ(2u, program->RetainedPageObjectIndex(3u).value());
