diff --git a/core/fpdfapi/page/cpdf_streamcontentparser_unittest.cpp b/core/fpdfapi/page/cpdf_streamcontentparser_unittest.cpp
index cb25710ad..a1a8089c4 100644
--- a/core/fpdfapi/page/cpdf_streamcontentparser_unittest.cpp
+++ b/core/fpdfapi/page/cpdf_streamcontentparser_unittest.cpp
@@ -3,6 +3,10 @@
 // found in the LICENSE file.
 
 #include "core/fpdfapi/page/cpdf_streamcontentparser.h"
+
+#include <cstddef>
+#include <vector>
+
 #include "testing/gtest/include/gtest/gtest.h"
 
 TEST(CPDFStreamContentParserTest, PDFFindKeyAbbreviation) {
@@ -42,3 +46,32 @@ TEST(CPDFStreamContentParserTest, PDFFindValueAbbreviation) {
             CPDF_StreamContentParser::FindValueAbbreviationForTesting(
                 ByteStringView("II")));
 }
+
+TEST(CPDFStreamContentParserTest, RetainsBoundedOmittedPathScratch) {
+  std::vector<CFX_Path::Point> path_points;
+  path_points.reserve(2u);
+  path_points.emplace_back(CFX_PointF(1.0f, 2.0f),
+                           CFX_Path::Point::Type::kMove, false);
+  path_points.emplace_back(CFX_PointF(3.0f, 4.0f),
+                           CFX_Path::Point::Type::kLine, false);
+
+  const size_t capacity =
+      CPDF_StreamContentParser::ResetOmittedPathPointsForTesting(&path_points);
+
+  EXPECT_TRUE(path_points.empty());
+  EXPECT_GE(capacity, 2u);
+  EXPECT_LE(capacity, 16u);
+}
+
+TEST(CPDFStreamContentParserTest, ReleasesOversizedOmittedPathScratch) {
+  std::vector<CFX_Path::Point> path_points;
+  path_points.reserve(1024u);
+  path_points.emplace_back(CFX_PointF(1.0f, 2.0f),
+                           CFX_Path::Point::Type::kMove, false);
+
+  const size_t capacity =
+      CPDF_StreamContentParser::ResetOmittedPathPointsForTesting(&path_points);
+
+  EXPECT_TRUE(path_points.empty());
+  EXPECT_EQ(capacity, 0u);
+}
