new file mode 100644
index 000000000..cd5142078
--- /dev/null
+++ b/fpdfsdk/fpdfex_render_callbacks.cpp
@@ -0,0 +1,30 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#include "public/fpdfex_render_callbacks.h"
+
+#include <cstddef>
+
+#include "core/fpdfapi/render/veloce_render_callbacks.h"
+
+namespace {
+
+static_assert(sizeof(FPDFEx_RenderCallbacks) == sizeof(VeloceRenderCallbacks));
+static_assert(offsetof(FPDFEx_RenderCallbacks, struct_size) ==
+              offsetof(VeloceRenderCallbacks, struct_size));
+static_assert(offsetof(FPDFEx_RenderCallbacks, feature_flags) ==
+              offsetof(VeloceRenderCallbacks, feature_flags));
+static_assert(offsetof(FPDFEx_RenderCallbacks, user_data) ==
+              offsetof(VeloceRenderCallbacks, user_data));
+static_assert(offsetof(FPDFEx_RenderCallbacks, cancel_check) ==
+              offsetof(VeloceRenderCallbacks, cancel_check));
+
+}  // namespace
+
+FPDF_EXPORT void FPDF_CALLCONV
+FPDFEx_SetRenderCallbacks(FPDF_PAGE page,
+                          const FPDFEx_RenderCallbacks* callbacks) {
+  (void)page;
+  VeloceSetRenderCallbacks(
+      reinterpret_cast<const VeloceRenderCallbacks*>(callbacks));
+}
