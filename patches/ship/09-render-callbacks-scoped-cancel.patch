new file mode 100644
index 000000000..6f719d564
--- /dev/null
+++ b/core/fpdfapi/render/veloce_render_callbacks.cpp
@@ -0,0 +1,34 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#include "core/fpdfapi/render/veloce_render_callbacks.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstring>
+
+namespace {
+
+thread_local VeloceRenderCallbacks g_render_callbacks = {};
+
+constexpr uint32_t kMinRenderableCallbacksSize =
+    static_cast<uint32_t>(offsetof(VeloceRenderCallbacks, cancel_check) +
+                          sizeof(VeloceRenderCancelCheckFn));
+
+}  // namespace
+
+const VeloceRenderCallbacks* VeloceGetRenderCallbacks() {
+  return g_render_callbacks.cancel_check ? &g_render_callbacks : nullptr;
+}
+
+void VeloceSetRenderCallbacks(const VeloceRenderCallbacks* callbacks) {
+  std::memset(&g_render_callbacks, 0, sizeof(g_render_callbacks));
+  if (!callbacks || callbacks->struct_size < kMinRenderableCallbacksSize) {
+    return;
+  }
+
+  const size_t bytes_to_copy =
+      std::min<size_t>(callbacks->struct_size, sizeof(g_render_callbacks));
+  std::memcpy(&g_render_callbacks, callbacks, bytes_to_copy);
+  g_render_callbacks.struct_size = sizeof(g_render_callbacks);
+}
diff --git a/core/fpdfapi/render/veloce_render_callbacks.h b/core/fpdfapi/render/veloce_render_callbacks.h
new file mode 100644
index 000000000..540746bde
--- /dev/null
+++ b/core/fpdfapi/render/veloce_render_callbacks.h
@@ -0,0 +1,25 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#ifndef CORE_FPDFAPI_RENDER_VELOCE_RENDER_CALLBACKS_H_
+#define CORE_FPDFAPI_RENDER_VELOCE_RENDER_CALLBACKS_H_
+
+#include <stdint.h>
+
+using VeloceRenderCancelCheckFn = int (*)(void* user_data);
+
+struct VeloceRenderCallbacks {
+  uint32_t struct_size;
+  uint32_t feature_flags;
+  void* user_data;
+  VeloceRenderCancelCheckFn cancel_check;
+  void* reserved0;
+  void* reserved1;
+  void* reserved2;
+  void* reserved3;
+};
+
+const VeloceRenderCallbacks* VeloceGetRenderCallbacks();
+void VeloceSetRenderCallbacks(const VeloceRenderCallbacks* callbacks);
+
+#endif  // CORE_FPDFAPI_RENDER_VELOCE_RENDER_CALLBACKS_H_
