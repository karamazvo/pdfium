+VelocePathDisplayListCompileResult GetCompiledPathRunForSegment(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    VeloceRenderPlanHolderKind holder_kind,
+    VelocePathDisplayListHolderKind path_holder_kind,
+    const VeloceRenderPlanSegment& segment,
+    std::shared_ptr<const VeloceCompiledPathDisplayList>* out_list,
+    bool* cache_hit,
+    size_t* node_count) {
+  if (out_list) {
+    out_list->reset();
+  }
+  if (cache_hit) {
+    *cache_hit = false;
+  }
+  if (node_count) {
+    *node_count = 0;
+  }
+  if (!status || !holder || !out_list || segment.object_count == 0) {
+    return VelocePathDisplayListCompileResult::kNotEligible;
+  }
+  if ((status->GetRenderFeatureFlags() &
+       kVeloceRenderPlanPathDisplayListFeature) == 0) {
+    return VelocePathDisplayListCompileResult::kNotEligible;
+  }
+
+  const CompiledPathRunCacheKey key =
+      MakeCompiledPathRunCacheKey(status, holder, holder_kind, segment);
+  std::shared_ptr<const VeloceCompiledPathDisplayList> cached_list =
+      FindCachedCompiledPathRun(key, node_count);
+  if (cached_list) {
+    const VelocePathDisplayListResult validate_result =
+        VeloceValidateCompiledPathDisplayListReplay(status, cached_list.get(),
+                                                    path_holder_kind);
+    if (validate_result == VelocePathDisplayListResult::kCancelled) {
+      return VelocePathDisplayListCompileResult::kCancelled;
+    }
+    if (validate_result != VelocePathDisplayListResult::kRendered) {
+      return VelocePathDisplayListCompileResult::kNotEligible;
+    }
+    if (cache_hit) {
+      *cache_hit = true;
+    }
+    *out_list = std::move(cached_list);
+    return VelocePathDisplayListCompileResult::kCompiled;
+  }
+
+  VeloceCompiledPathDisplayList* compiled_list = nullptr;
+  const VelocePathDisplayListCompileResult compile_result =
+      VeloceCompilePathDisplayListForObjectRange(
+          status, holder, segment.first_object_index, segment.object_count,
+          &compiled_list);
+  if (compile_result != VelocePathDisplayListCompileResult::kCompiled) {
+    VeloceDestroyCompiledPathDisplayList(compiled_list);
+    return compile_result;
+  }
+
+  const VelocePathDisplayListResult validate_result =
+      VeloceValidateCompiledPathDisplayListReplay(status, compiled_list,
+                                                  path_holder_kind);
+  if (validate_result == VelocePathDisplayListResult::kCancelled) {
+    VeloceDestroyCompiledPathDisplayList(compiled_list);
+    return VelocePathDisplayListCompileResult::kCancelled;
+  }
+  if (validate_result != VelocePathDisplayListResult::kRendered) {
+    VeloceDestroyCompiledPathDisplayList(compiled_list);
+    return VelocePathDisplayListCompileResult::kNotEligible;
+  }
+
+  const size_t compiled_node_count =
+      VeloceCompiledPathDisplayListNodeCount(compiled_list);
+  bool stored = false;
+  *out_list = StoreCachedCompiledPathRun(key, compiled_list,
+                                         compiled_node_count, &stored);
+  if (node_count) {
+    *node_count = compiled_node_count;
+  }
+  return VelocePathDisplayListCompileResult::kCompiled;
+}
