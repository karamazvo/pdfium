+struct CompiledPathRunCacheKey {
+  const CPDF_Document* document = nullptr;
+  const CPDF_PageObjectHolder* holder = nullptr;
+  uint32_t holder_dict_obj_num = 0;
+  VeloceRenderPlanHolderKind holder_kind = VeloceRenderPlanHolderKind::kForm;
+  size_t first_object_index = 0;
+  size_t object_count = 0;
+  bool aliased_path = false;
+
+  bool operator==(const CompiledPathRunCacheKey& other) const {
+    return document == other.document && holder == other.holder &&
+           holder_dict_obj_num == other.holder_dict_obj_num &&
+           holder_kind == other.holder_kind &&
+           first_object_index == other.first_object_index &&
+           object_count == other.object_count &&
+           aliased_path == other.aliased_path;
+  }
+};
+
+struct CompiledPathRunCacheKeyHash {
+  size_t operator()(const CompiledPathRunCacheKey& key) const {
+    size_t hash = std::hash<const CPDF_Document*>()(key.document);
+    hash ^= std::hash<const CPDF_PageObjectHolder*>()(key.holder) +
+            0x9e3779b97f4a7c15ull + (hash << 6) + (hash >> 2);
+    hash ^= std::hash<uint32_t>()(key.holder_dict_obj_num) +
+            0x9e3779b97f4a7c15ull + (hash << 6) + (hash >> 2);
+    hash ^= std::hash<int>()(static_cast<int>(key.holder_kind)) +
+            0x9e3779b97f4a7c15ull + (hash << 6) + (hash >> 2);
+    hash ^= std::hash<size_t>()(key.first_object_index) +
+            0x9e3779b97f4a7c15ull + (hash << 6) + (hash >> 2);
+    hash ^= std::hash<size_t>()(key.object_count) + 0x9e3779b97f4a7c15ull +
+            (hash << 6) + (hash >> 2);
+    hash ^= std::hash<bool>()(key.aliased_path) + 0x9e3779b97f4a7c15ull +
+            (hash << 6) + (hash >> 2);
+    return hash;
+  }
+};
+
+struct CompiledPathRunCacheEntry {
+  std::shared_ptr<const VeloceCompiledPathDisplayList> list;
+  size_t node_count = 0;
+  uint64_t last_use = 0;
+};
