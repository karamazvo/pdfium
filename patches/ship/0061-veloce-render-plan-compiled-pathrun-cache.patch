   return shared_plan;
 }
 
+std::shared_ptr<const VeloceCompiledPathDisplayList> MakeSharedCompiledPathRun(
+    VeloceCompiledPathDisplayList* list) {
+  return std::shared_ptr<const VeloceCompiledPathDisplayList>(
+      list, [](const VeloceCompiledPathDisplayList* owned_list) {
+        VeloceDestroyCompiledPathDisplayList(
+            const_cast<VeloceCompiledPathDisplayList*>(owned_list));
+      });
+}
+
+std::shared_ptr<const VeloceCompiledPathDisplayList> StoreCachedCompiledPathRun(
+    const CompiledPathRunCacheKey& key,
+    VeloceCompiledPathDisplayList* list,
+    size_t node_count,
+    bool* stored) {
+  if (stored) {
+    *stored = false;
+  }
+  std::shared_ptr<const VeloceCompiledPathDisplayList> shared =
+      MakeSharedCompiledPathRun(list);
+  if (node_count > kMaxCachedCompiledPathRunNodes) {
+    return shared;
+  }
+
+  std::lock_guard<std::mutex> lock(CompiledPathRunCacheMutex());
+  auto& cache = CompiledPathRunCache();
+  auto existing = cache.find(key);
+  if (existing != cache.end()) {
+    existing->second.last_use = ++CompiledPathRunCacheClock();
+    if (stored) {
+      *stored = true;
+    }
+    return existing->second.list;
+  }
+
+  cache[key] = {shared, node_count, ++CompiledPathRunCacheClock()};
+  CompiledPathRunCacheNodeCount() += node_count;
+  EvictCompiledPathRunCacheIfNeededLocked();
+  if (stored) {
+    *stored = cache.find(key) != cache.end();
+  }
+  return shared;
+}
