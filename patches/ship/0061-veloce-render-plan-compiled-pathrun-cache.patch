+CompiledPathRunCacheKey MakeCompiledPathRunCacheKey(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    VeloceRenderPlanHolderKind holder_kind,
+    const VeloceRenderPlanSegment& segment) {
+  CompiledPathRunCacheKey key;
+  key.document = holder ? holder->GetDocument() : nullptr;
+  key.holder = holder;
+  key.holder_kind = holder_kind;
+  if (holder) {
+    auto dict = holder->GetDict();
+    key.holder_dict_obj_num = dict ? dict->GetObjNum() : 0;
+  }
+  key.first_object_index = segment.first_object_index;
+  key.object_count = segment.object_count;
+  key.aliased_path =
+      status && status->GetRenderOptions().GetOptions().bNoPathSmooth;
+  return key;
+}
