+std::shared_ptr<const VeloceCompiledPathDisplayList> FindCachedCompiledPathRun(
+    const CompiledPathRunCacheKey& key,
+    size_t* node_count) {
+  std::lock_guard<std::mutex> lock(CompiledPathRunCacheMutex());
+  auto& cache = CompiledPathRunCache();
+  auto it = cache.find(key);
+  if (it == cache.end()) {
+    return nullptr;
+  }
+  it->second.last_use = ++CompiledPathRunCacheClock();
+  if (node_count) {
+    *node_count = it->second.node_count;
+  }
+  return it->second.list;
+}
+
 void EvictRenderPlanCacheIfNeededLocked() {
   auto& cache = RenderPlanCache();
   while (cache.size() > kMaxCachedRenderPlans) {
@@ -166,6 +276,26 @@ void EvictRenderPlanCacheIfNeededLocked() {
   }
 }
 
+void EvictCompiledPathRunCacheIfNeededLocked() {
+  auto& cache = CompiledPathRunCache();
+  size_t& total_nodes = CompiledPathRunCacheNodeCount();
+  while (cache.size() > kMaxCachedCompiledPathRuns ||
+         total_nodes > kMaxCachedCompiledPathRunNodes) {
+    auto oldest = cache.end();
+    for (auto it = cache.begin(); it != cache.end(); ++it) {
+      if (oldest == cache.end() ||
+          it->second.last_use < oldest->second.last_use) {
+        oldest = it;
+      }
+    }
+    if (oldest == cache.end()) {
+      return;
+    }
+    total_nodes -= std::min(total_nodes, oldest->second.node_count);
+    cache.erase(oldest);
+  }
+}
+
 std::shared_ptr<const VeloceRenderPlan> StoreCachedRenderPlan(
     const RenderPlanCacheKey& key,
     VeloceRenderPlan plan) {
