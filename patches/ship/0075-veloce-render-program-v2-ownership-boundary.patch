 core/fpdfapi/page/cpdf_pageobjectholder.cpp   | 11 +++++++++++
 core/fpdfapi/page/cpdf_pageobjectholder.h     |  9 +++++++++
 core/fpdfapi/page/veloce_render_program.h     | 27 +++++++++++++++++++++++++++
 4 files changed, 48 insertions(+)
 create mode 100644 core/fpdfapi/page/veloce_render_program.h

