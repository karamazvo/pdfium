@@ -3,6 +3,11 @@
 // found in the LICENSE file.
 
 #include "core/fpdfapi/page/cpdf_streamparser.h"
+
+#include <bit>
+
+#include "core/fxcrt/bytestring.h"
+#include "core/fxcrt/fx_number.h"
 #include "testing/gmock/include/gmock/gmock.h"
 #include "testing/gtest/include/gtest/gtest.h"
 
@@ -113,3 +118,35 @@ TEST(CPDFStreamParserTest, CompactTranslationGrammarFailsClosed) {
   EXPECT_FALSE(parser.TryParseTranslationOriginStrokeLine(&operands));
   EXPECT_EQ(0u, parser.GetPos());
 }
+
+TEST(CPDFStreamParserTest,
+     ExactTranslationNumbersMatchCanonicalNumberConversion) {
+  uint8_t data[] =
+      "q 1 0 0 1 +38.895285 -0.25 cm "
+      "0 0 m 2147483647 -2147483648 l S Q";
+  CPDF_StreamParser parser(data);
+  std::array<float, 4> operands = {};
+
+  ASSERT_TRUE(parser.TryParseTranslationOriginStrokeLine(&operands));
+  const std::array<ByteStringView, 4> expected_words = {
+      "+38.895285", "-0.25", "2147483647", "-2147483648"};
+  for (size_t i = 0; i < operands.size(); ++i) {
+    EXPECT_EQ(std::bit_cast<uint32_t>(FX_Number(expected_words[i]).GetFloat()),
+              std::bit_cast<uint32_t>(operands[i]));
+  }
+}
+
+TEST(CPDFStreamParserTest,
+     ExactTranslationNumbersPreserveCompatibilityFallback) {
+  uint8_t data[] = "q 1 0 0 1 --100.0 +-2.5 cm 0 0 m . +. l S Q";
+  CPDF_StreamParser parser(data);
+  std::array<float, 4> operands = {};
+
+  ASSERT_TRUE(parser.TryParseTranslationOriginStrokeLine(&operands));
+  const std::array<ByteStringView, 4> expected_words = {
+      "--100.0", "+-2.5", ".", "+."};
+  for (size_t i = 0; i < operands.size(); ++i) {
+    EXPECT_EQ(std::bit_cast<uint32_t>(FX_Number(expected_words[i]).GetFloat()),
+              std::bit_cast<uint32_t>(operands[i]));
+  }
+}
