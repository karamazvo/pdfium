+      static_cast<uint32_t>(std::numeric_limits<int32_t>::max());
+  if (value > (negative ? kSignedLimit + 1u : kSignedLimit)) {
+    value = 0u;
+  }
+  const int32_t signed_value = static_cast<int32_t>(value);
+  if (!negative) {
+    return static_cast<float>(signed_value);
+  }
+  if (signed_value == std::numeric_limits<int32_t>::min()) {
+    return static_cast<float>(signed_value);
