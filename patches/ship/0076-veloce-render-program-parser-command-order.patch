From 0f7884011e5c5f6f764ef5b80811c33a4d07787e Mon Sep 17 00:00:00 2001
From: "sh.chao" <sh.chao@gmail.com>
Date: Wed, 15 Jul 2026 12:23:41 +0800
Subject: [PATCH] r25-0076 record compact RenderProgram command order

Create one bounded parser-time recorder per empty page or Form holder and append one command-kind byte from the central AppendPageObject path. Seal immutable command order only after parsing and clip normalization complete, use implicit object indices, and abandon recording above a 32 MiB hard ceiling. Pre-populated holders fail closed without a program.

Keep rendering unchanged: no replay hook, geometry copy, bounds index, cache, lock, JNI/API change, classification pass, or second holder scan. Invalidate both in-progress and sealed programs on holder list mutation so later replay cannot observe stale order.
---
 core/fpdfapi/page/BUILD.gn                  |  1 +
 core/fpdfapi/page/cpdf_pageobjectholder.cpp | 23 ++++++++
 core/fpdfapi/page/cpdf_pageobjectholder.h   |  2 +
 core/fpdfapi/page/veloce_render_program.cpp | 58 +++++++++++++++++++++
 core/fpdfapi/page/veloce_render_program.h   | 58 +++++++++++++++++++--
 5 files changed, 138 insertions(+), 4 deletions(-)
 create mode 100644 core/fpdfapi/page/veloce_render_program.cpp

diff --git a/core/fpdfapi/page/BUILD.gn b/core/fpdfapi/page/BUILD.gn
index e54adba4e..8690d868a 100644
--- a/core/fpdfapi/page/BUILD.gn
+++ b/core/fpdfapi/page/BUILD.gn
@@ -108,6 +108,7 @@ source_set("page") {
     "ipdf_page.h",
     "jpx_decode_conversion.cpp",
     "jpx_decode_conversion.h",
+    "veloce_render_program.cpp",
     "veloce_render_program.h",
   ]
   configs += [ "../../../:pdfium_strict_config" ]
diff --git a/core/fpdfapi/page/cpdf_pageobjectholder.cpp b/core/fpdfapi/page/cpdf_pageobjectholder.cpp
index ef4f6bed1..7bc441072 100644
--- a/core/fpdfapi/page/cpdf_pageobjectholder.cpp
+++ b/core/fpdfapi/page/cpdf_pageobjectholder.cpp
@@ -60,6 +60,7 @@ void CPDF_PageObjectHolder::SetVeloceRenderProgram(
 }

 void CPDF_PageObjectHolder::ResetVeloceRenderProgram() {
+  veloce_render_program_builder_.reset();
   veloce_render_program_.reset();
 }

@@ -70,6 +71,11 @@ bool CPDF_PageObjectHolder::IsPage() const {
 void CPDF_PageObjectHolder::StartParse(
     std::unique_ptr<CPDF_ContentParser> pParser) {
   DCHECK_EQ(parse_state_, ParseState::kNotParsed);
+  ResetVeloceRenderProgram();
+  if (page_object_list_.empty()) {
+    veloce_render_program_builder_ =
+        std::make_unique<VeloceRenderProgramBuilder>();
+  }
   parser_ = std::move(pParser);
   parse_state_ = ParseState::kParsing;
 }
@@ -88,6 +94,15 @@ void CPDF_PageObjectHolder::ContinueParse(PauseIndicatorIface* pPause) {
   document_->IncrementParsedPageCount();
   all_ctms_ = parser_->TakeAllCTMs();

+  if (veloce_render_program_builder_) {
+    std::unique_ptr<const VeloceRenderProgram> program =
+        veloce_render_program_builder_->Finish();
+    veloce_render_program_builder_.reset();
+    if (program) {
+      SetVeloceRenderProgram(std::move(program));
+    }
+  }
+
   parser_.reset();
 }

@@ -198,6 +213,11 @@ void CPDF_PageObjectHolder::AppendPageObject(
     std::unique_ptr<CPDF_PageObject> pPageObj) {
   CHECK(pPageObj);
   page_object_list_.push_back(std::move(pPageObj));
+  if (veloce_render_program_builder_) {
+    veloce_render_program_builder_->AppendPageObject(*page_object_list_.back());
+  } else {
+    ResetVeloceRenderProgram();
+  }
 }

 bool CPDF_PageObjectHolder::InsertPageObjectAtIndex(
@@ -224,6 +244,7 @@ bool CPDF_PageObjectHolder::InsertPageObjectAtIndex(
   // std::deque::iterator::operator++() has not been marked as unsafe yet.
   page_object_list_.insert(UNSAFE_TODO(page_object_list_.begin() + index),
                            std::move(page_obj));
+  ResetVeloceRenderProgram();
   return true;
 }

@@ -237,6 +258,7 @@ std::unique_ptr<CPDF_PageObject> CPDF_PageObjectHolder::RemovePageObject(

   std::unique_ptr<CPDF_PageObject> result = std::move(*it);
   page_object_list_.erase(it);
+  ResetVeloceRenderProgram();

   int32_t content_stream = pPageObj->GetContentStream();
   if (content_stream >= 0) {
@@ -254,5 +276,6 @@ bool CPDF_PageObjectHolder::ErasePageObjectAtIndex(size_t index) {
   // Unsafe, but the compiler will not complain, because
   // std::deque::iterator::operator++() has not been marked as unsafe yet.
   page_object_list_.erase(UNSAFE_TODO(page_object_list_.begin() + index));
+  ResetVeloceRenderProgram();
   return true;
 }
