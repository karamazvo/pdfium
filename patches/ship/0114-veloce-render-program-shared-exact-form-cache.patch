@@ -83,9 +90,59 @@ void CPDF_Form::ParseContentInternal(const CPDF_AllStates* pGraphicStates,
   }
 
   if (GetParseState() == ParseState::kNotParsed) {
+    std::shared_ptr<const VeloceRenderProgram> cached_program;
+    CPDF_DocPageData* page_data = nullptr;
+    if (!pType3Char) {
+      page_data = CPDF_DocPageData::FromDocument(GetDocument());
+      cached_program = page_data->FindVeloceFormRenderProgram(
+          GetStream(), pGraphicStates, pParentMatrix,
+          GetTransparency().IsGroup(), GetTransparency().IsIsolated());
+    }
     StartParse(std::make_unique<CPDF_ContentParser>(
         GetStream(), this, pGraphicStates, pParentMatrix, pType3Char,
         recursion_state ? recursion_state : &recursion_state_));
+    if (cached_program) {
+      DisableVeloceRenderProgramRecordingForCurrentParse();
+    }
+    DCHECK_EQ(GetParseState(), ParseState::kParsing);
+    ContinueParse(nullptr);
+
+    if (cached_program) {
+      if (!VeloceParseUsedResources() &&
+          cached_program->command_count() == GetPageObjectCount()) {
+        SetVeloceRenderProgram(std::move(cached_program));
+#if BUILDFLAG(IS_ANDROID)
+        __android_log_print(
+            ANDROID_LOG_INFO, "VeloceRenderProgram2",
+            "revision=r25-3-0114 event=form_cache result=hit "
+            "streamObj=%u commands=%zu bytes=%zu",
+            GetStream()->GetObjNum(), GetVeloceRenderProgram()->command_count(),
+            GetVeloceRenderProgram()->EstimatedBytes());
+#endif
+      }
+      return;
+    }
+
+    std::shared_ptr<const VeloceRenderProgram> built_program =
+        GetVeloceRenderProgramShared();
+    if (page_data && built_program &&
+        built_program->header().native_command_count ==
+            built_program->command_count() &&
+        !VeloceParseUsedResources()) {
+      page_data->CacheVeloceFormRenderProgram(
+          GetStream(), pGraphicStates, pParentMatrix,
+          GetTransparency().IsGroup(), GetTransparency().IsIsolated(),
+          built_program);
+#if BUILDFLAG(IS_ANDROID)
+      __android_log_print(
+          ANDROID_LOG_INFO, "VeloceRenderProgram2",
+          "revision=r25-3-0114 event=form_cache result=store "
+          "streamObj=%u commands=%zu bytes=%zu",
+          GetStream()->GetObjNum(), built_program->command_count(),
+          built_program->EstimatedBytes());
+#endif
+    }
+    return;
   }
   DCHECK_EQ(GetParseState(), ParseState::kParsing);
   ContinueParse(nullptr);
diff --git a/core/fpdfapi/page/cpdf_form_unittest.cpp b/core/fpdfapi/page/cpdf_form_unittest.cpp
new file mode 100644
index 000000000..903e04db5
--- /dev/null
+++ b/core/fpdfapi/page/cpdf_form_unittest.cpp
@@ -0,0 +1,65 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#include "core/fpdfapi/page/cpdf_form.h"
+
+#include <iterator>
+#include <memory>
+
+#include "core/fpdfapi/page/veloce_render_program.h"
+#include "core/fpdfapi/parser/cpdf_dictionary.h"
+#include "core/fpdfapi/parser/cpdf_stream.h"
+#include "core/fpdfapi/parser/cpdf_test_document.h"
+#include "core/fxcrt/data_vector.h"
+#include "core/fxcrt/retain_ptr.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace {
+
+RetainPtr<CPDF_Stream> MakeOpaqueFillFormStream() {
+  static constexpr uint8_t kContents[] = "0 0 10 10 re f\n";
+  return pdfium::MakeRetain<CPDF_Stream>(
+      DataVector<uint8_t>(std::begin(kContents), std::end(kContents)),
+      pdfium::MakeRetain<CPDF_Dictionary>());
+}
+
+}  // namespace
+
+TEST(CPDFFormTest, ReusesExactResourceIndependentRenderProgram) {
+  auto document = std::make_unique<CPDF_TestDocument>();
+  document->CreateNewDoc();
+  RetainPtr<CPDF_Stream> stream = MakeOpaqueFillFormStream();
+
+  CPDF_Form first(document.get(), nullptr, stream);
+  first.ParseContent();
+  const VeloceRenderProgram* first_program = first.GetVeloceRenderProgram();
+  ASSERT_TRUE(first_program);
+  ASSERT_EQ(first_program->header().native_command_count,
+            first_program->command_count());
+
+  CPDF_Form second(document.get(), nullptr, stream);
+  second.ParseContent();
+
+  EXPECT_EQ(first_program, second.GetVeloceRenderProgram());
+  EXPECT_EQ(first.GetPageObjectCount(), second.GetPageObjectCount());
+}
+
+TEST(CPDFFormTest, StreamMutationInvalidatesCachedRenderProgram) {
+  auto document = std::make_unique<CPDF_TestDocument>();
+  document->CreateNewDoc();
+  RetainPtr<CPDF_Stream> stream = MakeOpaqueFillFormStream();
+
+  CPDF_Form first(document.get(), nullptr, stream);
+  first.ParseContent();
+  const VeloceRenderProgram* first_program = first.GetVeloceRenderProgram();
+  ASSERT_TRUE(first_program);
+
+  static constexpr uint8_t kReplacement[] = "0 0 20 20 re f\n";
+  stream->SetData(kReplacement);
+
+  CPDF_Form second(document.get(), nullptr, stream);
+  second.ParseContent();
+
+  ASSERT_TRUE(second.GetVeloceRenderProgram());
+  EXPECT_NE(first_program, second.GetVeloceRenderProgram());
+}
