 #include "core/fpdfapi/parser/cpdf_array.h"
 #include "core/fpdfapi/parser/cpdf_dictionary.h"
 #include "core/fpdfapi/parser/cpdf_name.h"
@@ -169,14 +174,217 @@ RetainPtr<CPDF_Dictionary> CalculateFontDesc(CPDF_Document* doc,
   return font_desc;
 }
 
+uint32_t VeloceFloatBits(float value) {
+  return std::bit_cast<uint32_t>(value);
+}
+
+std::array<uint32_t, 6> VeloceMatrixBits(const CFX_Matrix& matrix) {
+  return {VeloceFloatBits(matrix.a), VeloceFloatBits(matrix.b),
+          VeloceFloatBits(matrix.c), VeloceFloatBits(matrix.d),
+          VeloceFloatBits(matrix.e), VeloceFloatBits(matrix.f)};
+}
+
+enum class VeloceColorKind : uint8_t {
+  kAbsent,
+  kNull,
+  kPattern,
+  kSolid,
+};
+
+VeloceColorKind GetVeloceColorKind(const CPDF_Color* color) {
+  if (!color) {
+    return VeloceColorKind::kAbsent;
+  }
+  if (color->IsNull()) {
+    return VeloceColorKind::kNull;
+  }
+  return color->IsPattern() ? VeloceColorKind::kPattern
+                            : VeloceColorKind::kSolid;
+}
+
+struct VeloceFormInvocationKey {
+  RetainPtr<const CPDF_Stream> stream;
+  uint64_t stream_generation = 0u;
+  std::array<uint32_t, 6> form_matrix = {};
+  std::array<uint32_t, 4> form_bbox = {};
+  std::array<uint32_t, 6> initial_ctm = {};
+  std::array<uint32_t, 6> parent_matrix = {};
+  std::vector<uint32_t> dash_values;
+  RetainPtr<const CPDF_Dictionary> soft_mask;
+  RetainPtr<const CPDF_Object> transfer;
+  uint32_t fill_alpha = 0u;
+  uint32_t stroke_alpha = 0u;
+  uint32_t line_width = 0u;
+  uint32_t miter_limit = 0u;
+  uint32_t dash_phase = 0u;
+  uint32_t fill_color_ref = 0u;
+  uint32_t stroke_color_ref = 0u;
+  int op_mode = 0;
+  BlendMode blend_mode = BlendMode::kNormal;
+  CFX_GraphStateData::LineCap line_cap =
+      CFX_GraphStateData::LineCap::kButt;
+  CFX_GraphStateData::LineJoin line_join =
+      CFX_GraphStateData::LineJoin::kMiter;
+  VeloceColorKind fill_color_kind = VeloceColorKind::kAbsent;
+  VeloceColorKind stroke_color_kind = VeloceColorKind::kAbsent;
+  bool has_initial_states = false;
+  bool has_parent_matrix = false;
+  bool has_general_state = false;
+  bool has_color_state = false;
+  bool transparency_group = false;
+  bool isolated_group = false;
+  bool fill_overprint = false;
+  bool stroke_overprint = false;
+  bool stroke_adjust = false;
+
+  bool operator==(const VeloceFormInvocationKey&) const = default;
+};
+
+std::optional<VeloceFormInvocationKey> MakeVeloceFormInvocationKey(
+    RetainPtr<const CPDF_Stream> stream,
+    const CPDF_AllStates* initial_states,
+    const CFX_Matrix* parent_matrix,
+    bool transparency_group,
+    bool isolated_group) {
+  // Form invocations created by the page parser do not inherit a clip. Other
+  // callers can; structural clip equality is deliberately not approximated.
+  if (!stream || (initial_states && initial_states->clip_path().HasRef())) {
+    return std::nullopt;
+  }
+
+  VeloceFormInvocationKey key;
+  key.stream = std::move(stream);
+  key.stream_generation = key.stream->GetVeloceDataGeneration();
+  key.form_matrix =
+      VeloceMatrixBits(key.stream->GetDict()->GetMatrixFor("Matrix"));
+  if (RetainPtr<const CPDF_Array> bbox =
+          key.stream->GetDict()->GetArrayFor("BBox")) {
+    const CFX_FloatRect rect = bbox->GetRect();
+    key.form_bbox = {VeloceFloatBits(rect.left),
+                     VeloceFloatBits(rect.bottom),
+                     VeloceFloatBits(rect.right),
+                     VeloceFloatBits(rect.top)};
+  }
+  key.transparency_group = transparency_group;
+  key.isolated_group = isolated_group;
+  if (parent_matrix) {
+    key.has_parent_matrix = true;
+    key.parent_matrix = VeloceMatrixBits(*parent_matrix);
+  }
+  if (!initial_states) {
+    return key;
+  }
+
+  key.has_initial_states = true;
+  key.initial_ctm =
+      VeloceMatrixBits(initial_states->current_transformation_matrix());
+
+  const CPDF_GeneralState& general = initial_states->general_state();
+  key.has_general_state = general.HasRef();
+  if (key.has_general_state) {
+    key.blend_mode = general.GetBlendType();
+    key.fill_alpha = VeloceFloatBits(general.GetFillAlpha());
+    key.stroke_alpha = VeloceFloatBits(general.GetStrokeAlpha());
+    key.soft_mask = general.GetSoftMask();
+    key.transfer = general.GetTR();
+    key.fill_overprint = general.GetFillOP();
+    key.stroke_overprint = general.GetStrokeOP();
+    key.op_mode = general.GetOPMode();
+    key.stroke_adjust = general.GetStrokeAdjust();
+  }
+
+  const CFX_GraphState& graph = initial_states->graph_state();
+  key.line_width = VeloceFloatBits(graph.GetLineWidth());
+  key.miter_limit = VeloceFloatBits(graph.GetMiterLimit());
+  key.dash_phase = VeloceFloatBits(graph.GetLineDashPhase());
+  key.line_cap = graph.GetLineCap();
+  key.line_join = graph.GetLineJoin();
+  const std::vector<float> dashes = graph.GetLineDashArray();
+  key.dash_values.reserve(dashes.size());
+  for (float dash : dashes) {
+    key.dash_values.push_back(VeloceFloatBits(dash));
+  }
+
+  const CPDF_ColorState& color = initial_states->color_state();
+  key.has_color_state = color.HasRef();
+  if (key.has_color_state) {
+    key.fill_color_kind = GetVeloceColorKind(color.GetFillColor());
+    key.stroke_color_kind = GetVeloceColorKind(color.GetStrokeColor());
+    key.fill_color_ref = color.GetFillColorRef();
+    key.stroke_color_ref = color.GetStrokeColorRef();
+  }
+  return key;
+}
+
 }  // namespace
 
+class VeloceFormProgramCache final {
+ public:
+  static constexpr size_t kMaxBytes = 96u * 1024u * 1024u;
+  static constexpr size_t kMaxEntries = 16u;
+
+  std::shared_ptr<const VeloceRenderProgram> Find(
+      const VeloceFormInvocationKey& key) {
+    auto it = std::ranges::find(entries_, key, &Entry::key);
+    if (it == entries_.end()) {
+      return nullptr;
+    }
+    if (it->program->mutation_epoch() !=
+        GetVelocePageObjectMutationEpoch()) {
+      retained_bytes_ -= it->bytes;
+      entries_.erase(it);
+      return nullptr;
+    }
+    it->last_use = ++use_clock_;
+    return it->program;
+  }
+
+  void Store(VeloceFormInvocationKey key,
+             std::shared_ptr<const VeloceRenderProgram> program) {
+    CHECK(program);
+    const size_t bytes = program->EstimatedBytes();
+    if (bytes > kMaxBytes) {
+      return;
+    }
+
+    auto same = std::ranges::find(entries_, key, &Entry::key);
+    if (same != entries_.end()) {
+      retained_bytes_ -= same->bytes;
+      entries_.erase(same);
+    }
+    while (!entries_.empty() &&
+           (entries_.size() >= kMaxEntries ||
+            retained_bytes_ > kMaxBytes - bytes)) {
+      auto oldest = std::ranges::min_element(entries_, {}, &Entry::last_use);
+      retained_bytes_ -= oldest->bytes;
+      entries_.erase(oldest);
+    }
+    retained_bytes_ += bytes;
+    entries_.push_back(
+        {std::move(key), std::move(program), bytes, ++use_clock_});
+  }
+
+ private:
+  struct Entry {
+    VeloceFormInvocationKey key;
+    std::shared_ptr<const VeloceRenderProgram> program;
+    size_t bytes = 0u;
+    uint64_t last_use = 0u;
+  };
+
+  std::vector<Entry> entries_;
+  size_t retained_bytes_ = 0u;
+  uint64_t use_clock_ = 0u;
+};
+
 // static
 CPDF_DocPageData* CPDF_DocPageData::FromDocument(const CPDF_Document* doc) {
   return static_cast<CPDF_DocPageData*>(doc->GetPageData());
 }
 
-CPDF_DocPageData::CPDF_DocPageData() = default;
+CPDF_DocPageData::CPDF_DocPageData()
+    : veloce_form_program_cache_(
+          std::make_unique<VeloceFormProgramCache>()) {}
 
 CPDF_DocPageData::~CPDF_DocPageData() {
   for (auto& it : image_map_) {
@@ -435,6 +643,36 @@ RetainPtr<CPDF_Image> CPDF_DocPageData::GetImage(uint32_t dwStreamObjNum) {
   return pImage;
 }
 
+std::shared_ptr<const VeloceRenderProgram>
+CPDF_DocPageData::FindVeloceFormRenderProgram(
+    RetainPtr<const CPDF_Stream> stream,
+    const CPDF_AllStates* initial_states,
+    const CFX_Matrix* parent_matrix,
+    bool transparency_group,
+    bool isolated_group) {
+  std::optional<VeloceFormInvocationKey> key =
+      MakeVeloceFormInvocationKey(std::move(stream), initial_states,
+                                  parent_matrix, transparency_group,
+                                  isolated_group);
+  return key ? veloce_form_program_cache_->Find(*key) : nullptr;
+}
+
+void CPDF_DocPageData::CacheVeloceFormRenderProgram(
+    RetainPtr<const CPDF_Stream> stream,
+    const CPDF_AllStates* initial_states,
+    const CFX_Matrix* parent_matrix,
+    bool transparency_group,
+    bool isolated_group,
+    std::shared_ptr<const VeloceRenderProgram> program) {
+  std::optional<VeloceFormInvocationKey> key =
+      MakeVeloceFormInvocationKey(std::move(stream), initial_states,
+                                  parent_matrix, transparency_group,
+                                  isolated_group);
+  if (key) {
+    veloce_form_program_cache_->Store(std::move(*key), std::move(program));
+  }
+}
+
 void CPDF_DocPageData::MaybePurgeImage(uint32_t dwStreamObjNum) {
   DCHECK(dwStreamObjNum);
   auto it = image_map_.find(dwStreamObjNum);
