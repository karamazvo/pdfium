+FX_RECT GetExpandedClippedDeviceRect(const PathDlNode& node,
+                                     const CFX_Matrix& holder_to_device,
+                                     CFX_RenderDevice* device) {
+  FX_RECT rect =
+      holder_to_device.TransformRect(node.holder_space_bbox).GetOuterRect();
+  if (!rect.IsEmpty()) {
+    rect.left -= 1;
+    rect.top -= 1;
+    rect.right += 1;
+    rect.bottom += 1;
+  }
+  rect.Intersect(device->GetClipBox());
+  return rect;
+}
+
+bool RectsIntersect(const FX_RECT& lhs, const FX_RECT& rhs) {
+  FX_RECT intersection = lhs;
+  intersection.Intersect(rhs);
+  return !intersection.IsEmpty();
+}
+
+void UnionRect(FX_RECT* accumulator, const FX_RECT& rect) {
+  if (rect.IsEmpty()) {
+    return;
+  }
+  if (accumulator->IsEmpty()) {
+    *accumulator = rect;
+    return;
+  }
+  accumulator->left = std::min(accumulator->left, rect.left);
+  accumulator->top = std::min(accumulator->top, rect.top);
+  accumulator->right = std::max(accumulator->right, rect.right);
+  accumulator->bottom = std::max(accumulator->bottom, rect.bottom);
+}
