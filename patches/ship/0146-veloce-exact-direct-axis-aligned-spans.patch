+    pixel->green = AlphaMerge(pixel->green, green, alpha_ratio);
+    pixel->red = AlphaMerge(pixel->red, red, alpha_ratio);
+    return;
+  }
+  pixel->blue = AlphaMerge(pixel->blue, blue, cover);
+  pixel->green = AlphaMerge(pixel->green, green, cover);
+  pixel->red = AlphaMerge(pixel->red, red, cover);
