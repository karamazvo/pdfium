+unsigned ExactRectCoverage(int x_cover, int y_cover, bool no_smooth) {
+  CHECK_GE(x_cover, 0);
+  CHECK_LE(x_cover, agg::poly_base_size);
+  CHECK_GE(y_cover, 0);
+  CHECK_LE(y_cover, agg::poly_base_size);
+  unsigned cover = static_cast<unsigned>(x_cover * y_cover) >>
+                   agg::poly_base_shift;
+  cover = std::min(
+      cover, static_cast<unsigned>(agg::rasterizer_scanline_aa::aa_mask));
+  if (no_smooth) {
+    return cover > agg::rasterizer_scanline_aa::aa_mask / 2
+               ? agg::rasterizer_scanline_aa::aa_mask
