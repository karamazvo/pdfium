 }
 
+TEST(CFXDefaultRenderDeviceTest,
+     OrderedFixedPointCollapsedButtStrokeSkipsRasterPass) {
+  CFX_DefaultRenderDevice baseline;
+  CFX_DefaultRenderDevice batched;
+  CFX_DefaultRenderDevice untouched;
+  ASSERT_TRUE(
+      baseline.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  ASSERT_TRUE(
+      batched.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  ASSERT_TRUE(
+      untouched.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  baseline.GetBitmap()->Clear(0xffffffff);
+  batched.GetBitmap()->Clear(0xffffffff);
+  untouched.GetBitmap()->Clear(0xffffffff);
+
+  const CFX_GraphStateData graph_state;
+  CFX_FillRenderOptions stroke_options;
+  stroke_options.stroke = true;
+  constexpr FX_ARGB kStrokeColor = 0xff204080;
+  const CFX_OrderedPathDraw draw{
+      nullptr, {8.0f, 8.0f}, {8.001f, 8.0f}, CFX_Matrix(), 0,
+      stroke_options};
+
+  CFX_Path source_path;
+  source_path.AppendLine(draw.line_start, draw.line_end);
+  ASSERT_TRUE(baseline.DrawPath(
+      source_path, &draw.object_to_device, &graph_state, /*fill_color=*/0,
+      kStrokeColor, stroke_options));
+
+  auto context = batched.CreateOrderedPathBatchContext();
+  ASSERT_TRUE(context);
+  CFX_OrderedPathBatchStats stats;
+  ASSERT_TRUE(batched.DrawOrderedPathBatch(
+      context.get(), pdfium::span_from_ref(draw), &graph_state, kStrokeColor,
+      stroke_options, &stats));
+  EXPECT_EQ(1u, stats.source_draws);
+  EXPECT_EQ(0u, stats.raster_passes);
+  EXPECT_EQ(1u, stats.zero_coverage_strokes);
+  EXPECT_EQ(0u, stats.direct_butt_line_draws);
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 batched.GetBitmap()->GetBuffer()));
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 untouched.GetBitmap()->GetBuffer()));
+}
+
+TEST(CFXDefaultRenderDeviceTest,
+     OrderedButtStrokeAboveFixedPointCollapseStillRasterizes) {
+  CFX_DefaultRenderDevice baseline;
+  CFX_DefaultRenderDevice batched;
+  CFX_DefaultRenderDevice untouched;
+  ASSERT_TRUE(
+      baseline.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  ASSERT_TRUE(
+      batched.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  ASSERT_TRUE(
+      untouched.Create(/*width=*/32, /*height=*/32, FXDIB_Format::kBgra));
+  baseline.GetBitmap()->Clear(0xffffffff);
+  batched.GetBitmap()->Clear(0xffffffff);
+  untouched.GetBitmap()->Clear(0xffffffff);
+
+  const CFX_GraphStateData graph_state;
+  CFX_FillRenderOptions stroke_options;
+  stroke_options.stroke = true;
+  constexpr FX_ARGB kStrokeColor = 0xff204080;
+  const CFX_OrderedPathDraw draw{
+      nullptr, {8.0f, 8.0f}, {8.01f, 8.0f}, CFX_Matrix(), 0,
+      stroke_options};
+
+  CFX_Path source_path;
+  source_path.AppendLine(draw.line_start, draw.line_end);
+  ASSERT_TRUE(baseline.DrawPath(
+      source_path, &draw.object_to_device, &graph_state, /*fill_color=*/0,
+      kStrokeColor, stroke_options));
+
+  auto context = batched.CreateOrderedPathBatchContext();
+  ASSERT_TRUE(context);
+  CFX_OrderedPathBatchStats stats;
+  ASSERT_TRUE(batched.DrawOrderedPathBatch(
+      context.get(), pdfium::span_from_ref(draw), &graph_state, kStrokeColor,
+      stroke_options, &stats));
+  EXPECT_EQ(1u, stats.source_draws);
+  EXPECT_EQ(1u, stats.raster_passes);
+  EXPECT_EQ(0u, stats.zero_coverage_strokes);
+  EXPECT_EQ(1u, stats.direct_butt_line_draws);
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 batched.GetBitmap()->GetBuffer()));
+  EXPECT_FALSE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                  untouched.GetBitmap()->GetBuffer()));
+}
