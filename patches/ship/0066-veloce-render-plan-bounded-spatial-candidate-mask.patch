+constexpr size_t kSpatialCandidateWordBits = sizeof(uint64_t) * 8;
+
+bool HolderClipContainsIndex(const CFX_FloatRect& holder_clip,
+                             const PathDlSpatialIndex& index) {
+  return holder_clip.left <= index.bounds.left &&
+         holder_clip.right >= index.bounds.right &&
+         holder_clip.bottom <= index.bounds.bottom &&
+         holder_clip.top >= index.bounds.top;
+}
 
+void MarkSpatialCandidate(uint32_t node_index,
+                          size_t node_count,
+                          SpatialReplayQuery* query) {
+  if (node_index >= node_count) {
+    return;
+  }
+  const size_t word_index = node_index / kSpatialCandidateWordBits;
+  const uint64_t bit =
+      uint64_t{1} << (node_index % kSpatialCandidateWordBits);
+  uint64_t& word = query->candidate_words[word_index];
+  if ((word & bit) == 0) {
+    word |= bit;
+    ++query->candidate_count;
+  }
+}
