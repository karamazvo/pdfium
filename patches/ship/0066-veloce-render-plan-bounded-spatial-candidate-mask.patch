+
+void MarkSpatialCandidate(uint32_t node_index,
+                          size_t node_count,
+                          std::vector<uint64_t>* candidate_words,
+                          size_t* candidate_count) {
+  if (node_index >= node_count) {
+    return;
+  }
+  const size_t word_index = node_index / kSpatialCandidateWordBits;
+  const uint64_t bit =
+      uint64_t{1} << (node_index % kSpatialCandidateWordBits);
+  uint64_t& word = (*candidate_words)[word_index];
+  if ((word & bit) == 0) {
+    word |= bit;
+    ++*candidate_count;
+  }
+}
+
+bool IsSpatialCandidate(const std::vector<uint64_t>& candidate_words,
+                        uint32_t node_index) {
+  const size_t word_index = node_index / kSpatialCandidateWordBits;
+  return word_index < candidate_words.size() &&
+         (candidate_words[word_index] &
+          (uint64_t{1} << (node_index % kSpatialCandidateWordBits))) != 0;
+}
