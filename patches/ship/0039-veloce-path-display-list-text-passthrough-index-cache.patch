+bool ResolveTextPassthroughSegments(
+    const NativePathDisplayList& list,
+    const CPDF_PageObjectHolder* holder,
+    std::vector<CPDF_PageObject*>* resolved_objects) {
+  resolved_objects->clear();
+  std::vector<uint32_t> object_indexes;
+  for (const PathDlSegment& segment : list.segments) {
+    if (segment.kind != PathDlSegmentKind::kTextPassthrough) {
+      continue;
+    }
+    if (!object_indexes.empty() &&
+        segment.passthrough_obj_index <= object_indexes.back()) {
+      return false;
+    }
+    object_indexes.push_back(segment.passthrough_obj_index);
+  }
+  if (object_indexes.empty()) {
+    return true;
+  }
+  if (!holder) {
+    return false;
+  }
+
+  size_t next_index = 0;
+  uint32_t current_object_index = 0;
+  for (const auto& obj : *holder) {
+    if (next_index >= object_indexes.size()) {
+      break;
+    }
+    if (object_indexes[next_index] < current_object_index) {
+      return false;
+    }
+    if (object_indexes[next_index] == current_object_index) {
+      if (!obj || !obj->IsText()) {
+        return false;
+      }
+      resolved_objects->push_back(obj.get());
+      next_index++;
+    }
+    current_object_index++;
+  }
+  return next_index == object_indexes.size();
+}
