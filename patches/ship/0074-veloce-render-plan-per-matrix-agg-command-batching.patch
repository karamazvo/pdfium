@@ -1204,17 +1207,16 @@ VelocePathDisplayListResult ReplayPathDisplayList(
   };
 
   // Keep each path as a separate AGG raster/composite operation. The batch
-  // shares only immutable setup for adjacent same-state, same-matrix strokes;
-  // it never merges geometry or changes painter order.
+  // shares immutable setup for adjacent same-paint strokes while retaining
+  // each command's exact matrix. It never merges geometry or changes order.
   std::array<const CFX_Path*, kMaxStrokeBatchNodes> stroke_batch_paths;
+  std::array<CFX_Matrix, kMaxStrokeBatchNodes> stroke_batch_matrices;
   size_t stroke_batch_count = 0;
-  CFX_Matrix stroke_batch_matrix;
   uint32_t stroke_batch_paint_key = kNoClipKey;
   size_t stroke_batch_points = 0;
 
   auto reset_stroke_batch = [&]() {
     stroke_batch_count = 0;
-    stroke_batch_matrix = CFX_Matrix();
     stroke_batch_paint_key = kNoClipKey;
     stroke_batch_points = 0;
   };
@@ -1230,8 +1232,8 @@ VelocePathDisplayListResult ReplayPathDisplayList(
             : &list.graph_state_table[paint.graph_state_key];
     const bool draw_succeeded = device->DrawPathBatch(
         pdfium::span(stroke_batch_paths).first(stroke_batch_count),
-        &stroke_batch_matrix, graph_state, 0, paint.stroke_argb,
-        paint.fill_options);
+        pdfium::span(stroke_batch_matrices).first(stroke_batch_count),
+        graph_state, 0, paint.stroke_argb, paint.fill_options);
     if (replay_stats) {
       const size_t node_count = stroke_batch_count;
       replay_stats->stroke_draw_calls++;
@@ -1329,8 +1331,7 @@ VelocePathDisplayListResult ReplayPathDisplayList(
 
       const size_t node_points = path->GetPoints().size();
       if (stroke_batch_count > 0) {
-        const bool same_state = node.paint_key == stroke_batch_paint_key &&
-                                path_matrix == stroke_batch_matrix;
+        const bool same_state = node.paint_key == stroke_batch_paint_key;
         const bool within_capacity =
             stroke_batch_count < kMaxStrokeBatchNodes &&
             node_points <= kMaxStrokeBatchPoints -
@@ -1348,11 +1349,17 @@ VelocePathDisplayListResult ReplayPathDisplayList(
           }
         }
       }
+      if (stroke_batch_count > 0 &&
+          !(path_matrix == stroke_batch_matrices[stroke_batch_count - 1]) &&
+          replay_stats) {
+        replay_stats->stroke_matrix_changes_batched++;
+      }
       if (stroke_batch_count == 0) {
-        stroke_batch_matrix = path_matrix;
         stroke_batch_paint_key = node.paint_key;
       }
-      stroke_batch_paths[stroke_batch_count++] = path;
+      stroke_batch_paths[stroke_batch_count] = path;
+      stroke_batch_matrices[stroke_batch_count] = path_matrix;
+      stroke_batch_count++;
       stroke_batch_points += node_points;
       if (node_points > kMaxStrokeBatchPoints) {
         // Oversized paths remain individual draws and never inflate a batch.
@@ -1541,6 +1548,8 @@ VelocePathDisplayListResult VeloceReplayCompiledPathDisplayList(
     metrics->stroke_dispatches_saved = replay_stats.stroke_dispatches_saved;
     metrics->max_stroke_batch_nodes = replay_stats.max_stroke_batch_nodes;
     metrics->stroke_state_flushes = replay_stats.stroke_state_flushes;
+    metrics->stroke_matrix_changes_batched =
+        replay_stats.stroke_matrix_changes_batched;
     metrics->stroke_capacity_flushes = replay_stats.stroke_capacity_flushes;
     metrics->spatial_index_queries = replay_stats.spatial_index_queries;
