@@ -329,8 +363,8 @@ void LogPathDisplayListAttempt(const char* result,
   __android_log_print(
       ANDROID_LOG_INFO, "VelocePathDL",
       "result=%s holderKind=%s reason=%s holder=%p integrity=%s legacySkipped=%d "
-      "legacyFallback=%d programCommands=%zu programPaths=%zu "
-      "nodes=%zu paths=%zu paints=%zu graphStates=%zu clips=%zu "
+      "legacyFallback=%d programCommands=%zu programPaths=%zu programTexts=%zu "
+      "segments=%zu passthrough=%zu nodes=%zu paths=%zu paints=%zu graphStates=%zu clips=%zu "
       "scanned=%zu skippedInactive=%zu skippedInvisible=%zu skippedNoFill=%zu "
       "noopClips=%zu blendNodes=%zu scratchBlendNodes=%zu visited=%zu culled=%zu missingPath=%zu drawn=%zu "
       "clipSwitches=%zu cancelChecks=%zu groupRunComposites=%zu groupRunNodes=%zu maxGroupRunNodes=%zu "
@@ -344,6 +378,9 @@ void LogPathDisplayListAttempt(const char* result,
       legacy_fallback ? 1 : 0,
       program ? program->command_count() : kZero,
       program ? program->path_command_count() : kZero,
+      program ? program->text_command_count() : kZero,
+      list ? list->segments.size() : kZero,
+      list ? list->text_passthrough_objects : kZero,
       list ? list->nodes.size() : kZero,
       list ? list->path_table.size() : kZero,
       list ? list->paint_table.size() : kZero,
@@ -613,13 +650,65 @@ bool CompilePathDisplayList(CPDF_RenderStatus* status,
     return reject(PathDlRejectReason::kForcedColor);
   }

+  const VeloceRenderProgram* program = holder->GetVeloceRenderProgram();
+  if (!program || program->command_count() != holder->GetPageObjectCount()) {
+    return reject(PathDlRejectReason::kRenderProgramObjectCountMismatch);
+  }
+  const pdfium::span<const VeloceRenderCommandKind> commands =
+      program->commands();
+  uint32_t pending_path_run_first_node = 0;
+  uint32_t pending_path_run_node_count = 0;
+  auto flush_pending_path_run = [&]() -> bool {
+    if (pending_path_run_node_count == 0) {
+      return true;
+    }
+    if (list->segments.size() >= kMaxPathDisplayListSegments) {
+      return false;
+    }
+    PathDlSegment segment;
+    segment.kind = PathDlSegmentKind::kPathRun;
+    segment.first_node = pending_path_run_first_node;
+    segment.node_count = pending_path_run_node_count;
+    list->segments.push_back(segment);
+    pending_path_run_first_node = 0;
+    pending_path_run_node_count = 0;
+    return true;
+  };
+
+  uint32_t holder_object_index = 0;
   for (const auto& obj : *holder) {
+    const uint32_t current_object_index = holder_object_index++;
     list->scanned_objects++;
     if ((list->scanned_objects % kCancelCheckNodeInterval) == 0 &&
         status->ShouldCancelRender()) {
       return reject(PathDlRejectReason::kCancelled);
     }
-    if (!obj || !obj->IsActive()) {
+    if (!obj) {
+      return reject(PathDlRejectReason::kRenderProgramObjectKindMismatch);
+    }
+    const VeloceRenderCommandKind command_kind =
+        commands[current_object_index];
+    if (command_kind == VeloceRenderCommandKind::kText) {
+      if (!obj->IsText()) {
+        return reject(PathDlRejectReason::kRenderProgramObjectKindMismatch);
+      }
+      if (!flush_pending_path_run()) {
+        return reject(PathDlRejectReason::kSegmentTableOverflow);
+      }
+      if (list->segments.size() >= kMaxPathDisplayListSegments) {
+        return reject(PathDlRejectReason::kSegmentTableOverflow);
+      }
+      PathDlSegment segment;
+      segment.kind = PathDlSegmentKind::kTextPassthrough;
+      segment.object_index = current_object_index;
+      list->segments.push_back(segment);
+      list->text_passthrough_objects++;
+      continue;
+    }
+    if (command_kind != VeloceRenderCommandKind::kPath || !obj->IsPath()) {
+      return reject(PathDlRejectReason::kRenderProgramObjectKindMismatch);
+    }
+    if (!obj->IsActive()) {
       list->skipped_inactive++;
       continue;
     }
@@ -627,9 +716,6 @@ bool CompilePathDisplayList(CPDF_RenderStatus* status,
       list->skipped_invisible++;
       continue;
     }
-    if (!obj->IsPath()) {
-      return reject(PathDlRejectReason::kNonPathObject);
-    }
     if (!HasOnlySimplePathClip(obj->clip_path())) {
       return reject(PathDlRejectReason::kComplexClip);
     }
@@ -716,10 +802,17 @@ bool CompilePathDisplayList(CPDF_RenderStatus* status,
     node.path_index = static_cast<uint32_t>(list->path_table.size() - 1);
     node.paint_key = paint_key.value();
     node.clip_key = clip_key.value();
+    if (pending_path_run_node_count == 0) {
+      pending_path_run_first_node = static_cast<uint32_t>(list->nodes.size());
+    }
     list->nodes.push_back(std::move(node));
+    pending_path_run_node_count++;
   }

-  return !list->nodes.empty()
+  if (!flush_pending_path_run()) {
+    return reject(PathDlRejectReason::kSegmentTableOverflow);
+  }
+  return !list->nodes.empty() && !list->segments.empty()
              ? true
              : reject(PathDlRejectReason::kInactiveOrInvisibleOnly);
 }
@@ -864,11 +957,17 @@ bool FlushGroupRun(CFX_RenderDevice* device,
   return true;
 }

-VelocePathDisplayListResult ReplayPathDisplayList(
+VelocePathDisplayListResult ReplayPathDisplayListRange(
     CPDF_RenderStatus* status,
     const NativePathDisplayList& list,
     const CFX_Matrix& holder_to_device,
-    PathDlReplayStats* replay_stats) {
+    PathDlReplayStats* replay_stats,
+    uint32_t first_node,
+    uint32_t node_count) {
+  if (node_count == 0 || first_node >= list.nodes.size() ||
+      node_count > list.nodes.size() - first_node) {
+    return VelocePathDisplayListResult::kNotEligible;
+  }
   CFX_RenderDevice* device = status->GetRenderDevice();
   if (list.blend_nodes > 0 && !device->RenderCapBlendMode()) {
     return VelocePathDisplayListResult::kNotEligible;
@@ -898,8 +997,10 @@ VelocePathDisplayListResult ReplayPathDisplayList(
     return VelocePathDisplayListResult::kRendered;
   };

-  for (uint32_t i = 0; i < list.nodes.size(); ++i) {
-    if ((i % kCancelCheckNodeInterval) == 0) {
+  const uint32_t end_node = first_node + node_count;
+  uint32_t nodes_considered = 0;
+  for (uint32_t i = first_node; i < end_node; ++i) {
+    if ((nodes_considered++ % kCancelCheckNodeInterval) == 0) {
       if (replay_stats) {
         replay_stats->cancel_checks++;
       }
@@ -1034,6 +1135,71 @@ VelocePathDisplayListResult ReplayPathDisplayList(
   return VelocePathDisplayListResult::kRendered;
 }

+bool ObjectOutsideClip(const CPDF_PageObject* object,
+                       const CFX_FloatRect& holder_clip) {
+  const CFX_FloatRect object_rect = object->GetRect();
+  return object_rect.left > holder_clip.right ||
+         object_rect.right < holder_clip.left ||
+         object_rect.bottom > holder_clip.top ||
+         object_rect.top < holder_clip.bottom;
+}
+
+VelocePathDisplayListResult ReplayPathDisplayList(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    const NativePathDisplayList& list,
+    const CFX_Matrix& holder_to_device,
+    PathDlReplayStats* replay_stats) {
+  size_t passthrough_count = 0;
+  for (const PathDlSegment& segment : list.segments) {
+    if (segment.kind != PathDlSegmentKind::kTextPassthrough) {
+      continue;
+    }
+    CPDF_PageObject* object =
+        holder->GetPageObjectByIndex(segment.object_index);
+    if (!object || !object->IsText()) {
+      return VelocePathDisplayListResult::kNotEligible;
+    }
+    ++passthrough_count;
+  }
+  if (passthrough_count != list.text_passthrough_objects) {
+    return VelocePathDisplayListResult::kNotEligible;
+  }
+
+  const CFX_FloatRect holder_clip =
+      holder_to_device.GetInverse().TransformRect(
+          CFX_FloatRect(status->GetRenderDevice()->GetClipBox()));
+  CPDF_ClipPath empty_clip;
+  for (const PathDlSegment& segment : list.segments) {
+    if (status->ShouldCancelRender()) {
+      return VelocePathDisplayListResult::kCancelled;
+    }
+    if (segment.kind == PathDlSegmentKind::kPathRun) {
+      const VelocePathDisplayListResult result = ReplayPathDisplayListRange(
+          status, list, holder_to_device, replay_stats, segment.first_node,
+          segment.node_count);
+      status->ProcessClipPath(empty_clip, holder_to_device);
+      if (result != VelocePathDisplayListResult::kRendered) {
+        return result;
+      }
+      continue;
+    }
+
+    CPDF_PageObject* object =
+        holder->GetPageObjectByIndex(segment.object_index);
+    if (object->IsActive() && !ObjectOutsideClip(object, holder_clip)) {
+      status->RenderSingleObject(object, holder_to_device);
+    }
+    // RenderSingleObject updates CPDF_RenderStatus' clip cache. Return both the
+    // status cache and the device to their baseline before the next path run.
+    status->ProcessClipPath(empty_clip, holder_to_device);
+    if (status->ShouldCancelRender()) {
+      return VelocePathDisplayListResult::kCancelled;
+    }
+  }
+  return VelocePathDisplayListResult::kRendered;
+}
+
 }  // namespace

