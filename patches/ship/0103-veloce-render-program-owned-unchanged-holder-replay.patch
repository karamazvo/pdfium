-  // opcode in the same ordered stream as canonical commands.
+  // Self-owned exact opaque line executed in the same ordered stream as
+  // canonical commands.
   kNativeOpaqueLine,
   // Self-owned exact multi-segment, stroke-only path. It shares the opaque
   // graphics-state and ordered clip-run representation with native lines.
@@ -224,7 +222,7 @@ class VeloceNativeLineStorage final {
 
 // Immutable native rendering representation owned by one live page-object
