+++ b/core/fpdfapi/page/veloce_render_program.cpp
@@ -527,8 +527,7 @@ bool VeloceRenderProgramBuilder::WouldExceedRetainedBudget(
           sizeof(VeloceVisibilityRun) +
       (clip_runs_.size() + (needs_clip_run ? 1u : 0u)) *
           sizeof(VeloceClipRun) +
-      ((bytecode_.size() + 1u - kMinNativeCompileCommands +
-        kCommandBlockSize - 1u) /
+      ((bytecode_.size() + 1u + kCommandBlockSize - 1u) /
        kCommandBlockSize) * sizeof(VeloceCommandBlock) +
       leaf_range_count * sizeof(VeloceLineLeafRange) +
       coarse_range_count * sizeof(VeloceLineCoarseRange);
@@ -789,33 +788,30 @@ void VeloceRenderProgramBuilder::AppendPageObject(
     exceeded_budget_ = true;
     return;
   }
-  const bool compile_native =
-      bytecode_.size() >= kMinNativeCompileCommands;
-  if (compile_native && build_start_millis_ == 0u) {
+  if (build_start_millis_ == 0u) {
     build_start_millis_ = NowMillis();
   }
   VeloceRenderOpcode opcode = ToCanonicalOpcode(object);
-  if (compile_native) {
-    CFX_FloatRect bounds = object.GetRect();
-    bounds.Normalize();
-    const bool bounds_known = IsFiniteRect(bounds) && !bounds.IsEmpty();
-    const size_t previous_line_count = native_lines_.size();
-    if (TryAppendNativeOpaqueStroke(object, bounds, bounds_known)) {
-      opcode = last_native_was_darken_
-                   ? VeloceRenderOpcode::kNativeDarkenStrokePath
-                   : (native_lines_.size() != previous_line_count
-                          ? VeloceRenderOpcode::kNativeOpaqueLine
-                          : VeloceRenderOpcode::kNativeOpaqueStrokePath);
-    }
-    AppendCommandBlock(opcode, bounds, bounds_known);
-  }
+  CFX_FloatRect bounds = object.GetRect();
+  bounds.Normalize();
+  const bool bounds_known = IsFiniteRect(bounds) && !bounds.IsEmpty();
+  const size_t previous_line_count = native_lines_.size();
+  if (TryAppendNativeOpaqueStroke(object, bounds, bounds_known)) {
+    opcode = last_native_was_darken_
+                 ? VeloceRenderOpcode::kNativeDarkenStrokePath
+                 : (native_lines_.size() != previous_line_count
+                        ? VeloceRenderOpcode::kNativeOpaqueLine
+                        : VeloceRenderOpcode::kNativeOpaqueStrokePath);
+  }
+  AppendCommandBlock(opcode, bounds, bounds_known);
   bytecode_.push_back(static_cast<uint8_t>(opcode));
   ++opcode_counts_[static_cast<size_t>(opcode)];
 }
 
