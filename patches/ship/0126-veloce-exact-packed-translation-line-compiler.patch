+      {1.0f, 2.0f}, {3.0f, 4.0f}, CFX_Matrix(),
+      object->graphic_states(), *object->GetContentMarks()));
+  ASSERT_TRUE(builder.AppendParsedOpaqueLine(
+      CFX_PointF(), CFX_PointF(), CFX_Matrix(),
+      object->graphic_states(), *object->GetContentMarks(),
+      /*stream_fused=*/true, /*translation_origin=*/true));
