+bool CPDF_StreamParser::TryParseTranslationOriginStrokeLine(
+    std::array<float, 4>* operands) {
+  uint32_t candidate_position = pos_;
+  std::array<float, 4> candidate = {};
+  if (!ReadVelocePathOperator(buf_, &candidate_position, 'q') ||
+      !ReadVeloceExactNumberToken(buf_, &candidate_position, '1') ||
+      !ReadVeloceExactNumberToken(buf_, &candidate_position, '0') ||
+      !ReadVeloceExactNumberToken(buf_, &candidate_position, '0') ||
+      !ReadVeloceExactNumberToken(buf_, &candidate_position, '1') ||
+      !ReadVelocePathNumber(buf_, &candidate_position, &candidate[0]) ||
+      !ReadVelocePathNumber(buf_, &candidate_position, &candidate[1]) ||
+      !ReadVelocePathOperator(buf_, &candidate_position, 'c', 'm') ||
+      !ReadVeloceExactNumberToken(buf_, &candidate_position, '0') ||
+      !ReadVeloceExactNumberToken(buf_, &candidate_position, '0') ||
+      !ReadVelocePathOperator(buf_, &candidate_position, 'm') ||
+      !ReadVelocePathNumber(buf_, &candidate_position, &candidate[2]) ||
+      !ReadVelocePathNumber(buf_, &candidate_position, &candidate[3]) ||
+      !ReadVelocePathOperator(buf_, &candidate_position, 'l') ||
+      !ReadVelocePathOperator(buf_, &candidate_position, 'S') ||
+      !ReadVelocePathOperator(buf_, &candidate_position, 'Q')) {
+    return false;
+  }
+
+  last_obj_.Reset();
+  word_size_ = 0u;
+  pos_ = candidate_position;
+  *operands = candidate;
+  return true;
+}
