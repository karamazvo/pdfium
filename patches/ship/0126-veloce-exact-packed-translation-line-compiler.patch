+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(2u, program->command_count());
+  EXPECT_EQ(1u, program->native_line_count());
+  EXPECT_EQ(0u, program->native_translation_line_count());
+  EXPECT_TRUE(program->IsExactNoOp(1u));
