 }
+
+TEST(CPDFStreamParserTest, ParsesTranslationOriginStrokeWithFourConversions) {
+  uint8_t data[] = "q 1 0 0 1 10 -20 cm 0 0 m 3 +4.5 l S Q q";
+  CPDF_StreamParser parser(data);
+  std::array<float, 4> operands = {};
+
+  EXPECT_TRUE(parser.TryParseTranslationOriginStrokeLine(&operands));
+  EXPECT_FLOAT_EQ(10.0f, operands[0]);
+  EXPECT_FLOAT_EQ(-20.0f, operands[1]);
+  EXPECT_FLOAT_EQ(3.0f, operands[2]);
+  EXPECT_FLOAT_EQ(4.5f, operands[3]);
+  EXPECT_EQ(CPDF_StreamParser::ElementType::kKeyword,
+            parser.ParseNextElement());
+  EXPECT_EQ("q", parser.GetWord());
+}
+
+TEST(CPDFStreamParserTest, CompactTranslationGrammarFailsClosed) {
+  uint8_t data[] = "q 1.0 0 0 1 10 -20 cm 0 0 m 3 4 l S Q";
+  CPDF_StreamParser parser(data);
+  std::array<float, 4> operands = {};
+
+  EXPECT_FALSE(parser.TryParseTranslationOriginStrokeLine(&operands));
+  EXPECT_EQ(0u, parser.GetPos());
+}
