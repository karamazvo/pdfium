+TEST(VeloceRenderProgramTest,
+     TranslationOriginLinesUseExactCompactPayload) {
+  auto object = MakeOpaqueLine(1.0f, 3.0f);
+  VeloceRenderProgramBuilder builder(
+      0u, CFX_FloatRect(-100.0f, -100.0f, 100.0f, 100.0f));
+
+  ASSERT_TRUE(builder.AppendParsedOpaqueLine(
+      {1.0f, 2.0f}, {3.0f, 4.0f},
+      CFX_Matrix(1.0f, 0.0f, 0.0f, 1.0f, 5.0f, 6.0f),
+      object->graphic_states(), *object->GetContentMarks()));
+  ASSERT_TRUE(builder.AppendParsedOpaqueLine(
+      CFX_PointF(), {9.0f, 10.0f},
+      CFX_Matrix(1.0f, 0.0f, 0.0f, 1.0f, 11.0f, 12.0f),
+      object->graphic_states(), *object->GetContentMarks(),
+      /*stream_fused=*/true, /*translation_origin=*/true));
+  ASSERT_TRUE(builder.AppendParsedOpaqueLine(
+      CFX_PointF(), {15.0f, 16.0f},
+      CFX_Matrix(1.0f, 0.0f, 0.0f, 1.0f, 17.0f, 18.0f),
+      object->graphic_states(), *object->GetContentMarks(),
+      /*stream_fused=*/true, /*translation_origin=*/true));
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(1u, program->native_line_count());
+  EXPECT_EQ(2u, program->native_translation_line_count());
+  EXPECT_EQ(9.0f, program->native_translation_line(0).end.x);
+  EXPECT_EQ(10.0f, program->native_translation_line(0).end.y);
+  EXPECT_EQ(11.0f, program->native_translation_line(0).translation_x);
+  EXPECT_EQ(12.0f, program->native_translation_line(0).translation_y);
+  EXPECT_EQ(15.0f, program->native_translation_line(1).end.x);
+  EXPECT_EQ(16.0f, program->native_translation_line(1).end.y);
+  EXPECT_EQ(17.0f, program->native_translation_line(1).translation_x);
+  EXPECT_EQ(18.0f, program->native_translation_line(1).translation_y);
+  ASSERT_EQ(1u, program->native_translation_line_runs().size());
+  EXPECT_EQ(2u, program->native_translation_line_runs()[0].line_count);
+  ASSERT_EQ(2u, program->native_runs().size());
+  EXPECT_EQ(VeloceRenderOpcode::kNativeTranslationOriginLine,
+            program->native_runs()[1].opcode);
+  EXPECT_EQ(2u, program->native_runs()[1].command_count);
+}
+
+TEST(VeloceRenderProgramTest,
