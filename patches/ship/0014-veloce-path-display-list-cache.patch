@@ -38,9 +41,11 @@ constexpr uint32_t kVeloceFeaturePathDisplayListForm = 0x00000001u;
 constexpr uint32_t kNoClipKey = std::numeric_limits<uint32_t>::max();
 constexpr uint32_t kMaxClipPathCount = 16;
 constexpr uint32_t kCancelCheckNodeInterval = 64;
+constexpr size_t kMaxCachedPathDisplayLists = 32;
 
 enum class PathDlRejectReason {
   kNone,
+  kCancelled,
   kFeatureDisabled,
   kForcedColor,
   kInactiveOrInvisibleOnly,
@@ -80,6 +85,37 @@ struct NativePathDisplayList {
   size_t skipped_no_fill = 0;
 };
 
+struct PathDisplayListCacheKey {
+  const CPDF_Document* document = nullptr;
+  const CPDF_PageObjectHolder* holder = nullptr;
+  uint32_t holder_dict_obj_num = 0;
+  bool aliased_path = false;
+
+  bool operator==(const PathDisplayListCacheKey& other) const {
+    return document == other.document && holder == other.holder &&
+           holder_dict_obj_num == other.holder_dict_obj_num &&
+           aliased_path == other.aliased_path;
+  }
+};
+
+struct PathDisplayListCacheKeyHash {
+  size_t operator()(const PathDisplayListCacheKey& key) const {
+    size_t hash = std::hash<const CPDF_Document*>()(key.document);
+    hash ^= std::hash<const CPDF_PageObjectHolder*>()(key.holder) +
+            0x9e3779b97f4a7c15ull + (hash << 6) + (hash >> 2);
+    hash ^= std::hash<uint32_t>()(key.holder_dict_obj_num) +
+            0x9e3779b97f4a7c15ull + (hash << 6) + (hash >> 2);
+    hash ^= std::hash<bool>()(key.aliased_path) + 0x9e3779b97f4a7c15ull +
+            (hash << 6) + (hash >> 2);
+    return hash;
+  }
+};
+
+struct PathDisplayListCacheEntry {
+  std::shared_ptr<const NativePathDisplayList> list;
+  uint64_t last_use = 0;
+};
+
 struct PathDlReplayStats {
   size_t visited_nodes = 0;
   size_t culled_nodes = 0;
@@ -108,6 +144,8 @@ const char* RejectReasonName(PathDlRejectReason reason) {
   switch (reason) {
     case PathDlRejectReason::kNone:
       return "none";
+    case PathDlRejectReason::kCancelled:
+      return "cancelled";
     case PathDlRejectReason::kFeatureDisabled:
       return "feature_disabled";
     case PathDlRejectReason::kForcedColor:
@@ -157,6 +195,7 @@ bool DisplayListIntegrityOk(const NativePathDisplayList& list) {
 }
 
 void LogPathDisplayListAttempt(const char* result,
+                               const char* cache_state,
                                PathDlRejectReason reason,
                                const CPDF_PageObjectHolder* holder,
                                const NativePathDisplayList* list,
@@ -176,7 +215,7 @@ void LogPathDisplayListAttempt(const char* result,
       "legacyFallback=%d nodes=%zu paths=%zu paints=%zu clips=%zu "
       "scanned=%zu skippedInactive=%zu skippedInvisible=%zu skippedNoFill=%zu "
       "visited=%zu culled=%zu missingPath=%zu drawn=%zu clipSwitches=%zu "
-      "cancelChecks=%zu compileMs=%" PRId64 " replayMs=%" PRId64
+      "cancelChecks=%zu cache=%s compileMs=%" PRId64 " replayMs=%" PRId64
       " totalFastMs=%" PRId64 " estimatedDispatchAvoided=%zu",
       result, RejectReasonName(reason), holder,
       integrity_ok ? "ok" : "bad", legacy_skipped ? 1 : 0,
@@ -194,12 +233,90 @@ void LogPathDisplayListAttempt(const char* result,
       replay_stats ? replay_stats->missing_path_nodes : kZero,
       replay_stats ? replay_stats->drawn_nodes : kZero,
       replay_stats ? replay_stats->clip_switches : kZero,
-      replay_stats ? replay_stats->cancel_checks : kZero, compile_ms,
+      replay_stats ? replay_stats->cancel_checks : kZero,
+      cache_state ? cache_state : "none", compile_ms,
       replay_ms, compile_ms + replay_ms,
       list ? list->nodes.size() : kZero);
 #endif
 }
 
+std::mutex& PathDisplayListCacheMutex() {
+  static std::mutex* mutex = new std::mutex();
+  return *mutex;
+}
+
+std::unordered_map<PathDisplayListCacheKey,
+                   PathDisplayListCacheEntry,
+                   PathDisplayListCacheKeyHash>&
+PathDisplayListCache() {
+  static auto* cache = new std::unordered_map<PathDisplayListCacheKey,
+                                              PathDisplayListCacheEntry,
+                                              PathDisplayListCacheKeyHash>();
+  return *cache;
+}
+
+uint64_t& PathDisplayListCacheUseCounter() {
+  static uint64_t* counter = new uint64_t(0);
+  return *counter;
+}
+
+PathDisplayListCacheKey MakePathDisplayListCacheKey(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder) {
+  PathDisplayListCacheKey key;
+  key.document = holder->GetDocument();
+  key.holder = holder;
+  RetainPtr<const CPDF_Dictionary> dict = holder->GetDict();
+  key.holder_dict_obj_num = dict ? dict->GetObjNum() : 0;
+  key.aliased_path = status->GetRenderOptions().GetOptions().bNoPathSmooth;
+  return key;
+}
+
+std::shared_ptr<const NativePathDisplayList> FindCachedPathDisplayList(
+    const PathDisplayListCacheKey& key) {
+  std::lock_guard<std::mutex> lock(PathDisplayListCacheMutex());
+  auto& cache = PathDisplayListCache();
+  auto it = cache.find(key);
+  if (it == cache.end()) {
+    return nullptr;
+  }
+  it->second.last_use = ++PathDisplayListCacheUseCounter();
+  return it->second.list;
+}
+
+void EvictOnePathDisplayListLocked() {
+  auto& cache = PathDisplayListCache();
+  if (cache.empty()) {
+    return;
+  }
+  auto oldest = cache.begin();
+  for (auto it = cache.begin(); it != cache.end(); ++it) {
+    if (it->second.last_use < oldest->second.last_use) {
+      oldest = it;
+    }
+  }
+  cache.erase(oldest);
+}
+
+std::shared_ptr<const NativePathDisplayList> StoreCachedPathDisplayList(
+    const PathDisplayListCacheKey& key,
+    std::unique_ptr<NativePathDisplayList> list) {
+  auto shared = std::shared_ptr<const NativePathDisplayList>(std::move(list));
+  std::lock_guard<std::mutex> lock(PathDisplayListCacheMutex());
+  auto& cache = PathDisplayListCache();
+  auto existing = cache.find(key);
+  if (existing != cache.end()) {
+    existing->second.last_use = ++PathDisplayListCacheUseCounter();
+    return existing->second.list;
+  }
+  if (cache.size() >= kMaxCachedPathDisplayLists) {
+    EvictOnePathDisplayListLocked();
+  }
+  cache.emplace(key, PathDisplayListCacheEntry{
+                         shared, ++PathDisplayListCacheUseCounter()});
+  return shared;
+}
+
 bool HasOnlySimplePathClip(const CPDF_ClipPath& clip_path) {
   if (!clip_path.HasRef()) {
     return true;
@@ -303,6 +420,10 @@ bool CompilePathDisplayList(CPDF_RenderStatus* status,
 
   for (const auto& obj : *holder) {
