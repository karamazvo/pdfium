+        status->ShouldCancelRender()) {
+      return reject(PathDlRejectReason::kCancelled);
+    }
     if (!obj || !obj->IsActive()) {
       list->skipped_inactive++;
       continue;
@@ -470,24 +591,42 @@ VelocePathDisplayListResult VeloceTryRenderPathDisplayList(
     return VelocePathDisplayListResult::kNotEligible;
   }
 
-  NativePathDisplayList list;
+  const PathDisplayListCacheKey cache_key =
+      MakePathDisplayListCacheKey(status, holder);
+  std::shared_ptr<const NativePathDisplayList> cached_list =
+      FindCachedPathDisplayList(cache_key);
   PathDlRejectReason reject_reason = PathDlRejectReason::kNone;
-  const int64_t compile_start_ns = NowNs();
-  if (!CompilePathDisplayList(status, holder, &list, &reject_reason)) {
-    LogPathDisplayListAttempt("not_eligible", reject_reason, holder, &list,
-                              nullptr, ElapsedMs(compile_start_ns), 0);
-    return VelocePathDisplayListResult::kNotEligible;
+  int64_t compile_ms = 0;
+
+  if (!cached_list) {
+    auto compiled_list = std::make_unique<NativePathDisplayList>();
+    const int64_t compile_start_ns = NowNs();
+    if (!CompilePathDisplayList(status, holder, compiled_list.get(),
+                                &reject_reason)) {
+      compile_ms = ElapsedMs(compile_start_ns);
+      if (reject_reason == PathDlRejectReason::kCancelled) {
+        LogPathDisplayListAttempt("cancelled", "miss", reject_reason, holder,
+                                  compiled_list.get(), nullptr, compile_ms, 0);
+        return VelocePathDisplayListResult::kCancelled;
+      }
+      LogPathDisplayListAttempt("not_eligible", "miss", reject_reason, holder,
+                                compiled_list.get(), nullptr, compile_ms, 0);
+      return VelocePathDisplayListResult::kNotEligible;
+    }
+    compile_ms = ElapsedMs(compile_start_ns);
+    cached_list =
+        StoreCachedPathDisplayList(cache_key, std::move(compiled_list));
   }
-  const int64_t compile_ms = ElapsedMs(compile_start_ns);
 
   PathDlReplayStats replay_stats;
   const int64_t replay_start_ns = NowNs();
   const VelocePathDisplayListResult result =
-      ReplayPathDisplayList(status, list, holder_to_device, &replay_stats);
+      ReplayPathDisplayList(status, *cached_list, holder_to_device,
+                            &replay_stats);
   LogPathDisplayListAttempt(
       result == VelocePathDisplayListResult::kRendered ? "rendered"
                                                        : "cancelled",
-      PathDlRejectReason::kNone, holder, &list, &replay_stats, compile_ms,
-      ElapsedMs(replay_start_ns));
+      compile_ms == 0 ? "hit" : "miss", PathDlRejectReason::kNone, holder,
+      cached_list.get(), &replay_stats, compile_ms, ElapsedMs(replay_start_ns));
   return result;
 }
