+void VeloceRenderProgramBuilder::AppendCommandBlock(
+    VeloceRenderOpcode opcode,
+    const CFX_FloatRect& bounds,
+    bool bounds_known) {
+  if (pending_command_block_.command_count == 0u) {
+    pending_command_block_.first_command =
+        static_cast<uint32_t>(bytecode_.size());
+    pending_command_block_.first_native_line =
+        static_cast<uint32_t>(native_lines_.size());
+    pending_command_block_.first_native_path =
+        static_cast<uint32_t>(native_stroke_paths_.size());
+    if (opcode == VeloceRenderOpcode::kNativeOpaqueLine) {
+      --pending_command_block_.first_native_line;
+    }
+    if (opcode == VeloceRenderOpcode::kNativeOpaqueStrokePath ||
+        opcode == VeloceRenderOpcode::kNativeDarkenStrokePath) {
+      --pending_command_block_.first_native_path;
+    }
+  }
+
+  ++pending_command_block_.command_count;
+  if (opcode == VeloceRenderOpcode::kNativeOpaqueLine) {
+    ++pending_command_block_.native_line_count;
+  } else if (opcode == VeloceRenderOpcode::kNativeOpaqueStrokePath ||
+             opcode == VeloceRenderOpcode::kNativeDarkenStrokePath) {
+    ++pending_command_block_.native_path_count;
+  }
+
+  if (bounds_known) {
+    UnionKnownBounds(bounds, &pending_command_block_.bounds);
+  } else {
+    pending_command_block_.flags |= kVeloceCommandBlockUnbounded;
+  }
+  if (pending_command_block_.command_count == kCommandBlockSize) {
+    SealPendingCommandBlock();
+  }
+}
+
+void VeloceRenderProgramBuilder::SealPendingCommandBlock() {
+  if (pending_command_block_.command_count == 0u) {
+    return;
+  }
+  if (command_blocks_.size() >= kMaxCommandBlocks) {
+    exceeded_budget_ = true;
+    return;
+  }
+  command_blocks_.push_back(pending_command_block_);
+  pending_command_block_ = VeloceCommandBlock();
+}
