+// Exact ordered metadata for a consecutive suffix of commands. Bounds are a
+// conservative union of the same holder-space object bounds used by canonical
+// replay. An unknown bound makes the entire block fail open.
+struct VeloceCommandBlock {
+  CFX_FloatRect bounds;
+  uint32_t first_command = 0;
+  uint32_t first_native_line = 0;
+  uint32_t first_native_path = 0;
+  uint16_t command_count = 0;
+  uint16_t native_line_count = 0;
+  uint16_t native_path_count = 0;
+  uint16_t flags = 0;
+};
+static_assert(sizeof(VeloceCommandBlock) == 36u);
