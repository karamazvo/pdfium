+bool CFX_AggDeviceDriver::DrawPathWithBlend(
+    const CFX_Path& path,
+    const CFX_Matrix* pObject2Device,
+    const CFX_GraphStateData* pGraphState,
+    uint32_t fill_color,
+    uint32_t stroke_color,
+    const CFX_FillRenderOptions& fill_options,
+    BlendMode blend_mode) {
+  const FXDIB_Format destination_format = bitmap_->GetFormat();
+  const bool supported_destination =
+      destination_format == FXDIB_Format::kBgr ||
+      destination_format == FXDIB_Format::kBgrx ||
+      destination_format == FXDIB_Format::kBgra;
+  const bool has_fill =
+      fill_options.fill_type != CFX_FillRenderOptions::FillType::kNoFill &&
+      FXARGB_A(fill_color) != 0;
+  const bool has_stroke = pGraphState && FXARGB_A(stroke_color) != 0;
+  if (blend_mode != BlendMode::kDarken || !supported_destination ||
+      has_fill == has_stroke || fill_options.full_cover || group_knockout_) {
+    return false;
+  }
+  if (bitmap_->GetBuffer().empty()) {
+    return true;
+  }
+
+  fill_options_ = fill_options;
+  agg::rasterizer_scanline_aa rasterizer;
+  rasterizer.clip_box(0.0f, 0.0f, static_cast<float>(GetPixelWidth()),
+                      static_cast<float>(GetPixelHeight()));
+  if (has_fill) {
+    agg::path_storage path_data = BuildAggPath(path, pObject2Device);
+    rasterizer.add_path(path_data);
+    rasterizer.filling_rule(GetAlternateOrWindingFillType(fill_options));
+    RenderRasterizerWithBlend(rasterizer, fill_color, blend_mode);
+    return true;
+  }
+
+  if (fill_options.zero_area) {
+    agg::path_storage path_data = BuildAggPath(path, pObject2Device);
+    RasterizeStroke(&rasterizer, &path_data, nullptr, pGraphState, 1,
+                    fill_options.stroke_text_mode);
+    RenderRasterizerWithBlend(rasterizer, stroke_color, blend_mode);
+    return true;
+  }
+
+  CFX_Matrix matrix1;
+  CFX_Matrix matrix2;
+  if (pObject2Device) {
+    matrix1.a = std::max(fabs(pObject2Device->a), fabs(pObject2Device->b));
+    matrix1.d = matrix1.a;
+    if (matrix1.a == 0.0f) {
+      return false;
+    }
+    matrix2 = CFX_Matrix(
+        pObject2Device->a / matrix1.a, pObject2Device->b / matrix1.a,
+        pObject2Device->c / matrix1.d, pObject2Device->d / matrix1.d, 0, 0);
+    matrix1 = *pObject2Device * matrix2.GetInverse();
+  }
+  agg::path_storage path_data = BuildAggPath(path, &matrix1);
+  RasterizeStroke(&rasterizer, &path_data, &matrix2, pGraphState, matrix1.a,
+                  fill_options.stroke_text_mode);
+  RenderRasterizerWithBlend(rasterizer, stroke_color, blend_mode);
+  return true;
+}
