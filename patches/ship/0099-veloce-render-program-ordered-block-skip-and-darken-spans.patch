+TEST(CFXDIBitmapTest, DarkenCoverageAndClipMatchSingleBgraObject) {
+  constexpr uint32_t kSourceRgb = 0x002850a0;
+  constexpr FXDIB_Format kDestinationFormats[] = {
+      FXDIB_Format::kBgr, FXDIB_Format::kBgrx, FXDIB_Format::kBgra};
+  constexpr uint32_t kDestinations[] = {0xffc86432, 0x80c86432, 0x012040e0,
+                                        0x00000000};
+  constexpr uint8_t kAlphas[] = {1, 64, 127, 255};
+  constexpr uint8_t kCoverages[] = {1, 63, 128, 255};
+  constexpr uint8_t kClipCoverages[] = {1, 47, 191, 255};
+  const FX_RECT clip_rect(0, 0, 1, 1);
+
+  for (FXDIB_Format destination_format : kDestinationFormats) {
+    for (uint32_t destination : kDestinations) {
+      for (uint8_t source_alpha : kAlphas) {
+        for (uint8_t coverage : kCoverages) {
+          for (uint8_t clip_coverage : kClipCoverages) {
+            auto baseline = pdfium::MakeRetain<CFX_DIBitmap>();
+            auto direct = pdfium::MakeRetain<CFX_DIBitmap>();
+            auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+            auto mask = pdfium::MakeRetain<CFX_DIBitmap>();
+            auto baseline_clip = pdfium::MakeRetain<CFX_DIBitmap>();
+            auto direct_clip = pdfium::MakeRetain<CFX_DIBitmap>();
+            ASSERT_TRUE(baseline->Create(1, 1, destination_format));
+            ASSERT_TRUE(direct->Create(1, 1, destination_format));
+            ASSERT_TRUE(source->Create(1, 1, FXDIB_Format::kBgra));
+            ASSERT_TRUE(mask->Create(1, 1, FXDIB_Format::k8bppMask));
+            ASSERT_TRUE(
+                baseline_clip->Create(1, 1, FXDIB_Format::k8bppMask));
+            ASSERT_TRUE(direct_clip->Create(1, 1,
+                                            FXDIB_Format::k8bppMask));
+            baseline->Clear(destination);
+            direct->Clear(destination);
+            const uint8_t effective_alpha =
+                static_cast<uint8_t>(source_alpha * coverage / 255);
+            source->Clear((static_cast<uint32_t>(effective_alpha) << 24) |
+                          kSourceRgb);
+            mask->GetWritableScanline(0)[0] = coverage;
+            baseline_clip->GetWritableScanline(0)[0] = clip_coverage;
+            direct_clip->GetWritableScanline(0)[0] = clip_coverage;
+
+            ASSERT_TRUE(baseline->CompositeBitmap(
+                0, 0, 1, 1, source, 0, 0, BlendMode::kDarken, &clip_rect,
+                std::move(baseline_clip), /*bRgbByteOrder=*/false));
+            ASSERT_TRUE(direct->CompositeMask(
+                0, 0, 1, 1, mask,
+                (static_cast<uint32_t>(source_alpha) << 24) | kSourceRgb, 0,
+                0, BlendMode::kDarken, &clip_rect, std::move(direct_clip),
+                /*bRgbByteOrder=*/false));
+            EXPECT_TRUE(std::ranges::equal(baseline->GetBuffer(),
+                                           direct->GetBuffer()));
+          }
+        }
+      }
+    }
+  }
+}
