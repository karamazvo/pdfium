diff --git a/core/fpdfapi/render/veloce_render_plan.cpp b/core/fpdfapi/render/veloce_render_plan.cpp
new file mode 100644
index 000000000..b5fc813f1
--- /dev/null
+++ b/core/fpdfapi/render/veloce_render_plan.cpp
@@ -0,0 +1,55 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#include "core/fpdfapi/render/veloce_render_plan.h"
+
+#include "core/fpdfapi/render/veloce_path_display_list.h"
+
+namespace {
+
+VelocePathDisplayListHolderKind ToPathDisplayListHolderKind(
+    VeloceRenderPlanHolderKind holder_kind) {
+  switch (holder_kind) {
+    case VeloceRenderPlanHolderKind::kRootPage:
+      return VelocePathDisplayListHolderKind::kRootPage;
+    case VeloceRenderPlanHolderKind::kForm:
+      return VelocePathDisplayListHolderKind::kForm;
+  }
+  return VelocePathDisplayListHolderKind::kForm;
+}
+
+VeloceRenderPlanResult ToRenderPlanResult(VelocePathDisplayListResult result) {
+  switch (result) {
+    case VelocePathDisplayListResult::kNotEligible:
+      return VeloceRenderPlanResult::kNotEligible;
+    case VelocePathDisplayListResult::kRendered:
+      return VeloceRenderPlanResult::kRendered;
+    case VelocePathDisplayListResult::kCancelled:
+      return VeloceRenderPlanResult::kCancelled;
+  }
+  return VeloceRenderPlanResult::kNotEligible;
+}
+
+}  // namespace
+
+VeloceRenderPlanResult VeloceTryRenderPlanForHolder(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    const CFX_Matrix& holder_to_device,
+    VeloceRenderPlanHolderKind holder_kind) {
+  // This facade is the only PDFium-renderer-facing acceleration boundary.
+  //
+  // The contract is fail-closed: kNotEligible means no accelerated backend
+  // drew pixels, so the caller must continue through the original PDFium
+  // pipeline. kRendered means the holder is complete in the caller's current
+  // render device. kCancelled means the caller should stop the current render
+  // without legacy fallback because cancellation output will be discarded.
+  //
+  // r25 keeps behavior identical by delegating to the existing path display
+  // list backend. Later ordered RenderPlan patches should compose backends
+  // here rather than adding more hooks to CPDF_RenderStatus or
+  // CPDF_ProgressiveRenderer.
+  return ToRenderPlanResult(VeloceTryRenderPathDisplayListForHolder(
+      status, holder, holder_to_device,
+      ToPathDisplayListHolderKind(holder_kind)));
+}
diff --git a/core/fpdfapi/render/veloce_render_plan.h b/core/fpdfapi/render/veloce_render_plan.h
new file mode 100644
index 000000000..3ddfc5345
--- /dev/null
+++ b/core/fpdfapi/render/veloce_render_plan.h
@@ -0,0 +1,40 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#ifndef CORE_FPDFAPI_RENDER_VELOCE_RENDER_PLAN_H_
+#define CORE_FPDFAPI_RENDER_VELOCE_RENDER_PLAN_H_
+
+#include "core/fxcrt/fx_coordinates.h"
+
+class CPDF_PageObjectHolder;
+class CPDF_RenderStatus;
+
+enum class VeloceRenderPlanResult {
+  // No pixels were drawn; caller must continue with the original PDFium path.
+  kNotEligible,
+  // The full holder was rendered into the caller's current render device.
+  kRendered,
+  // Rendering was cancelled; caller should stop without legacy fallback.
+  kCancelled,
+};
+
+enum class VeloceRenderPlanHolderKind {
+  kRootPage,
+  kForm,
+};
+
+// Attempts to render one PDFium holder through the Veloce acceleration layer.
+//
+// This is the stable boundary between PDFium's baseline renderer and Veloce.
+// Implementations behind this function may compile ordered path/text/blend
+// plans, use bounded caches, or decline the holder. The caller-visible
+// invariant must not change: unsupported content returns kNotEligible before
+// drawing, preserving the original PDFium rendering pipeline as the source of
+// truth.
+VeloceRenderPlanResult VeloceTryRenderPlanForHolder(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    const CFX_Matrix& holder_to_device,
+    VeloceRenderPlanHolderKind holder_kind);
+
+#endif  // CORE_FPDFAPI_RENDER_VELOCE_RENDER_PLAN_H_
