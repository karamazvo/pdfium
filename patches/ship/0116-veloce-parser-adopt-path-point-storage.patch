diff --git a/core/fpdfapi/page/veloce_render_program_unittest.cpp b/core/fpdfapi/page/veloce_render_program_unittest.cpp
index d6f7e1a36..5a158b329 100644
--- a/core/fpdfapi/page/veloce_render_program_unittest.cpp
+++ b/core/fpdfapi/page/veloce_render_program_unittest.cpp
@@ -109,6 +109,35 @@ TEST(VeloceRenderProgramTest, OwnsLineGeometryAndInternsExactState) {
   EXPECT_TRUE(program->mandatory_ranges().empty());
 }
 
+TEST(VeloceRenderProgramTest, AdoptedPathPointsPreserveExactPointMetadata) {
+  std::vector<CFX_Path::Point> points;
+  points.emplace_back(CFX_PointF(1.25f, -2.5f),
+                      CFX_Path::Point::Type::kMove, /*close=*/false);
+  points.emplace_back(CFX_PointF(3.75f, 4.5f),
+                      CFX_Path::Point::Type::kBezier, /*close=*/false);
+  points.emplace_back(CFX_PointF(-5.25f, 6.5f),
+                      CFX_Path::Point::Type::kLine, /*close=*/true);
+
+  CPDF_Path path;
+  path.SetPoints(std::move(points));
+
+  ASSERT_EQ(3u, path.GetPoints().size());
+  EXPECT_EQ(CFX_PointF(1.25f, -2.5f), path.GetPoints()[0].point_);
+  EXPECT_EQ(CFX_Path::Point::Type::kMove, path.GetPoints()[0].type_);
+  EXPECT_FALSE(path.GetPoints()[0].close_figure_);
+  EXPECT_EQ(CFX_PointF(3.75f, 4.5f), path.GetPoints()[1].point_);
+  EXPECT_EQ(CFX_Path::Point::Type::kBezier, path.GetPoints()[1].type_);
+  EXPECT_FALSE(path.GetPoints()[1].close_figure_);
+  EXPECT_EQ(CFX_PointF(-5.25f, 6.5f), path.GetPoints()[2].point_);
+  EXPECT_EQ(CFX_Path::Point::Type::kLine, path.GetPoints()[2].type_);
+  EXPECT_TRUE(path.GetPoints()[2].close_figure_);
+
+  CPDF_Path shared_path = path;
+  path.Transform(CFX_Matrix(1.0f, 0.0f, 0.0f, 1.0f, 10.0f, 20.0f));
+  EXPECT_EQ(CFX_PointF(1.25f, -2.5f), shared_path.GetPoints()[0].point_);
+  EXPECT_EQ(CFX_PointF(11.25f, 17.5f), path.GetPoints()[0].point_);
+}
+
 TEST(VeloceRenderProgramTest,
      DegenerateButtCapLineNeedsNoSpatialCandidate) {
   auto no_op = MakeOpaqueLine(1.0f, 1.0f);
