From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "sh.chao" <sh.chao@gmail.com>
Date: Sun, 26 Jul 2026 13:10:00 +0800
Subject: [PATCH] Veloce r25-3-0116: adopt parsed path point storage

Transfer the parser's completed point vector directly into the canonical
CPDF_Path instead of reconstructing the same path one point at a time. The
existing loop creates a temporary CFX_Path and grows destination storage for
every point after the parser has already allocated and populated an exact
vector. Dense line drawings therefore pay millions of redundant allocations
and copies before RenderProgram execution begins.

The adopted vector remains owned by the normal copy-on-write CPDF_Path. Point
coordinates, types, close flags, object boundaries, graphics state, source
ordinals, clipping, editing behavior, and canonical fallback are unchanged.
Clip-and-paint operators continue to share the CPDF_Path and clone on the
existing transform boundary.

This is a universal parser storage correction: it adds no page classifier,
threshold, retained cache, synchronization, UI-thread work, or alternate
object model. Add exact metadata coverage and revision proof. Q16 should keep
the same 3,165,420 commands and replay counters while materially reducing
compileWindowMs and first-preview acquire time.
---
diff --git a/core/fpdfapi/page/cpdf_form.cpp b/core/fpdfapi/page/cpdf_form.cpp
index 317933b72..f3388c0ac 100644
--- a/core/fpdfapi/page/cpdf_form.cpp
+++ b/core/fpdfapi/page/cpdf_form.cpp
@@ -114,7 +114,7 @@ void CPDF_Form::ParseContentInternal(const CPDF_AllStates* pGraphicStates,
 #if BUILDFLAG(IS_ANDROID)
         __android_log_print(
             ANDROID_LOG_INFO, "VeloceRenderProgram2",
-            "revision=r25-3-0115 event=form_cache result=hit "
+            "revision=r25-3-0116 event=form_cache result=hit "
             "streamObj=%u commands=%zu bytes=%zu",
             GetStream()->GetObjNum(), GetVeloceRenderProgram()->command_count(),
             GetVeloceRenderProgram()->EstimatedBytes());
@@ -136,7 +136,7 @@ void CPDF_Form::ParseContentInternal(const CPDF_AllStates* pGraphicStates,
 #if BUILDFLAG(IS_ANDROID)
       __android_log_print(
           ANDROID_LOG_INFO, "VeloceRenderProgram2",
-          "revision=r25-3-0115 event=form_cache result=store "
+          "revision=r25-3-0116 event=form_cache result=store "
           "streamObj=%u commands=%zu bytes=%zu",
           GetStream()->GetObjNum(), built_program->command_count(),
           built_program->EstimatedBytes());
diff --git a/core/fpdfapi/page/cpdf_path.cpp b/core/fpdfapi/page/cpdf_path.cpp
index c30035949..8b6cf3bf3 100644
--- a/core/fpdfapi/page/cpdf_path.cpp
+++ b/core/fpdfapi/page/cpdf_path.cpp
@@ -6,6 +6,8 @@
 
 #include "core/fpdfapi/page/cpdf_path.h"
 
+#include <utility>
+
 CPDF_Path::CPDF_Path() = default;
 
 CPDF_Path::CPDF_Path(const CPDF_Path& that) = default;
@@ -16,6 +18,10 @@ const std::vector<CFX_Path::Point>& CPDF_Path::GetPoints() const {
   return ref_.GetObject()->GetPoints();
 }
 
+void CPDF_Path::SetPoints(std::vector<CFX_Path::Point> points) {
+  ref_.Emplace()->GetPoints() = std::move(points);
+}
+
 void CPDF_Path::ClosePath() {
   ref_.GetPrivateCopy()->ClosePath();
 }
diff --git a/core/fpdfapi/page/cpdf_path.h b/core/fpdfapi/page/cpdf_path.h
index 0745cc959..815510984 100644
--- a/core/fpdfapi/page/cpdf_path.h
+++ b/core/fpdfapi/page/cpdf_path.h
@@ -22,6 +22,7 @@ class CPDF_Path {
   bool HasRef() const { return !!ref_; }
 
   const std::vector<CFX_Path::Point>& GetPoints() const;
+  void SetPoints(std::vector<CFX_Path::Point> points);
   void ClosePath();
 
   CFX_PointF GetPoint(int index) const;
diff --git a/core/fpdfapi/page/cpdf_streamcontentparser.cpp b/core/fpdfapi/page/cpdf_streamcontentparser.cpp
index 752222ff1..277f636fe 100644
--- a/core/fpdfapi/page/cpdf_streamcontentparser.cpp
+++ b/core/fpdfapi/page/cpdf_streamcontentparser.cpp
@@ -1610,13 +1610,7 @@ void CPDF_StreamContentParser::AddPathObject(
   }
 
   CPDF_Path path;
-  for (const auto& point : path_points) {
-    if (point.close_figure_) {
-      path.AppendPointAndClose(point.point_, point.type_);
-    } else {
-      path.AppendPoint(point.point_, point.type_);
-    }
-  }
+  path.SetPoints(std::move(path_points));
 
   CFX_Matrix matrix =
       cur_states_->current_transformation_matrix() * mt_content_to_user_;
