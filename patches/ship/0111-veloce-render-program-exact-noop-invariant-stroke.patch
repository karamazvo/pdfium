+      program->spatial_index()->MarkCandidates(
+          CFX_FloatRect(0.0f, 0.0f, 10.0f, 10.0f), &candidates);
+  EXPECT_EQ(VeloceSpatialQueryMode::kCandidates, query.mode);
+  EXPECT_FALSE(IsCandidate(candidates, 0u));
+  EXPECT_TRUE(IsCandidate(candidates, 1u));
+  EXPECT_TRUE(IsCandidate(candidates, 2u));
+}
