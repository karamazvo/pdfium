From d96993ffa6a0f8e4658b5e63a09dd0cf507afeb8 Mon Sep 17 00:00:00 2001
From: "sh.chao" <sh.chao@gmail.com>
Date: Wed, 22 Jul 2026 11:08:11 +0800
Subject: [PATCH] Veloce r25-2-0102: align verification-safe revision markers

Advance generation-2 compile, discard, and replay markers after the r25-2-0101 workflow rejected a valid local identifier through an overbroad legacy-symbol grep.

No RenderProgram format, execution, memory, or pixel behavior changes.
---
 core/fpdfapi/page/veloce_render_program.cpp | 4 ++--
 core/fpdfapi/render/cpdf_renderstatus.cpp   | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/core/fpdfapi/page/veloce_render_program.cpp b/core/fpdfapi/page/veloce_render_program.cpp
index 10d417a76..38f2097e3 100644
--- a/core/fpdfapi/page/veloce_render_program.cpp
+++ b/core/fpdfapi/page/veloce_render_program.cpp
@@ -843,7 +843,7 @@ VeloceRenderProgramBuilder::Finish() {
 #if BUILDFLAG(IS_ANDROID)
     __android_log_print(
         ANDROID_LOG_INFO, "VeloceRenderProgram2",
-        "revision=r25-2-0101 event=discard reason=actual_budget bytes=%zu "
+        "revision=r25-2-0102 event=discard reason=actual_budget bytes=%zu "
         "budgetBytes=%zu",
         program->EstimatedBytes(), kMaxRetainedProgramBytes);
 #endif
@@ -853,7 +853,7 @@ VeloceRenderProgramBuilder::Finish() {
   if (program->command_count() >= 4096u) {
     __android_log_print(
         ANDROID_LOG_INFO, "VeloceRenderProgram2",
-        "revision=r25-2-0101 event=compile mode=ordered_line_batches_darken "
+        "revision=r25-2-0102 event=compile mode=ordered_line_batches_darken "
         "commands=%zu "
         "nativeOpaqueLines=%zu nativeOpaquePaths=%zu nativeDarkenPaths=%zu "
         "canonicalPaths=%zu "
diff --git a/core/fpdfapi/render/cpdf_renderstatus.cpp b/core/fpdfapi/render/cpdf_renderstatus.cpp
index dab2bf3c0..7b3ffee6c 100644
--- a/core/fpdfapi/render/cpdf_renderstatus.cpp
+++ b/core/fpdfapi/render/cpdf_renderstatus.cpp
@@ -475,7 +475,7 @@ bool CPDF_RenderStatus::ReplayVeloceProgram(
             .count());
     __android_log_print(
         ANDROID_LOG_INFO, "VeloceRenderProgram2",
-        "revision=r25-2-0101 event=replay mode=ordered_line_batches_darken "
+        "revision=r25-2-0102 event=replay mode=ordered_line_batches_darken "
         "result=%s commandsVisited=%zu commandsSkipped=%zu "
         "nativeLines=%zu nativePaths=%zu "
         "clipRuns=%zu canonicalDraws=%zu nativeDraws=%zu pathDraws=%zu "
