+StrokeRunFlushReason ClassifyStrokePaintChange(const PathDlPaint& previous,
+                                                const PathDlPaint& next) {
+  const bool color_changed = previous.fill_argb != next.fill_argb ||
+                             previous.stroke_argb != next.stroke_argb;
+  const bool graph_state_changed =
+      previous.graph_state_key != next.graph_state_key;
+  const bool path_style_changed = !(previous.fill_options == next.fill_options);
+  const bool blend_changed = previous.blend_mode != next.blend_mode;
+  const size_t changed_fields = (color_changed ? 1u : 0u) +
+                                (graph_state_changed ? 1u : 0u) +
+                                (path_style_changed ? 1u : 0u) +
+                                (blend_changed ? 1u : 0u);
+  if (changed_fields != 1u) {
+    return StrokeRunFlushReason::kPaint;
+  }
+  if (color_changed) {
+    return StrokeRunFlushReason::kColor;
+  }
+  if (graph_state_changed) {
+    return StrokeRunFlushReason::kGraphState;
+  }
+  if (path_style_changed) {
+    return StrokeRunFlushReason::kPathStyle;
+  }
+  return StrokeRunFlushReason::kBlend;
+}
+
+void RecordStrokeRunFlush(PathDlReplayStats* replay_stats,
+                          StrokeRunFlushReason reason) {
+  if (!replay_stats) {
+    return;
+  }
+  switch (reason) {
+    case StrokeRunFlushReason::kPaint:
+      replay_stats->stroke_run_flush_paint++;
+      break;
+    case StrokeRunFlushReason::kColor:
+      replay_stats->stroke_run_flush_color++;
+      break;
+    case StrokeRunFlushReason::kGraphState:
+      replay_stats->stroke_run_flush_graph_state++;
+      break;
+    case StrokeRunFlushReason::kMatrix:
+      replay_stats->stroke_run_flush_matrix++;
+      break;
+    case StrokeRunFlushReason::kPathStyle:
+      replay_stats->stroke_run_flush_path_style++;
+      break;
+    case StrokeRunFlushReason::kFillMode:
+      replay_stats->stroke_run_flush_fill_mode++;
+      break;
+    case StrokeRunFlushReason::kClip:
+      replay_stats->stroke_run_flush_clip++;
+      break;
+    case StrokeRunFlushReason::kBlend:
+      replay_stats->stroke_run_flush_blend++;
+      break;
+    case StrokeRunFlushReason::kSegment:
+      replay_stats->stroke_run_flush_segment++;
+      break;
+    case StrokeRunFlushReason::kCapacity:
+      replay_stats->stroke_run_flush_capacity++;
+      break;
+    case StrokeRunFlushReason::kEnd:
+      replay_stats->stroke_run_flush_end++;
+      break;
+  }
+}
