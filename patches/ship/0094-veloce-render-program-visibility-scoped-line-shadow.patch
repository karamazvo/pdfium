+TEST(VeloceRenderProgramTest, EncodesTranslationOnlyMatricesExactly) {
+  auto first = MakeOpaqueLine(1.0f, 3.0f);
+  auto second = MakeOpaqueLine(5.0f, 7.0f);
+  first->SetPathMatrix(CFX_Matrix(1, 0, 0, 1, 10, 20));
+  second->SetPathMatrix(CFX_Matrix(1, 0, 0, 1, -2, 4));
+
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+  builder.AppendPageObject(*first);
+  builder.AppendPageObject(*second);
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(2u, program->native_line_count());
+  EXPECT_EQ(2u, program->inline_translation_line_count());
+  EXPECT_EQ(0u, program->path_matrices().size());
+  EXPECT_EQ(1.0f, program->native_line(0).start.x);
+  EXPECT_EQ(2.0f, program->native_line(0).start.y);
+  EXPECT_EQ(3.0f, program->native_line(0).end.x);
+  EXPECT_EQ(4.0f, program->native_line(0).end.y);
+  EXPECT_EQ(10.0f, program->native_line(0).translation_x);
+  EXPECT_EQ(20.0f, program->native_line(0).translation_y);
+  EXPECT_EQ(-2.0f, program->native_line(1).translation_x);
+  EXPECT_EQ(4.0f, program->native_line(1).translation_y);
+  EXPECT_EQ(kVeloceInlineTranslationMatrixIndex,
+            program->native_line(1).matrix_index);
+}
