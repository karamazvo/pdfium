+bool VeloceRenderProgramBuilder::Reject(
+    VeloceNativeLineRejectReason reason) {
+  ++rejection_counts_[static_cast<size_t>(reason)];
+  return false;
+}
+
+bool VeloceRenderProgramBuilder::HasSameVisibilityScope(
+    const CPDF_ContentMarks& marks) const {
+  if (!has_previous_visibility_scope_ ||
+      previous_visibility_marks_.size() != marks.CountItems()) {
+    return false;
+  }
+  for (size_t i = 0; i < marks.CountItems(); ++i) {
+    if (previous_visibility_marks_[i].Get() != marks.GetItem(i)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void VeloceRenderProgramBuilder::RememberVisibilityScope(
+    const CPDF_ContentMarks& marks) {
+  previous_visibility_marks_.clear();
+  previous_visibility_marks_.reserve(marks.CountItems());
+  for (size_t i = 0; i < marks.CountItems(); ++i) {
+    previous_visibility_marks_.push_back(
+        pdfium::WrapRetain(marks.GetItem(i)));
+  }
+  has_previous_visibility_scope_ = true;
+}
+
+bool VeloceRenderProgramBuilder::WouldExceedRetainedBudget(
+    bool needs_state,
+    bool needs_matrix,
+    size_t dash_count,
+    bool needs_visibility_run) const {
+  const size_t logical_bytes =
+      sizeof(VeloceRenderProgram) + bytecode_.size() + 1u +
+      (native_lines_.size() + 1u) * sizeof(VeloceNativeLine) +
+      (opaque_path_states_.size() + (needs_state ? 1u : 0u)) *
+          sizeof(VeloceOpaquePathState) +
+      (path_matrices_.size() + (needs_matrix ? 1u : 0u)) *
+          sizeof(CFX_Matrix) +
+      (dash_values_.size() + (needs_state ? dash_count : 0u)) *
+          sizeof(float) +
+      (visibility_runs_.size() + (needs_visibility_run ? 1u : 0u)) *
+          sizeof(VeloceVisibilityRun);
+  return logical_bytes > kMaxRetainedProgramBytes;
+}
