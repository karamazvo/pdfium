+  CPDF_ContentMarks second_marks;
+  second_marks.AddMark("OC");
+
+  auto first = MakeOpaqueLine(1.0f, 3.0f);
+  auto second = MakeOpaqueLine(5.0f, 7.0f);
+  auto third = MakeOpaqueLine(9.0f, 11.0f);
+  first->SetContentMarks(first_marks);
+  second->SetContentMarks(first_marks);
+  third->SetContentMarks(second_marks);
+
+  VeloceRenderProgramBuilder builder;
+  ReachNativeCompileThreshold(&builder);
+  builder.AppendPageObject(*first);
+  builder.AppendPageObject(*second);
+  builder.AppendPageObject(*third);
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_EQ(3u, program->native_line_count());
+  EXPECT_EQ(3u, program->visibility_scoped_line_count());
+  ASSERT_EQ(2u, program->visibility_runs().size());
+  EXPECT_EQ(4096u, program->visibility_runs()[0].first_command);
+  EXPECT_EQ(4098u, program->visibility_runs()[1].first_command);
+  EXPECT_EQ(0u, program->rejection_count(
+                    VeloceNativeLineRejectReason::kVisibility));
+}
