+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#ifndef CORE_FPDFAPI_RENDER_VELOCE_PATH_DISPLAY_LIST_H_
+#define CORE_FPDFAPI_RENDER_VELOCE_PATH_DISPLAY_LIST_H_
+
+class CFX_Matrix;
+class CPDF_PageObjectHolder;
+class CPDF_RenderStatus;
+
+enum class VelocePathDisplayListResult {
+  kNotEligible,
+  kRendered,
+  kCancelled,
+};
+
+// Attempts to render a path-only object holder through a compact internal
+// display list into `status`'s current CFX_RenderDevice.
+//
+// This is intentionally conservative: unsupported objects or paint states
+// return kNotEligible before drawing, so callers can fall back to legacy
+// CPDF_RenderStatus::RenderObjectList().
+VelocePathDisplayListResult VeloceTryRenderPathDisplayList(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    const CFX_Matrix& holder_to_device);
+
+#endif  // CORE_FPDFAPI_RENDER_VELOCE_PATH_DISPLAY_LIST_H_
diff --git a/public/fpdfex_render_callbacks.h b/public/fpdfex_render_callbacks.h
index db8e1f924..d1f1966e6 100644
--- a/public/fpdfex_render_callbacks.h
+++ b/public/fpdfex_render_callbacks.h
@@ -17,6 +17,12 @@ typedef int (*FPDFEx_RenderCancelCheckFn)(void* user_data);
 
 #define FPDFEX_FEATURE_NONE 0u
 
+// Enables the experimental path-only Form XObject display-list fast path.
+// When set, eligible path-only Forms may be compiled to an internal display
+// list and replayed into the current render device. Unsupported content falls
+// back to legacy PDFium rendering before drawing.
+#define FPDFEX_FEATURE_PATH_DISPLAY_LIST_FORM 0x00000001u
+
 typedef struct FPDFEx_RenderCallbacks {
   uint32_t struct_size;
   uint32_t feature_flags;
