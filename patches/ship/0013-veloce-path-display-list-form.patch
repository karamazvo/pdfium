diff --git a/core/fpdfapi/render/veloce_path_display_list.cpp b/core/fpdfapi/render/veloce_path_display_list.cpp
new file mode 100644
index 000000000..21db163f8
--- /dev/null
+++ b/core/fpdfapi/render/veloce_path_display_list.cpp
@@ -0,0 +1,296 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#include "core/fpdfapi/render/veloce_path_display_list.h"
+
+#include <stdint.h>
+
+#include <limits>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include "constants/transparency.h"
+#include "core/fpdfapi/page/cpdf_clippath.h"
+#include "core/fpdfapi/page/cpdf_color.h"
+#include "core/fpdfapi/page/cpdf_colorstate.h"
+#include "core/fpdfapi/page/cpdf_generalstate.h"
+#include "core/fpdfapi/page/cpdf_pageobject.h"
+#include "core/fpdfapi/page/cpdf_pageobjectholder.h"
+#include "core/fpdfapi/page/cpdf_pathobject.h"
+#include "core/fpdfapi/render/cpdf_renderoptions.h"
+#include "core/fpdfapi/render/cpdf_renderstatus.h"
+#include "core/fpdfapi/render/veloce_render_callbacks.h"
+#include "core/fxge/cfx_fillrenderoptions.h"
+#include "core/fxge/cfx_path.h"
+#include "core/fxge/cfx_renderdevice.h"
+
+namespace {
+
+constexpr uint32_t kVeloceFeaturePathDisplayListForm = 0x00000001u;
+constexpr uint32_t kNoClipKey = std::numeric_limits<uint32_t>::max();
+constexpr uint32_t kMaxClipPathCount = 16;
+constexpr uint32_t kCancelCheckNodeInterval = 64;
+
+struct PathDlPaint {
+  CFX_FillRenderOptions fill_options;
+  uint32_t fill_argb = 0;
+};
+
+struct PathDlNode {
+  CFX_FloatRect holder_space_bbox;
+  CFX_Matrix path_to_holder;
+  uint32_t path_index = 0;
+  uint32_t paint_key = 0;
+  uint32_t clip_key = kNoClipKey;
+};
+
+struct NativePathDisplayList {
+  std::vector<CPDF_Path> path_table;
+  std::vector<PathDlPaint> paint_table;
+  std::vector<CPDF_ClipPath> clip_table;
+  std::vector<PathDlNode> nodes;
+};
+
+bool IsPathDisplayListFeatureEnabled(const CPDF_RenderStatus* status) {
+  return (status->GetRenderFeatureFlags() & kVeloceFeaturePathDisplayListForm) !=
+         0;
+}
+
+bool HasOnlySimplePathClip(const CPDF_ClipPath& clip_path) {
+  if (!clip_path.HasRef()) {
+    return true;
+  }
+  if (clip_path.GetTextCount() != 0) {
+    return false;
+  }
+  if (clip_path.GetPathCount() > kMaxClipPathCount) {
+    return false;
+  }
+  for (size_t i = 0; i < clip_path.GetPathCount(); ++i) {
+    CPDF_Path path = clip_path.GetPath(i);
+    if (!path.GetObject()) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool RequiresTransparency(const CPDF_PageObject* obj) {
+  const CPDF_GeneralState& general_state = obj->general_state();
+  if (general_state.GetSoftMask()) {
+    return true;
+  }
+  if (general_state.GetBlendType() != BlendMode::kNormal) {
+    return true;
+  }
+  if (general_state.GetFillAlpha() != 1.0f) {
+    return true;
+  }
+  if (general_state.GetStrokeAlpha() != 1.0f) {
+    return true;
+  }
+  return false;
+}
+
+bool HasPatternPaint(const CPDF_PathObject* path_obj,
+                     CFX_FillRenderOptions::FillType fill_type,
+                     bool stroke) {
+  if (fill_type != CFX_FillRenderOptions::FillType::kNoFill) {
+    const CPDF_Color* fill_color = path_obj->color_state().GetFillColor();
+    if (!fill_color || fill_color->IsPattern()) {
+      return true;
+    }
+  }
+  if (stroke) {
+    const CPDF_Color* stroke_color = path_obj->color_state().GetStrokeColor();
+    if (!stroke_color || stroke_color->IsPattern()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::optional<uint32_t> AddClipKey(NativePathDisplayList* list,
+                                   const CPDF_ClipPath& clip_path) {
+  if (!clip_path.HasRef()) {
+    return kNoClipKey;
+  }
+  for (uint32_t i = 0; i < list->clip_table.size(); ++i) {
+    if (list->clip_table[i] == clip_path) {
+      return i;
+    }
+  }
+  if (list->clip_table.size() >= std::numeric_limits<uint32_t>::max()) {
+    return std::nullopt;
+  }
+  list->clip_table.push_back(clip_path);
+  return static_cast<uint32_t>(list->clip_table.size() - 1);
+}
+
+std::optional<uint32_t> AddPaintKey(NativePathDisplayList* list,
+                                    const PathDlPaint& paint) {
+  for (uint32_t i = 0; i < list->paint_table.size(); ++i) {
+    const PathDlPaint& existing = list->paint_table[i];
+    if (existing.fill_options == paint.fill_options &&
+        existing.fill_argb == paint.fill_argb) {
+      return i;
+    }
+  }
+  if (list->paint_table.size() >= std::numeric_limits<uint32_t>::max()) {
+    return std::nullopt;
+  }
+  list->paint_table.push_back(paint);
+  return static_cast<uint32_t>(list->paint_table.size() - 1);
+}
+
+bool CompilePathDisplayList(CPDF_RenderStatus* status,
+                            const CPDF_PageObjectHolder* holder,
+                            NativePathDisplayList* list) {
+  if (status->GetRenderOptions().ColorModeIs(CPDF_RenderOptions::kForcedColor)) {
+    return false;
+  }
+
+  for (const auto& obj : *holder) {
+    if (!obj || !obj->IsActive()) {
+      continue;
+    }
+    if (!status->GetRenderOptions().CheckPageObjectVisible(obj.get())) {
+      continue;
+    }
+    if (!obj->IsPath()) {
+      return false;
+    }
+    if (!HasOnlySimplePathClip(obj->clip_path())) {
+      return false;
+    }
+    if (RequiresTransparency(obj.get())) {
+      return false;
+    }
+
+    auto* path_obj = obj->AsPath();
+    CFX_FillRenderOptions::FillType fill_type = path_obj->filltype();
+    const bool stroke = path_obj->stroke();
+    if (stroke) {
+      // v1 optimizes the Meta20-class fill-only workload. Stroke support can
+      // be added once graph-state side-table replay is pixel-diffed.
+      return false;
+    }
+    if (fill_type == CFX_FillRenderOptions::FillType::kNoFill) {
+      continue;
+    }
+    if (HasPatternPaint(path_obj, fill_type, stroke)) {
+      return false;
+    }
+    CPDF_Path path = path_obj->path();
+    if (!path.GetObject()) {
+      return false;
+    }
+
+    std::optional<uint32_t> clip_key = AddClipKey(list, obj->clip_path());
+    if (!clip_key.has_value()) {
+      return false;
+    }
+
+    CFX_FillRenderOptions fill_options(fill_type);
+    fill_options.aliased_path =
+        status->GetRenderOptions().GetOptions().bNoPathSmooth;
+    PathDlPaint paint;
+    paint.fill_options = fill_options;
+    paint.fill_argb = status->GetFillArgb(path_obj);
+    std::optional<uint32_t> paint_key = AddPaintKey(list, paint);
+    if (!paint_key.has_value()) {
+      return false;
+    }
+    if (list->path_table.size() >= std::numeric_limits<uint32_t>::max()) {
+      return false;
+    }
+
+    list->path_table.push_back(path);
+
+    PathDlNode node;
+    node.holder_space_bbox = obj->GetRect();
+    node.path_to_holder = path_obj->matrix();
+    node.path_index = static_cast<uint32_t>(list->path_table.size() - 1);
+    node.paint_key = paint_key.value();
+    node.clip_key = clip_key.value();
+    list->nodes.push_back(std::move(node));
+  }
+
+  return !list->nodes.empty();
+}
+
+bool IntersectsDeviceClip(const PathDlNode& node,
+                          const CFX_Matrix& holder_to_device,
+                          CFX_RenderDevice* device) {
+  FX_RECT rect = holder_to_device.TransformRect(node.holder_space_bbox)
+                     .GetOuterRect();
+  rect.Intersect(device->GetClipBox());
+  return !rect.IsEmpty();
+}
+
+VelocePathDisplayListResult ReplayPathDisplayList(
+    CPDF_RenderStatus* status,
+    const NativePathDisplayList& list,
+    const CFX_Matrix& holder_to_device) {
+  CFX_RenderDevice* device = status->GetRenderDevice();
+  CFX_RenderDevice::StateRestorer restorer(device);
+
+  uint32_t current_clip_key = kNoClipKey;
+  bool have_clip_state = false;
+  CPDF_ClipPath empty_clip;
+
+  for (uint32_t i = 0; i < list.nodes.size(); ++i) {
+    if ((i % kCancelCheckNodeInterval) == 0 && status->ShouldCancelRender()) {
+      return VelocePathDisplayListResult::kCancelled;
+    }
+
+    const PathDlNode& node = list.nodes[i];
+    if (!IntersectsDeviceClip(node, holder_to_device, device)) {
+      continue;
+    }
+
+    if (!have_clip_state || current_clip_key != node.clip_key) {
+      if (node.clip_key == kNoClipKey) {
+        status->ProcessClipPath(empty_clip, holder_to_device);
+      } else {
+        status->ProcessClipPath(list.clip_table[node.clip_key],
+                                holder_to_device);
+      }
+      have_clip_state = true;
+      current_clip_key = node.clip_key;
+    }
+
+    const PathDlPaint& paint = list.paint_table[node.paint_key];
+    const CFX_Path* path = list.path_table[node.path_index].GetObject();
+    if (!path) {
+      continue;
+    }
+    CFX_Matrix path_matrix = node.path_to_holder * holder_to_device;
+    device->DrawPath(*path, &path_matrix, nullptr, paint.fill_argb,
+                     /*stroke_color=*/0, paint.fill_options);
+  }
+
+  if (status->ShouldCancelRender()) {
+    return VelocePathDisplayListResult::kCancelled;
+  }
+  return VelocePathDisplayListResult::kRendered;
+}
+
+}  // namespace
+
+VelocePathDisplayListResult VeloceTryRenderPathDisplayList(
+    CPDF_RenderStatus* status,
+    const CPDF_PageObjectHolder* holder,
+    const CFX_Matrix& holder_to_device) {
+  if (!status || !holder || !IsPathDisplayListFeatureEnabled(status)) {
+    return VelocePathDisplayListResult::kNotEligible;
+  }
+
+  NativePathDisplayList list;
+  if (!CompilePathDisplayList(status, holder, &list)) {
+    return VelocePathDisplayListResult::kNotEligible;
+  }
+
+  return ReplayPathDisplayList(status, list, holder_to_device);
+}
