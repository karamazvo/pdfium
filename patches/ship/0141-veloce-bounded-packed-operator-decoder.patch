+bool ReadVelocePackedTranslationOriginStrokeLine(
+    pdfium::raw_span<const uint8_t> buffer,
+    uint32_t* position,
+    VeloceParsedTranslationOriginLine* line) {
+  uint32_t candidate_position = *position;
+  SkipVelocePathTrivia(buffer, &candidate_position);
+
+  float translation_x = 0.0f;
+  float translation_y = 0.0f;
+  float end_x = 0.0f;
+  float end_y = 0.0f;
+  if (!ReadVeloceExactBytes(buffer, &candidate_position, "q 1 0 0 1 ") ||
+      !ReadVeloceExactPathNumber(buffer, &candidate_position,
+                                 &translation_x) ||
+      !ReadVeloceExactBytes(buffer, &candidate_position, " ") ||
+      !ReadVeloceExactPathNumber(buffer, &candidate_position,
+                                 &translation_y) ||
+      !ReadVeloceExactBytes(buffer, &candidate_position, " cm\n0 0 m\n") ||
+      !ReadVeloceExactPathNumber(buffer, &candidate_position, &end_x) ||
+      !ReadVeloceExactBytes(buffer, &candidate_position, " ") ||
+      !ReadVeloceExactPathNumber(buffer, &candidate_position, &end_y) ||
+      !ReadVeloceExactBytes(buffer, &candidate_position, " l\nS\nQ")) {
+    return false;
+  }
+
+  *position = candidate_position;
+  *line = {CFX_PointF(end_x, end_y), translation_x, translation_y};
+  return true;
+}
