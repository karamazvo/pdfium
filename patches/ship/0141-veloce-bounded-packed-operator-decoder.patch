+TEST(CPDFStreamParserTest,
+     ParsesBoundedPackedTranslationOriginStrokeLineRun) {
+  uint8_t data[] =
+      "q 1 0 0 1 10 -20 cm\n"
+      "0 0 m\n"
+      "3 4.5 l\n"
+      "S\n"
+      "Q\n"
+      "q 1 0 0 1 -7 8.25 cm\n"
+      "0 0 m\n"
+      "-9 10 l\n"
+      "S\n"
+      "Q\n"
+      "q 1 0 0 1 1 2 cm 0 0 m 3 4 l S Q";
+  CPDF_StreamParser parser(data);
+  std::array<VeloceParsedTranslationOriginLine, 4> lines;
+  std::array<uint32_t, 4> unit_starts = {};
+
+  EXPECT_EQ(2u, parser.TryParsePackedTranslationOriginStrokeLineRun(
+                    lines, unit_starts, sizeof(data) - 1u));
+  EXPECT_EQ(CFX_PointF(3.0f, 4.5f), lines[0].end);
+  EXPECT_FLOAT_EQ(10.0f, lines[0].translation_x);
+  EXPECT_FLOAT_EQ(-20.0f, lines[0].translation_y);
+  EXPECT_EQ(CFX_PointF(-9.0f, 10.0f), lines[1].end);
+  EXPECT_FLOAT_EQ(-7.0f, lines[1].translation_x);
+  EXPECT_FLOAT_EQ(8.25f, lines[1].translation_y);
+  EXPECT_EQ(0u, unit_starts[0]);
+  EXPECT_LT(unit_starts[0], unit_starts[1]);
+
+  std::array<float, 4> operands = {};
+  EXPECT_TRUE(parser.TryParseTranslationOriginStrokeLine(&operands));
+  EXPECT_FLOAT_EQ(1.0f, operands[0]);
+  EXPECT_FLOAT_EQ(2.0f, operands[1]);
