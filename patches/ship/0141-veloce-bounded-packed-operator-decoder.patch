+template <size_t N>
+bool ReadVeloceExactBytes(pdfium::raw_span<const uint8_t> buffer,
+                          uint32_t* position,
+                          const char (&expected)[N]) {
+  static_assert(N > 1u);
+  constexpr size_t kExpectedSize = N - 1u;
+  if (*position > buffer.size() ||
+      buffer.size() - *position < kExpectedSize) {
+    return false;
+  }
+  for (size_t i = 0u; i < kExpectedSize; ++i) {
+    if (buffer[*position + i] != static_cast<uint8_t>(expected[i])) {
+      return false;
+    }
+  }
+  *position += kExpectedSize;
+  return true;
+}
