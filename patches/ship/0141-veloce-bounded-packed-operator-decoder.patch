+size_t CPDF_StreamParser::TryParsePackedTranslationOriginStrokeLineRun(
+    pdfium::span<VeloceParsedTranslationOriginLine> lines,
+    pdfium::span<uint32_t> unit_starts,
+    uint32_t end_position) {
+  const size_t line_limit = std::min(lines.size(), unit_starts.size());
+  if (line_limit == 0u) {
+    return 0u;
+  }
+  end_position = static_cast<uint32_t>(
+      std::min(static_cast<size_t>(end_position), buf_.size()));
+
+  uint32_t candidate_position = pos_;
+  size_t parsed_count = 0u;
+  while (parsed_count < line_limit) {
+    const uint32_t unit_start = candidate_position;
+    VeloceParsedTranslationOriginLine line;
+    if (!ReadVelocePackedTranslationOriginStrokeLine(
+            buf_, &candidate_position, &line) ||
+        candidate_position > end_position) {
+      candidate_position = unit_start;
+      break;
+    }
+    unit_starts[parsed_count] = unit_start;
+    lines[parsed_count] = line;
+    ++parsed_count;
+  }
+  if (parsed_count == 0u) {
+    return 0u;
+  }
+
+  last_obj_.Reset();
+  word_size_ = 0u;
+  pos_ = candidate_position;
+  return parsed_count;
+}
