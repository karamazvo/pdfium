+bool CPDF_RenderStatus::VeloceShouldDeferImage(
+    const CPDF_ImageObject* pImageObj) const {
+  if (!(render_skip_mask_ & kVeloceRenderSkipHugeImage)) {
+    return false;
+  }
+  RetainPtr<CPDF_Image> image = pImageObj->GetImage();
+  if (!image || image->IsMask()) {
+    return false;
+  }
+  const int64_t pixels = static_cast<int64_t>(image->GetPixelWidth()) *
+                         static_cast<int64_t>(image->GetPixelHeight());
+  return pixels > static_cast<int64_t>(VeloceGetHugeImagePixelThreshold());
+}
+
+void CPDF_RenderStatus::FillImagePlaceholder(CPDF_PageObject* pImageObj,
+                                             const CFX_Matrix& mtObj2Device) {
+  FX_RECT rect = GetObjectClippedRect(pImageObj, mtObj2Device);
+  if (rect.IsEmpty()) {
+    return;
+  }
+  constexpr FX_ARGB kHugeImagePlaceholderColor = 0xFFC8C8C8;
+  device_->FillRect(rect, kHugeImagePlaceholderColor);
+}
+
 bool CPDF_RenderStatus::ProcessImage(CPDF_ImageObject* pImageObj,
                                      const CFX_Matrix& mtObj2Device) {
+  if (VeloceShouldDeferImage(pImageObj)) {
+    FillImagePlaceholder(pImageObj, mtObj2Device);
+    return true;
+  }
   CPDF_ImageRenderer render(this);
   if (render.Start(pImageObj, mtObj2Device, std_cs_)) {
     render.Continue(nullptr);
