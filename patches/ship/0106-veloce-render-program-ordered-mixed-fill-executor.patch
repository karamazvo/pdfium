+bool CFX_AggDeviceDriver::DrawOrderedPathBatch(
+    pdfium::span<const CFX_OrderedPathDraw> draws,
+    const CFX_GraphStateData* stroke_state,
+    uint32_t stroke_color,
+    const CFX_FillRenderOptions& stroke_options) {
+  if (draws.empty() || bitmap_->GetBuffer().empty()) {
+    return true;
+  }
+
+  bool has_line = false;
+  for (const CFX_OrderedPathDraw& draw : draws) {
+    const CFX_Matrix& matrix = draw.object_to_device;
+    if (!std::isfinite(matrix.a) || !std::isfinite(matrix.b) ||
+        !std::isfinite(matrix.c) || !std::isfinite(matrix.d) ||
+        !std::isfinite(matrix.e) || !std::isfinite(matrix.f)) {
+      return false;
+    }
+    if (draw.path && draw.fill_options.fill_type !=
+                         CFX_FillRenderOptions::FillType::kNoFill) {
+      if (draw.fill_options.stroke || FXARGB_A(draw.fill_color) == 0) {
+        return false;
+      }
+    } else {
+      has_line = true;
+      if (draw.fill_options.fill_type !=
+              CFX_FillRenderOptions::FillType::kNoFill ||
+          !draw.fill_options.stroke) {
+        return false;
+      }
+      if (!draw.fill_options.zero_area) {
+        const float scale = std::max(fabs(matrix.a), fabs(matrix.b));
+        if (!std::isfinite(scale) || scale == 0.0f) {
+          return false;
+        }
+      }
+    }
+  }
+  if (has_line &&
+      (!stroke_state || FXARGB_A(stroke_color) == 0 ||
+       stroke_options.fill_type !=
+           CFX_FillRenderOptions::FillType::kNoFill)) {
+    return false;
+  }
+
+  RetainPtr<CFX_DIBitmap> backdrop =
+      group_knockout_ ? backdrop_bitmap_ : nullptr;
+  agg::scanline_u8 scanline;
+  agg::path_storage path_data;
+  agg::rasterizer_scanline_aa rasterizer;
+  rasterizer.clip_box(0.0f, 0.0f, static_cast<float>(GetPixelWidth()),
+                      static_cast<float>(GetPixelHeight()));
+
+  for (const CFX_OrderedPathDraw& draw : draws) {
+    path_data.remove_all();
+    rasterizer.reset();
+    fill_options_ = draw.fill_options;
+    if (draw.path && draw.fill_options.fill_type !=
+                         CFX_FillRenderOptions::FillType::kNoFill) {
+      BuildAggPathInto(*draw.path, &draw.object_to_device, &path_data);
+      rasterizer.add_path(path_data);
+      rasterizer.filling_rule(
+          GetAlternateOrWindingFillType(draw.fill_options));
+      CFX_AggRenderer renderer(bitmap_, nullptr, clip_rgn_.get(),
+                               draw.fill_color,
+                               draw.fill_options.full_cover, rgb_byte_order_);
+      agg::render_scanlines(rasterizer, scanline, renderer,
+                            draw.fill_options.aliased_path);
+      continue;
+    }
+
+    if (draw.fill_options.zero_area) {
+      if (draw.path) {
+        BuildAggPathInto(*draw.path, &draw.object_to_device, &path_data);
+      } else {
+        const CFX_StrokeLine line{draw.line_start, draw.line_end,
+                                  draw.object_to_device};
+        BuildAggStrokeLine(line, &line.object_to_device, &path_data);
+      }
+      RasterizeStroke(&rasterizer, &path_data, nullptr, stroke_state, 1,
+                      draw.fill_options.stroke_text_mode);
+    } else {
+      const CFX_Matrix& object_matrix = line.object_to_device;
+      CFX_Matrix matrix1;
+      CFX_Matrix matrix2;
+      matrix1.a = std::max(fabs(object_matrix.a), fabs(object_matrix.b));
+      matrix1.d = matrix1.a;
+      matrix2 = CFX_Matrix(
+          object_matrix.a / matrix1.a, object_matrix.b / matrix1.a,
+          object_matrix.c / matrix1.d, object_matrix.d / matrix1.d, 0, 0);
+      matrix1 = object_matrix * matrix2.GetInverse();
+      if (draw.path) {
+        BuildAggPathInto(*draw.path, &matrix1, &path_data);
+      } else {
+        const CFX_StrokeLine line{draw.line_start, draw.line_end,
+                                  draw.object_to_device};
+        BuildAggStrokeLine(line, &matrix1, &path_data);
+      }
+      RasterizeStroke(&rasterizer, &path_data, &matrix2, stroke_state,
+                      matrix1.a, draw.fill_options.stroke_text_mode);
+    }
+    CFX_AggRenderer renderer(bitmap_, backdrop, clip_rgn_.get(), stroke_color,
+                             draw.fill_options.full_cover, rgb_byte_order_);
+    agg::render_scanlines(rasterizer, scanline, renderer,
+                          draw.fill_options.aliased_path);
+  }
+  return true;
+}
