+uint64_t HashPath(const CFX_Path& path) {
+  uint64_t hash = kFnvOffsetBasis;
+  for (const CFX_Path::Point& point : path.GetPoints()) {
+    hash = HashWord(hash, FloatBits(point.point_.x));
+    hash = HashWord(hash, FloatBits(point.point_.y));
+    hash = HashWord(hash, static_cast<uint32_t>(point.type_));
+    hash = HashWord(hash, point.close_figure_ ? 1u : 0u);
+  }
+  return hash;
+}
+
+bool SamePath(const CFX_Path& lhs, const CFX_Path& rhs) {
+  const auto& lhs_points = lhs.GetPoints();
+  const auto& rhs_points = rhs.GetPoints();
+  if (lhs_points.size() != rhs_points.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < lhs_points.size(); ++i) {
+    if (FloatBits(lhs_points[i].point_.x) !=
+            FloatBits(rhs_points[i].point_.x) ||
+        FloatBits(lhs_points[i].point_.y) !=
+            FloatBits(rhs_points[i].point_.y) ||
+        lhs_points[i].type_ != rhs_points[i].type_ ||
+        lhs_points[i].close_figure_ != rhs_points[i].close_figure_) {
+      return false;
+    }
+  }
+  return true;
+}
