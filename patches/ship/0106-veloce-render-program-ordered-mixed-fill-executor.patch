+  auto path = std::make_unique<CPDF_PathObject>();
+  path->SetDefaultStates();
+  path->mutable_general_state().Emplace();
+  path->path().Emplace();
+  path->path().AppendPoint({0.0f, 0.0f}, CFX_Path::Point::Type::kMove);
+  path->path().AppendPoint({4.0f, 0.0f}, CFX_Path::Point::Type::kLine);
+  path->path().AppendPointAndClose({2.0f, 3.0f},
+                                   CFX_Path::Point::Type::kLine);
+  path->set_stroke(false);
+  path->set_alternate_filltype();
+  path->SetPathMatrix(
+      CFX_Matrix(1.0f, 0.0f, 0.0f, 1.0f, translation_x, 0.0f));
+  path->SetRect(CFX_FloatRect(translation_x, 0.0f,
+                              translation_x + 4.0f, 3.0f));
+  return path;
+}
