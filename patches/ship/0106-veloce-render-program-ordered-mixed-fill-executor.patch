+      ASSERT_TRUE(baseline.DrawPath(*draw.path, &draw.object_to_device,
+                                    nullptr, draw.fill_color,
+                                    /*stroke_color=*/0, draw.fill_options));
+    } else {
+      CFX_Path line;
+      const CFX_Path* stroke = draw.path;
+      if (!stroke) {
+        line.AppendLine(draw.line_start, draw.line_end);
+        stroke = &line;
+      }
+      ASSERT_TRUE(baseline.DrawPath(*stroke, &draw.object_to_device,
+                                    &graphics_state, /*fill_color=*/0,
+                                    kStrokeColor, draw.fill_options));
+    }
+  }
+  ASSERT_TRUE(batched.DrawOrderedPathBatch(
+      draws, &graphics_state, kStrokeColor, stroke_options));
+  EXPECT_TRUE(std::ranges::equal(baseline.GetBitmap()->GetBuffer(),
+                                 batched.GetBitmap()->GetBuffer()));
+}
