+TEST(VeloceRenderProgramTest, EmptyExactNoOpTapeValidates) {
+  VeloceRenderProgramBuilder builder;
+  ASSERT_TRUE(builder.AppendPageObject(*MakeOpaqueLine(1.0f, 2.0f)));
+
+  std::unique_ptr<const VeloceRenderProgram> program = builder.Finish();
+
+  ASSERT_TRUE(program);
+  EXPECT_TRUE(program->is_valid());
+  EXPECT_EQ(0u, program->exact_noop_count());
+  EXPECT_EQ(0u, program->exact_noop_word_count());
+  EXPECT_EQ(0u, program->exact_noop_rank_block_count());
+  EXPECT_EQ(1u, program->native_line_count());
+}
