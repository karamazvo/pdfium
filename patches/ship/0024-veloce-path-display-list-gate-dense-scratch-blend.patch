+bool ShouldRejectScratchBlendReplay(
+    const NativePathDisplayList& list,
+    VelocePathDisplayListHolderKind holder_kind) {
+  if (list.blend_nodes <= kMaxScratchBlendNodes) {
+    return false;
+  }
+
+  // r17's Darken support composites each blended node through its own
+  // temporary BGRA bitmap. Dense root pages such as 11.pdf have tens of
+  // thousands of Darken nodes, which makes replay slower than legacy PDFium.
+  // Reject before drawing so callers can use the original renderer unchanged.
+  return holder_kind == VelocePathDisplayListHolderKind::kRootPage;
+}
