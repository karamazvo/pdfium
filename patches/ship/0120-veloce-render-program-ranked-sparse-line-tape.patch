+std::vector<uint32_t> BuildExactNoOpRankBlocks(
+    pdfium::span<const uint64_t> words) {
+  if (words.empty()) {
+    return {};
+  }
+  std::vector<uint32_t> ranks;
+  ranks.reserve((words.size() + kVeloceExactNoOpRankBlockWords - 1u) /
+                    kVeloceExactNoOpRankBlockWords +
+                1u);
+  uint32_t rank = 0u;
+  ranks.push_back(rank);
+  for (size_t word = 0u; word < words.size(); ++word) {
+    rank += std::popcount(words[word]);
+    if ((word + 1u) % kVeloceExactNoOpRankBlockWords == 0u) {
+      ranks.push_back(rank);
+    }
+  }
+  if (words.size() % kVeloceExactNoOpRankBlockWords != 0u) {
+    ranks.push_back(rank);
+  }
+  return ranks;
+}
