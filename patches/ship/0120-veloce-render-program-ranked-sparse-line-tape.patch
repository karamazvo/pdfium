+bool VeloceRenderProgram::IsExactNoOp(uint32_t command_index) const {
+  const size_t word_index = command_index / kVeloceExactNoOpWordBits;
+  return word_index < exact_noop_words_.size() &&
+         (exact_noop_words_[word_index] &
+          (uint64_t{1} << (command_index % kVeloceExactNoOpWordBits))) != 0u;
+}
+
+uint32_t VeloceRenderProgram::ExactNoOpsBefore(
+    uint32_t command_index) const {
+  if (command_index == 0u || exact_noop_words_.empty()) {
+    return 0u;
+  }
+  const size_t word_limit =
+      std::min<size_t>(command_index / kVeloceExactNoOpWordBits,
+                       exact_noop_words_.size());
+  const size_t rank_block =
+      word_limit / kVeloceExactNoOpRankBlockWords;
+  CHECK_LT(rank_block, exact_noop_rank_blocks_.size());
+  uint32_t rank = exact_noop_rank_blocks_[rank_block];
+  const size_t first_word =
+      rank_block * kVeloceExactNoOpRankBlockWords;
+  for (size_t word = first_word; word < word_limit; ++word) {
+    rank += std::popcount(exact_noop_words_[word]);
+  }
+  const uint32_t bit = command_index % kVeloceExactNoOpWordBits;
+  if (bit != 0u && word_limit < exact_noop_words_.size()) {
+    rank += std::popcount(exact_noop_words_[word_limit] &
+                          ((uint64_t{1} << bit) - 1u));
+  }
+  return rank;
+}
+
+uint32_t VeloceRenderProgram::ConsecutiveExactNoOps(
+    uint32_t command_index) const {
+  if (!IsExactNoOp(command_index)) {
+    return 0u;
+  }
+  uint32_t count = 0u;
+  uint32_t command = command_index;
+  while (command < command_count()) {
+    const size_t word_index = command / kVeloceExactNoOpWordBits;
+    if (word_index >= exact_noop_words_.size()) {
+      break;
+    }
+    const uint32_t bit = command % kVeloceExactNoOpWordBits;
+    const uint64_t shifted = exact_noop_words_[word_index] >> bit;
+    const uint32_t available = std::min<uint32_t>(
+        kVeloceExactNoOpWordBits - bit,
+        static_cast<uint32_t>(command_count() - command));
+    const uint32_t ones =
+        std::min<uint32_t>(std::countr_one(shifted), available);
+    count += ones;
+    command += ones;
+    if (ones != available) {
+      break;
+    }
+  }
+  return count;
+}
+
+uint32_t VeloceRenderProgram::NativeLinePayloadIndex(
+    const VeloceNativeRun& run,
+    uint32_t command_index) const {
+  CHECK_EQ(run.opcode, VeloceRenderOpcode::kNativeOpaqueLine);
+  CHECK_GE(command_index, run.first_command);
+  CHECK_LT(command_index, run.first_command + run.command_count);
+  CHECK(!IsExactNoOp(command_index));
+  const uint32_t source_offset = command_index - run.first_command;
+  const uint32_t preceding_noops =
+      ExactNoOpsBefore(command_index) -
+      ExactNoOpsBefore(run.first_command);
+  CHECK_GE(source_offset, preceding_noops);
+  return run.first_payload + source_offset - preceding_noops;
+}
