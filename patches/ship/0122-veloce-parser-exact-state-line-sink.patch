+VeloceRenderProgramBuilder::ParsedLineCacheResult
+VeloceRenderProgramBuilder::TryAppendCachedParsedLine(
+    const CFX_PointF& start,
+    const CFX_PointF& end,
+    const CFX_Matrix& matrix,
+    const CPDF_GraphicStates& states,
+    const CPDF_ContentMarks& content_marks,
+    uint32_t command_index,
+    CFX_FloatRect* bounds,
+    bool* bounds_known) {
+  if (!parsed_line_context_ || !IsFinitePoint(start) || !IsFinitePoint(end) ||
+      !IsFiniteMatrix(matrix)) {
+    return ParsedLineCacheResult::kMiss;
+  }
+  const bool uses_inline_translation = HasIdentityLinearPart(matrix);
+  if (uses_inline_translation !=
+          parsed_line_context_->uses_inline_translation ||
+      (!uses_inline_translation &&
+       !SameMatrix(parsed_line_context_->matrix, matrix)) ||
+      !parsed_line_context_->general_state.HasSameBackingStore(
+          states.general_state()) ||
+      !parsed_line_context_->color_state.HasSameBackingStore(
+          states.color_state()) ||
+      !parsed_line_context_->graph_state.HasSameBackingStore(
+          states.graph_state()) ||
+      content_marks.CountItems() > kMaxVisibilityMarks) {
+    return ParsedLineCacheResult::kMiss;
+  }
+
+  last_native_was_exact_noop_ = false;
+  last_native_was_darken_ = false;
+  last_native_was_fill_ = false;
+  if (start == end &&
+      parsed_line_context_->line_cap ==
+          CFX_GraphStateData::LineCap::kButt) {
+    ++parser_line_context_hit_count_;
+    return AppendExactNoOp(command_index)
+               ? ParsedLineCacheResult::kAppended
+               : ParsedLineCacheResult::kRejected;
+  }
+  if (!HasSameVisibilityScope(content_marks) ||
+      !HasSameClipScope(states.clip_path())) {
+    return ParsedLineCacheResult::kMiss;
+  }
+  ++parser_line_context_hit_count_;
+
+  *bounds = CFX_Path::GetBoundingBoxForStrokeLine(
+      start, end, parsed_line_context_->line_width);
+  *bounds = matrix.TransformRect(*bounds);
+  if (parsed_line_context_->line_width == 0.0f) {
+    bounds->Inflate(0.5f, 0.5f);
+  }
+  bounds->Normalize();
+  *bounds_known = IsFiniteRect(*bounds) && !bounds->IsEmpty();
+
+  const bool needs_native_run =
+      native_runs_.empty() ||
+      native_runs_.back().opcode != VeloceRenderOpcode::kNativeOpaqueLine ||
+      native_runs_.back().first_command + native_runs_.back().command_count !=
+          command_index;
+  const bool needs_line_run =
+      native_line_runs_.empty() ||
+      native_line_runs_.back().state_index !=
+          parsed_line_context_->state_index ||
+      native_line_runs_.back().matrix_index !=
+          parsed_line_context_->matrix_index;
+  if (native_lines_.size() >= kMaxNativeLines ||
+      (needs_native_run && native_runs_.size() >= kMaxNativeRuns) ||
+      !TryReserveCachedParsedLineBudget(needs_line_run, needs_native_run)) {
+    ++native_budget_fallbacks_;
+    Reject(VeloceNativeLineRejectReason::kBudget);
+    return ParsedLineCacheResult::kRejected;
+  }
+
+  VeloceNativeLine line;
+  line.start = start;
+  line.end = end;
+  line.translation_x = uses_inline_translation ? matrix.e : 0.0f;
+  line.translation_y = uses_inline_translation ? matrix.f : 0.0f;
+  CHECK(native_lines_.Append(line, kMaxNativeLines));
+  if (*bounds_known) {
+    if (native_line_bounds_) {
+      native_line_bounds_->Union(*bounds);
+    } else {
+      native_line_bounds_ = *bounds;
+    }
+  }
+  AppendNativeLineRun(parsed_line_context_->state_index,
+                      parsed_line_context_->matrix_index);
+  AppendSpatialOrdinal(command_index, *bounds, *bounds_known);
+  if (content_marks.CountItems() != 0u) {
+    ++visibility_scoped_line_count_;
+  }
+  if (uses_inline_translation) {
+    ++inline_translation_line_count_;
+  }
+  return ParsedLineCacheResult::kAppended;
+}
