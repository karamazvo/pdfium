+bool VeloceRenderProgramBuilder::TryReserveCachedParsedLineBudget(
+    bool needs_line_run,
+    bool needs_native_run) {
+  constexpr size_t kRunReservationEntries = 4096u;
+  constexpr size_t kLineRunReservationEntries = 1024u;
+
+  size_t line_slots =
+      cached_line_payload_budget_slots_ == 0u
+          ? std::min(VeloceNativeLineStorage::kChunkLines,
+                     kMaxNativeLines - native_lines_.size())
+          : 0u;
+  size_t native_run_slots =
+      needs_native_run && cached_native_run_budget_slots_ == 0u
+          ? std::min(kRunReservationEntries,
+                     kMaxNativeRuns - native_runs_.size())
+          : 0u;
+  size_t line_run_slots =
+      needs_line_run && cached_line_run_budget_slots_ == 0u
+          ? std::min(kLineRunReservationEntries,
+                     kMaxNativeLines - native_line_runs_.size())
+          : 0u;
+  if (line_slots == 0u && cached_line_payload_budget_slots_ == 0u) {
+    return false;
+  }
+  if (needs_native_run && native_run_slots == 0u &&
+      cached_native_run_budget_slots_ == 0u) {
+    return false;
+  }
+  if (needs_line_run && line_run_slots == 0u &&
+      cached_line_run_budget_slots_ == 0u) {
+    return false;
+  }
+
+  size_t additional_bytes =
+      line_slots * sizeof(VeloceNativeLine) +
+      native_run_slots * sizeof(VeloceNativeRun) +
+      line_run_slots * sizeof(VeloceNativeLineRun);
+  if (additional_bytes != 0u) {
+    if (logical_retained_bytes_ > kMaxRetainedProgramBytes) {
+      return false;
+    }
+    const size_t remaining_bytes =
+        kMaxRetainedProgramBytes - logical_retained_bytes_;
+    if (additional_bytes > remaining_bytes) {
+      // A packet is only an accounting optimization. Shrink the final refill
+      // so it cannot reject a command that fits under the exact byte ceiling.
+      line_slots = line_slots == 0u ? 0u : 1u;
+      native_run_slots = native_run_slots == 0u ? 0u : 1u;
+      line_run_slots = line_run_slots == 0u ? 0u : 1u;
+      additional_bytes =
+          line_slots * sizeof(VeloceNativeLine) +
+          native_run_slots * sizeof(VeloceNativeRun) +
+          line_run_slots * sizeof(VeloceNativeLineRun);
+    }
+    if (additional_bytes > remaining_bytes) {
+      return false;
+    }
+    ++parser_line_budget_refill_count_;
+    logical_retained_bytes_ += additional_bytes;
+    cached_line_payload_budget_slots_ += line_slots;
+    cached_native_run_budget_slots_ += native_run_slots;
+    cached_line_run_budget_slots_ += line_run_slots;
+  }
+
+  CHECK_GT(cached_line_payload_budget_slots_, 0u);
+  --cached_line_payload_budget_slots_;
+  if (needs_native_run) {
+    CHECK_GT(cached_native_run_budget_slots_, 0u);
+    --cached_native_run_budget_slots_;
+  }
+  if (needs_line_run) {
+    CHECK_GT(cached_line_run_budget_slots_, 0u);
+    --cached_line_run_budget_slots_;
+  }
+  return true;
+}
