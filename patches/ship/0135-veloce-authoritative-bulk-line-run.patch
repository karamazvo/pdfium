+size_t VeloceRenderProgramBuilder::AppendParsedTranslationOriginLineRun(
+    pdfium::span<const VeloceParsedTranslationOriginLine> lines,
+    const CFX_Matrix& common_matrix,
+    const CPDF_GraphicStates& states,
+    const CPDF_ContentMarks& content_marks) {
+  if (lines.empty() || exceeded_budget_ || !parsed_line_context_ ||
+      !parsed_line_context_->uses_inline_translation ||
+      !HasIdentityLinearPart(common_matrix) ||
+      !IsFiniteMatrix(common_matrix) ||
+      !parsed_line_context_->general_state.HasSameBackingStore(
+          states.general_state()) ||
+      !parsed_line_context_->color_state.HasSameBackingStore(
+          states.color_state()) ||
+      !parsed_line_context_->graph_state.HasSameBackingStore(
+          states.graph_state()) ||
+      content_marks.CountItems() > kMaxVisibilityMarks ||
+      !HasSameVisibilityScope(content_marks) ||
+      !HasSameClipScope(states.clip_path())) {
+    return 0u;
+  }
+
+  size_t candidate_count = 0u;
+  for (const VeloceParsedTranslationOriginLine& line : lines) {
+    if (!IsFinitePoint(line.end) || !std::isfinite(line.translation_x) ||
+        !std::isfinite(line.translation_y) ||
+        (line.end == CFX_PointF() &&
+         parsed_line_context_->line_cap ==
+             CFX_GraphStateData::LineCap::kButt)) {
+      break;
+    }
+    ++candidate_count;
+  }
+  candidate_count =
+      std::min(candidate_count,
+               static_cast<size_t>(kMaxHolderCommands - object_count_));
+  candidate_count =
+      std::min(candidate_count,
+               kMaxNativeLines -
+                   native_lines_.size() - native_translation_lines_.size());
+  if (candidate_count == 0u) {
+    return 0u;
+  }
+
+  const uint32_t first_command = object_count_;
+  const VeloceRenderOpcode opcode =
+      VeloceRenderOpcode::kNativeTranslationOriginLine;
+  const bool needs_native_run =
+      native_runs_.empty() || native_runs_.back().opcode != opcode ||
+      native_runs_.back().first_command + native_runs_.back().command_count !=
+          first_command;
+  const bool needs_line_run =
+      native_translation_line_runs_.empty() ||
+      native_translation_line_runs_.back().state_index !=
+          parsed_line_context_->state_index ||
+      native_translation_line_runs_.back().matrix_index !=
+          parsed_line_context_->matrix_index;
+  if (!TryReserveCachedParsedLineBudget(
+          /*translation_origin=*/true, needs_line_run, needs_native_run)) {
+    return 0u;
+  }
+
+  // The scalar reservation consumed one payload slot. Consume the rest of the
+  // already-accounted packet here, then commit exactly that bounded prefix.
+  const size_t reserved_count =
+      1u + cached_translation_line_payload_budget_slots_;
+  const size_t append_count = std::min(candidate_count, reserved_count);
+  cached_translation_line_payload_budget_slots_ -= append_count - 1u;
+
+  object_count_ += static_cast<uint32_t>(append_count);
+  if (build_start_millis_ == 0u) {
+    build_start_millis_ = NowMillis();
+  }
+  path_object_count_ += static_cast<uint32_t>(append_count);
+  parser_direct_line_attempt_count_ += static_cast<uint32_t>(append_count);
+  parser_line_context_hit_count_ += static_cast<uint32_t>(append_count);
+  parser_fused_line_count_ += static_cast<uint32_t>(append_count);
+  parser_constant_folded_line_count_ += static_cast<uint32_t>(append_count);
+  inline_translation_line_count_ += static_cast<uint32_t>(append_count);
+  if (content_marks.CountItems() != 0u) {
+    visibility_scoped_line_count_ += static_cast<uint32_t>(append_count);
+  }
+  last_native_was_exact_noop_ = false;
+  last_native_was_darken_ = false;
+  last_native_was_fill_ = false;
+
+  std::optional<CFX_FloatRect> batch_bounds;
+  const uint32_t first_payload =
+      static_cast<uint32_t>(native_translation_lines_.size());
+  for (size_t i = 0u; i < append_count; ++i) {
+    const VeloceParsedTranslationOriginLine& parsed_line = lines[i];
+    VeloceNativeTranslationOriginLine line;
+    line.end = parsed_line.end;
+    line.translation_x = parsed_line.translation_x;
+    line.translation_y = parsed_line.translation_y;
+    CHECK(native_translation_lines_.Append(line, kMaxNativeLines));
+
+    const CFX_Matrix matrix(1.0f, 0.0f, 0.0f, 1.0f,
+                            parsed_line.translation_x,
+                            parsed_line.translation_y);
+    CFX_FloatRect bounds = BuildConservativeTranslationLineBounds(
+        parsed_line.end, matrix, parsed_line_context_->line_width);
+    bounds.Normalize();
+    const bool bounds_known = IsFiniteRect(bounds) && !bounds.IsEmpty();
+    if (bounds_known) {
+      if (batch_bounds) {
+        batch_bounds->Union(bounds);
+      } else {
+        batch_bounds = bounds;
+      }
+    }
+    AppendSpatialOrdinal(first_command + static_cast<uint32_t>(i), bounds,
+                         bounds_known);
+  }
+
+  if (batch_bounds) {
+    if (native_line_bounds_) {
+      native_line_bounds_->Union(*batch_bounds);
+    } else {
+      native_line_bounds_ = *batch_bounds;
+    }
+  }
+  if (needs_line_run) {
+    native_translation_line_runs_.push_back(
+        {first_payload, static_cast<uint32_t>(append_count),
+         parsed_line_context_->state_index,
+         parsed_line_context_->matrix_index});
+  } else {
+    native_translation_line_runs_.back().line_count +=
+        static_cast<uint32_t>(append_count);
+  }
+  if (needs_native_run) {
+    native_runs_.push_back(
+        {first_command, static_cast<uint32_t>(append_count), first_payload,
+         opcode});
+  } else {
+    native_runs_.back().command_count += static_cast<uint32_t>(append_count);
+  }
+  opcode_counts_[static_cast<size_t>(opcode)] +=
+      static_cast<uint32_t>(append_count);
+  return append_count;
+}
