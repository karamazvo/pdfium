From: xPDFSDK team <noreply@xpdfsdk.local>
Date: 2026-05-17
Subject: [PATCH] Plumb resolution_levels_to_skip into JPEG (DCTDecode) decoder

Background
==========
PDFium already plumbs `resolution_levels_to_skip` through CPDF_DIB::StartLoadDIBBase
and into the decoder factory (cpdf_dib.cpp:200-207). The JPEG2000 (JPXDecode)
path honors it — LoadJpxBitmap(resolution_levels_to_skip) — but the baseline JPEG
(DCTDecode) path silently discards it.

Consequence: when an embedder calls FPDF_RenderPageBitmap at a small target size
(e.g. a thumbnail at 1/8 of the page's natural pixel size), PDFium decodes every
embedded JPEG at FULL native resolution and then downscales the resulting bitmap.
For image-heavy PDFs (magazines, picture books, print-ready content) this is the
dominant cost — a 6000x8000 embedded JPEG decodes to ~24 MB even when the target
viewport only needs 750x1000.

This patch
==========
1. JpegModule::CreateDecoder gains a `resolution_levels_to_skip` parameter.
2. JpegDecoder::Create applies libjpeg's scale_num=1, scale_denom=2^skip before
   start_decompress. Output dims become ceil(orig / scale_denom).
3. CPDF_DIB::CreateDCTDecoder forwards the skip value through both initial-create
   and retry paths.
4. CPDF_StreamParser passes 0 (no skip — inline images are already tiny).

Effect: JPEG-bearing pages render at the target resolution rather than at native.
Expected speedup on image-heavy PDFs (Phase 2 magazine test case): ~5-10x.

Risk
====
Low. scale_num/scale_denom is a documented libjpeg API. Output dimensions become
ceil(orig / scale_denom). CPDF_DIB::CreateDCTDecoder propagates the (possibly
smaller) post-scale dims via SetWidth/SetHeight, so CFX_DIBitmap allocation
matches the decoded data. Tested values: scale_denom ∈ {1, 2, 4, 8}.

---
 core/fpdfapi/page/cpdf_dib.cpp           | 15 +++++++++------
 core/fpdfapi/page/cpdf_dib.h             |  3 ++-
 core/fpdfapi/page/cpdf_streamparser.cpp  |  2 +-
 core/fxcodec/jpeg/jpegmodule.cpp         | 21 ++++++++++++++++++++-
 core/fxcodec/jpeg/jpegmodule.h           |  3 ++-
 5 files changed, 34 insertions(+), 10 deletions(-)

diff --git a/core/fpdfapi/page/cpdf_dib.cpp b/core/fpdfapi/page/cpdf_dib.cpp
--- a/core/fpdfapi/page/cpdf_dib.cpp
+++ b/core/fpdfapi/page/cpdf_dib.cpp
@@ -475,7 +475,7 @@ CPDF_DIB::LoadState CPDF_DIB::CreateDecoder(uint8_t resolution_levels_to_skip) {
     decoder_ = BasicModule::CreateRunLengthDecoder(
         src_span, GetWidth(), GetHeight(), components_, bpc_);
   } else if (decoder == "DCTDecode") {
-    if (!CreateDCTDecoder(src_span, pParams)) {
+    if (!CreateDCTDecoder(src_span, pParams, resolution_levels_to_skip)) {
       return LoadState::kFail;
     }
   }
@@ -503,9 +503,11 @@ CPDF_DIB::LoadState CPDF_DIB::CreateDecoder(uint8_t resolution_levels_to_skip) {
 }

 bool CPDF_DIB::CreateDCTDecoder(pdfium::span<const uint8_t> src_span,
-                                const CPDF_Dictionary* pParams) {
+                                const CPDF_Dictionary* pParams,
+                                uint8_t resolution_levels_to_skip) {
   decoder_ = JpegModule::CreateDecoder(
       src_span, GetWidth(), GetHeight(), components_,
+      resolution_levels_to_skip,
       !pParams || pParams->GetIntegerFor("ColorTransform", 1));
   if (decoder_) {
     return true;
@@ -524,10 +526,11 @@ bool CPDF_DIB::CreateDCTDecoder(pdfium::span<const uint8_t> src_span,
       !CPDF_Image::IsValidJpegBitsPerComponent(info.bits_per_components)) {
     return false;
   }
+
   decoder_ = JpegModule::CreateDecoder(src_span, GetWidth(), GetHeight(),
-                                       components_, info.color_transform);
+                                       components_, resolution_levels_to_skip,
+                                       info.color_transform);
   if (!decoder_) {
     return false;
   }
   return true;
 }

diff --git a/core/fpdfapi/page/cpdf_dib.h b/core/fpdfapi/page/cpdf_dib.h
--- a/core/fpdfapi/page/cpdf_dib.h
+++ b/core/fpdfapi/page/cpdf_dib.h
@@ -100,7 +100,8 @@ class CPDF_DIB final : public CFX_DIBBase {
                       const CPDF_Dictionary* pPageResources);
   LoadState CreateDecoder(uint8_t resolution_levels_to_skip);
   bool CreateDCTDecoder(pdfium::span<const uint8_t> src_span,
-                        const CPDF_Dictionary* pParams);
+                        const CPDF_Dictionary* pParams,
+                        uint8_t resolution_levels_to_skip);
   void LoadPalette();
   LoadState StartLoadMask();
   LoadState StartLoadMaskDIB(RetainPtr<const CPDF_Stream> mask_stream);

diff --git a/core/fpdfapi/page/cpdf_streamparser.cpp b/core/fpdfapi/page/cpdf_streamparser.cpp
--- a/core/fpdfapi/page/cpdf_streamparser.cpp
+++ b/core/fpdfapi/page/cpdf_streamparser.cpp
@@ -102,7 +102,8 @@
   }
   if (decoder == "DCTDecode") {
     std::unique_ptr<ScanlineDecoder> pDecoder = JpegModule::CreateDecoder(
-        src_span, width, height, 0,
+        src_span, width, height, /*nComps=*/0,
+        /*resolution_levels_to_skip=*/0,
         !pParam || pParam->GetIntegerFor("ColorTransform", 1));
     return DecodeAllScanlines(std::move(pDecoder));
   }

diff --git a/core/fxcodec/jpeg/jpegmodule.cpp b/core/fxcodec/jpeg/jpegmodule.cpp
--- a/core/fxcodec/jpeg/jpegmodule.cpp
+++ b/core/fxcodec/jpeg/jpegmodule.cpp
@@ -200,11 +200,16 @@ bool JpegDecoder::Create(pdfium::span<const uint8_t> src_span,
                          uint32_t width,
                          uint32_t height,
                          int nComps,
+                         uint8_t resolution_levels_to_skip,
                          bool ColorTransform) {
   src_span_ = JpegScanSOI(src_span);
   if (src_span_.size() < 2) {
     return false;
   }
+  // libjpeg supports decode-time downscale via scale_num/scale_denom.
+  // scale_denom must be a power of 2 in [1, 8]. Clamp here.
+  const uint32_t scale_denom =
+      1u << std::min<uint8_t>(resolution_levels_to_skip, 3);

   PatchUpTrailer();

@@ -229,9 +234,17 @@ bool JpegDecoder::Create(pdfium::span<const uint8_t> src_span,
   if (common_.cinfo.num_components < nComps) {
     return false;
   }

   if (common_.cinfo.image_width < width) {
     return false;
   }
+
+  // Apply downscale-on-decode. libjpeg will skip DCT blocks during the
+  // IDCT pass, producing output of dimensions ceil(orig / scale_denom).
+  // This is the major speedup for image-heavy PDFs rendered at thumbnail
+  // or low-zoom target sizes. Must be set BEFORE jpeg_start_decompress
+  // (called via Rewind() in the scanline iteration path).
+  common_.cinfo.scale_num = 1;
+  common_.cinfo.scale_denom = scale_denom;
+  default_scale_denom_ = scale_denom;
+  output_width_ = (orig_width_ + scale_denom - 1) / scale_denom;
+  output_height_ = (orig_height_ + scale_denom - 1) / scale_denom;

   CalcPitch();
   scanline_buf_ = DataVector<uint8_t>(pitch_);
@@ -353,11 +366,13 @@ std::unique_ptr<ScanlineDecoder> JpegModule::CreateDecoder(
     pdfium::span<const uint8_t> src_span,
     uint32_t width,
     uint32_t height,
     int nComps,
+    uint8_t resolution_levels_to_skip,
     bool ColorTransform) {
   DCHECK(!src_span.empty());

   auto pDecoder = std::make_unique<JpegDecoder>();
-  if (!pDecoder->Create(src_span, width, height, nComps, ColorTransform)) {
+  if (!pDecoder->Create(src_span, width, height, nComps,
+                        resolution_levels_to_skip, ColorTransform)) {
     return nullptr;
   }


diff --git a/core/fxcodec/jpeg/jpegmodule.h b/core/fxcodec/jpeg/jpegmodule.h
--- a/core/fxcodec/jpeg/jpegmodule.h
+++ b/core/fxcodec/jpeg/jpegmodule.h
@@ -34,7 +34,8 @@ class JpegModule {
       pdfium::span<const uint8_t> src_span,
       uint32_t width,
       uint32_t height,
-      int nComps,
+      int nComps,
+      uint8_t resolution_levels_to_skip,
       bool ColorTransform);

   // Returns std::nullopt on failure.
--
