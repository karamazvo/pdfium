+bool CStretchEngine::BuildExactCoveragePlan() {
+  if (exact_coverage_->GetFormat() != FXDIB_Format::k8bppMask ||
+      exact_coverage_->GetWidth() != dest_clip_.Width() ||
+      exact_coverage_->GetHeight() != dest_clip_.Height()) {
+    return false;
+  }
+
+  const size_t destination_width =
+      static_cast<size_t>(dest_clip_.Width());
+  active_words_per_source_row_ =
+      (destination_width + kCoverageWordBits - 1) / kCoverageWordBits;
+  FX_SAFE_SIZE_T safe_word_count =
+      static_cast<size_t>(src_clip_.Height());
+  safe_word_count *= active_words_per_source_row_;
+  FX_SAFE_SIZE_T safe_bytes = safe_word_count;
+  safe_bytes *= sizeof(uint32_t);
+  if (!safe_bytes.IsValid() || safe_bytes.ValueOrDie() == 0 ||
+      safe_bytes.ValueOrDie() > kMaxExactCoveragePlanBytes) {
+    return false;
+  }
+
+  active_destination_columns_by_source_row_.assign(
+      safe_word_count.ValueOrDie(), 0u);
+  bool found_coverage = false;
+  for (int destination_row = dest_clip_.top;
+       destination_row < dest_clip_.bottom; ++destination_row) {
+    const pdfium::span<const uint8_t> coverage_row =
+        exact_coverage_->GetScanline(destination_row - dest_clip_.top);
+    if (coverage_row.size() < destination_width) {
+      active_destination_columns_by_source_row_.clear();
+      active_words_per_source_row_ = 0;
+      return false;
+    }
+
+    const PixelWeight* vertical_weights =
+        vertical_weight_table_.GetPixelWeight(destination_row);
+    for (size_t word_index = 0;
+         word_index < active_words_per_source_row_; ++word_index) {
+      const size_t first_column = word_index * kCoverageWordBits;
+      const size_t last_column =
+          std::min(destination_width, first_column + kCoverageWordBits);
+      uint32_t active_word = 0;
+      for (size_t column = first_column; column < last_column; ++column) {
+        if (coverage_row[column] != 0) {
+          active_word |= uint32_t{1} << (column - first_column);
+        }
+      }
+      if (active_word == 0) {
+        continue;
+      }
+      found_coverage = true;
+      for (int source_row = vertical_weights->src_start_;
+           source_row <= vertical_weights->src_end_; ++source_row) {
+        const size_t source_row_index =
+            static_cast<size_t>(source_row - src_clip_.top);
+        active_destination_columns_by_source_row_[
+            source_row_index * active_words_per_source_row_ + word_index] |=
+            active_word;
+      }
+    }
+  }
+
+  uses_exact_coverage_ = true;
+  exact_coverage_empty_ = !found_coverage;
+  return true;
+}
