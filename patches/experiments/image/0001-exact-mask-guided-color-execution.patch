+bool CFX_AggDeviceDriver::CanStartDIBitsWithMask(
+    const CFX_DIBBase& bitmap,
+    const CFX_Matrix& matrix,
+    BlendMode blend_type) const {
+  return bitmap.IsOpaqueImage() && blend_type == BlendMode::kNormal &&
+         !group_knockout_ && !backdrop_bitmap_ &&
+         (!clip_rgn_ || !clip_rgn_->GetMask()) && matrix.a != 0.0f &&
+         matrix.d != 0.0f && fabs(matrix.b) < 0.5f &&
+         fabs(matrix.c) < 0.5f;
+}
+
+RenderDeviceDriverIface::StartResult CFX_AggDeviceDriver::StartDIBitsWithMask(
+    RetainPtr<const CFX_DIBBase> bitmap,
+    RetainPtr<const CFX_DIBBase> mask,
+    const FX_RECT& mask_rect,
+    float alpha,
+    const CFX_Matrix& matrix,
+    const FXDIB_ResampleOptions& options,
+    BlendMode blend_type) {
+  if (!bitmap || !mask ||
+      !CanStartDIBitsWithMask(*bitmap, matrix, blend_type) ||
+      alpha != 1.0f ||
+      mask->GetFormat() != FXDIB_Format::k8bppMask ||
+      mask->GetWidth() != mask_rect.Width() ||
+      mask->GetHeight() != mask_rect.Height()) {
+    return {Result::kFailure, nullptr};
+  }
+
+  FX_RECT clipped_image_rect = matrix.GetUnitRect().GetOuterRect();
+  clipped_image_rect.Intersect(GetClipBox());
+  if (clipped_image_rect != mask_rect) {
+    return {Result::kFailure, nullptr};
+  }
+  if (bitmap_->GetBuffer().empty() || clipped_image_rect.IsEmpty()) {
+    return {Result::kSuccess, nullptr};
+  }
+
+  auto renderer = std::make_unique<CFX_AggImageRenderer>(
+      bitmap_, clip_rgn_.get(), std::move(bitmap), alpha,
+      /*mask_color=*/0, matrix, options, rgb_byte_order_, std::move(mask),
+      mask_rect, blend_type);
+  if (!renderer->IsValid()) {
+    return {Result::kFailure, nullptr};
+  }
+  return {Result::kSuccess, std::move(renderer)};
+}
