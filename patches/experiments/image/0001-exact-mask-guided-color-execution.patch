+      static_cast<size_t>(destination_col - dest_clip_.left);
+  const size_t source_row_index =
+      static_cast<size_t>(source_row - src_clip_.top);
+  const size_t word_index = local_column / kCoverageWordBits;
+  const uint32_t word = active_destination_columns_by_source_row_[
+      source_row_index * active_words_per_source_row_ + word_index];
+  return (word & (uint32_t{1} << (local_column % kCoverageWordBits))) != 0;
+}
