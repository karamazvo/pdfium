+TEST(CFXDefaultRenderDeviceTest, BoundedMaskedBitsMatchCanonicalComposite) {
+  constexpr int kWidth = 79;
+  constexpr int kHeight = 96;
+  auto canonical_source = pdfium::MakeRetain<CFX_DIBitmap>();
+  auto direct_source = pdfium::MakeRetain<CFX_DIBitmap>();
+  auto canonical_mask = pdfium::MakeRetain<CFX_DIBitmap>();
+  auto direct_mask = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(canonical_source->Create(kWidth, kHeight,
+                                       FXDIB_Format::kBgrx));
+  ASSERT_TRUE(direct_source->Create(kWidth, kHeight, FXDIB_Format::kBgrx));
+  ASSERT_TRUE(canonical_mask->Create(kWidth, kHeight,
+                                     FXDIB_Format::k8bppMask));
+  ASSERT_TRUE(direct_mask->Create(kWidth, kHeight,
+                                  FXDIB_Format::k8bppMask));
+  canonical_source->Clear(0xff2850a0);
+  direct_source->Clear(0xff2850a0);
+  for (int row = 0; row < kHeight; ++row) {
+    auto canonical_row = canonical_mask->GetWritableScanline(row).first(
+        static_cast<size_t>(kWidth));
+    auto direct_row = direct_mask->GetWritableScanline(row).first(
+        static_cast<size_t>(kWidth));
+    for (int col = 0; col < kWidth; ++col) {
+      const uint8_t coverage = static_cast<uint8_t>((row * 17 + col * 29) % 256);
+      canonical_row[col] = coverage;
+      direct_row[col] = coverage;
+    }
+  }
+
+  CFX_DefaultRenderDevice canonical;
+  CFX_DefaultRenderDevice direct;
+  ASSERT_TRUE(canonical.Create(kWidth, kHeight, FXDIB_Format::kBgra));
+  ASSERT_TRUE(direct.Create(kWidth, kHeight, FXDIB_Format::kBgra));
+  canonical.GetBitmap()->Clear(0xffc86432);
+  direct.GetBitmap()->Clear(0xffc86432);
+  ASSERT_TRUE(canonical_source->MultiplyAlphaMask(canonical_mask));
+  ASSERT_TRUE(canonical.SetDIBits(canonical_source, 0, 0));
+  EXPECT_EQ(RenderDeviceDriverIface::SetBitsWithMaskResult::kSuccess,
+            direct.SetBitsWithMaskAndCancel(direct_source, direct_mask, 0, 0,
+                                            1.0f, BlendMode::kNormal,
+                                            nullptr));
+  EXPECT_TRUE(std::ranges::equal(canonical.GetBitmap()->GetBuffer(),
+                                 direct.GetBitmap()->GetBuffer()));
+}
+
+TEST(CFXDefaultRenderDeviceTest, BoundedMaskedBitsObserveCancellation) {
+  constexpr int kWidth = 79;
+  constexpr int kHeight = 96;
+  auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+  auto mask = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(source->Create(kWidth, kHeight, FXDIB_Format::kBgrx));
+  ASSERT_TRUE(mask->Create(kWidth, kHeight, FXDIB_Format::k8bppMask));
+  source->Clear(0xff2850a0);
+  mask->Clear(0x80808080);
+
+  CFX_DefaultRenderDevice device;
+  CFX_DefaultRenderDevice untouched;
+  ASSERT_TRUE(device.Create(kWidth, kHeight, FXDIB_Format::kBgra));
+  ASSERT_TRUE(untouched.Create(kWidth, kHeight, FXDIB_Format::kBgra));
+  device.GetBitmap()->Clear(0xffc86432);
+  untouched.GetBitmap()->Clear(0xffc86432);
+  CancelOnSecondCheck cancel;
+  EXPECT_EQ(RenderDeviceDriverIface::SetBitsWithMaskResult::kCancelled,
+            device.SetBitsWithMaskAndCancel(source, mask, 0, 0, 1.0f,
+                                            BlendMode::kNormal, &cancel));
+  EXPECT_FALSE(std::ranges::equal(device.GetBitmap()->GetScanline(0),
+                                  untouched.GetBitmap()->GetScanline(0)));
+  EXPECT_TRUE(std::ranges::equal(
+      device.GetBitmap()->GetScanline(kHeight - 1),
+      untouched.GetBitmap()->GetScanline(kHeight - 1)));
+}
