diff --git a/core/fxge/dib/cfx_imagetransformer_unittest.cpp b/core/fxge/dib/cfx_imagetransformer_unittest.cpp
new file mode 100644
index 000000000..2cc3f3f38
--- /dev/null
+++ b/core/fxge/dib/cfx_imagetransformer_unittest.cpp
@@ -0,0 +1,46 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "core/fxge/dib/cfx_imagetransformer.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+
+#include "core/fxge/dib/cfx_dibitmap.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+TEST(CFXImageTransformer, AffineTransformContinuesInBoundedExactChunks) {
+  auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(source->Create(64, 64, FXDIB_Format::kBgra));
+  auto source_buffer = source->GetWritableBuffer();
+  for (size_t i = 0; i < source_buffer.size(); ++i) {
+    source_buffer[i] = static_cast<uint8_t>((i * 29u + i / 17u) & 0xffu);
+  }
+
+  const CFX_Matrix matrix(512.0f, 32.0f, 16.0f, -512.0f, 0.0f, 512.0f);
+  CFX_ImageTransformer transformer(source, matrix, FXDIB_ResampleOptions(),
+                                   nullptr);
+  int continuation_count = 0;
+  while (transformer.Continue(nullptr)) {
+    ++continuation_count;
+  }
+
+  EXPECT_GT(continuation_count, 1);
+  RetainPtr<CFX_DIBitmap> result = transformer.DetachBitmap();
+  ASSERT_TRUE(result);
+  EXPECT_EQ(transformer.result().Width(), result->GetWidth());
+  EXPECT_EQ(transformer.result().Height(), result->GetHeight());
+  EXPECT_FALSE(result->GetBuffer().empty());
+
+  int result_left = 0;
+  int result_top = 0;
+  RetainPtr<CFX_DIBitmap> synchronous_result =
+      source->TransformTo(matrix, &result_left, &result_top);
+  ASSERT_TRUE(synchronous_result);
+  EXPECT_EQ(transformer.result().left, result_left);
+  EXPECT_EQ(transformer.result().top, result_top);
+  EXPECT_TRUE(std::ranges::equal(result->GetBuffer(),
+                                 synchronous_result->GetBuffer()));
+}
