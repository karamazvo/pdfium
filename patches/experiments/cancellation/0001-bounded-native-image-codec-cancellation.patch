+// found in the LICENSE file.
+
+#ifndef CORE_FXCRT_CANCELINDICATOR_IFACE_H_
+#define CORE_FXCRT_CANCELINDICATOR_IFACE_H_
+
+// Cancellation is intentionally separate from PauseIndicatorIface. A pause
+// yields progressive work that must be resumable; cancellation permanently
+// abandons the current result.
+class CancelIndicatorIface {
+ public:
+  virtual ~CancelIndicatorIface() = default;
+  virtual bool IsCancelled() const = 0;
+};
+
+#endif  // CORE_FXCRT_CANCELINDICATOR_IFACE_H_
