diff --git a/BUILD.gn b/BUILD.gn
index e025aad..a7cda3e 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -229,6 +229,14 @@ group("pdfium_public_headers") {
 component("pdfium") {
   output_name = "pdfium"
   libs = []
+  # xPDFSDK: link `libandroid.so` on Android so the AGG/JPEG ATrace_*
+  # markers added in core/fpdfapi/render/cpdf_renderstatus.cpp and
+  # core/fxcodec/jpeg/jpegmodule.cpp resolve at load time. ATrace_* is
+  # part of the NDK system library and incurs zero cost when tracing
+  # is disabled.
+  if (is_android) {
+    libs += [ "android" ]
+  }
   configs += [ ":pdfium_strict_config" ]
   public_configs = [ ":pdfium_public_config" ]
 
