+  // xPDFSDK: trace the object-type dispatch so we can see in the
+  // Perfetto trace whether image / text / path / form dominates time.
   bool bRet = false;
   switch (pObj->GetType()) {
     case CPDF_PageObject::Type::kText:
+      XPDF_ATRACE_BEGIN("pdfium.ProcessText");
       bRet = ProcessText(pObj->AsText(), mtObj2Device, nullptr);
+      XPDF_ATRACE_END();
       break;
     case CPDF_PageObject::Type::kPath:
+      XPDF_ATRACE_BEGIN("pdfium.ProcessPath");
       bRet = ProcessPath(pObj->AsPath(), mtObj2Device);
+      XPDF_ATRACE_END();
