+DataVector<uint8_t> ReadTestFile(const char* name) {
+  const std::string path = PathService::GetTestFilePath(name);
+  RetainPtr<CFX_FileAccessStream> stream =
+      CFX_FileAccessStream::CreateFromFilename(path.c_str());
+  if (!stream || stream->GetSize() <= 0) {
+    return {};
+  }
+  DataVector<uint8_t> data(
+      pdfium::checked_cast<size_t>(stream->GetSize()));
+  return stream->ReadBlockAtOffset(data, 0) ? std::move(data)
+                                             : DataVector<uint8_t>();
+}
