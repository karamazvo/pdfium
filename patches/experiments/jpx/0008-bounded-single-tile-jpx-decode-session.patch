+TEST(fxcodec, ReuseSingleTileGrayDecodeArea) {
+  const DataVector<uint8_t> source = ReadTestFile("gray.jp2");
+  ASSERT_FALSE(source.empty());
+
+  std::unique_ptr<CJPX_Decoder> decoder = CJPX_Decoder::Create(
+      source, CJPX_Decoder::ColorSpaceOption::kNormal,
+      /*resolution_levels_to_skip=*/0, /*strict_mode=*/true);
+  ASSERT_TRUE(decoder);
+  ASSERT_TRUE(decoder->CanReuseDecodeArea());
+  const CJPX_Decoder::JpxImageInfo full = decoder->GetFullInfo();
+  ASSERT_EQ(1u, full.channels);
+  ASSERT_GT(full.width, 1u);
+  ASSERT_GT(full.height, 1u);
+
+  const uint32_t split = full.width / 2;
+  ASSERT_TRUE(decoder->SetDecodeArea(0, 0, split, full.height));
+  ASSERT_TRUE(decoder->StartReusableDecode());
+  const CJPX_Decoder::JpxImageInfo left = decoder->GetInfo();
+  const std::optional<uint32_t> left_pitch =
+      fxge::CalculatePitch32(/*bpp=*/8, left.width);
+  ASSERT_TRUE(left_pitch.has_value());
+  DataVector<uint8_t> left_pixels(left_pitch.value() * left.height);
+  ASSERT_TRUE(decoder->Decode(left_pixels, left_pitch.value(),
+                              /*swap_rgb=*/false, /*component_count=*/1));
+
+  ASSERT_TRUE(
+      decoder->SetDecodeArea(split, 0, full.width, full.height));
+  ASSERT_TRUE(decoder->StartReusableDecode());
+  const CJPX_Decoder::JpxImageInfo right = decoder->GetInfo();
+  const std::optional<uint32_t> right_pitch =
+      fxge::CalculatePitch32(/*bpp=*/8, right.width);
+  ASSERT_TRUE(right_pitch.has_value());
+  DataVector<uint8_t> reused_pixels(right_pitch.value() * right.height);
+  ASSERT_TRUE(decoder->Decode(reused_pixels, right_pitch.value(),
+                              /*swap_rgb=*/false, /*component_count=*/1));
+
+  std::unique_ptr<CJPX_Decoder> reference = CJPX_Decoder::Create(
+      source, CJPX_Decoder::ColorSpaceOption::kNormal,
+      /*resolution_levels_to_skip=*/0, /*strict_mode=*/true);
+  ASSERT_TRUE(reference);
+  ASSERT_TRUE(
+      reference->SetDecodeArea(split, 0, full.width, full.height));
+  ASSERT_TRUE(reference->StartDecode());
+  const CJPX_Decoder::JpxImageInfo reference_info = reference->GetInfo();
+  ASSERT_EQ(right.width, reference_info.width);
+  ASSERT_EQ(right.height, reference_info.height);
+  DataVector<uint8_t> reference_pixels(right_pitch.value() * right.height);
+  ASSERT_TRUE(reference->Decode(reference_pixels, right_pitch.value(),
+                                /*swap_rgb=*/false,
+                                /*component_count=*/1));
+  EXPECT_EQ(reused_pixels, reference_pixels);
+}
