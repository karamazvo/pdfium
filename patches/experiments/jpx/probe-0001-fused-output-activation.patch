   if (result == OutputSinkResult::kFallback) {
+    decoder->fused_output_callback_result_ =
+        FusedOutputCallbackResult::kFallback;
     return OPJ_DECODE_OUTPUT_FALLBACK;
   }
   if (result == OutputSinkResult::kError) {
+    decoder->fused_output_callback_result_ = FusedOutputCallbackResult::kError;
     return OPJ_DECODE_OUTPUT_ERROR;
   }
 
+  decoder->fused_output_callback_result_ = FusedOutputCallbackResult::kReady;
   output->data = sink_output.data;
   output->data_size = sink_output.data_size;
   output->pitch = sink_output.pitch;
