   }
 
 #if defined(__ANDROID__)
+  if (output_sink) {
+    static std::atomic<uint32_t> probe_ordinal = 0;
+    const uint32_t ordinal =
+        probe_ordinal.fetch_add(1, std::memory_order_relaxed);
+    if (ordinal < 64 || (ordinal & 127u) == 0) {
