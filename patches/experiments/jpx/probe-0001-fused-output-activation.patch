+          break;
+      }
+      const auto probe_components = components_span(image_.get());
+      const opj_image_comp_t* first =
+          probe_components.empty() ? nullptr : &probe_components.front();
+      __android_log_print(
+          ANDROID_LOG_INFO, "PdfJpxFusedProbe",
+          "revision=r25-jpx-probe-0001 event=decode_result ordinal=%u "
