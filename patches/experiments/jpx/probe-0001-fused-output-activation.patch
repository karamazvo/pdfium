+          ordinal, fused_output_candidate_ ? 1 : 0, callback_result,
+          used_output_sink_ ? 1 : 0, parameters_.cp_reduce,
+          static_cast<int>(image_->color_space), probe_components.size(),
+          first ? first->prec : 0, first ? first->sgnd : 0,
+          first ? first->dx : 0, first ? first->dy : 0);
+    }
+  }
   if (used_output_sink_) {
