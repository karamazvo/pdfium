+
+bool CPDF_PageImageCache::Entry::IsSourceWindowValid(
+    const CFX_Size& max_size_required,
+    const std::optional<FX_RECT>& source_clip) const {
+  if (!cached_source_window_ || !cached_source_clip_.has_value() ||
+      !source_clip.has_value()) {
+    return false;
+  }
+  const FX_RECT& cached_clip = *cached_source_clip_;
+  const FX_RECT& required_clip = *source_clip;
+  if (required_clip.left < cached_clip.left ||
+      required_clip.top < cached_clip.top ||
+      required_clip.right > cached_clip.right ||
+      required_clip.bottom > cached_clip.bottom) {
+    return false;
+  }
+  if (cached_source_window_max_size_required_.width !=
+          max_size_required.width ||
+      cached_source_window_max_size_required_.height !=
+          max_size_required.height) {
+    return false;
+  }
+  return cached_source_window_->GetWidth() >= max_size_required.width &&
+         cached_source_window_->GetHeight() >= max_size_required.height;
+}
