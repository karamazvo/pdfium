--- a/core/fpdfapi/page/cpdf_pageimagecache_unittest.cpp
+++ b/core/fpdfapi/page/cpdf_pageimagecache_unittest.cpp
@@ -138,4 +138,67 @@ TEST_F(CPDFPageImageCacheTest, RenderBug1924) {
   }
 }
 
+TEST_F(CPDFPageImageCacheTest, ReusesContainedJpxSourceWindow) {
+  std::string file_path = PathService::GetTestFilePath("jpx_lzw.pdf");
+  ASSERT_FALSE(file_path.empty());
+  auto document =
+      std::make_unique<CPDF_Document>(std::make_unique<CPDF_DocRenderData>(),
+                                      std::make_unique<CPDF_DocPageData>());
+  ASSERT_EQ(document->LoadDoc(
+                CFX_FileAccessStream::CreateFromFilename(file_path.c_str()),
+                nullptr),
+            CPDF_Parser::SUCCESS);
+
+  RetainPtr<CPDF_Dictionary> page_dict =
+      document->GetMutablePageDictionary(0);
+  ASSERT_TRUE(page_dict);
+  auto page =
+      pdfium::MakeRetain<CPDF_Page>(document.get(), std::move(page_dict));
+  page->AddPageImageCache();
+  page->ParseContent();
+
+  CPDF_PageObject* page_obj = page->GetPageObjectByIndex(0);
+  ASSERT_TRUE(page_obj);
+  CPDF_ImageObject* image = page_obj->AsImage();
+  ASSERT_TRUE(image);
+  CPDF_PageImageCache* cache = page->GetPageImageCache();
+
+  const FX_RECT first_clip(40, 50, 440, 450);
+  bool should_continue = cache->StartGetCachedBitmap(
+      image->GetImage(), nullptr, page->GetMutablePageResources(), true,
+      CPDF_ColorSpace::Family::kICCBased, false, {612, 792}, nullptr,
+      first_clip);
+  while (should_continue) {
+    should_continue = cache->Continue(nullptr);
+  }
+  RetainPtr<CFX_DIBBase> first = cache->DetachCurBitmap();
+  ASSERT_TRUE(first);
+
+  const FX_RECT contained_clip(80, 90, 400, 410);
+  should_continue = cache->StartGetCachedBitmap(
+      image->GetImage(), nullptr, page->GetMutablePageResources(), true,
+      CPDF_ColorSpace::Family::kICCBased, false, {612, 792}, nullptr,
+      contained_clip);
+  while (should_continue) {
+    should_continue = cache->Continue(nullptr);
+  }
+  RetainPtr<CFX_DIBBase> contained = cache->DetachCurBitmap();
+  ASSERT_TRUE(contained);
+  EXPECT_EQ(first.Get(), contained.Get());
+
+  const FX_RECT outside_clip(300, 300, 600, 700);
+  should_continue = cache->StartGetCachedBitmap(
+      image->GetImage(), nullptr, page->GetMutablePageResources(), true,
+      CPDF_ColorSpace::Family::kICCBased, false, {612, 792}, nullptr,
+      outside_clip);
+  while (should_continue) {
+    should_continue = cache->Continue(nullptr);
+  }
+  RetainPtr<CFX_DIBBase> outside = cache->DetachCurBitmap();
+  ASSERT_TRUE(outside);
+  EXPECT_NE(first.Get(), outside.Get());
+
+  page->AsPDFPage()->ClearView();
+}
