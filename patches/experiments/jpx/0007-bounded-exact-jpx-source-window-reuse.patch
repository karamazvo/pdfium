+void CPDF_PageImageCache::ClearSourceWindow(Entry* entry) {
+  if (retained_source_window_entry_ != entry) {
+    return;
+  }
+  entry->ClearSourceWindow();
+  retained_source_window_entry_ = nullptr;
+}
+
+void CPDF_PageImageCache::RetainSourceWindow(
+    Entry* entry,
+    RetainPtr<CFX_DIBBase> bitmap,
+    const FX_RECT& source_clip,
+    const CFX_Size& max_size_required) {
+  if (!bitmap || bitmap->GetEstimatedImageMemoryBurden() >
+                     kMaxRetainedSourceWindowBytes) {
+    return;
+  }
+  if (retained_source_window_entry_ &&
+      retained_source_window_entry_ != entry) {
+    Entry* old_entry = retained_source_window_entry_;
+    const uint32_t old_size = old_entry->EstimateSize();
+    old_entry->ClearSourceWindow();
+    const uint32_t removed_size = old_size - old_entry->EstimateSize();
+    CHECK(cache_size_ >= removed_size);
+    cache_size_ -= removed_size;
+  }
+  entry->SetSourceWindow(std::move(bitmap), source_clip, max_size_required);
+  retained_source_window_entry_ = entry;
+}
