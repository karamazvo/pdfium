+class SourceWindowDIB final : public CFX_DIBBase {
+ public:
+  static RetainPtr<CFX_DIBBase> Create(RetainPtr<CFX_DIBitmap> window,
+                                       int full_width,
+                                       int full_height,
+                                       int window_left,
+                                       int window_top,
+                                       const FX_RECT& required_window) {
+    if (!window || window->GetBPP() < 8 || full_width <= 0 ||
+        full_height <= 0 || window_left < 0 || window_top < 0 ||
+        window_left + window->GetWidth() > full_width ||
+        window_top + window->GetHeight() > full_height ||
+        window_left > required_window.left ||
+        window_top > required_window.top ||
+        window_left + window->GetWidth() < required_window.right ||
+        window_top + window->GetHeight() < required_window.bottom) {
+      return nullptr;
+    }
+    std::optional<uint32_t> pitch =
+        fxge::CalculatePitch32(window->GetBPP(), full_width);
+    if (!pitch.has_value()) {
+      return nullptr;
+    }
+    return pdfium::MakeRetain<SourceWindowDIB>(
+        std::move(window), full_width, full_height, window_left, window_top,
+        pitch.value());
+  }
+
+  SourceWindowDIB(RetainPtr<CFX_DIBitmap> window,
+                  int full_width,
+                  int full_height,
+                  int window_left,
+                  int window_top,
+                  uint32_t pitch)
+      : window_(std::move(window)),
+        window_left_(window_left),
+        window_top_(window_top),
+        row_(pitch) {
+    SetFormat(window_->GetFormat());
+    SetWidth(full_width);
+    SetHeight(full_height);
+    SetPitch(pitch);
+    SetPalette(window_->GetPaletteSpan());
+  }
+
+  pdfium::span<const uint8_t> GetScanline(int line) const override {
+    std::ranges::fill(row_, 0);
+    if (line < window_top_ || line >= window_top_ + window_->GetHeight()) {
+      return row_;
+    }
+    const size_t bytes_per_pixel = static_cast<size_t>(GetBPP() / 8);
+    const size_t destination_offset =
+        static_cast<size_t>(window_left_) * bytes_per_pixel;
+    const size_t copy_bytes =
+        static_cast<size_t>(window_->GetWidth()) * bytes_per_pixel;
+    const auto source =
+        window_->GetScanline(line - window_top_).first(copy_bytes);
+    fxcrt::spancpy(pdfium::span(row_).subspan(destination_offset, copy_bytes),
+                   source);
+    return row_;
+  }
+
+  size_t GetEstimatedImageMemoryBurden() const override {
+    return CFX_DIBBase::GetEstimatedImageMemoryBurden() + row_.size() +
+           window_->GetEstimatedImageMemoryBurden();
+  }
+
+ private:
+  ~SourceWindowDIB() override = default;
+
+  RetainPtr<CFX_DIBitmap> const window_;
+  const int window_left_;
+  const int window_top_;
+  mutable DataVector<uint8_t> row_;
+};
+
