+// static
+FX_RECT CStretchEngine::CalculateSourceClip(
+    int source_width,
+    int source_height,
+    int destination_width,
+    int destination_height,
+    const FX_RECT& destination_clip) {
+  if (destination_width == 0 || destination_height == 0) {
+    return FX_RECT();
+  }
+
+  const double scale_x = static_cast<double>(source_width) / destination_width;
+  const double scale_y =
+      static_cast<double>(source_height) / destination_height;
+  const double base_x = destination_width > 0 ? 0.0 : destination_width;
+  const double base_y = destination_height > 0 ? 0.0 : destination_height;
+  double source_left = scale_x * (destination_clip.left + base_x);
+  double source_right = scale_x * (destination_clip.right + base_x);
+  double source_top = scale_y * (destination_clip.top + base_y);
+  double source_bottom = scale_y * (destination_clip.bottom + base_y);
+  if (source_left > source_right) {
+    std::swap(source_left, source_right);
+  }
+  if (source_top > source_bottom) {
+    std::swap(source_top, source_bottom);
+  }
+
+  FX_RECT result(static_cast<int>(floor(source_left)),
+                 static_cast<int>(floor(source_top)),
+                 static_cast<int>(ceil(source_right)),
+                 static_cast<int>(ceil(source_bottom)));
+  result.Intersect(0, 0, source_width, source_height);
+  return result;
+}
