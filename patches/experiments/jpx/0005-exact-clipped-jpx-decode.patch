+bool CJPX_Decoder::SetDecodeArea(uint32_t left,
+                                 uint32_t top,
+                                 uint32_t right,
+                                 uint32_t bottom) {
+  if (!image_ || image_->x0 != 0 || image_->y0 != 0 || left >= right ||
+      top >= bottom || right > image_->x1 || bottom > image_->y1) {
+    return false;
+  }
+
+  const auto components = components_span(image_.get());
+  if (components.empty()) {
+    return false;
+  }
+  const opj_image_comp_t& first = components.front();
+  if (first.dx != 1 || first.dy != 1 || first.x0 != 0 || first.y0 != 0) {
+    return false;
+  }
+  for (const opj_image_comp_t& component : components) {
+    if (component.dx != first.dx || component.dy != first.dy ||
+        component.x0 != first.x0 || component.y0 != first.y0 ||
+        component.w != first.w || component.h != first.h) {
+      return false;
+    }
+  }
+
+  parameters_.DA_x0 = left;
+  parameters_.DA_y0 = top;
+  parameters_.DA_x1 = right;
+  parameters_.DA_y1 = bottom;
+  return true;
+}
