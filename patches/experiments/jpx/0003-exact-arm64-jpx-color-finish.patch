+uint8x16_t LoadJpx8BitChannel(const OPJ_INT32* source, int32_t offset) {
+  const int32x4_t voffset = vdupq_n_s32(offset);
+  const int32x4_t samples0 = vaddq_s32(vld1q_s32(source), voffset);
+  const int32x4_t samples1 = vaddq_s32(vld1q_s32(source + 4), voffset);
+  const int32x4_t samples2 = vaddq_s32(vld1q_s32(source + 8), voffset);
+  const int32x4_t samples3 = vaddq_s32(vld1q_s32(source + 12), voffset);
+  const int16x8_t low =
+      vcombine_s16(vmovn_s32(samples0), vmovn_s32(samples1));
+  const int16x8_t high =
+      vcombine_s16(vmovn_s32(samples2), vmovn_s32(samples3));
+  return vreinterpretq_u8_s8(
+      vcombine_s8(vmovn_s16(low), vmovn_s16(high)));
+}
+
+std::optional<bool> TryPackJpx8BitComponents(
+    pdfium::span<uint8_t> dest_buf,
+    uint32_t pitch,
+    bool swap_rgb,
+    uint32_t channel_count,
+    pdfium::span<opj_image_comp_t> components,
+    CancelIndicatorIface* cancel) {
+  if ((channel_count != 3 && channel_count != 4) ||
+      components.size() < channel_count) {
+    return std::nullopt;
+  }
+  for (uint32_t channel = 0; channel < channel_count; ++channel) {
+    if (!components[channel].data || components[channel].prec != 8) {
+      return std::nullopt;
+    }
+  }
+
+  const uint32_t width = components[0].w;
+  const uint32_t height = components[0].h;
+  const int32_t offset0 = components[0].sgnd ? 128 : 0;
+  const int32_t offset1 = components[1].sgnd ? 128 : 0;
+  const int32_t offset2 = components[2].sgnd ? 128 : 0;
+  const int32_t offset3 =
+      channel_count == 4 && components[3].sgnd ? 128 : 0;
+  UNSAFE_TODO({
+    for (uint32_t row = 0; row < height; ++row) {
+      if (cancel && cancel->IsCancelled()) {
+        return false;
+      }
+
+      uint8_t* const output_row = dest_buf.data() + row * pitch;
+      const size_t source_row = static_cast<size_t>(row) * width;
+      uint32_t col = 0;
+      for (; col + 16 <= width; col += 16) {
+        const OPJ_INT32* const source0 =
+            components[0].data + source_row + col;
+        const OPJ_INT32* const source1 =
+            components[1].data + source_row + col;
+        const OPJ_INT32* const source2 =
+            components[2].data + source_row + col;
+        const uint8x16_t channel0 = LoadJpx8BitChannel(source0, offset0);
+        const uint8x16_t channel1 = LoadJpx8BitChannel(source1, offset1);
+        const uint8x16_t channel2 = LoadJpx8BitChannel(source2, offset2);
+
+        if (channel_count == 3) {
+          uint8x16x3_t output;
+          output.val[0] = swap_rgb ? channel2 : channel0;
+          output.val[1] = channel1;
+          output.val[2] = swap_rgb ? channel0 : channel2;
+          vst3q_u8(output_row + col * 3, output);
+          continue;
+        }
+
+        const OPJ_INT32* const source3 =
+            components[3].data + source_row + col;
+        uint8x16x4_t output;
+        output.val[0] = swap_rgb ? channel2 : channel0;
+        output.val[1] = channel1;
+        output.val[2] = swap_rgb ? channel0 : channel2;
+        output.val[3] = LoadJpx8BitChannel(source3, offset3);
+        vst4q_u8(output_row + col * 4, output);
+      }
+
+      for (; col < width; ++col) {
+        for (uint32_t channel = 0; channel < channel_count; ++channel) {
+          uint32_t output_channel = channel;
+          if (swap_rgb && channel == 0) {
+            output_channel = 2;
+          } else if (swap_rgb && channel == 2) {
+            output_channel = 0;
+          }
+          const opj_image_comp_t& component = components[channel];
+          const int32_t offset = component.sgnd ? 128 : 0;
+          output_row[col * channel_count + output_channel] =
+              static_cast<uint8_t>(component.data[source_row + col] + offset);
+        }
+      }
+    }
+  });
+  return true;
+}
