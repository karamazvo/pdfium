+struct DecodedJpx {
+  CJPX_Decoder::JpxImageInfo info;
+  uint32_t pitch;
+  std::vector<uint8_t> pixels;
+};
+
+std::optional<DecodedJpx> DecodeJpxWithThreads(
+    pdfium::span<const uint8_t> encoded,
+    uint32_t decode_threads) {
+  std::unique_ptr<CJPX_Decoder> decoder = CJPX_Decoder::Create(
+      encoded, CJPX_Decoder::ColorSpaceOption::kNormal,
+      /*resolution_levels_to_skip=*/0, /*strict_mode=*/true, decode_threads);
+  if (!decoder || !decoder->StartDecode()) {
+    return std::nullopt;
+  }
+
+  const CJPX_Decoder::JpxImageInfo info = decoder->GetInfo();
+  const std::optional<uint32_t> pitch =
+      fxge::CalculatePitch32(8 * info.channels, info.width);
+  if (!pitch.has_value()) {
+    return std::nullopt;
+  }
+
+  std::vector<uint8_t> pixels(info.height * pitch.value());
+  if (!decoder->Decode(pixels, pitch.value(), /*swap_rgb=*/false,
+                       info.channels)) {
+    return std::nullopt;
+  }
+  return DecodedJpx{info, pitch.value(), std::move(pixels)};
+}
+
 }  // namespace
 
+TEST(fxcodec, BoundedParallelDecodeMatchesSerialBytes) {
+  constexpr std::array<const char*, 3> kFixtures = {
+      "RGB.jp2", "RGB-alpha.jp2", "gray.jp2"};
+  for (const char* fixture : kFixtures) {
+    const std::string file_path = PathService::GetTestFilePath(fixture);
+    ASSERT_FALSE(file_path.empty()) << fixture;
+    const std::vector<uint8_t> encoded = GetFileContents(file_path.c_str());
+    ASSERT_FALSE(encoded.empty()) << fixture;
+
+    const std::optional<DecodedJpx> serial =
+        DecodeJpxWithThreads(encoded, /*decode_threads=*/0);
+    const std::optional<DecodedJpx> parallel = DecodeJpxWithThreads(
+        encoded, CJPX_Decoder::kMaxDecodeThreads);
+    ASSERT_TRUE(serial.has_value()) << fixture;
+    ASSERT_TRUE(parallel.has_value()) << fixture;
+    EXPECT_EQ(serial->info.width, parallel->info.width) << fixture;
+    EXPECT_EQ(serial->info.height, parallel->info.height) << fixture;
+    EXPECT_EQ(serial->info.channels, parallel->info.channels) << fixture;
+    EXPECT_EQ(serial->info.colorspace, parallel->info.colorspace) << fixture;
+    EXPECT_EQ(serial->pitch, parallel->pitch) << fixture;
+    EXPECT_EQ(serial->pixels, parallel->pixels) << fixture;
+  }
+}
