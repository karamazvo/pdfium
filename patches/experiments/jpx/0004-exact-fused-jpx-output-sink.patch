+// static
+OPJ_INT32 CJPX_Decoder::BeginFusedOutput(
+    void* client_data,
+    OPJ_UINT32 width,
+    OPJ_UINT32 height,
+    OPJ_UINT32 component_count,
+    opj_decode_output_buffer_t* output) {
+  auto* decoder = static_cast<CJPX_Decoder*>(client_data);
+  if (!decoder || !decoder->output_sink_ ||
+      !decoder->output_sink_->callback || !output) {
+    return OPJ_DECODE_OUTPUT_FALLBACK;
+  }
+
+  OutputSinkBuffer sink_output;
+  const JpxImageInfo image_info = {width, height, component_count,
+                                   decoder->image_->color_space};
+  const OutputSinkResult result = decoder->output_sink_->callback(
+      decoder->output_sink_->context, image_info, &sink_output);
+  if (result == OutputSinkResult::kFallback) {
+    return OPJ_DECODE_OUTPUT_FALLBACK;
+  }
+  if (result == OutputSinkResult::kError) {
+    return OPJ_DECODE_OUTPUT_ERROR;
+  }
+
+  output->data = sink_output.data;
+  output->data_size = sink_output.data_size;
+  output->pitch = sink_output.pitch;
+  output->channel_count = sink_output.channel_count;
+  output->swap_rgb = sink_output.swap_rgb ? OPJ_TRUE : OPJ_FALSE;
+  return OPJ_DECODE_OUTPUT_READY;
+}
