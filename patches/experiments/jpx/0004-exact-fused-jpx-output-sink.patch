+    OPJ_UINT32 row;
+    OPJ_INT32 callback_result;
+    OPJ_FLOAT32 *c0;
+    OPJ_FLOAT32 *c1;
+    OPJ_FLOAT32 *c2;
+
+    if (!p_manager || !p_manager->decode_output_handler ||
+            !p_tcd->whole_tile_decoding || p_tcd->used_component ||
+            p_tcd->cp->tw != 1U || p_tcd->cp->th != 1U ||
+            p_tcd->cp->tx0 != 0U || p_tcd->cp->ty0 != 0U ||
+            p_tcd->image->x0 != 0U || p_tcd->image->y0 != 0U ||
+            p_tcd->image->x1 != p_tcd->cp->tdx ||
+            p_tcd->image->y1 != p_tcd->cp->tdy ||
+            p_tcd->tcd_tileno != 0U || p_tcd->image->numcomps != 3U ||
+            p_tcd->tcp->mct != 1U) {
+        return OPJ_TCD_FUSED_OUTPUT_NOT_USED;
+    }
+
+    tile = p_tcd->tcd_image->tiles;
+    for (component = 0; component < 3U; ++component) {
+        opj_image_comp_t *image_component = &p_tcd->image->comps[component];
+        opj_tcd_tilecomp_t *tile_component = &tile->comps[component];
+        opj_tccp_t *coding_component = &p_tcd->tcp->tccps[component];
+        if (image_component->prec != 8U || image_component->sgnd ||
+                coding_component->qmfbid != 0U ||
+                coding_component->m_dc_level_shift != 128 ||
+                tile_component->minimum_num_resolutions == 0U ||
+                image_component->resno_decoded !=
+                tile_component->minimum_num_resolutions - 1U ||
+                !tile_component->data) {
+            return OPJ_TCD_FUSED_OUTPUT_NOT_USED;
+        }
+    }
+
+    resolution = tile->comps[0].resolutions +
+                 tile->comps[0].minimum_num_resolutions - 1U;
+    width = (OPJ_UINT32)(resolution->x1 - resolution->x0);
+    height = (OPJ_UINT32)(resolution->y1 - resolution->y0);
+    if (width == 0U || height == 0U || width > SIZE_MAX / height ||
+            width > UINT32_MAX / 3U) {
+        return OPJ_TCD_FUSED_OUTPUT_NOT_USED;
+    }
+    for (component = 1; component < 3U; ++component) {
+        opj_tcd_tilecomp_t *tile_component = &tile->comps[component];
+        opj_tcd_resolution_t *component_resolution =
+            tile_component->resolutions +
+            tile_component->minimum_num_resolutions - 1U;
+        OPJ_UINT32 component_width =
+            (OPJ_UINT32)(component_resolution->x1 - component_resolution->x0);
+        OPJ_UINT32 component_height =
+            (OPJ_UINT32)(component_resolution->y1 - component_resolution->y0);
+        if (component_width != width || component_height != height) {
+            return OPJ_TCD_FUSED_OUTPUT_NOT_USED;
+        }
+    }
+
+    memset(&output, 0, sizeof(output));
+    callback_result = p_manager->decode_output_handler(
+        p_manager->m_decode_output_data, width, height, 3U, &output);
+    if (callback_result == OPJ_DECODE_OUTPUT_FALLBACK) {
+        return OPJ_TCD_FUSED_OUTPUT_NOT_USED;
+    }
+    if (callback_result != OPJ_DECODE_OUTPUT_READY || !output.data ||
+            output.channel_count != 3U || output.pitch < width * 3U ||
+            height > output.data_size / output.pitch) {
+        return OPJ_TCD_FUSED_OUTPUT_ERROR;
+    }
+
+    c0 = (OPJ_FLOAT32 *)tile->comps[0].data;
+    c1 = (OPJ_FLOAT32 *)tile->comps[1].data;
+    c2 = (OPJ_FLOAT32 *)tile->comps[2].data;
+    for (row = 0; row < height; ++row) {
+        OPJ_UINT32 col = 0;
+        OPJ_BYTE *destination = output.data + (OPJ_SIZE_T)row * output.pitch;
+        while (col < width) {
+            OPJ_UINT32 end = opj_uint_min(col + 256U, width);
+            if (opj_event_is_cancelled(p_manager)) {
+                return OPJ_TCD_FUSED_OUTPUT_ERROR;
+            }
+            for (; col < end; ++col) {
+                OPJ_SIZE_T index = (OPJ_SIZE_T)row * width + col;
+                OPJ_FLOAT32 y = c0[index];
+                OPJ_FLOAT32 u = c1[index];
+                OPJ_FLOAT32 v = c2[index];
+                OPJ_BYTE red = opj_tcd_fused_unsigned_8bit_sample(
+                                   y + v * 1.402f);
+                OPJ_BYTE green = opj_tcd_fused_unsigned_8bit_sample(
+                                     y - u * 0.34413f - v * 0.71414f);
+                OPJ_BYTE blue = opj_tcd_fused_unsigned_8bit_sample(
+                                    y + u * 1.772f);
+                OPJ_BYTE *pixel = destination + (OPJ_SIZE_T)col * 3U;
+                pixel[output.swap_rgb ? 2U : 0U] = red;
+                pixel[1] = green;
+                pixel[output.swap_rgb ? 0U : 2U] = blue;
+            }
+        }
+    }
+
+    p_manager->m_decode_output_used = OPJ_TRUE;
+    return OPJ_TCD_FUSED_OUTPUT_USED;
+}
