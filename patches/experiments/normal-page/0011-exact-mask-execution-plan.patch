+TEST(CFXDIBitmapTest, OpaqueBitmapMaskMatchesCanonicalBgraComposite) {
+  constexpr uint32_t kSource = 0xff2850a0;
+  constexpr FXDIB_Format kDestinationFormats[] = {
+      FXDIB_Format::kBgr, FXDIB_Format::kBgrx, FXDIB_Format::kBgra};
+  constexpr uint32_t kDestinations[] = {0xffc86432, 0x80c86432, 0x00000000};
+  constexpr uint8_t kCoverages[] = {0, 1, 64, 127, 255};
+  constexpr bool kRgbByteOrders[] = {false, true};
+  const FX_RECT image_rect(0, 0, 1, 1);
+
+  for (FXDIB_Format destination_format : kDestinationFormats) {
+    for (uint32_t destination : kDestinations) {
+      for (uint8_t coverage : kCoverages) {
+        for (bool rgb_byte_order : kRgbByteOrders) {
+          auto baseline = pdfium::MakeRetain<CFX_DIBitmap>();
+          auto direct = pdfium::MakeRetain<CFX_DIBitmap>();
+          auto baseline_source = pdfium::MakeRetain<CFX_DIBitmap>();
+          auto direct_source = pdfium::MakeRetain<CFX_DIBitmap>();
+          auto baseline_mask = pdfium::MakeRetain<CFX_DIBitmap>();
+          auto direct_mask = pdfium::MakeRetain<CFX_DIBitmap>();
+          ASSERT_TRUE(baseline->Create(1, 1, destination_format));
+          ASSERT_TRUE(direct->Create(1, 1, destination_format));
+          ASSERT_TRUE(baseline_source->Create(1, 1, FXDIB_Format::kBgrx));
+          ASSERT_TRUE(direct_source->Create(1, 1, FXDIB_Format::kBgrx));
+          ASSERT_TRUE(
+              baseline_mask->Create(1, 1, FXDIB_Format::k8bppMask));
+          ASSERT_TRUE(direct_mask->Create(1, 1, FXDIB_Format::k8bppMask));
+          baseline->Clear(destination);
+          direct->Clear(destination);
+          baseline_source->Clear(kSource);
+          direct_source->Clear(kSource);
+          baseline_mask->GetWritableScanline(0)[0] = coverage;
+          direct_mask->GetWritableScanline(0)[0] = coverage;
+
+          ASSERT_TRUE(
+              baseline_source->MultiplyAlphaMask(std::move(baseline_mask)));
+          ASSERT_TRUE(baseline->CompositeBitmap(
+              0, 0, 1, 1, baseline_source, 0, 0, BlendMode::kNormal, nullptr,
+              nullptr, rgb_byte_order));
+          ASSERT_TRUE(direct->CompositeBitmap(
+              0, 0, 1, 1, direct_source, 0, 0, BlendMode::kNormal,
+              &image_rect, std::move(direct_mask), rgb_byte_order));
+          EXPECT_TRUE(std::ranges::equal(baseline->GetBuffer(),
+                                         direct->GetBuffer()));
+        }
+      }
+    }
+  }
+}
