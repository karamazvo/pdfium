diff --git a/core/fpdfapi/render/cpdf_imagerenderer.cpp b/core/fpdfapi/render/cpdf_imagerenderer.cpp
--- a/core/fpdfapi/render/cpdf_imagerenderer.cpp
+++ b/core/fpdfapi/render/cpdf_imagerenderer.cpp
@@ -9,6 +9,7 @@
 #include <math.h>
 
 #include <algorithm>
+#include <cmath>
 #include <memory>
 #include <utility>
 
@@ -56,6 +57,29 @@ bool IsImageValueTooBig(int val) {
   FX_SAFE_INT32 safe_val = val;
   safe_val = safe_val.Abs();
   return safe_val.ValueOrDefault(kLimit) >= kLimit;
+}
+
+int CalculateDecodeAxisSize(float transformed_size, int device_limit) {
+  if (device_limit <= 0 || IsImageValueTooBig(device_limit) ||
+      !std::isfinite(transformed_size) || transformed_size <= 0.0f) {
+    return 0;
+  }
+
+  // Never request more than the canonical device-sized demand. This makes the
+  // experiment optimization-only while allowing smaller image footprints to
+  // select a lower decoder resolution.
+  const float bounded_size =
+      std::min(transformed_size, static_cast<float>(device_limit));
+  return std::max(1, static_cast<int>(std::ceil(bounded_size)));
+}
+
+CFX_Size CalculateDecodeSize(const CFX_Matrix& image_matrix,
+                             const CFX_Size& device_size) {
+  const int width =
+      CalculateDecodeAxisSize(image_matrix.GetXUnit(), device_size.width);
+  const int height =
+      CalculateDecodeAxisSize(image_matrix.GetYUnit(), device_size.height);
+  return width > 0 && height > 0 ? CFX_Size(width, height) : CFX_Size(0, 0);
 }
 
 }  // namespace
