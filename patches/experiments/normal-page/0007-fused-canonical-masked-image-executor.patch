+TEST(CFXDefaultRenderDeviceTest, MaskedImageScanlinesMatchCanonicalComposite) {
+  auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(source->Create(/*width=*/1, /*height=*/1,
+                             FXDIB_Format::kBgrx));
+  source->Clear(0xffc03010);
+
+  auto mask = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(mask->Create(/*width=*/4, /*height=*/4,
+                           FXDIB_Format::k8bppMask));
+  for (int row = 0; row < mask->GetHeight(); ++row) {
+    auto scanline = mask->GetWritableScanline(row);
+    for (int col = 0; col < mask->GetWidth(); ++col) {
+      scanline[col] = static_cast<uint8_t>(32 + row * 40 + col * 8);
+    }
+  }
+
+  CFX_DefaultRenderDevice canonical;
+  CFX_DefaultRenderDevice fused;
+  ASSERT_TRUE(canonical.Create(/*width=*/4, /*height=*/4,
+                               FXDIB_Format::kBgra));
+  ASSERT_TRUE(fused.Create(/*width=*/4, /*height=*/4,
+                           FXDIB_Format::kBgra));
+  canonical.GetBitmap()->Clear(0xffe0d0c0);
+  fused.GetBitmap()->Clear(0xffe0d0c0);
+
+  auto color = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(color->Create(/*width=*/4, /*height=*/4,
+                            FXDIB_Format::kBgrx));
+  color->Clear(0xffc03010);
+  ASSERT_TRUE(color->MultiplyAlphaMask(mask));
+  ASSERT_TRUE(color->MultiplyAlpha(0.5f));
+  EXPECT_TRUE(canonical.SetDIBitsWithBlend(
+      color, /*left=*/0, /*top=*/0, BlendMode::kNormal));
+
+  const CFX_Matrix matrix(4, 0, 0, -4, 0, 4);
+  ASSERT_TRUE(
+      fused.CanStartDIBitsWithMask(*source, matrix, BlendMode::kNormal));
+  RenderDeviceDriverIface::StartResult result = fused.StartDIBitsWithMask(
+      source, mask, FX_RECT(0, 0, 4, 4), 0.5f, matrix,
+      FXDIB_ResampleOptions(), BlendMode::kNormal);
+  ASSERT_EQ(RenderDeviceDriverIface::Result::kSuccess, result.result);
+  while (result.continuation &&
+         fused.ContinueDIBits(result.continuation.get(), nullptr)) {
+  }
+
+  EXPECT_TRUE(std::ranges::equal(canonical.GetBitmap()->GetBuffer(),
+                                 fused.GetBitmap()->GetBuffer()));
+}
