+// Realizes the canonical decoded bitmap as its consumer requests scanlines.
+// The prefix invariant avoids decoder rewinds and lets a progressive stretcher
+// consume each newly decoded row before the next row is produced.
+class CanonicalRowCache final : public CFX_DIBBase {
+ public:
+  static RetainPtr<CFX_DIBBase> Create(RetainPtr<CFX_DIBBase> image) {
+    // A source with an existing decoded bitmap is already realized. Wrapping
+    // it would retain two full decoded buffers until the row cache completes.
+    if (image->GetEstimatedImageMemoryBurden() != 0) {
+      return nullptr;
+    }
+    auto bitmap = pdfium::MakeRetain<CFX_DIBitmap>();
+    if (!bitmap->Create(image->GetWidth(), image->GetHeight(),
+                        image->GetFormat())) {
+      return nullptr;
+    }
+    bitmap->SetPalette(image->GetPaletteSpan());
+
+    std::optional<uint32_t> copy_bytes = fxge::CalculatePitch8(
+        image->GetBPP(), /*components=*/1, image->GetWidth());
+    if (!copy_bytes.has_value()) {
+      return nullptr;
+    }
+    copy_bytes = std::min(copy_bytes.value(), image->GetPitch());
+    return pdfium::MakeRetain<CanonicalRowCache>(
+        std::move(image), std::move(bitmap), copy_bytes.value());
+  }
+
+  CanonicalRowCache(RetainPtr<CFX_DIBBase> image,
+                    RetainPtr<CFX_DIBitmap> bitmap,
+                    uint32_t copy_bytes)
+      : source_(std::move(image)),
+        bitmap_(std::move(bitmap)),
+        copy_bytes_(copy_bytes) {
+    SetFormat(bitmap_->GetFormat());
+    SetWidth(bitmap_->GetWidth());
+    SetHeight(bitmap_->GetHeight());
+    SetPitch(bitmap_->GetPitch());
+    SetPalette(bitmap_->GetPaletteSpan());
+  }
+
+  pdfium::span<const uint8_t> GetScanline(int line) const override {
+    if (line < 0 || line >= GetHeight()) {
+      return {};
+    }
+    if (line < cached_rows_) {
+      return bitmap_->GetScanline(line);
+    }
+    while (cached_rows_ < line) {
+      if (!CacheNextRow()) {
+        return {};
+      }
+    }
+
+    std::optional<pdfium::span<const uint8_t>> decoded_row =
+        DecodeAndCacheNextRow();
+    if (!decoded_row.has_value()) {
+      return {};
+    }
+    if (cached_rows_ == GetHeight()) {
+      source_.Reset();
+      return bitmap_->GetScanline(line);
+    }
+    return decoded_row.value();
+  }
+
+  bool SkipToScanline(int line, PauseIndicatorIface* pause) const override {
+    const int target = std::clamp(line, 0, GetHeight());
+    while (cached_rows_ < target) {
+      if (!CacheNextRow()) {
+        return false;
+      }
+      if (pause && pause->NeedToPauseNow()) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  size_t GetEstimatedImageMemoryBurden() const override {
+    size_t bytes = CFX_DIBBase::GetEstimatedImageMemoryBurden() +
+                   bitmap_->GetEstimatedImageMemoryBurden();
+    if (source_) {
+      bytes += source_->GetEstimatedImageMemoryBurden();
+    }
+    return bytes;
+  }
+
+#if BUILDFLAG(IS_WIN) || defined(PDF_USE_SKIA)
+  RetainPtr<const CFX_DIBitmap> RealizeIfNeeded() const override {
+    return CacheThroughRow(GetHeight() - 1) ? bitmap_ : nullptr;
+  }
+#endif
+
+ private:
+  ~CanonicalRowCache() override = default;
+
+  bool CacheThroughRow(int line) const {
+    while (cached_rows_ <= line) {
+      if (!CacheNextRow()) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  bool CacheNextRow() const {
+    if (!DecodeAndCacheNextRow().has_value()) {
+      return false;
+    }
+    if (cached_rows_ == GetHeight()) {
+      source_.Reset();
+    }
+    return true;
+  }
+
+  std::optional<pdfium::span<const uint8_t>> DecodeAndCacheNextRow() const {
+    if (!source_ || cached_rows_ >= GetHeight()) {
+      return std::nullopt;
+    }
+    const pdfium::span<const uint8_t> source_row =
+        source_->GetScanline(cached_rows_);
+    if (source_row.size() < copy_bytes_) {
+      return std::nullopt;
+    }
+    fxcrt::spancpy(bitmap_->GetWritableScanline(cached_rows_),
+                   source_row.first(copy_bytes_));
+    ++cached_rows_;
+    return source_row;
+  }
+
+  mutable RetainPtr<CFX_DIBBase> source_;
+  RetainPtr<CFX_DIBitmap> const bitmap_;
+  const uint32_t copy_bytes_;
+  mutable int cached_rows_ = 0;
+};
+
 #if defined(PDF_USE_SKIA)
 // Wrapper around a `CFX_DIBBase` that memoizes `RealizeSkImage()`. This is only
 // safe if the underlying `CFX_DIBBase` is not mutable.
