   }
 #endif  // defined(PDF_USE_SKIA)
-  return realize_hint ? image->Realize() : image;
+  if (!realize_hint) {
+    return image;
+  }
+  RetainPtr<CFX_DIBBase> row_cache = CanonicalRowCache::Create(image);
+  return row_cache ? std::move(row_cache) : image->Realize();
 }
 
