+void ExpectBilinearStretchMatchesWeightTableReference(FXDIB_Format format) {
+  static constexpr int kSourceWidth = 17;
+  static constexpr int kSourceHeight = 13;
+  static constexpr int kDestWidth = 29;
+  static constexpr int kDestHeight = 23;
+  const size_t components = static_cast<size_t>(GetCompsFromFormat(format));
+  ASSERT_TRUE(components == 1u || components == 3u);
+
+  auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(source->Create(kSourceWidth, kSourceHeight, format));
+  for (int row = 0; row < kSourceHeight; ++row) {
+    pdfium::span<uint8_t> scanline = source->GetWritableScanline(row);
+    for (int col = 0; col < kSourceWidth; ++col) {
+      for (size_t channel = 0; channel < components; ++channel) {
+        scanline[static_cast<size_t>(col) * components + channel] =
+            static_cast<uint8_t>((row * 37 + col * 19 + channel * 71) & 0xff);
+      }
+    }
+  }
+
+  FXDIB_ResampleOptions options;
+  options.bInterpolateBilinear = true;
+  CFX_BitmapStorer storer;
+  bool used_bounded_rows = true;
+  size_t intermediate_bytes = 0;
+  ASSERT_TRUE(RunStretch(source, format, kDestWidth, kDestHeight, options, true,
+                         &storer, &used_bounded_rows, &intermediate_bytes));
+  EXPECT_FALSE(used_bounded_rows);
+  ASSERT_TRUE(storer.GetBitmap());
+
+  CStretchEngine::WeightTable horizontal_weights;
+  ASSERT_TRUE(horizontal_weights.CalculateWeights(
+      kDestWidth, 0, kDestWidth, kSourceWidth, 0, kSourceWidth, options));
+  CStretchEngine::WeightTable vertical_weights;
+  ASSERT_TRUE(vertical_weights.CalculateWeights(
+      kDestHeight, 0, kDestHeight, kSourceHeight, 0, kSourceHeight, options));
+
+  DataVector<uint8_t> horizontal(static_cast<size_t>(kDestWidth) *
+                                 kSourceHeight * components);
+  for (int row = 0; row < kSourceHeight; ++row) {
+    const pdfium::span<const uint8_t> source_row = source->GetScanline(row);
+    for (int col = 0; col < kDestWidth; ++col) {
+      const CStretchEngine::PixelWeight* weights =
+          horizontal_weights.GetPixelWeight(col);
+      for (size_t channel = 0; channel < components; ++channel) {
+        uint32_t sum = 0;
+        for (int source_col = weights->src_start_;
+             source_col <= weights->src_end_; ++source_col) {
+          sum += weights->GetWeightForPosition(source_col) *
+                 source_row[static_cast<size_t>(source_col) * components +
+                            channel];
+        }
+        const size_t offset =
+            (static_cast<size_t>(row) * kDestWidth + col) * components +
+            channel;
+        horizontal[offset] = CStretchEngine::PixelFromFixed(sum);
+      }
+    }
+  }
+
+  for (int row = 0; row < kDestHeight; ++row) {
+    const CStretchEngine::PixelWeight* weights =
+        vertical_weights.GetPixelWeight(row);
+    const pdfium::span<const uint8_t> actual =
+        storer.GetBitmap()->GetScanline(row);
+    for (int col = 0; col < kDestWidth; ++col) {
+      for (size_t channel = 0; channel < components; ++channel) {
+        uint32_t sum = 0;
+        for (int source_row = weights->src_start_;
+             source_row <= weights->src_end_; ++source_row) {
+          const size_t offset =
+              (static_cast<size_t>(source_row) * kDestWidth + col) *
+                  components +
+              channel;
+          sum += weights->GetWeightForPosition(source_row) * horizontal[offset];
+        }
+        const size_t actual_offset =
+            static_cast<size_t>(col) * components + channel;
+        EXPECT_EQ(CStretchEngine::PixelFromFixed(sum), actual[actual_offset])
+            << "row=" << row << " col=" << col << " channel=" << channel;
+      }
+    }
+  }
+}
