+bool CStretchEngine::TryStretchExactVectorVertScanline(
+    const PixelWeight* weights,
+    pdfium::span<const uint8_t> first_row,
+    pdfium::span<const uint8_t> second_row) {
+  if (!HasOneOrTwoSourceRows(weights) ||
+      (trans_method_ != TransformMethod::k8BppTo8Bpp &&
+       trans_method_ != TransformMethod::k8BppToManyBpp &&
+       trans_method_ != TransformMethod::kManyBpptoManyBpp)) {
+    return false;
+  }
+
+  const size_t bytes_per_pixel = static_cast<size_t>(dest_bpp_ / 8);
+  if (bytes_per_pixel != 1u && bytes_per_pixel != 3u) {
+    return false;
+  }
+  const size_t pixel_count = static_cast<size_t>(dest_clip_.Width());
+  const size_t active_bytes = pixel_count * bytes_per_pixel;
+  if (first_row.size() < active_bytes || dest_scanline_.size() < active_bytes) {
+    return false;
+  }
+
+  const uint32_t first_weight =
+      weights->GetWeightForPosition(weights->src_start_);
+  if (weights->src_start_ == weights->src_end_) {
+    if (first_weight != kFixedPointOne) {
+      return false;
+    }
+    fxcrt::spancpy(pdfium::span(dest_scanline_).first(active_bytes),
+                   first_row.first(active_bytes));
+    return true;
+  }
+
+  if (second_row.size() < active_bytes) {
+    return false;
+  }
+  const uint32_t second_weight =
+      weights->GetWeightForPosition(weights->src_end_);
+  if (first_weight > kFixedPointOne || second_weight > kFixedPointOne ||
+      first_weight + second_weight != kFixedPointOne) {
+    return false;
+  }
+  if (first_weight == kFixedPointOne || second_weight == kFixedPointOne) {
+    const pdfium::span<const uint8_t> source_row =
+        first_weight == kFixedPointOne ? first_row : second_row;
+    fxcrt::spancpy(pdfium::span(dest_scanline_).first(active_bytes),
+                   source_row.first(active_bytes));
+    return true;
+  }
+#if defined(__ARM_NEON)
+  const uint16_t first_weight_16 = static_cast<uint16_t>(first_weight);
+  const uint16_t second_weight_16 = static_cast<uint16_t>(second_weight);
+  size_t byte_offset = 0;
+  for (; byte_offset + 16u <= active_bytes; byte_offset += 16u) {
+    UNSAFE_TODO({
+      const uint8x16_t first = vld1q_u8(first_row.data() + byte_offset);
+      const uint8x16_t second = vld1q_u8(second_row.data() + byte_offset);
+      vst1q_u8(
+          dest_scanline_.data() + byte_offset,
+          BlendExact16(first, second, first_weight_16, second_weight_16));
+    });
+  }
+
+  for (; byte_offset < active_bytes; ++byte_offset) {
+    dest_scanline_[byte_offset] =
+        PixelFromFixed(first_weight * first_row[byte_offset] +
+                       second_weight * second_row[byte_offset]);
+  }
+  return true;
+#else
+  return false;
+#endif
+}
