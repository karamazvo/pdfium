+  const uint16x8_t second_wide = vmovl_u8(second);
+  const uint32x4_t low =
+      vmlal_n_u16(vmull_n_u16(vget_low_u16(first_wide), first_weight),
+                  vget_low_u16(second_wide), second_weight);
+  const uint32x4_t high =
+      vmlal_n_u16(vmull_n_u16(vget_high_u16(first_wide), first_weight),
+                  vget_high_u16(second_wide), second_weight);
+  return vmovn_u16(
+      vcombine_u16(vshrn_n_u32(low, CStretchEngine::kFixedPointBits),
+                   vshrn_n_u32(high, CStretchEngine::kFixedPointBits)));
+}
