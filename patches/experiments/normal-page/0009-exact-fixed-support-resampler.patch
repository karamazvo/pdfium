+bool CStretchEngine::StretchExactFixedSupportVertScanline(
+    const PixelWeight* weights,
+    pdfium::span<const uint8_t> first_row,
+    pdfium::span<const uint8_t> second_row) {
+  if (!HasExactFixedSupport(weights) ||
+      trans_method_ == TransformMethod::kManyBpptoManyBppWithAlpha) {
+    return false;
+  }
+
+  const uint32_t first_weight =
+      weights->GetWeightForPosition(weights->src_start_);
+  const bool has_second = weights->src_end_ != weights->src_start_;
+  const uint32_t second_weight =
+      has_second ? weights->GetWeightForPosition(weights->src_end_) : 0;
+  const int bytes_per_pixel = dest_bpp_ / 8;
+  uint8_t* dest_scan = dest_scanline_.data();
+  for (int col = dest_clip_.left; col < dest_clip_.right; ++col) {
+    const size_t pixel_offset =
+        static_cast<size_t>(col - dest_clip_.left) * bytes_per_pixel;
+    if (trans_method_ == TransformMethod::k1BppTo8Bpp ||
+        trans_method_ == TransformMethod::k1BppToManyBpp ||
+        trans_method_ == TransformMethod::k8BppTo8Bpp) {
+      uint32_t dest_a = first_weight * first_row[pixel_offset];
+      if (has_second) {
+        dest_a += second_weight * second_row[pixel_offset];
+      }
+      *dest_scan = PixelFromFixed(dest_a);
+    } else {
+      uint32_t dest_b = first_weight * first_row[pixel_offset];
+      uint32_t dest_g = first_weight * first_row[pixel_offset + 1];
+      uint32_t dest_r = first_weight * first_row[pixel_offset + 2];
+      if (has_second) {
+        dest_b += second_weight * second_row[pixel_offset];
+        dest_g += second_weight * second_row[pixel_offset + 1];
+        dest_r += second_weight * second_row[pixel_offset + 2];
+      }
+      UNSAFE_TODO({
+        dest_scan[0] = PixelFromFixed(dest_b);
+        dest_scan[1] = PixelFromFixed(dest_g);
+        dest_scan[2] = PixelFromFixed(dest_r);
+      });
+    }
+    UNSAFE_TODO(dest_scan += bytes_per_pixel);
+  }
+  return true;
+}
