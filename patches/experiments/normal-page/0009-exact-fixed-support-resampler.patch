+TEST(CStretchEngine, ExactFixedSupportMatchesWeightTableReference) {
+  static constexpr int kSourceWidth = 17;
+  static constexpr int kSourceHeight = 13;
+  static constexpr int kDestWidth = 29;
+  static constexpr int kDestHeight = 23;
+  FXDIB_ResampleOptions options;
+  options.bInterpolateBilinear = true;
+
+  for (FXDIB_Format format :
+       {FXDIB_Format::k8bppMask, FXDIB_Format::kBgr}) {
+    auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+    ASSERT_TRUE(source->Create(kSourceWidth, kSourceHeight, format));
+    pdfium::span<uint8_t> source_buffer = source->GetWritableBuffer();
+    for (size_t i = 0; i < source_buffer.size(); ++i) {
+      source_buffer[i] = static_cast<uint8_t>((i * 37u + i / 11u) & 0xffu);
+    }
+
+    CFX_BitmapStorer storer;
+    bool used_bounded_rows = false;
+    size_t intermediate_bytes = 0;
+    ASSERT_TRUE(RunStretch(source, format, kDestWidth, kDestHeight, options,
+                           true, &storer, &used_bounded_rows,
+                           &intermediate_bytes));
+    EXPECT_FALSE(used_bounded_rows);
+    ASSERT_TRUE(storer.GetBitmap());
+    ExpectStretchMatchesWeightTableReference(
+        source, *storer.GetBitmap(), kDestWidth, kDestHeight, options);
+  }
