+void ExpectStretchMatchesWeightTableReference(
+    const RetainPtr<const CFX_DIBBase>& source,
+    const CFX_DIBitmap& output,
+    int dest_width,
+    int dest_height,
+    const FXDIB_ResampleOptions& options) {
+  CStretchEngine::WeightTable horizontal_weights;
+  CStretchEngine::WeightTable vertical_weights;
+  ASSERT_TRUE(horizontal_weights.CalculateWeights(
+      dest_width, 0, dest_width, source->GetWidth(), 0, source->GetWidth(),
+      options));
+  ASSERT_TRUE(vertical_weights.CalculateWeights(
+      dest_height, 0, dest_height, source->GetHeight(), 0,
+      source->GetHeight(), options));
+
+  const int bytes_per_pixel = source->GetBPP() / 8;
+  for (int row = 0; row < dest_height; ++row) {
+    const CStretchEngine::PixelWeight* row_weights =
+        vertical_weights.GetPixelWeight(row);
+    ASSERT_LE(row_weights->src_end_ - row_weights->src_start_, 1);
+    const pdfium::span<const uint8_t> output_scan = output.GetScanline(row);
+    for (int col = 0; col < dest_width; ++col) {
+      const CStretchEngine::PixelWeight* col_weights =
+          horizontal_weights.GetPixelWeight(col);
+      ASSERT_LE(col_weights->src_end_ - col_weights->src_start_, 1);
+      for (int channel = 0; channel < bytes_per_pixel; ++channel) {
+        uint32_t vertical_sum = 0;
+        for (int source_row = row_weights->src_start_;
+             source_row <= row_weights->src_end_; ++source_row) {
+          const pdfium::span<const uint8_t> source_scan =
+              source->GetScanline(source_row);
+          uint32_t horizontal_sum = 0;
+          for (int source_col = col_weights->src_start_;
+               source_col <= col_weights->src_end_; ++source_col) {
+            horizontal_sum +=
+                col_weights->GetWeightForPosition(source_col) *
+                source_scan[source_col * bytes_per_pixel + channel];
+          }
+          vertical_sum +=
+              row_weights->GetWeightForPosition(source_row) *
+              CStretchEngine::PixelFromFixed(horizontal_sum);
+        }
+        EXPECT_EQ(CStretchEngine::PixelFromFixed(vertical_sum),
+                  output_scan[col * bytes_per_pixel + channel])
+            << "row=" << row << " col=" << col
+            << " channel=" << channel;
+      }
+    }
+  }
+}
