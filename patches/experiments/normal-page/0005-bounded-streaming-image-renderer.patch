+bool CStretchEngine::TryStartBoundedRows(size_t full_intermediate_bytes) {
+  if (dest_height_ <= 0 || dest_clip_.IsEmpty() || src_clip_.IsEmpty()) {
+    return false;
+  }
+  if (!vertical_weight_table_.CalculateWeights(
+          dest_height_, dest_clip_.top, dest_clip_.bottom, src_height_,
+          src_clip_.top, src_clip_.bottom, resample_options_)) {
+    return false;
+  }
+
+  size_t max_source_rows = 0;
+  int previous_start = src_clip_.top;
+  int previous_end = src_clip_.top - 1;
+  for (int row = dest_clip_.top; row < dest_clip_.bottom; ++row) {
+    const PixelWeight* weights = vertical_weight_table_.GetPixelWeight(row);
+    if (weights->src_start_ < src_clip_.top ||
+        weights->src_end_ >= src_clip_.bottom ||
+        weights->src_start_ > weights->src_end_ ||
+        weights->src_start_ < previous_start ||
+        weights->src_end_ < previous_end) {
+      return false;
+    }
+    previous_start = weights->src_start_;
+    previous_end = weights->src_end_;
+    max_source_rows =
+        std::max(max_source_rows,
+                 static_cast<size_t>(weights->src_end_ -
+                                     weights->src_start_ + 1));
+  }
+  if (max_source_rows == 0) {
+    return false;
+  }
+
+  FX_SAFE_SIZE_T safe_size = max_source_rows;
+  safe_size *= inter_pitch_;
+  const size_t bounded_bytes = safe_size.ValueOrDefault(0);
+  if (bounded_bytes == 0 ||
+      bounded_bytes > kMaxBoundedIntermediateBytes ||
+      bounded_bytes >= full_intermediate_bytes) {
+    return false;
+  }
+
+  inter_buf_ = FixedSizeDataVector<uint8_t>::TryZeroed(bounded_bytes);
+  if (inter_buf_.empty()) {
+    return false;
+  }
+  bounded_row_capacity_ = max_source_rows;
+  cur_row_ = dest_clip_.top;
+  next_bounded_source_row_ = src_clip_.top;
+  uses_bounded_rows_ = true;
+  state_ = State::kBoundedRows;
+  return true;
+}
