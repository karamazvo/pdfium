+pdfium::span<uint8_t> CStretchEngine::GetBoundedIntermediateRow(
+    int source_row) {
+  CHECK_GT(bounded_row_capacity_, 0u);
+  CHECK_GE(source_row, src_clip_.top);
+  const size_t row_index =
+      static_cast<size_t>(source_row - src_clip_.top) % bounded_row_capacity_;
+  return inter_buf_.subspan(row_index * inter_pitch_, inter_pitch_);
+}
