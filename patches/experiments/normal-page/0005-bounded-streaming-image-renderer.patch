+TEST(CStretchEngine, BoundedRowsMatchCanonicalPixelsExactly) {
+  static constexpr int kSourceWidth = 1024;
+  static constexpr int kSourceHeight = 1024;
+  static constexpr int kDestWidth = 1200;
+  static constexpr int kDestHeight = 512;
+
+  for (FXDIB_Format format :
+       {FXDIB_Format::k8bppMask, FXDIB_Format::kBgr,
+        FXDIB_Format::kBgra}) {
+    auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+    ASSERT_TRUE(source->Create(kSourceWidth, kSourceHeight, format));
+    pdfium::span<uint8_t> source_buffer = source->GetWritableBuffer();
+    for (size_t i = 0; i < source_buffer.size(); ++i) {
+      source_buffer[i] = static_cast<uint8_t>((i * 29u + i / 17u) & 0xffu);
+    }
+
+    for (bool no_smoothing : {false, true}) {
+      FXDIB_ResampleOptions options;
+      options.bNoSmoothing = no_smoothing;
+      CFX_BitmapStorer bounded_storer;
+      CFX_BitmapStorer canonical_storer;
+      bool used_bounded_rows = false;
+      bool canonical_used_bounded_rows = true;
+      size_t bounded_bytes = 0;
+      size_t canonical_bytes = 0;
+      ASSERT_TRUE(RunStretch(source, format, kDestWidth, kDestHeight, options,
+                             true, &bounded_storer, &used_bounded_rows,
+                             &bounded_bytes));
+      ASSERT_TRUE(RunStretch(source, format, kDestWidth, kDestHeight, options,
+                             false, &canonical_storer,
+                             &canonical_used_bounded_rows, &canonical_bytes));
+
+      EXPECT_TRUE(used_bounded_rows);
+      EXPECT_FALSE(canonical_used_bounded_rows);
+      EXPECT_LT(bounded_bytes, canonical_bytes);
+      EXPECT_LE(bounded_bytes, 1024u * 1024u);
+      ASSERT_TRUE(bounded_storer.GetBitmap());
+      ASSERT_TRUE(canonical_storer.GetBitmap());
+      EXPECT_TRUE(std::ranges::equal(bounded_storer.GetBitmap()->GetBuffer(),
+                                     canonical_storer.GetBitmap()->GetBuffer()))
+          << "format=" << static_cast<int>(format)
+          << " no_smoothing=" << no_smoothing;
+    }
+  }
+}
+
+TEST(CStretchEngine, SmallIntermediateKeepsCanonicalPath) {
+  auto source = pdfium::MakeRetain<CFX_DIBitmap>();
+  ASSERT_TRUE(source->Create(64, 64, FXDIB_Format::kBgr));
+  CFX_BitmapStorer storer;
+  bool used_bounded_rows = true;
+  size_t intermediate_bytes = 0;
+  ASSERT_TRUE(RunStretch(source, FXDIB_Format::kBgr, 32, 32,
+                         FXDIB_ResampleOptions(), true, &storer,
+                         &used_bounded_rows, &intermediate_bytes));
+  EXPECT_FALSE(used_bounded_rows);
+  EXPECT_EQ(32u * 3u * 64u, intermediate_bytes);
+}
