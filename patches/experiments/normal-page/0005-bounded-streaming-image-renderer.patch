+bool CStretchEngine::ContinueBoundedRows(PauseIndicatorIface* pPause) {
+  int work_rows_until_pause = kStretchPauseRows;
+  while (cur_row_ < dest_clip_.bottom) {
+    const PixelWeight* weights =
+        vertical_weight_table_.GetPixelWeight(cur_row_);
+    if (next_bounded_source_row_ < weights->src_start_) {
+      if (source_->SkipToScanline(weights->src_start_, pPause)) {
+        return true;
+      }
+      next_bounded_source_row_ = weights->src_start_;
+    }
+    if (next_bounded_source_row_ <= weights->src_end_ &&
+        source_->SkipToScanline(next_bounded_source_row_, pPause)) {
+      return true;
+    }
+    while (next_bounded_source_row_ <= weights->src_end_) {
+      const pdfium::span<const uint8_t> src_scan =
+          source_->GetScanline(next_bounded_source_row_);
+      StretchHorizontalScanline(
+          src_scan, GetBoundedIntermediateRow(next_bounded_source_row_));
+      ++next_bounded_source_row_;
+      if (--work_rows_until_pause == 0) {
+        if (pPause && pPause->NeedToPauseNow()) {
+          return true;
         }
-        break;
+        work_rows_until_pause = kStretchPauseRows;
       }
     }
-    rows_to_go--;
+
+    StretchBoundedVertScanline(weights);
+    dest_bitmap_->ComposeScanline(cur_row_ - dest_clip_.top, dest_scanline_);
+    ++cur_row_;
+    if (--work_rows_until_pause == 0) {
+      if (pPause && pPause->NeedToPauseNow()) {
+        return true;
+      }
+      work_rows_until_pause = kStretchPauseRows;
+    }
   }
   return false;
 }
