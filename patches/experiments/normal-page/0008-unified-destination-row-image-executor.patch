+class CFX_AggImageRenderer::BufferedMaskComposer final
+    : public ScanlineComposerIface {
+ public:
+  bool SetInfo(int width,
+               int height,
+               FXDIB_Format src_format,
+               DataVector<uint32_t> src_palette) override {
+    if (width <= 0 || height <= 0 ||
+        src_format != FXDIB_Format::k8bppMask || !src_palette.empty()) {
+      return false;
+    }
+    width_ = width;
+    row_.resize(static_cast<size_t>(width));
+    return true;
+  }
+
+  void ComposeScanline(int line,
+                       pdfium::span<const uint8_t> scanline) override {
+    CHECK(!ready_);
+    CHECK_GE(scanline.size(), static_cast<size_t>(width_));
+    std::ranges::copy(scanline.first(static_cast<size_t>(width_)),
+                      row_.begin());
+    line_ = line;
+    ready_ = true;
+  }
+
+  bool HasRow() const { return ready_; }
+  int line() const {
+    CHECK(ready_);
+    return line_;
+  }
+  pdfium::span<const uint8_t> row() const {
+    CHECK(ready_);
+    return pdfium::span(row_);
+  }
+  void ConsumeRow() {
+    CHECK(ready_);
+    ready_ = false;
+  }
+
+ private:
+  DataVector<uint8_t> row_;
+  int width_ = 0;
+  int line_ = -1;
+  bool ready_ = false;
+};
+
+class CFX_AggImageRenderer::MaskedBitmapComposer final
+    : public ScanlineComposerIface {
+ public:
+  MaskedBitmapComposer(CFX_AggBitmapComposer* destination,
+                       BufferedMaskComposer* mask)
+      : destination_(destination), mask_(mask) {}
+
+  bool SetInfo(int width,
+               int height,
+               FXDIB_Format src_format,
+               DataVector<uint32_t> src_palette) override {
+    return destination_->SetInfo(width, height, src_format,
+                                 std::move(src_palette));
+  }
+
+  void ComposeScanline(int line,
+                       pdfium::span<const uint8_t> scanline) override {
+    CHECK(mask_->HasRow());
+    CHECK_EQ(mask_->line(), line);
+    destination_->ComposeScanlineWithOpacity(line, scanline, mask_->row());
+    mask_->ConsumeRow();
+  }
+
+ private:
+  UnownedPtr<CFX_AggBitmapComposer> const destination_;
+  UnownedPtr<BufferedMaskComposer> const mask_;
+};
 
