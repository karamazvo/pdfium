+RetainPtr<const CFX_DIBBase> MakeStreamingMaskView(
+    RetainPtr<const CFX_DIBBase> mask) {
+  if (!mask) {
+    return nullptr;
+  }
+  if (mask->GetFormat() == FXDIB_Format::k8bppMask) {
+    return mask;
+  }
+  if (mask->GetFormat() != FXDIB_Format::k8bppRgb ||
+      mask->GetPaletteSpan().size() != CFX_DIBBase::kPaletteSize) {
+    return nullptr;
+  }
+  for (uint32_t value = 0; value < CFX_DIBBase::kPaletteSize; ++value) {
+    const int component = static_cast<int>(value);
+    if (mask->GetPaletteArgb(value) !=
+        ArgbEncode(255, component, component, component)) {
+      return nullptr;
+    }
+  }
+  return pdfium::MakeRetain<IdentityGrayMaskView>(std::move(mask));
+}
