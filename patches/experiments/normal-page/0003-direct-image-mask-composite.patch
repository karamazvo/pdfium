+bool CFX_AggDeviceDriver::SetBitsWithMask(
+    RetainPtr<const CFX_DIBBase> bitmap,
+    RetainPtr<const CFX_DIBBase> mask,
+    int dest_left,
+    int dest_top,
+    float alpha,
+    BlendMode blend_type) {
+  // The canonical path first turns this opaque bitmap into BGRA using the
+  // mask, then composites it. For the exact common case below, the existing
+  // scanline compositor can consume the same mask as coverage directly.
+  if (alpha != 1.0f || blend_type != BlendMode::kNormal ||
+      bitmap->GetFormat() != FXDIB_Format::kBgrx ||
+      mask->GetFormat() != FXDIB_Format::k8bppMask ||
+      bitmap->GetWidth() != mask->GetWidth() ||
+      bitmap->GetHeight() != mask->GetHeight() || group_knockout_ ||
+      (clip_rgn_ && clip_rgn_->GetMask())) {
+    return false;
+  }
+  if (bitmap_->GetBuffer().empty()) {
+    return true;
+  }
+
+  const FX_RECT image_rect(dest_left, dest_top,
+                           dest_left + bitmap->GetWidth(),
+                           dest_top + bitmap->GetHeight());
+  FX_RECT draw_rect = image_rect;
+  const FX_RECT device_rect(0, 0, bitmap_->GetWidth(), bitmap_->GetHeight());
+  draw_rect.Intersect(device_rect);
+  if (clip_rgn_) {
+    draw_rect.Intersect(clip_rgn_->GetBox());
+  }
+  if (draw_rect.IsEmpty()) {
+    return true;
+  }
+
+  return bitmap_->CompositeBitmap(
+      draw_rect.left, draw_rect.top, draw_rect.Width(), draw_rect.Height(),
+      std::move(bitmap), draw_rect.left - dest_left, draw_rect.top - dest_top,
+      blend_type, &image_rect, std::move(mask), rgb_byte_order_);
+}
