+  int skipped_shading_count;
+  int skipped_form_count;
+  int skipped_transparency_count;
+  int skipped_soft_mask_count;
+
+  int64_t render_page_bitmap_ns;
+  int64_t render_page_bitmap_with_matrix_ns;
+  int64_t sdk_render_page_ns;
+  int64_t progressive_continue_ns;
+  int64_t render_object_list_ns;
