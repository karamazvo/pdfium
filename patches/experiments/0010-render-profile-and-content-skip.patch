@@ -0,0 +1,281 @@
+// Copyright 2026 The xPDFSDK Authors
+// Use of this source code is governed by the PDFium BSD-style license.
+
+#ifndef CORE_FPDFAPI_RENDER_VELOCE_RENDER_PROFILE_H_
+#define CORE_FPDFAPI_RENDER_VELOCE_RENDER_PROFILE_H_
+
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+
+#include "public/fpdfview.h"
+
+enum class VeloceRenderProfilePhase {
+  kRenderPageBitmap,
+  kRenderPageBitmapWithMatrix,
+  kSdkRenderPage,
+  kProgressiveContinue,
+  kRenderObjectList,
+  kRenderSingleObject,
+  kContinueSingleObject,
+  kProcessClipPath,
+  kProcessTransparency,
+  kProcessObjectNoClip,
+  kProcessText,
+  kProcessPath,
+  kProcessImage,
+  kProcessShading,
+  kProcessForm,
+  kDrawObjWithBackground,
+  kLoadSMask,
+};
+
+struct VeloceRenderProfileState {
+  bool active = false;
+  FPDFEx_RenderProfile current = {};
+};
+
+inline std::atomic<bool>& VeloceRenderProfileEnabledFlag() {
+  static std::atomic<bool> flag{false};
+  return flag;
+}
+
+inline std::atomic<uint32_t>& VeloceRenderSkipMaskFlag() {
+  static std::atomic<uint32_t> mask{0};
+  return mask;
+}
+
+inline VeloceRenderProfileState& VeloceRenderProfileStateForThread() {
+  thread_local VeloceRenderProfileState state;
+  return state;
+}
+
+inline FPDFEx_RenderProfile& VeloceLastRenderProfileForProbe() {
+  static FPDFEx_RenderProfile profile = {};
+  return profile;
+}
+
+inline std::mutex& VeloceLastRenderProfileMutexForProbe() {
+  static std::mutex mutex;
+  return mutex;
+}
+
+inline void VeloceSetRenderProfileEnabledForProbe(bool enabled) {
+  VeloceRenderProfileEnabledFlag().store(enabled, std::memory_order_relaxed);
+}
+
+inline bool VeloceIsRenderProfileEnabledForProbe() {
+  return VeloceRenderProfileEnabledFlag().load(std::memory_order_relaxed);
+}
+
+inline void VeloceSetRenderSkipMaskForProbe(uint32_t mask) {
+  VeloceRenderSkipMaskFlag().store(mask, std::memory_order_relaxed);
+}
+
+inline uint32_t VeloceGetRenderSkipMaskForProbe() {
+  return VeloceRenderSkipMaskFlag().load(std::memory_order_relaxed);
+}
+
+inline bool VeloceShouldSkipRenderPartForProbe(uint32_t mask) {
+  return (VeloceGetRenderSkipMaskForProbe() & mask) != 0;
+}
+
+inline void VeloceResetRenderProfileForProbe() {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  state.current = {};
+  std::lock_guard<std::mutex> lock(VeloceLastRenderProfileMutexForProbe());
+  VeloceLastRenderProfileForProbe() = {};
+}
+
+inline bool VeloceGetLastRenderProfileForProbe(FPDFEx_RenderProfile* out) {
+  if (!out) {
+    return false;
+  }
+
+  std::lock_guard<std::mutex> lock(VeloceLastRenderProfileMutexForProbe());
+  const FPDFEx_RenderProfile& last = VeloceLastRenderProfileForProbe();
+  if (last.struct_size != sizeof(FPDFEx_RenderProfile)) {
+    std::memset(out, 0, sizeof(*out));
+    return false;
+  }
+
+  *out = last;
+  return true;
+}
+
+inline void VeloceBeginRenderProfileForProbe() {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  state.active = VeloceIsRenderProfileEnabledForProbe();
+  state.current = {};
+  state.current.struct_size = sizeof(FPDFEx_RenderProfile);
+  state.current.skip_mask = VeloceGetRenderSkipMaskForProbe();
+}
+
+inline void VeloceEndRenderProfileForProbe() {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  if (state.active) {
+    std::lock_guard<std::mutex> lock(VeloceLastRenderProfileMutexForProbe());
+    VeloceLastRenderProfileForProbe() = state.current;
+  }
+  state.active = false;
+}
+
+inline void VeloceAddRenderProfileTimeForProbe(VeloceRenderProfilePhase phase,
+                                               int64_t elapsed_ns) {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  if (!state.active) {
+    return;
+  }
+
+  switch (phase) {
+    case VeloceRenderProfilePhase::kRenderPageBitmap:
+      state.current.render_page_bitmap_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kRenderPageBitmapWithMatrix:
+      state.current.render_page_bitmap_with_matrix_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kSdkRenderPage:
+      state.current.sdk_render_page_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProgressiveContinue:
+      state.current.progressive_continue_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kRenderObjectList:
+      state.current.render_object_list_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kRenderSingleObject:
+      state.current.render_single_object_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kContinueSingleObject:
+      state.current.continue_single_object_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessClipPath:
+      state.current.process_clip_path_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessTransparency:
+      state.current.process_transparency_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessObjectNoClip:
+      state.current.process_object_no_clip_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessText:
+      state.current.process_text_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessPath:
+      state.current.process_path_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessImage:
+      state.current.process_image_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessShading:
+      state.current.process_shading_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kProcessForm:
+      state.current.process_form_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kDrawObjWithBackground:
+      state.current.draw_obj_with_background_ns += elapsed_ns;
+      break;
+    case VeloceRenderProfilePhase::kLoadSMask:
+      state.current.load_smask_ns += elapsed_ns;
+      break;
+  }
+}
+
+inline void VeloceRecordRenderObjectForProbe(uint32_t object_mask) {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  if (!state.active) {
+    return;
+  }
+
+  ++state.current.total_object_count;
+  switch (object_mask) {
+    case FPDFEX_RENDER_SKIP_TEXT:
+      ++state.current.text_object_count;
+      break;
+    case FPDFEX_RENDER_SKIP_PATH:
+      ++state.current.path_object_count;
+      break;
+    case FPDFEX_RENDER_SKIP_IMAGE:
+      ++state.current.image_object_count;
+      break;
+    case FPDFEX_RENDER_SKIP_SHADING:
+      ++state.current.shading_object_count;
+      break;
+    case FPDFEX_RENDER_SKIP_FORM:
+      ++state.current.form_object_count;
+      break;
+  }
+}
+
+inline void VeloceRecordSkippedRenderObjectForProbe(uint32_t object_mask) {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  if (!state.active) {
+    return;
+  }
+
+  ++state.current.skipped_object_count;
+  switch (object_mask) {
+    case FPDFEX_RENDER_SKIP_TEXT:
+      ++state.current.skipped_text_count;
+      break;
+    case FPDFEX_RENDER_SKIP_PATH:
+      ++state.current.skipped_path_count;
+      break;
+    case FPDFEX_RENDER_SKIP_IMAGE:
+      ++state.current.skipped_image_count;
+      break;
+    case FPDFEX_RENDER_SKIP_SHADING:
+      ++state.current.skipped_shading_count;
+      break;
+    case FPDFEX_RENDER_SKIP_FORM:
+      ++state.current.skipped_form_count;
+      break;
+  }
+}
+
+inline void VeloceRecordSkippedTransparencyForProbe() {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  if (state.active) {
+    ++state.current.skipped_transparency_count;
+  }
+}
+
+inline void VeloceRecordSkippedSoftMaskForProbe() {
+  VeloceRenderProfileState& state = VeloceRenderProfileStateForThread();
+  if (state.active) {
+    ++state.current.skipped_soft_mask_count;
+  }
+}
+
+class VeloceRenderProfileScopeForProbe {
+ public:
+  explicit VeloceRenderProfileScopeForProbe(VeloceRenderProfilePhase phase)
+      : phase_(phase),
+        active_(VeloceRenderProfileStateForThread().active),
+        start_(std::chrono::steady_clock::now()) {}
+
+  ~VeloceRenderProfileScopeForProbe() {
+    if (!active_) {
+      return;
+    }
+    const auto elapsed = std::chrono::steady_clock::now() - start_;
+    VeloceAddRenderProfileTimeForProbe(
+        phase_, std::chrono::duration_cast<std::chrono::nanoseconds>(elapsed)
+                    .count());
+  }
+
+ private:
+  VeloceRenderProfilePhase phase_;
+  bool active_;
+  std::chrono::steady_clock::time_point start_;
+};
+
+class VeloceRenderProfileSessionForProbe {
+ public:
+  VeloceRenderProfileSessionForProbe() { VeloceBeginRenderProfileForProbe(); }
+  ~VeloceRenderProfileSessionForProbe() { VeloceEndRenderProfileForProbe(); }
+};
+
+#endif  // CORE_FPDFAPI_RENDER_VELOCE_RENDER_PROFILE_H_
