      "writtenOn": "2025-01-22T17:36:21Z",
      "side": 1,
      "message": "I tried `u8\"foo\"` and the compiler still didn\u0027t want to accept a span of char8_t as a span of StringViewTemplate::UnsignedType. Maybe we should borrow Chromium\u0027s base::byte_span_from_cstring() to make this easier.",
      "parentUuid": "437fe935_2f655bee",
      "revId": "748122cd7ad72da5165180718c76417d13d40edb",
      "serverId": "fca2d64a-0420-3532-b200-12848c95a47b"
    },
