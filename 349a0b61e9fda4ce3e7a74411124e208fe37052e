      "lineNbr": 155,
      "author": {
        "id": 5045
      },
      "writtenOn": "2025-10-28T00:48:04Z",
      "side": 1,
      "message": "Would PngAskScanlineBuf().size() work instead?",
      "revId": "349a0b61e9fda4ce3e7a74411124e208fe37052e",
      "serverId": "fca2d64a-0420-3532-b200-12848c95a47b"
    },
